DEBUG=False
SECRET_KEY=replace-with-strong-secret
# Include your Droplet public IP and domain (no spaces). Required when DEBUG=False or Docker sets DEBUG=0.
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_DROPLET_IP,127.0.0.1,localhost

# Database / cache
DATABASE_URL=postgres://postgres:postgres@db:5432/rankjee_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
USE_REDIS_CACHE=1
REDIS_CACHE_URL=redis://redis:6379/2

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Payments
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_USE_DUMMY=0

# App URLs
SITE_BASE_URL=https://yourdomain.com

