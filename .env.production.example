DEBUG=False
SECRET_KEY=replace-with-strong-secret
# Include your Droplet public IP and domain (no spaces). Required when DEBUG=False or Docker sets DEBUG=0.
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_DROPLET_IP,127.0.0.1,localhost

# Database / cache (PostgreSQL required when DEBUG=False; pooled connections for performance)
DATABASE_URL=postgres://postgres:postgres@db:5432/rankjee_db
DB_CONN_MAX_AGE=600
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# With DEBUG=0 and REDIS_URL set, Django uses Redis cache unless USE_REDIS_CACHE=0
USE_REDIS_CACHE=1
REDIS_CACHE_URL=redis://redis:6379/2

RAZORPAY_KEY_ID=rzp_live_SlNUl9CLVyDk42
RAZORPAY_KEY_SECRET=7skyrAV4i8MEH5zSwX397R7l

# Optional: tune Gunicorn (docker-compose web service)
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Payments — KEY_ID + KEY_SECRET must be from the same Razorpay mode (both test or both live).
# Docker: put these in project `.env` next to docker-compose.yml — Compose uses `env_file: .env` so values are not
# broken by `${VAR}` interpolation (secrets with `$` used to truncate / auth fail).
# No quotes; no spaces around `=`. Regenerate secret from Dashboard if you see "Authentication failed".
# On the server: `docker compose exec web python manage.py razorpay_check` (tests API auth, prints no secrets).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_USE_DUMMY=0
# Webhook signing secret from Razorpay Dashboard → Webhooks (for /hometutor/payments/webhook/razorpay/)
RAZORPAY_WEBHOOK_SECRET=

# Home tutor marketplace (separate from subscription checkout)
HOMETUTOR_DEFAULT_MONTHLY_FEE_INR=5000
HOMETUTOR_PLATFORM_FEE_PERCENT=15

# App URLs
SITE_BASE_URL=https://yourdomain.com
SITE_ID=1
# Required behind HTTPS reverse proxy (scheme + host, comma-separated, no paths)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Optional for apex+www mixed traffic; share auth/csrf cookies across subdomains
# COOKIE_DOMAIN=.yourdomain.com

# Google OAuth (Django allauth)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# HSTS (set SECURE_HSTS_SECONDS=0 to disable). SSL redirect defaults to ON in production.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# SECURE_HSTS_PRELOAD=0
# SECURE_SSL_REDIRECT=0

