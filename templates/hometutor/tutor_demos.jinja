{% extends "base.jinja" %}
{% block title %}Demo inbox · RankJee{% endblock %}

{% block content %}
<section class="bg-slate-100 border-b border-slate-200/80 pt-8 pb-10 px-4">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
            {% include "partials/_breadcrumb.jinja" %}
            <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-600 mb-2">Tutor workspace · Demo inbox</p>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Demo inbox{% if pending_rows %} <span class="text-lg font-black text-emerald-700">({{ pending_rows|length }})</span>{% endif %}</h1>
            <p class="text-slate-600 text-sm mt-1">{{ profile.display_name }} · {{ profile.city or hometutor_pilot_city }}</p>
        </div>
        <div class="flex flex-wrap gap-3 text-sm font-bold">
            <a href="{{ url('dashboard:index') }}" class="text-slate-600 hover:text-slate-900">Dashboard</a>
            <a href="{{ url('hometutor:my_profile') }}" class="text-indigo-600 hover:underline">Edit listing</a>
        </div>
    </div>
</section>

<section class="max-w-4xl mx-auto px-4 py-10 space-y-10">
    <div>
        <h2 class="text-lg font-black text-slate-900 mb-4">Pending</h2>
        {% if pending_rows %}
        <div class="space-y-6">
            {% for row in pending_rows %}
            <article class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-4">
                    <div>
                        <p class="font-black text-slate-900">{{ row.demo.requester.get_username() }}</p>
                        <p class="text-xs text-slate-500">Email: {{ row.requester_email_masked }}</p>
                        {% if row.requester_phone_masked %}<p class="text-sm text-slate-700 mt-1">Phone: {{ row.requester_phone_masked }}</p>{% endif %}
                    </div>
                    <p class="text-xs text-slate-400">{{ row.demo.created_at.strftime('%d %b %Y %H:%M') }}</p>
                </div>
                {% if row.demo.message %}
                <p class="text-sm text-slate-700 whitespace-pre-line border-l-4 border-indigo-200 pl-3 mb-4">{{ row.demo.message }}</p>
                {% endif %}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
                    <form method="post" action="{{ url('hometutor:demo_accept', row.demo.id) }}" class="space-y-2">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-wider">Accept — propose time</label>
                        {{ row.accept_form.scheduled_at }}
                        <button type="submit" class="mt-2 w-full py-2.5 rounded-xl bg-emerald-600 text-white text-sm font-black hover:bg-emerald-500">Accept</button>
                    </form>
                    <form method="post" action="{{ url('hometutor:demo_decline', row.demo.id) }}" class="space-y-2">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-wider">Decline (optional note)</label>
                        {{ row.decline_form.decline_reason }}
                        <button type="submit" class="mt-2 w-full py-2.5 rounded-xl border border-slate-200 text-slate-800 text-sm font-black hover:bg-slate-50">Decline</button>
                    </form>
                </div>
            </article>
            {% endfor %}
        </div>
        {% else %}
        <p class="text-slate-500 text-sm">No pending demo requests.</p>
        {% endif %}
    </div>

    <div>
        <h2 class="text-lg font-black text-slate-900 mb-4">Recent</h2>
        {% if recent %}
        <ul class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
            {% for d in recent %}
            <li class="px-4 py-4 flex flex-col gap-2 text-sm border-b border-slate-100 last:border-0">
                <div class="flex flex-wrap justify-between gap-2 items-start">
                    <span class="font-bold text-slate-800">{{ d.requester.get_username() }}</span>
                    <span class="text-xs font-black uppercase tracking-wider {% if d.status == 'ACCEPTED' %}text-emerald-700{% elif d.status == 'DECLINED' %}text-rose-700{% else %}text-slate-500{% endif %}">{{ d.get_status_display() }}</span>
                </div>
                {% if d.scheduled_at %}<span class="text-xs text-slate-500">{{ d.scheduled_at.strftime('%d %b %Y %H:%M') }}</span>{% endif %}
                {% if d.status == 'ACCEPTED' and d.engagement %}
                {% if d.engagement.status == 'ACTIVE' %}
                <p class="text-xs font-black text-indigo-800">Fully confirmed by both sides.</p>
                <a href="{{ url('hometutor:engagement_room', d.engagement.id) }}" class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg border border-indigo-200 text-indigo-700 text-xs font-black hover:bg-indigo-50">Open session room</a>
                {% else %}
                <p class="text-xs text-slate-600">Confirmations: parent {% if d.engagement.parent_confirmed_at %}✓{% else %}pending{% endif %} · you {% if d.engagement.tutor_confirmed_at %}✓{% else %}pending{% endif %}</p>
                {% if not d.engagement.tutor_confirmed_at %}
                <form method="post" action="{{ url('hometutor:demo_confirm_tutor', d.id) }}" class="inline">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    <button type="submit" class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-black hover:bg-indigo-500">I confirm this demo time</button>
                </form>
                {% endif %}
                {% endif %}
                {% endif %}
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="text-slate-500 text-sm">No history yet.</p>
        {% endif %}
    </div>
</section>
{% endblock %}
