{% extends "base.jinja" %}
{% block title %}My tutor listing · RankJee{% endblock %}

{% block content %}
<section class="bg-slate-100 border-b border-slate-200/80 pt-8 pb-10 px-4">
    <div class="max-w-3xl mx-auto">
        {% include "partials/_breadcrumb.jinja" %}
        <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600 mb-2">Home tutor</p>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight mb-2">Your public listing</h1>
        <p class="text-slate-600 text-sm">Shown in search after <strong>approval</strong> by our team. Edits to key fields may send you back to pending review.</p>
        {% if profile %}
        <p class="mt-3 text-sm font-bold text-slate-700">
            Status:
            <span class="text-indigo-700">{{ profile.get_verification_status_display() }}</span>
            {% if profile.slug %}
            · <a href="{{ url('hometutor:tutor_detail', profile.slug) }}" class="text-indigo-600 hover:underline">Preview public URL</a>
            {% endif %}
        </p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm font-bold">
            <a href="{{ url('dashboard:index') }}" class="text-slate-600 hover:text-slate-900">Dashboard</a>
            <a href="{{ url('hometutor:tutor_demos') }}" class="text-emerald-700 hover:text-emerald-900">Demo inbox</a>
        </div>
        {% endif %}
    </div>
</section>

<section class="max-w-3xl mx-auto px-4 py-10">
    <form method="post" enctype="multipart/form-data" class="space-y-8">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">

        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-500">Listing</h2>
            {% for field in form %}
            <div>
                <label for="{{ field.id_for_label }}" class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-1">{{ field.label }}</label>
                {{ field }}
                {% if field.help_text %}
                <p class="mt-1 text-xs text-slate-500">{{ field.help_text }}</p>
                {% endif %}
                {% if field.errors %}
                <p class="text-red-600 text-sm mt-1 font-medium">{% for e in field.errors %}{{ e }}{% endfor %}</p>
                {% endif %}
            </div>
            {% endfor %}
        </div>

        {% if profile %}
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-3">
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-500">Verification documents</h2>
            <p class="text-xs text-slate-500">Upload ID or degree proof; staff reviews in <code class="bg-slate-100 px-1 rounded">/sd/</code>.</p>
            <ul class="text-sm text-slate-700 space-y-1">
                {% for d in profile.documents.all() %}
                {% if loop.index <= 10 %}
                <li class="flex flex-wrap gap-2 items-center">
                    <span class="font-bold">{{ d.label }}</span>
                    <span class="text-xs px-2 py-0.5 rounded-full {% if d.status == 'APPROVED' %}bg-emerald-100 text-emerald-800{% elif d.status == 'REJECTED' %}bg-rose-100 text-rose-800{% else %}bg-amber-100 text-amber-800{% endif %}">{{ d.get_status_display() }}</span>
                    {% if d.file %}<a href="{{ d.file.url }}" class="text-indigo-600 text-xs font-bold hover:underline" target="_blank" rel="noopener">View</a>{% endif %}
                </li>
                {% endif %}
                {% else %}
                <li class="text-slate-500">No documents yet.</li>
                {% endfor %}
            </ul>
            <div class="pt-2 border-t border-slate-100 space-y-2">
                <label for="{{ doc_form.label.id_for_label }}" class="block text-xs font-black text-slate-500 uppercase tracking-wider">Add document</label>
                {{ doc_form.label }}
                {{ doc_form.file }}
                {% if doc_form.non_field_errors() %}
                <p class="text-red-600 text-sm">{% for e in doc_form.non_field_errors() %}{{ e }}{% endfor %}</p>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-3">
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-500">Optional document</h2>
            <p class="text-xs text-slate-500">After you save once, upload ID or degree proof for faster verification.</p>
            {{ doc_form.label }}
            {{ doc_form.file }}
        </div>
        {% endif %}

        <div class="flex flex-wrap gap-3">
            <button type="submit" name="action" value="submit_review" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-indigo-600 text-white text-sm font-black hover:bg-indigo-500 transition-colors">
                {% if profile and profile.verification_status == 'DRAFT' %}Submit for review{% else %}Save &amp; submit for review{% endif %}
            </button>
            <button type="submit" name="action" value="save_draft" class="inline-flex items-center justify-center px-6 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-bold hover:bg-slate-50 transition-colors">
                Save draft
            </button>
            <a href="{{ url('dashboard:index') }}" class="inline-flex items-center justify-center px-6 py-3 rounded-xl text-slate-600 text-sm font-bold hover:text-indigo-600">Dashboard</a>
        </div>
    </form>
</section>
{% endblock %}
