{# Paginator for tutor marketplace — preserves active filter query string #}
{% if page_obj and page_obj.paginator.num_pages > 1 %}
<nav class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3" aria-label="Tutor results pages">
    {% if page_obj.has_previous() %}
    <a href="?{% if pagination_query %}{{ pagination_query }}&{% endif %}page={{ page_obj.previous_page_number() }}"
       class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">
        ← Previous
    </a>
    {% endif %}
    <p class="text-sm font-semibold text-slate-600 text-center">
        Page <span class="text-slate-900 font-black">{{ page_obj.number }}</span>
        of {{ page_obj.paginator.num_pages }}
        <span class="text-slate-400 font-medium">· {{ page_obj.paginator.count }} tutors</span>
    </p>
    {% if page_obj.has_next() %}
    <a href="?{% if pagination_query %}{{ pagination_query }}&{% endif %}page={{ page_obj.next_page_number() }}"
       class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">
        Next →
    </a>
    {% endif %}
</nav>
{% elif page_obj and page_obj.paginator.count %}
<p class="mt-6 text-center text-xs font-semibold text-slate-500">
    Showing {{ page_obj.start_index() }}–{{ page_obj.end_index() }} of {{ page_obj.paginator.count }} tutors
</p>
{% endif %}
