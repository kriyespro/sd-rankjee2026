{# Premium tutor card for home page featured section only #}
<article class="home-tutor-card group flex flex-col h-full overflow-hidden rounded-2xl bg-white border border-slate-200/80 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="box-shadow:0 4px 24px -8px rgba(13,43,94,0.12);">
    <div class="h-1.5 w-full shrink-0" style="background:linear-gradient(90deg,var(--rj-navy) 0%,var(--rj-saffron) 55%,var(--rj-gold) 100%);"></div>

    <div class="flex flex-col flex-grow p-5 sm:p-6">
        {# Header: avatar + badges #}
        <div class="flex items-start gap-4 mb-4">
            {% if t.image_url %}
            <div class="relative shrink-0">
                <img src="{{ t.image_url }}" alt="{{ t.name }}" class="w-16 h-16 sm:w-[4.25rem] sm:h-[4.25rem] rounded-2xl object-cover border-2 border-white shadow-md" style="box-shadow:0 8px 20px -6px rgba(13,43,94,0.25);">
                <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-white text-[10px] font-black" title="Verified">✓</span>
            </div>
            {% else %}
            <div class="relative shrink-0 w-16 h-16 sm:w-[4.25rem] sm:h-[4.25rem] rounded-2xl flex items-center justify-center text-2xl font-black text-white shadow-md" style="background:linear-gradient(145deg,var(--rj-navy) 0%,#1e3a6e 100%);">
                {{ t.name[0] }}
                {% if t.verified %}
                <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-white text-[10px] font-black">✓</span>
                {% endif %}
            </div>
            {% endif %}
            <div class="min-w-0 flex-1 pt-0.5">
                {% if t.verified %}
                <span class="inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full mb-1.5" style="background:rgba(28,169,123,0.1);color:#047857;border:1px solid rgba(28,169,123,0.25);">
                    Verified tutor
                </span>
                {% endif %}
                <p class="flex items-center gap-1 text-sm font-black" style="color:var(--rj-navy);">
                    <span class="text-amber-500">★</span>
                    {{ t.rating }}
                    <span class="text-slate-400 font-semibold text-xs">({{ t.reviews }} reviews)</span>
                </p>
            </div>
        </div>

        {# Name & subjects #}
        <div class="mb-4 flex-grow">
            <h3 class="text-lg sm:text-xl font-black tracking-tight leading-tight mb-1" style="color:var(--rj-navy);">{{ t.name }}</h3>
            <p class="text-sm font-semibold leading-snug line-clamp-2" style="color:color-mix(in srgb,var(--rj-navy) 75%,#475569);">{{ t.subjects }}</p>
            <p class="text-xs text-slate-500 mt-1.5 font-medium">{{ t.classes }}</p>
        </div>

        {# Chips #}
        <div class="flex flex-wrap gap-2 mb-4">
            <span class="inline-flex items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 border border-slate-200/80">{{ t.teaching_mode|default('Hybrid') }}</span>
            <span class="inline-flex items-center text-[11px] font-bold px-2.5 py-1 rounded-lg border" style="background:rgba(244,113,28,0.08);color:var(--rj-saffron);border-color:rgba(244,113,28,0.2);">{{ t.class_range|default(t.classes) }}</span>
        </div>

        {# Location #}
        <p class="text-xs text-slate-600 flex items-start gap-1.5 mb-5">
            <span class="text-sm leading-none mt-0.5" aria-hidden="true">📍</span>
            <span>{{ t.area }}{% if t.city %}, {{ t.city }}{% endif %}{% if t.pincode %} · {{ t.pincode }}{% endif %}</span>
        </p>

        {# Fee row #}
        <div class="flex items-end justify-between gap-3 pt-4 border-t border-slate-100 mb-4">
            <span class="text-xs font-bold uppercase tracking-wide text-slate-500">Starting fee</span>
            <span class="text-lg font-black tracking-tight" style="color:var(--rj-navy);">{{ t.fee_label }}</span>
        </div>

        {# CTA #}
        {% if t.profile_url %}
        <a href="{{ t.profile_url }}" class="mt-auto block w-full text-center py-3 rounded-xl font-black text-sm text-white uppercase tracking-wide transition-all group-hover:opacity-95" style="background:var(--rj-saffron);box-shadow:0 10px 28px -10px rgba(244,113,28,0.55);">
            View profile →
        </a>
        {% else %}
        <a href="{{ url('hometutor:tutor_list') }}" class="mt-auto block w-full text-center py-3 rounded-xl font-black text-sm text-white uppercase tracking-wide transition-all" style="background:var(--rj-saffron);box-shadow:0 10px 28px -10px rgba(244,113,28,0.55);">
            Find tutors →
        </a>
        {% endif %}
    </div>
</article>
