<article class="bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-lg hover:border-indigo-200 transition-all p-6 flex flex-col h-full">
    <div class="flex items-start justify-between gap-2 mb-4">
        {% if t.image_url %}
        <img src="{{ t.image_url }}" alt="{{ t.name }}" class="w-16 h-16 rounded-2xl object-cover border border-slate-200 shrink-0">
        {% else %}
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white flex items-center justify-center text-2xl font-black shrink-0">
            {{ t.name[0] }}
        </div>
        {% endif %}
        <div class="flex flex-col items-end gap-2">
            {% if t.verified %}
            <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full">Verified</span>
            {% endif %}
            <span class="text-xs text-amber-600 font-bold bg-amber-50 px-2.5 py-1 rounded-full">★ {{ t.rating }} <span class="text-slate-500 font-semibold">({{ t.reviews }})</span></span>
        </div>
    </div>
    {% if t.profile_url %}
    <a href="{{ t.profile_url }}" class="group block flex-grow flex flex-col">
        <h3 class="text-lg font-black text-slate-900 group-hover:text-indigo-700">{{ t.name }}</h3>
        <p class="text-sm text-indigo-700 font-semibold mt-1 line-clamp-2">{{ t.subjects }}</p>
        <p class="text-xs text-slate-500 mt-2">{{ t.classes }}</p>
        <div class="mt-3 flex flex-wrap gap-2">
            <span class="inline-flex items-center rounded-lg bg-slate-100 text-slate-700 px-2.5 py-1 text-xs font-semibold">{{ t.teaching_mode }}</span>
            <span class="inline-flex items-center rounded-lg bg-indigo-50 text-indigo-700 px-2.5 py-1 text-xs font-semibold">{{ t.class_range }}</span>
        </div>
        <p class="text-xs text-slate-500 mt-3">{{ t.languages }}</p>
        <p class="text-sm text-slate-600 mt-3 flex items-center gap-1">
            <span aria-hidden="true">📍</span> {{ t.area }}, {{ t.city }}
            {% if t.pincode %}<span class="text-slate-400">· {{ t.pincode }}</span>{% endif %}
        </p>
        <div class="mt-5 flex items-end justify-between gap-2">
            <span class="text-sm text-slate-500 font-semibold">Starting fee</span>
            <span class="text-base font-black text-slate-900">{{ t.fee_label }}</span>
        </div>
    </a>
    <a href="{{ t.profile_url }}" class="mt-5 w-full py-3 rounded-xl bg-indigo-600 text-white text-sm font-bold text-center hover:bg-indigo-500 transition-colors">
        View full profile
    </a>
    {% else %}
    <div class="flex-grow flex flex-col">
        <h3 class="text-lg font-black text-slate-900">{{ t.name }}</h3>
        <p class="text-sm text-indigo-700 font-semibold mt-1 line-clamp-2">{{ t.subjects }}</p>
        <p class="text-xs text-slate-500 mt-2">{{ t.classes }}</p>
        <div class="mt-3 flex flex-wrap gap-2">
            <span class="inline-flex items-center rounded-lg bg-slate-100 text-slate-700 px-2.5 py-1 text-xs font-semibold">{{ t.teaching_mode }}</span>
            <span class="inline-flex items-center rounded-lg bg-indigo-50 text-indigo-700 px-2.5 py-1 text-xs font-semibold">{{ t.class_range }}</span>
        </div>
        <p class="text-xs text-slate-500 mt-3">{{ t.languages }}</p>
        <p class="text-sm text-slate-600 mt-3 flex items-center gap-1">
            <span aria-hidden="true">📍</span> {{ t.area }}, {{ t.city }}
            {% if t.pincode %}<span class="text-slate-400">· {{ t.pincode }}</span>{% endif %}
        </p>
        <div class="mt-5 flex items-end justify-between gap-2">
            <span class="text-sm text-slate-500 font-semibold">Starting fee</span>
            <span class="text-base font-black text-slate-900">{{ t.fee_label }}</span>
        </div>
    </div>
    <button type="button" disabled class="mt-5 w-full py-3 rounded-xl bg-slate-100 text-slate-500 text-sm font-bold cursor-not-allowed border border-slate-200">
        Request demo — soon
    </button>
    {% endif %}
</article>
