<article class="bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-lg hover:border-indigo-200 transition-all p-6 flex flex-col h-full">
    <div class="flex items-start justify-between gap-2 mb-4">
        {% if t.image_url %}
        <img src="{{ t.image_url }}" alt="{{ t.name }}" class="w-16 h-16 rounded-2xl object-cover border border-slate-200 shrink-0">
        {% else %}
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white flex items-center justify-center text-2xl font-black shrink-0">
            {{ t.name[0] }}
        </div>
        {% endif %}
        <div class="flex flex-col items-end gap-2">
            {% if t.verified %}
            <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full">Verified</span>
            {% endif %}
            <span class="text-xs text-amber-600 font-bold bg-amber-50 px-2.5 py-1 rounded-full">★ {{ t.rating }} <span class="text-slate-500 font-semibold">({{ t.reviews }})</span></span>
        </div>
    </div>
    {% if t.demo_status %}
    <div class="mb-3">
        {% if t.demo_status == 'PENDING' %}
        <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-amber-800">Demo status: pending</span>
        {% elif t.demo_status == 'ACCEPTED' %}
        <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-emerald-800">Demo status: accepted</span>
        {% elif t.demo_status == 'DECLINED' %}
        <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-rose-800">Demo status: declined</span>
        {% elif t.demo_status == 'CANCELLED' %}
        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-slate-700">Demo status: cancelled</span>
        {% endif %}
    </div>
    {% endif %}
    {% if t.profile_url %}
    <a href="{{ t.profile_url }}" class="group block flex-grow flex flex-col">
        <h3 class="text-lg font-black text-slate-900 group-hover:text-indigo-700">{{ t.name }}</h3>
        <p class="text-sm text-indigo-700 font-semibold mt-1 line-clamp-2">{{ t.subjects }}</p>
        <p class="text-xs text-slate-500 mt-2">{{ t.classes }}</p>
        <div class="mt-3 flex flex-wrap gap-2">
            <span class="inline-flex items-center rounded-lg bg-slate-100 text-slate-700 px-2.5 py-1 text-xs font-semibold">{{ t.teaching_mode }}</span>
            <span class="inline-flex items-center rounded-lg bg-indigo-50 text-indigo-700 px-2.5 py-1 text-xs font-semibold">{{ t.class_range }}</span>
        </div>
        <p class="text-xs text-slate-500 mt-3">{{ t.languages }}</p>
        <p class="text-sm text-slate-600 mt-3 flex items-center gap-1">
            <span aria-hidden="true">📍</span> {{ t.area }}, {{ t.city }}
            {% if t.pincode %}<span class="text-slate-400">· {{ t.pincode }}</span>{% endif %}
        </p>
        <div class="mt-5 flex items-end justify-between gap-2">
            <span class="text-sm text-slate-500 font-semibold">Starting fee</span>
            <span class="text-base font-black text-slate-900">{{ t.fee_label }}</span>
        </div>
    </a>
    <div class="mt-5 grid grid-cols-1 gap-2">
        <a href="{{ t.profile_url }}" class="w-full py-3 rounded-xl bg-indigo-600 text-white text-sm font-bold text-center hover:bg-indigo-500 transition-colors">
            View full profile
        </a>
        {% if dashboard_mode %}
        {% if t.demo_status == 'PENDING' or t.demo_status == 'ACCEPTED' %}
        <a href="{{ url('hometutor:my_demo_requests') }}" class="w-full py-2.5 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 text-xs font-black uppercase tracking-wider text-center hover:bg-emerald-100 transition-colors">
            View my demo request
        </a>
        {% else %}
        <a href="{{ t.profile_url }}#request-demo" class="w-full py-2.5 rounded-xl border border-indigo-200 bg-indigo-50 text-indigo-700 text-xs font-black uppercase tracking-wider text-center hover:bg-indigo-100 transition-colors">
            {% if parent_gate_enabled %}Request for approval{% else %}Request demo{% endif %}
        </a>
        {% endif %}
        {% endif %}
        {% if enable_compare %}
        <button
            type="button"
            class="w-full py-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 text-xs font-black uppercase tracking-wider hover:bg-slate-100 transition-colors"
            @click='toggleCompare({{ t.slug|tojson }}, {{ t.name|tojson }}, {{ t.profile_url|tojson }})'
        >
            Add to compare
        </button>
        {% endif %}
    </div>
    {% else %}
    <div class="flex-grow flex flex-col">
        <h3 class="text-lg font-black text-slate-900">{{ t.name }}</h3>
        <p class="text-sm text-indigo-700 font-semibold mt-1 line-clamp-2">{{ t.subjects }}</p>
        <p class="text-xs text-slate-500 mt-2">{{ t.classes }}</p>
        <div class="mt-3 flex flex-wrap gap-2">
            <span class="inline-flex items-center rounded-lg bg-slate-100 text-slate-700 px-2.5 py-1 text-xs font-semibold">{{ t.teaching_mode }}</span>
            <span class="inline-flex items-center rounded-lg bg-indigo-50 text-indigo-700 px-2.5 py-1 text-xs font-semibold">{{ t.class_range }}</span>
        </div>
        <p class="text-xs text-slate-500 mt-3">{{ t.languages }}</p>
        <p class="text-sm text-slate-600 mt-3 flex items-center gap-1">
            <span aria-hidden="true">📍</span> {{ t.area }}, {{ t.city }}
            {% if t.pincode %}<span class="text-slate-400">· {{ t.pincode }}</span>{% endif %}
        </p>
        <div class="mt-5 flex items-end justify-between gap-2">
            <span class="text-sm text-slate-500 font-semibold">Starting fee</span>
            <span class="text-base font-black text-slate-900">{{ t.fee_label }}</span>
        </div>
    </div>
    <a href="{{ url('hometutor:tutor_list') }}" class="mt-5 w-full py-3 rounded-xl bg-indigo-600 text-white text-sm font-bold text-center hover:bg-indigo-500 transition-colors block">
        Request demo
    </a>
    {% endif %}
</article>
