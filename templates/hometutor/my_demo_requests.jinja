{% extends "base.jinja" %}
{% block title %}My demo requests · RankJee{% endblock %}

{% block content %}
<section class="bg-slate-100 border-b border-slate-200/80 pt-8 pb-10 px-4">
    <div class="max-w-3xl mx-auto">
        {% include "partials/_breadcrumb.jinja" %}
        <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600 mb-2">Home tutor</p>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">My demo requests</h1>
        <p class="text-slate-600 text-sm mt-1">Track requests you sent to tutors.</p>
    </div>
</section>

<section class="max-w-3xl mx-auto px-4 py-10">
    {% if demos %}
    <ul class="space-y-4">
        {% for d in demos %}
        <li class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col gap-3">
            <div class="flex flex-wrap justify-between gap-2 items-start">
                <div>
                    <a href="{{ url('hometutor:tutor_detail', d.tutor.slug) }}" class="font-black text-slate-900 hover:text-indigo-600">{{ d.tutor.display_name }}</a>
                    <p class="text-xs text-slate-500">{{ d.tutor.city }}{% if d.tutor.area %} · {{ d.tutor.area }}{% endif %}</p>
                </div>
                <span class="text-xs font-black uppercase tracking-wider px-2 py-1 rounded-full {% if d.status == 'PENDING' %}bg-amber-100 text-amber-800{% elif d.status == 'ACCEPTED' %}bg-emerald-100 text-emerald-800{% elif d.status == 'DECLINED' %}bg-rose-100 text-rose-800{% else %}bg-slate-100 text-slate-600{% endif %}">{{ d.get_status_display() }}</span>
            </div>
            {% if d.scheduled_at and d.status == 'ACCEPTED' %}
            <p class="text-sm font-bold text-emerald-800">Scheduled: {{ d.scheduled_at.strftime('%d %b %Y %H:%M') }}</p>
            {% endif %}
            {% if d.status == 'ACCEPTED' and d.engagement %}
            {% if d.engagement.status == 'ACTIVE' %}
            <p class="text-sm font-black text-indigo-800">Both sides confirmed — you&apos;re set.</p>
            <a href="{{ url('hometutor:engagement_room', d.engagement.id) }}" class="inline-flex mt-2 items-center justify-center px-4 py-2 rounded-xl border border-indigo-200 text-indigo-700 text-xs font-black hover:bg-indigo-50">Open session room</a>
            {% if d.marketplace_paid %}
            <p class="text-xs font-bold text-emerald-800">Marketplace fee paid — thank you.</p>
            {% elif d.engagement_pay_id %}
            <a href="{{ url('hometutor_payments:pay_checkout', d.engagement_pay_id) }}" class="inline-flex mt-2 items-center justify-center px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-black hover:bg-slate-800">Pay first month (platform)</a>
            {% endif %}
            {% else %}
            <p class="text-xs text-slate-600">Confirmations: you {% if d.engagement.parent_confirmed_at %}✓{% else %}pending{% endif %} · tutor {% if d.engagement.tutor_confirmed_at %}✓{% else %}pending{% endif %}</p>
            {% if not d.engagement.parent_confirmed_at %}
            <form method="post" action="{{ url('hometutor:demo_confirm_parent', d.id) }}" class="inline">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <button type="submit" class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-black hover:bg-indigo-500">I confirm this demo time</button>
            </form>
            {% endif %}
            {% endif %}
            {% endif %}
            {% if d.status == 'DECLINED' and d.decline_reason %}
            <p class="text-sm text-slate-600">Note: {{ d.decline_reason }}</p>
            {% endif %}
            {% if d.status == 'PENDING' %}
            <form method="post" action="{{ url('hometutor:demo_cancel', d.id) }}" class="inline">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <button type="submit" class="text-xs font-black text-rose-700 hover:underline uppercase tracking-wider">Cancel request</button>
            </form>
            {% endif %}
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="text-slate-600 text-center py-12">You haven&apos;t requested any demos yet. <a href="{{ url('hometutor:tutor_list') }}" class="text-indigo-600 font-bold hover:underline">Browse tutors</a></p>
    {% endif %}
</section>
{% endblock %}
