{% extends "base.jinja" %}
{% block title %}{{ seo_title if seo_title is defined and seo_title else 'Find home tutors · ' + hometutor_pilot_city + ' · RankJee' }}{% endblock %}

{% block extra_head %}
{% include "hometutor/partials/_landing_styles.jinja" %}
{% endblock %}

{% block schema %}
{% if is_seo_landing %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "RankJee Home Tutors – {{ landing_city|e }}",
  "description": "Verified home tutors in {{ landing_city|e }} for subject and class-specific learning.",
  "areaServed": { "@type": "City", "name": "{{ landing_city|e }}" },
  "serviceType": "Home Tutor Services",
  "url": "{{ canonical_url if canonical_url is defined else request.build_absolute_uri(request.path) }}",
  "provider": { "@type": "Organization", "name": "RankJee" }
}
</script>
{% endif %}
{% if is_seo_landing and faq_items %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq_items %}
    {
      "@type": "Question",
      "name": "{{ item.q|e }}",
      "acceptedAnswer": { "@type": "Answer", "text": "{{ item.a|e }}" }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}

{% block content %}
{% set display_city = landing_city if is_seo_landing else (filter_city or hometutor_pilot_city) %}
{% set hero_tutor = featured_tutor_cards[0] if featured_tutor_cards else none %}
{% set active_filters = filter_q or filter_subject or filter_mode or filter_area or filter_language or filter_class_min or filter_pincode %}

<div class="ht-land w-full max-w-none">

{# ═══════════════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════════════════ #}
<section class="ht-hero-wrap">
  <div class="ht-wrap">
    <div class="ht-hero-grid">

      {# ── Left: copy ── #}
      <div>
        <p class="ht-badge">
          <span class="ht-badge-dot"></span>
          {% if is_seo_landing %}Verified tutors in {{ display_city }}
          {% else %}Trusted home tutoring · {{ display_city }}{% endif %}
        </p>

        <h1 class="ht-hero-title">
          {% if is_seo_landing %}
          {{ seo_heading }}
          {% else %}
          <span class="ht-accent">Expert tutors</span><br>
          who come to your<br>
          <span class="ht-underline">home.</span>
          {% endif %}
        </h1>

        <p class="ht-hero-sub">
          {% if is_seo_landing %}
          Discover verified tutor profiles in {{ display_city }}, compare class fit, and
          request a free demo before you commit — no upfront payment.
          {% else %}
          Find the right home tutor for your child in minutes. One-on-one sessions
          around your schedule — offline, online, or hybrid in {{ display_city }}.
          {% endif %}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href="#find-tutors" class="ht-btn ht-btn-primary">Find a tutor</a>
          <a href="#how" class="ht-btn ht-btn-secondary">How it works</a>
        </div>

        {# ── Trust row ── #}
        <div class="ht-trust mt-5">
          <div class="ht-trust-avs">
            <span class="ht-trust-av" style="background:linear-gradient(135deg,#F5B731,#F4711C)">RK</span>
            <span class="ht-trust-av" style="background:linear-gradient(135deg,#1CA97B,#0D2B5E)">PM</span>
            <span class="ht-trust-av" style="background:linear-gradient(135deg,#60a5fa,#0D2B5E)">SJ</span>
            <span class="ht-trust-av" style="background:linear-gradient(135deg,#f472b6,#db2777)">AV</span>
          </div>
          <div>
            <div class="ht-stars">★★★★★</div>
            <p class="text-xs text-slate-600 mt-0.5">
              <strong class="text-slate-800">{{ landing_stats.avg_rating }}/5</strong>
              &nbsp;·&nbsp;{{ landing_stats.review_count }}+ reviews
            </p>
          </div>
        </div>

        {# ── City-specific related-subject chips ── #}
        {% if is_seo_landing and related_subjects %}
        <div class="mt-4 flex flex-wrap gap-2">
          {% for s in related_subjects %}
          <a href="{{ url('hometutor:tutor_city_subject_landing', city_slug=landing_city|lower|replace(' ','-'), subject_slug=s.slug) }}"
             class="ht-chip">{{ s.label }} tutors</a>
          {% endfor %}
        </div>
        {% endif %}
      </div>{# /left #}

      {# ── Right: tutor preview card ── #}
      <div class="ht-hero-visual">
        <div class="ht-float ht-float-t">
          <span class="ht-ficon ht-ficon-n">🎓</span>
          <div>
            <p class="text-sm font-black text-slate-900 leading-none">Verified</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Background-checked tutors</p>
          </div>
        </div>
        <div class="ht-float ht-float-b">
          <span class="ht-ficon ht-ficon-g">⏱</span>
          <div>
            <p class="text-sm font-black text-slate-900 leading-none">Free demo</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Try before you pay</p>
          </div>
        </div>

        <div class="ht-card-main">
          {% if hero_tutor %}
          <div class="flex items-start gap-3 mb-4">
            {% if hero_tutor.image_url %}
            <img src="{{ hero_tutor.image_url }}" alt="{{ hero_tutor.name }}"
                 class="w-14 h-14 rounded-xl object-cover shrink-0">
            {% else %}
            <div class="w-14 h-14 rounded-xl shrink-0 flex items-center justify-center text-xl font-black text-white"
                 style="background:linear-gradient(135deg,var(--ht-navy),#1e40af)">
              {{ hero_tutor.name[0] }}
            </div>
            {% endif %}
            <div class="min-w-0 flex-1">
              <p class="font-bold text-slate-900 truncate">{{ hero_tutor.name }}</p>
              <p class="text-xs text-slate-500 truncate mt-0.5">{{ hero_tutor.subjects }}</p>
              <p class="text-xs text-slate-400 truncate">{{ hero_tutor.area }}, {{ display_city }}</p>
            </div>
            <p class="text-sm font-black shrink-0" style="color:var(--ht-navy)">★ {{ hero_tutor.rating }}</p>
          </div>
          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">This week</p>
          <div class="ht-card-week">
            <span class="ht-day ht-day-done">Mon</span>
            <span class="ht-day ht-day-done">Wed</span>
            <span class="ht-day ht-day-today">Fri</span>
            <span class="ht-day ht-day-open">Sat</span>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-3">
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800">
              {{ hero_tutor.teaching_mode | title }}
            </span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-900">
              {{ hero_tutor.class_range }}
            </span>
          </div>
          {% if hero_tutor.demo_status == 'pending' or not hero_tutor.demo_requested %}
          <a href="{{ url('hometutor:tutor_detail', slug=hero_tutor.slug) }}"
             class="mt-4 block w-full text-center ht-btn ht-btn-accent text-sm !py-2.5">
            View profile →
          </a>
          {% endif %}
          {% else %}
          <p class="text-slate-700 font-bold mb-1.5">Browse verified tutors</p>
          <p class="text-xs text-slate-500 leading-relaxed">
            Profiles with subjects, fees, and demo requests — all in one place on RankJee.
          </p>
          <a href="#find-tutors" class="mt-4 block w-full text-center ht-btn ht-btn-primary text-sm !py-2.5">
            Browse tutors →
          </a>
          {% endif %}
        </div>
      </div>{# /hero-visual #}
    </div>{# /hero-grid #}
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   STATS BAR — full-width navy
══════════════════════════════════════════════════════════════ #}
<section class="ht-stats-wrap" aria-label="Platform statistics">
  <div class="ht-wrap">
    <div class="ht-stats-inner">
      <div class="ht-stat">
        <p class="ht-stat-n">{{ landing_stats.families_label }}</p>
        <p class="ht-stat-l">Learners connected</p>
      </div>
      <div class="ht-stat">
        <p class="ht-stat-n">{{ landing_stats.tutor_count }}<sup>+</sup></p>
        <p class="ht-stat-l">Verified tutors</p>
      </div>
      <div class="ht-stat">
        <p class="ht-stat-n">{{ landing_stats.city_count }}<sup>+</sup></p>
        <p class="ht-stat-l">Cities covered</p>
      </div>
      <div class="ht-stat">
        <p class="ht-stat-n">{{ landing_stats.avg_rating }}<sup>★</sup></p>
        <p class="ht-stat-l">Avg tutor rating</p>
      </div>
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   HOW IT WORKS
══════════════════════════════════════════════════════════════ #}
<section class="ht-sec bg-white" id="how">
  <div class="ht-wrap">
    <p class="ht-lbl">How it works</p>
    <h2 class="ht-title">From search to first session — <em>three steps</em></h2>
    <p class="ht-sub">No long-term lock-in. Request a free demo from any tutor before you commit.</p>
    <div class="ht-how-grid">
      <article class="ht-how-card">
        <p class="ht-step-n">01</p>
        <div class="ht-step-icon">🔍</div>
        <h3 class="font-bold text-slate-900 mb-2">Tell us what you need</h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Filter by subject, class, area, and teaching mode. We surface the best-fit tutors
          in {{ display_city }} instantly.
        </p>
      </article>
      <article class="ht-how-card">
        <p class="ht-step-n">02</p>
        <div class="ht-step-icon">✅</div>
        <h3 class="font-bold text-slate-900 mb-2">Compare &amp; request demo</h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Read verified profiles, fees, and ratings. Send a demo request — both tutor and family
          confirm before the first paid session.
        </p>
      </article>
      <article class="ht-how-card">
        <p class="ht-step-n">03</p>
        <div class="ht-step-icon">🏠</div>
        <h3 class="font-bold text-slate-900 mb-2">Learn at home, your way</h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Offline home visits or online sessions. Track engagement on RankJee and
          pair tutoring with practice tests and concept videos.
        </p>
      </article>
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   SUBJECTS
══════════════════════════════════════════════════════════════ #}
<section class="ht-sec" style="background:var(--ht-bg-alt)" id="subjects">
  <div class="ht-wrap">
    <p class="ht-lbl">Subjects</p>
    <h2 class="ht-title">Every subject, <em>every level</em></h2>
    <p class="ht-sub">
      School basics to competitive exam prep — tap a subject to see matching tutors in {{ display_city }}.
    </p>
    <div class="ht-subj-grid">
      {% for subject_name, emoji in landing_subjects %}
      <a href="{{ url('hometutor:tutor_list') }}?subject={{ subject_name|urlencode }}&city={{ display_city|urlencode }}"
         class="ht-subj-card">
        <span class="ht-subj-emoji">{{ emoji }}</span>
        <span class="ht-subj-name">{{ subject_name }}</span>
        <span class="ht-subj-meta">Browse tutors</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   TUTOR SEARCH + GRID
══════════════════════════════════════════════════════════════ #}
<section class="ht-sec" style="background:var(--ht-bg)" id="find-tutors">
  <div class="ht-wrap">
    <p class="ht-lbl">Find tutors</p>
    <h2 class="ht-title">
      {% if page_obj and page_obj.paginator.count %}
        {{ page_obj.paginator.count }} tutor{{ 's' if page_obj.paginator.count != 1 else '' }} in {{ display_city }}
      {% elif tutor_cards %}
        {{ tutor_cards|length }} tutor{{ 's' if tutor_cards|length != 1 else '' }} in {{ display_city }}
      {% else %}
        Search our directory
      {% endif %}
    </h2>
    <p class="ht-sub">Refine by subject, class, pincode radius, or teaching mode.</p>

    {# ── Active filter chips ── #}
    {% if active_filters %}
    <div class="flex flex-wrap gap-2 mt-3 mb-1">
      {% if filter_q %}<span class="ht-chip">Search: {{ filter_q }}</span>{% endif %}
      {% if filter_subject %}<span class="ht-chip">{{ filter_subject }}</span>{% endif %}
      {% if filter_mode %}<span class="ht-chip">{{ filter_mode|title }}</span>{% endif %}
      {% if filter_area %}<span class="ht-chip">{{ filter_area }}</span>{% endif %}
      {% if filter_class_min %}<span class="ht-chip">Class {{ filter_class_min }}</span>{% endif %}
      {% if filter_pincode %}<span class="ht-chip">📍 {{ filter_pincode }}</span>{% endif %}
      {% if filter_language %}<span class="ht-chip">{{ filter_language }}</span>{% endif %}
      <a href="{{ url('hometutor:tutor_list') }}"
         class="text-[11px] font-black text-slate-400 hover:text-red-500 flex items-center gap-1 ml-1">✕ Clear all</a>
    </div>
    {% endif %}

    {# ── Filter form with progressive disclosure ── #}
    <div x-data="{ showAdv: {{ 'true' if (filter_area or filter_language or filter_class_min or filter_pincode) else 'false' }} }"
         class="ht-filter-form mt-5">
      <form method="get" action="{{ url('hometutor:tutor_list') }}">
        {# Basic: search + subject + mode ── always visible #}
        <div class="ht-filter-basic">
          <div>
            <label for="ht_q" class="ht-filter-label">Search</label>
            <input type="search" name="q" id="ht_q" value="{{ filter_q }}"
                   placeholder="Name, area, subject…" class="ht-input">
          </div>
          <div>
            <label for="ht_sub" class="ht-filter-label">Subject</label>
            <input type="text" name="subject" id="ht_sub" value="{{ filter_subject }}"
                   placeholder="e.g. Physics, Maths" class="ht-input">
          </div>
          <div>
            <label for="ht_mode" class="ht-filter-label">Mode</label>
            <select name="mode" id="ht_mode" class="ht-input">
              <option value="">Any</option>
              <option value="OFFLINE" {% if filter_mode == 'OFFLINE' %}selected{% endif %}>Offline</option>
              <option value="ONLINE"  {% if filter_mode == 'ONLINE'  %}selected{% endif %}>Online</option>
              <option value="HYBRID"  {% if filter_mode == 'HYBRID'  %}selected{% endif %}>Hybrid</option>
            </select>
          </div>
        </div>

        {# Advanced: hidden by default ── toggle via Alpine #}
        <div x-show="showAdv" x-cloak class="ht-filter-adv">
          <div>
            <label for="ht_area" class="ht-filter-label">Area / Locality</label>
            <input type="text" name="area" id="ht_area" value="{{ filter_area }}"
                   placeholder="e.g. Satellite, Bopal" class="ht-input">
          </div>
          <div>
            <label for="ht_lang" class="ht-filter-label">Language</label>
            <input type="text" name="language" id="ht_lang" value="{{ filter_language }}"
                   placeholder="e.g. Hindi, English" class="ht-input">
          </div>
          <div>
            <label for="ht_city" class="ht-filter-label">City</label>
            <input type="text" name="city" id="ht_city" value="{{ filter_city }}"
                   placeholder="{{ hometutor_pilot_city }}" class="ht-input">
          </div>
          <div>
            <label for="ht_cls" class="ht-filter-label">Student class (1–12)</label>
            <input type="number" name="class_min" id="ht_cls" value="{{ filter_class_min }}"
                   min="1" max="12" placeholder="e.g. 10" class="ht-input">
          </div>
          <div>
            <label for="ht_pin" class="ht-filter-label">Pincode</label>
            <input type="text" name="pincode" id="ht_pin" value="{{ filter_pincode }}"
                   placeholder="e.g. 380015" class="ht-input">
          </div>
          <div>
            <label for="ht_rad" class="ht-filter-label">Radius (km)</label>
            <input type="number" name="radius_km" id="ht_rad" value="{{ filter_radius_km }}"
                   min="1" max="100" placeholder="5" class="ht-input">
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="submit" class="ht-btn ht-btn-primary !py-2.5 !px-6">Apply filters</button>
          <button type="button" @click="showAdv = !showAdv"
                  class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1">
            <span x-text="showAdv ? '▲ Less filters' : '▼ More filters'">▼ More filters</span>
          </button>
          {% if active_filters %}
          <a href="{{ url('hometutor:tutor_list') }}"
             class="text-xs font-bold text-slate-400 hover:text-red-500">Reset</a>
          {% endif %}
        </div>
      </form>
    </div>

    {# ── Tutor grid ── #}
    <div id="tutor-results">
    {% if tutor_cards %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-2">
      {% for t in tutor_cards %}
      {% include "hometutor/partials/_tutor_card.jinja" %}
      {% endfor %}
    </div>
    {% include "hometutor/partials/_tutor_pagination.jinja" %}
    {% else %}
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center mt-2">
      <p class="text-3xl mb-3">🔍</p>
      <p class="text-slate-700 font-bold mb-1.5">No tutors match these filters yet.</p>
      <p class="text-slate-500 text-sm mb-5">
        Try removing a filter, or browse all tutors in {{ hometutor_pilot_city }}.
      </p>
      <a href="{{ url('hometutor:tutor_list') }}"
         class="ht-btn ht-btn-primary !text-sm">View all tutors in {{ hometutor_pilot_city }}</a>
    </div>
    {% endif %}
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   TESTIMONIALS — full-width dark navy
══════════════════════════════════════════════════════════════ #}
<section class="ht-sec ht-sec-dark" id="reviews">
  <div class="ht-wrap">
    <p class="ht-lbl">What families say</p>
    <h2 class="ht-title">Real feedback from parents &amp; <em>students</em></h2>
