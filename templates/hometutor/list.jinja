{# ═══════════════════════════════════════════════════════════
   DUAL CTA: Become a tutor + Prepare online
══════════════════════════════════════════════════════════════ #}
<section class="ht-sec bg-white">
  <div class="ht-wrap">
    <div class="ht-dual-grid">
      {# Become a tutor #}
      <div class="ht-dual-card"
           style="background:linear-gradient(135deg,color-mix(in srgb,var(--ht-navy) 8%,#fff),#fff)">
        <p class="text-2xl mb-3">🧑‍🏫</p>
        <h3 class="text-lg font-bold text-slate-900 mb-1.5">Are you a tutor in {{ display_city }}?</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          List your profile on RankJee for free. Get demo requests from families near you
          — offline, online, or hybrid. No commission until you confirm.
        </p>
        <a href="{{ url('hometutor:my_profile') }}" class="ht-btn ht-btn-primary !text-sm">
          Create your listing →
        </a>
      </div>
      {# Prepare online #}
      <div class="ht-dual-card"
           style="background:linear-gradient(135deg,color-mix(in srgb,var(--ht-saffron) 6%,#fff),#fff)"
           where="var(--ht-saffron)">
        <p class="text-2xl mb-3">📊</p>
        <h3 class="text-lg font-bold text-slate-900 mb-1.5">Prepare online on RankJee</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          After shortlisting a tutor, run diagnostic skill tests and concept videos
          in the same account. Track exactly where your child needs help.
        </p>
        <div class="flex flex-wrap gap-2">
          <a href="{{ url('assessment:index') }}" class="ht-btn ht-btn-accent !text-sm">Start diagnostics</a>
          <a href="{{ url('learning:index') }}" class="ht-btn ht-btn-secondary !text-sm">Watch videos</a>
        </div>
      </div>
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   BOTTOM CTA
══════════════════════════════════════════════════════════════ #}
<section class="ht-sec ht-cta-wrap">
  <div class="ht-wrap">
    <span class="ht-cta-badge">✨ Free demo request</span>
    <h2 class="ht-cta-h">Ready to find your <em>perfect tutor</em><br>in {{ display_city }}?</h2>
    <p class="ht-cta-sub">
      Join families on RankJee who book verified home tutors with confidence
      — no hidden contracts, no upfront payment.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="#find-tutors" class="ht-btn ht-btn-primary">Find my tutor →</a>
      {% if not request.user.is_authenticated %}
      <a href="{{ url('users:signup') }}" class="ht-btn ht-btn-secondary">Sign up free</a>
      {% endif %}
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════════
   FAQ — SEO landing pages only (Alpine.js accordion)
══════════════════════════════════════════════════════════════ #}
{% if is_seo_landing and faq_items %}
<section class="ht-sec-sm bg-white">
  <div class="ht-wrap">
    <p class="ht-lbl">FAQ</p>
    <h2 class="ht-title">Frequently asked questions</h2>
    <div class="mt-6" x-data="{ open: null }">
      {% for item in faq_items %}
      <div class="ht-faq-item">
        <button class="ht-faq-q" @click="open = (open === {{ loop.index }}) ? null : {{ loop.index }}"
                type="button">
          <span>{{ item.q }}</span>
          <span class="ht-faq-icon" :class="open === {{ loop.index }} ? 'open' : ''">▼</span>
        </button>
        <div x-show="open === {{ loop.index }}" x-cloak class="ht-faq-a">
          {{ item.a }}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

</div>{# /ht-land #}
{% endblock %}
