{% extends "base.jinja" %}
{% block title %}{{ seo_title if seo_title is defined and seo_title else t.display_name + ' · Home tutor · RankJee' }}{% endblock %}

{% block content %}
<section class="bg-gradient-to-b from-indigo-50 to-slate-50 border-b border-indigo-100/80 pt-10 pb-8 px-4">
    <div class="max-w-5xl mx-auto">
        {% include "partials/_breadcrumb.jinja" %}
        <div class="bg-white/80 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-6 md:p-8 flex flex-col md:flex-row md:items-start gap-5">
            {% if t.profile_image %}
            <img src="{{ t.profile_image.url }}" alt="{{ t.display_name }}" class="w-24 h-24 rounded-3xl object-cover border border-indigo-100 shadow-sm shrink-0">
            {% else %}
            <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white flex items-center justify-center text-4xl font-black shrink-0">
                {{ t.display_name[0] }}
            </div>
            {% endif %}
            <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h1 class="text-3xl font-black text-slate-900 tracking-tight">{{ t.display_name }}</h1>
                        <p class="text-indigo-700 font-semibold mt-1">{{ t.subjects }}</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-sm font-black text-amber-700">★ {{ t.rating_display }}</span>
                        <span class="text-sm text-slate-600 font-semibold">{{ t.reviews_count }} reviews</span>
                    </div>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-lg bg-slate-100 text-slate-700 px-3 py-1.5 text-xs font-bold">{{ t.get_teaching_mode_display() }}</span>
                    <span class="inline-flex items-center rounded-lg bg-indigo-50 text-indigo-700 px-3 py-1.5 text-xs font-bold">
                        {% if t.classes_label %}{{ t.classes_label }}{% else %}Class {{ t.teaches_from }}-{{ t.teaches_to }}{% endif %}
                    </span>
                    {% if t.languages %}
                    <span class="inline-flex items-center rounded-lg bg-violet-50 text-violet-700 px-3 py-1.5 text-xs font-bold">{{ t.languages }}</span>
                    {% endif %}
                </div>
                <p class="text-slate-600 text-sm mt-4 flex flex-wrap gap-x-4 gap-y-2">
                    <span>📍 {{ t.area or '—' }}, {{ t.city }}</span>
                    {% if t.pincode %}<span>Pin {{ t.pincode }}</span>{% endif %}
                    <span>Member since {{ t.created_at.strftime('%b %Y') if t.created_at else '—' }}</span>
                </p>
                {% if viewer_is_owner %}
                <p class="mt-3 text-xs font-bold text-indigo-800 bg-indigo-50 border border-indigo-100 rounded-xl px-3 py-2 inline-block">
                    Listing status: {{ t.get_verification_status_display() }}
                    · <a href="{{ url('hometutor:my_profile') }}" class="underline hover:text-indigo-950">Edit listing</a>
                </p>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<section class="max-w-5xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-4">Tutor overview</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                        <p class="text-xs font-black uppercase tracking-wider text-slate-500 mb-1">Subjects</p>
                        <p class="text-slate-900 font-semibold">{{ t.subjects }}</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                        <p class="text-xs font-black uppercase tracking-wider text-slate-500 mb-1">Teaching mode</p>
                        <p class="text-slate-900 font-semibold">{{ t.get_teaching_mode_display() }}</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                        <p class="text-xs font-black uppercase tracking-wider text-slate-500 mb-1">Class coverage</p>
                        <p class="text-slate-900 font-semibold">
                            {% if t.classes_label %}{{ t.classes_label }}{% else %}Class {{ t.teaches_from }}-{{ t.teaches_to }}{% endif %}
                        </p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                        <p class="text-xs font-black uppercase tracking-wider text-slate-500 mb-1">Languages</p>
                        <p class="text-slate-900 font-semibold">{{ t.languages or 'Not specified' }}</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 sm:col-span-2">
                        <p class="text-xs font-black uppercase tracking-wider text-slate-500 mb-1">Service area</p>
                        <p class="text-slate-900 font-semibold">{{ t.area or '—' }}, {{ t.city }}{% if t.pincode %} · {{ t.pincode }}{% endif %}</p>
                    </div>
                </div>
            </div>

            {% if t.bio %}
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-2">About tutor</h2>
                <p class="text-slate-700 whitespace-pre-line leading-relaxed">{{ t.bio }}</p>
            </div>
            {% endif %}

            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                <div class="flex flex-wrap items-end justify-between gap-2 mb-4">
                    <div>
                        <h2 class="text-sm font-black uppercase tracking-wider text-slate-500">Parent testimonials</h2>
                        <p class="text-xs text-slate-500 mt-1">What families say after demo / regular classes</p>
                    </div>
                    <span class="text-xs font-bold text-slate-600">★ {{ t.rating_display }} · {{ t.reviews_count }} reviews</span>
                </div>
                {% if testimonials %}
                <ul class="space-y-4">
                    {% for rev in testimonials %}
                    <li class="rounded-xl border border-slate-100 bg-slate-50/80 p-4">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div>
                                <p class="text-sm font-black text-slate-900">{{ rev.author_name }}</p>
                                {% if rev.author_label %}
                                <p class="text-[11px] font-semibold text-slate-500">{{ rev.author_label }}</p>
                                {% endif %}
                            </div>
                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-black text-amber-700">
                                ★ {{ rev.rating }}/5
                            </span>
                        </div>
                        <p class="mt-2 text-sm text-slate-700 leading-relaxed">“{{ rev.comment }}”</p>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="text-sm text-slate-500">No testimonials yet — be the first to book a demo and share feedback.</p>
                {% endif %}
            </div>
        </div>

        <aside class="space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-2">Fee details</h2>
                <p class="text-3xl font-black text-slate-900">{{ t.fee_label or 'Fee on request' }}</p>
                <p class="text-xs text-slate-500 mt-2">Final fee may vary by class level, mode, and weekly sessions.</p>
            </div>

            {% if can_request_demo and demo_form %}
            <div id="request-demo" class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-2">Request a free demo</h2>
                {% if listing_needs_staff %}
                <p class="text-slate-600 text-sm mb-4">
                    Share your class details — RankJee will connect you with this tutor and follow up on your request.
                </p>
                {% else %}
                <p class="text-slate-600 text-sm mb-4">The tutor will receive your message in RankJee inbox.</p>
                {% endif %}
                <form method="post" action="{{ url('hometutor:demo_request_create', slug=t.slug) }}" class="space-y-3" id="demo-request-form">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    <div>
                        <label for="{{ demo_form.message.id_for_label }}" class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-1">Message</label>
                        {{ demo_form.message }}
                    </div>
                    <div>
                        <label for="{{ demo_form.contact_phone.id_for_label }}" class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-1">WhatsApp / phone</label>
                        {{ demo_form.contact_phone }}
                        <p class="mt-1 text-[11px] text-slate-500">Helps us reach you faster for the demo.</p>
                    </div>
                    <button type="submit" form="demo-request-form" class="w-full inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-black hover:bg-indigo-500 transition-colors">
                        Send demo request
                    </button>
                </form>
            </div>
            {% elif not request.user.is_authenticated %}
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center text-sm text-slate-600">
                <a href="{{ url('users:login') }}?next={{ request.path }}#request-demo" class="font-black text-indigo-600 hover:underline">Log in</a> to request a free demo with this tutor.
            </div>
            {% elif viewer_is_owner %}
            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/80 p-6 text-sm text-indigo-900">
                This is your listing. Demo requests from parents appear in
                <a href="{{ url('hometutor:tutor_demos') }}" class="font-black underline">your inbox</a>.
            </div>
            {% endif %}

            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/50 p-6">
                <h2 class="text-sm font-black uppercase tracking-wider text-indigo-800 mb-2">Prepare online on RankJee</h2>
                <p class="text-slate-700 text-sm mb-4">Diagnostics, skill paths, and rewards in the same student account.</p>
                <a href="{{ url('assessment:index') }}" class="w-full inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-black hover:bg-indigo-500 transition-colors">
                    Practice online
                </a>
            </div>
        </aside>
    </div>

    <p class="text-center text-xs text-slate-500">
        <a href="{{ url('hometutor:tutor_list') }}" class="text-indigo-600 font-bold hover:underline">← Back to all tutors</a>
    </p>
</section>
{% endblock %}
