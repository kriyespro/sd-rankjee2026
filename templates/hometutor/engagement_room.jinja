{% extends "base.jinja" %}
{% block title %}Engagement #{{ engagement.id }} · Home tutor · RankJee{% endblock %}

{% block content %}
<section class="bg-slate-100 border-b border-slate-200/80 pt-8 pb-10 px-4">
    <div class="max-w-5xl mx-auto">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600 mb-2">Home tutor engagement</p>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Session log, review, and chat</h1>
        <p class="text-slate-600 text-sm mt-1">
            {{ engagement.tutor_profile.display_name }} · {{ engagement.student.get_username() }}
        </p>
    </div>
</section>

<section class="max-w-5xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-3">Session attendance</h2>
            {% if is_tutor %}
            <form method="post" class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="mark_session">
                <div>{{ session_form.scheduled_for }}</div>
                <div>{{ session_form.status }}</div>
                <div>{{ session_form.tutor_note }}</div>
                <button type="submit" class="md:col-span-3 inline-flex items-center justify-center px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-black hover:bg-indigo-500">Add session log</button>
            </form>
            {% endif %}
            {% if sessions %}
            <ul class="space-y-2">
                {% for s in sessions %}
                <li class="rounded-xl border border-slate-100 px-3 py-2 text-sm flex flex-wrap justify-between gap-2">
                    <span class="font-semibold text-slate-800">{{ s.scheduled_for.strftime('%d %b %Y %H:%M') }}</span>
                    <span class="text-xs font-black uppercase tracking-wider text-indigo-700">{{ s.get_status_display() }}</span>
                    {% if s.tutor_note %}<span class="text-slate-600">{{ s.tutor_note }}</span>{% endif %}
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="text-sm text-slate-500">No session attendance logged yet.</p>
            {% endif %}
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-3">Chat</h2>
            <div class="space-y-2 mb-4 max-h-80 overflow-y-auto pr-1">
                {% for m in chat_messages %}
                <div class="rounded-xl px-3 py-2 {{ 'bg-indigo-50 border border-indigo-100' if m.sender_id == user.id else 'bg-slate-50 border border-slate-100' }}">
                    <p class="text-xs font-black text-slate-600">{{ m.sender.get_username() }} · {{ m.created_at.strftime('%d %b %H:%M') }}</p>
                    <p class="text-sm text-slate-800 whitespace-pre-line">{{ m.body }}</p>
                    {% if m.support_flag %}<p class="text-[11px] font-black uppercase tracking-wider text-rose-700 mt-1">Support flag</p>{% endif %}
                </div>
                {% else %}
                <p class="text-sm text-slate-500">No messages yet.</p>
                {% endfor %}
            </div>
            <form method="post" class="space-y-2">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="send_message">
                {{ chat_form.body }}
                <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-600">
                    {{ chat_form.support_flag }} Mark for admin support
                </label>
                <button type="submit" class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-black hover:bg-slate-800">Send message</button>
            </form>
        </div>
    </div>

    <aside class="space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-3">Review</h2>
            {% if review %}
            <p class="text-sm font-black text-slate-900">{{ review.rating }}/5</p>
            <p class="text-sm text-slate-600 mt-1">{{ review.comment or 'No comment' }}</p>
            {% elif is_requester %}
            <form method="post" class="space-y-2">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="submit_review">
                {{ review_form.rating }}
                {{ review_form.comment }}
                <button type="submit" class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-black hover:bg-emerald-500">Submit review</button>
            </form>
            {% else %}
            <p class="text-sm text-slate-500">Review can be submitted by parent/student side.</p>
            {% endif %}
        </div>

        <div class="bg-white rounded-2xl border border-rose-100 p-5 shadow-sm">
            <h2 class="text-sm font-black uppercase tracking-wider text-rose-700 mb-3">Disputes</h2>
            <form method="post" class="space-y-2 mb-3">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="raise_dispute">
                {{ dispute_form.reason }}
                <button type="submit" class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-rose-600 text-white text-xs font-black hover:bg-rose-500">Raise dispute</button>
            </form>
            <ul class="space-y-2">
                {% for d in disputes %}
                <li class="rounded-xl border border-slate-100 px-3 py-2">
                    <p class="text-xs font-black uppercase tracking-wider text-slate-600">{{ d.status }} · {{ d.created_at.strftime('%d %b %H:%M') }}</p>
                    <p class="text-sm text-slate-800 mt-1">{{ d.reason }}</p>
                </li>
                {% else %}
                <li class="text-sm text-slate-500">No disputes raised.</li>
                {% endfor %}
            </ul>
        </div>
    </aside>
</section>
{% endblock %}
