{% extends "base.jinja" %}
{% block title %}Micro Learning - RankJee{% endblock %}
{% block content %}
<div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-2">Your Learning Plan</h2>
    {% if current_skill %}
    <p class="text-gray-500 mb-4">Learning: <strong>{{ current_skill.name }}</strong>. Watch videos, revise quickly, then take the quiz.</p>
    {% if selected_concept %}
    <p class="text-sm text-indigo-700 mb-6">Focused concept: <strong>{{ selected_concept }}</strong></p>
    {% else %}
    <p class="text-sm text-slate-500 mb-6">Pick a category below to switch topics faster.</p>
    {% endif %}

    {% if category_skills %}
    <div class="mb-6 overflow-x-auto">
        <div class="flex gap-2 min-w-max">
            {% for skill in category_skills %}
            <a
                href="{{ url('learning:index') }}?skill={{ skill.id }}"
                class="px-4 py-2 rounded-full text-sm font-semibold border transition {% if current_skill and current_skill.id == skill.id %}bg-indigo-600 text-white border-indigo-600{% else %}bg-white text-slate-700 border-slate-200 hover:border-indigo-300 hover:text-indigo-700{% endif %}"
            >
                {{ skill.name }}
                <span class="ml-1 text-xs opacity-80">({{ skill.video_count }})</span>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="mb-8 p-4 bg-indigo-50 border border-indigo-100 rounded-xl flex justify-between items-center">
        <div>
            <h3 class="font-bold text-indigo-900">Step 3: Take category quiz</h3>
            <p class="text-sm text-indigo-700">Pass with 80% to move to the next lesson.</p>
        </div>
        <a href="{{ url('assessment:take_test', current_skill.id) }}" class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-indigo-700 transition">Take Assessment &rarr;</a>
    </div>
    {% else %}
    <p class="text-gray-500 mb-6">Explore all available lessons or take a diagnostic test.</p>
    {% endif %}

    {% if videos %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for video in videos %}
        <div class="bg-white rounded-xl shadow hover:shadow-md transition p-5">
            <span class="text-xs font-semibold bg-indigo-100 text-indigo-700 px-2 py-1 rounded uppercase">{{ video.concept_tag }}</span>
            <h3 class="text-lg font-bold mt-3 mb-2">{{ video.title }}</h3>
            <div class="relative w-full overflow-hidden rounded-lg group video-player" style="padding-top: 56.25%" data-embed-url="{{ video.get_embed_url() }}" data-video-id="{{ video.id }}">
                <!-- Thumbnail Layer -->
                <button type="button" class="absolute inset-0 cursor-pointer video-poster text-left w-full" aria-label="Play {{ video.title }}">
                    <img src="{{ video.get_thumbnail_url() }}" 
                         alt="{{ video.title }}" 
                         class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500">
                    
                    <!-- Gradient Overlay -->
                    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-300"></div>
                    
                    <!-- Play Button -->
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="bg-indigo-600/90 text-white w-16 h-16 rounded-full flex items-center justify-center shadow-2xl transform group-hover:scale-110 transition-all duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                        </div>
                    </div>
                </button>

                <!-- Video Layer -->
                <iframe
                    class="absolute inset-0 w-full h-full rounded-lg hidden video-iframe"
                    src=""
                    data-loaded="0"
                    title="{{ video.title }}"
                    frameborder="0"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen>
                </iframe>
            </div>
            <div class="flex justify-between items-center mt-3">
                <p class="text-gray-400 text-xs">~{{ video.duration_seconds // 60 }} min</p>
                <a href="{{ video.video_url }}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-indigo-700 hover:underline">Open on YouTube</a>
            </div>
            {% if video.text_summary %}
            <details class="mt-4 bg-slate-50 border border-slate-200 rounded-lg p-3">
                <summary class="cursor-pointer text-xs font-bold text-slate-700">Read revision bite</summary>
                <div class="mt-2 text-sm text-slate-600 whitespace-pre-line">{{ video.text_summary }}</div>
            </details>
            {% endif %}
            {% if video.skill %}
            <a href="{{ url('assessment:take_test', video.skill.id) }}?concept={{ video.concept_tag|urlencode }}&video_id={{ video.id }}" class="mt-4 block text-center bg-indigo-600 text-white py-2.5 rounded-lg font-bold hover:bg-indigo-700 hover:shadow-lg transition-all">
                Retest &rarr;
            </a>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
        <p>No learning content available for this filter yet.</p>
        <a href="{{ url('assessment:index') }}" class="mt-4 inline-block text-indigo-600 font-semibold hover:underline">Take a Diagnostic Test</a>
        <a href="{{ url('learning:index') }}" class="mt-3 ml-4 inline-block text-slate-600 font-semibold hover:underline">Reset filters</a>
    </div>
    {% endif %}
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.video-player').forEach(function (root) {
        const poster = root.querySelector('.video-poster');
        const iframe = root.querySelector('.video-iframe');
        if (!poster || !iframe) return;
        poster.addEventListener('click', function () {
            const embedUrl = root.dataset.embedUrl || '';
            if (!embedUrl) return;
            if (iframe.dataset.loaded !== '1') {
                iframe.src = embedUrl;
                iframe.dataset.loaded = '1';
            }
            poster.classList.add('hidden');
            iframe.classList.remove('hidden');
        });
    });

    const params = new URLSearchParams(window.location.search);
    const targetVideoId = params.get('video_id');
    if (!targetVideoId) return;

    const targetRoot = document.querySelector('.video-player[data-video-id="' + targetVideoId + '"]');
    if (!targetRoot) return;

    const targetPoster = targetRoot.querySelector('.video-poster');
    if (targetPoster) {
        targetRoot.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(function () {
            targetPoster.click();
        }, 150);
    }
});
</script>
{% endblock %}
