{% extends "base.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block extra_head %}
<meta property="og:type" content="article">
{% if blog_image_url %}
<meta property="og:image" content="{{ blog_image_url }}">
<meta name="twitter:image" content="{{ blog_image_url }}">
{% endif %}
<style>
  /* Blog article — readable measure & RankJEE palette (colorp.md) */
  .blog-page {
    --blog-navy: #0d2b5e;
    --blog-gold: #f5b731;
    --blog-saffron: #f4711c;
    --blog-body: #3d4f63;
    --blog-heading: #0d2b5e;
  }
  .blog-content {
    font-size: 1.0625rem;
    line-height: 1.78;
    letter-spacing: 0.01em;
    color: var(--blog-body);
    max-width: 65ch;
    margin-left: auto;
    margin-right: auto;
    overflow-wrap: anywhere;
    word-break: break-word;
    font-variant-numeric: oldstyle-nums;
  }
  @media (min-width: 640px) {
    .blog-content {
      font-size: 1.125rem;
      line-height: 1.75;
    }
  }
  .blog-content > p:first-of-type {
    font-size: 1.07em;
    line-height: 1.72;
    color: color-mix(in srgb, var(--blog-body) 92%, var(--blog-heading));
  }
  @media (min-width: 640px) {
    .blog-content > p:first-of-type {
      font-size: 1.08em;
    }
  }
  .blog-content h1,
  .blog-content h2,
  .blog-content h3,
  .blog-content h4 {
    font-family: Outfit, Inter, sans-serif;
    letter-spacing: -0.02em;
    color: var(--blog-heading);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.28;
    scroll-margin-top: 5rem;
  }
  .blog-content h1:first-child,
  .blog-content h2:first-child,
  .blog-content h3:first-child {
    margin-top: 0;
  }
  .blog-content h1 { font-size: calc(1.875rem * 0.95); font-weight: 900; }
  .blog-content h1 {
    background: linear-gradient(90deg, color-mix(in srgb, var(--blog-navy) 95%, #111827), color-mix(in srgb, var(--blog-saffron) 35%, var(--blog-navy)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .blog-content h2 {
    font-size: 1.4375rem;
    font-weight: 800;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid color-mix(in srgb, var(--blog-navy) 12%, #e2e8f0);
    position: relative;
    padding-left: 0.8rem;
  }
  .blog-content h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2rem;
    bottom: 0.3rem;
    width: 0.2rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--blog-saffron), var(--blog-gold));
  }
  .blog-content h3 { font-size: 1.22rem; font-weight: 800; }
  .blog-content h4 { font-size: 1.08rem; font-weight: 800; color: color-mix(in srgb, var(--blog-heading) 88%, #475569); }
  .blog-content p {
    margin: 0;
  }
  .blog-content p + p {
    margin-top: 1.125rem;
  }
  .blog-content strong {
    color: var(--blog-heading);
    font-weight: 700;
  }
  .blog-content em {
    color: color-mix(in srgb, var(--blog-body) 85%, var(--blog-heading));
  }
  .blog-content ul,
  .blog-content ol {
    margin: 1.125rem 0;
    padding-left: 0;
    list-style-position: outside;
  }
  .blog-content ul {
    margin-left: 1.15rem;
    list-style-type: disc;
  }
  .blog-content ol {
    margin-left: 1.35rem;
    list-style-type: decimal;
  }
  .blog-content li {
    margin: 0.55rem 0;
    padding-left: 0.35rem;
  }
  .blog-content li::marker {
    color: var(--blog-saffron);
  }
  .blog-content h3 + ul {
    margin-top: 0.85rem;
    margin-left: 0;
    list-style: none;
    padding: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--blog-navy) 12%, #e2e8f0);
    border-radius: 0.85rem;
    background: linear-gradient(180deg, #ffffff, color-mix(in srgb, var(--blog-navy) 4%, #ffffff));
  }
  .blog-content h3 + ul li {
    margin: 0;
    padding: 0;
  }
  .blog-content h3 + ul li + li {
    margin-top: 0.55rem;
  }
  .blog-content h3 + ul li a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.55rem;
    border-radius: 0.6rem;
    text-decoration: none;
    background: color-mix(in srgb, var(--blog-navy) 4%, #f8fafc);
    border: 1px solid color-mix(in srgb, var(--blog-navy) 10%, #e2e8f0);
  }
  .blog-content h3 + ul li a::before {
    content: "↗";
    font-size: 0.84em;
    color: var(--blog-saffron);
    line-height: 1;
  }
  .blog-content h3 + ul li a:hover {
    border-color: color-mix(in srgb, var(--blog-saffron) 35%, #cbd5e1);
    background: color-mix(in srgb, var(--blog-saffron) 9%, #ffffff);
  }
  .blog-content hr {
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--blog-navy) 10%, #e2e8f0);
    margin: 2.25rem 0;
  }
  .blog-content blockquote {
    margin: 1.75rem 0;
    padding: 1rem 1.15rem 1rem 1.25rem;
    border-left: 4px solid var(--blog-gold);
    background: color-mix(in srgb, var(--blog-navy) 5%, #ffffff);
    color: color-mix(in srgb, var(--blog-heading) 72%, #334155);
    border-radius: 0 0.65rem 0.65rem 0;
    font-size: 1.02em;
    line-height: 1.68;
  }
  .blog-content a {
    color: var(--blog-navy);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .blog-content a:hover {
    color: var(--blog-saffron);
    text-decoration-color: color-mix(in srgb, var(--blog-saffron) 65%, transparent);
  }
  .blog-content a:focus-visible {
    outline: 2px solid var(--blog-saffron);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .blog-content code {
    background: color-mix(in srgb, var(--blog-navy) 7%, #f1f5f9);
    color: var(--blog-heading);
    padding: 0.12rem 0.4rem;
    border-radius: 0.35rem;
    font-size: 0.88em;
    border: 1px solid color-mix(in srgb, var(--blog-navy) 9%, #e2e8f0);
  }
  .blog-content pre {
    background: var(--blog-navy);
    color: #e8eef8;
    border-radius: 0.85rem;
    padding: 1.15rem 1.25rem;
    overflow-x: auto;
    max-width: 100%;
    margin: 1.35rem 0;
    font-size: 0.88em;
    line-height: 1.65;
    border: 1px solid color-mix(in srgb, var(--blog-navy) 65%, #1e293b);
    -webkit-overflow-scrolling: touch;
  }
  .blog-content pre code {
    background: transparent;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }
  .blog-content img,
  .blog-content video {
    max-width: 100%;
    height: auto;
    border-radius: 0.85rem;
    margin: 1.5rem auto;
    display: block;
  }
  .blog-content iframe {
    max-width: 100%;
    border-radius: 0.65rem;
  }
  .blog-content table {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.35rem 0;
    font-size: 0.94em;
  }
  .blog-content th,
  .blog-content td {
    padding: 0.5rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--blog-navy) 12%, #e2e8f0);
  }
  .blog-content th {
    background: color-mix(in srgb, var(--blog-navy) 6%, #f8fafc);
    font-weight: 700;
    color: var(--blog-heading);
    text-align: left;
  }
</style>
{% endblock %}
{% block schema %}
<script type="application/ld+json">{{ blog_posting_ld_json }}</script>
<script type="application/ld+json">{{ breadcrumb_ld_json }}</script>
{% endblock %}

{% block content %}
<div class="blog-page max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12 min-w-0">
    <nav class="text-[11px] sm:text-xs font-black uppercase tracking-[0.12em] text-slate-500 mb-5 sm:mb-7 flex flex-wrap items-center gap-x-2 gap-y-1" aria-label="Breadcrumb">
        <a href="{{ url('blog:index') }}" class="text-[#0d2b5e] hover:text-[#f4711c] underline decoration-[#0d2b5e]/25 underline-offset-4 shrink-0 transition-colors">Blog</a>
        <span class="text-slate-300 select-none" aria-hidden="true">/</span>
        <span class="text-slate-700 min-w-0 break-words leading-snug font-semibold tracking-normal normal-case">{{ post.title }}</span>
    </nav>

    <article class="min-w-0">
        {% if post.category %}
        <span class="text-[10px] font-black uppercase tracking-[0.16em] text-[#f4711c]">{{ post.category.name }}</span>
        {% endif %}
        <div class="mt-2 mb-3 flex flex-wrap items-center gap-2 text-[11px] font-bold text-slate-500">
            <span>{{ post.author.get_full_name() or post.author.username if post.author else "RankJee Team" }}</span>
            <span class="text-slate-300">|</span>
            <span>{{ post.category.name if post.category else "General" }}</span>
            <span class="text-slate-300">|</span>
            <span>{{ post.published_at.strftime('%d %b %Y') if post.published_at else post.created_at.strftime('%d %b %Y') }}</span>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <h1 class="font-black text-[#0d2b5e] mt-2 mb-0 tracking-tight break-words text-[1.65rem] sm:text-[1.85rem] md:text-[2.15rem] leading-[1.18] max-w-[65ch]">{{ post.title }}</h1>
            {% if can_edit and edit_url %}
            <a href="{{ edit_url }}" class="inline-flex items-center justify-center rounded-xl border border-[#0d2b5e]/15 bg-white px-4 py-2 text-[11px] font-black uppercase tracking-wider text-[#0d2b5e] hover:border-[#f4711c]/35 hover:text-[#f4711c] hover:bg-[#faf8f5] transition-colors">
                Edit post
            </a>
            {% endif %}
        </div>
        {% if post.published_at %}
        <time class="text-sm text-slate-500 block mb-8 sm:mb-10 tabular-nums" datetime="{{ post.published_at.isoformat() }}">{{ post.published_at.strftime('%d %B %Y') }}</time>
        {% endif %}

        {% if blog_image_url %}
        <img src="{{ blog_image_url }}" alt="{{ post.title }}" class="w-full rounded-2xl mb-9 sm:mb-10 object-cover max-h-[22rem] bg-slate-100 shadow-sm border border-slate-100/80" loading="eager" decoding="async"{% if not blog_hero_is_upload %} referrerpolicy="no-referrer"{% endif %}>
        {% endif %}

        <div class="blog-content min-w-0">
            {{ body_html }}
        </div>

        <aside class="mt-14 sm:mt-16 rounded-2xl border border-[#0d2b5e]/12 bg-gradient-to-br from-[#faf8f5] to-[#f4f6fb] p-6 sm:p-7 shadow-sm">
            <h2 class="text-lg font-black text-[#0d2b5e] mb-3 tracking-tight">Explore RankJee</h2>
            <ul class="space-y-2.5 text-[0.9375rem] font-semibold text-[#0d2b5e]/95 leading-snug">
                <li><a href="{{ url('hometutor:tutor_city_landing', city_slug='ahmedabad') }}" class="underline decoration-[#f4711c]/35 underline-offset-[5px] hover:text-[#f4711c] hover:decoration-[#f4711c]/70 transition-colors">Home tutors in Ahmedabad</a></li>
                <li><a href="{{ url('assessment:mock_test_landing', exam_slug='jee-main') }}" class="underline decoration-[#f4711c]/35 underline-offset-[5px] hover:text-[#f4711c] hover:decoration-[#f4711c]/70 transition-colors">Free JEE Main mock test</a></li>
                <li><a href="{{ url('core:courses') }}" class="underline decoration-[#f4711c]/35 underline-offset-[5px] hover:text-[#f4711c] hover:decoration-[#f4711c]/70 transition-colors">Job-ready courses</a></li>
                <li><a href="{{ url('learning:index') }}" class="underline decoration-[#f4711c]/35 underline-offset-[5px] hover:text-[#f4711c] hover:decoration-[#f4711c]/70 transition-colors">Micro-learning videos &amp; quizzes</a></li>
            </ul>
        </aside>

        {% if related_posts %}
        <section class="mt-11 sm:mt-12">
            <h2 class="text-xl font-black text-[#0d2b5e] mb-4 tracking-tight">Related posts</h2>
            <div class="grid gap-3">
                {% for related in related_posts %}
                <a href="{{ url('blog:detail', slug=related.slug) }}" class="block rounded-xl border border-slate-200/90 bg-white px-4 py-4 hover:border-[#f4711c]/35 hover:shadow-md transition-all">
                    {% if related.category %}
                    <span class="text-[10px] font-black uppercase tracking-[0.14em] text-[#f4711c]">{{ related.category.name }}</span>
                    {% endif %}
                    <p class="font-bold text-slate-900 mt-1">{{ related.title }}</p>
                    {% if related.excerpt %}
                    <p class="text-sm text-slate-600 mt-1">{{ related.excerpt }}</p>
                    {% endif %}
                </a>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </article>
</div>
{% endblock %}
