{% extends "base.jinja" %}
{% block title %}Watch & Earn - RankJee Rewards{% endblock %}

{% block extra_head %}
<!-- AdSense Auto Ads Script (Placeholder) -->
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>

<style>
    .grain-bg {
        background-color: #020617;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        background-size: 200px;
        opacity: 0.95;
    }
    .timer-circle {
        transition: stroke-dashoffset 1s linear;
    }
</style>
{% endblock %}

{% block content %}
<div class="grain-bg min-h-[80vh] py-8 md:py-12 px-4 pb-24 md:pb-12 flex items-center justify-center text-white">
    <div class="max-w-4xl w-full" x-data="{ 
        timer: 30, 
        canClaim: false, 
        adLoaded: false,
        startTimer() {
            let interval = setInterval(() => {
                if(this.timer > 0) {
                    this.timer--;
                } else {
                    this.canClaim = true;
                    clearInterval(interval);
                }
            }, 1000);
        }
    }" x-init="startTimer()">
        
        <div class="text-center mb-8 md:mb-10">
            <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-2">Watch & <span class="text-indigo-400">Earn Rewards</span></h2>
            <p class="text-slate-400 text-sm md:text-base font-medium">Earn ₹0.50 platform credit for every ad you finish watching.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
            <!-- Ad Viewing Area -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white/5 backdrop-blur-2xl border border-white/10 rounded-[2rem] md:rounded-[2.5rem] p-1 overflow-hidden shadow-2xl relative min-h-[300px] md:min-h-[400px]">
                    <!-- AdSense Placement -->
                    <div class="w-full h-full flex items-center justify-center bg-slate-900/50 rounded-[1.8rem] md:rounded-[2.2rem]">
                        <ins class="adsbygoogle"
                             style="display:block; width:100%; height:300px;"
                             data-ad-client="ca-pub-XXXXXXXXXXXXX"
                             data-ad-slot="XXXXXXXXXX"
                             data-ad-format="auto"
                             data-full-width-responsive="true"></ins>
                        <script>
                             (adsbygoogle = window.adsbygoogle || []).push({});
                        </script>
                        
                        <!-- Overlay when timer is running -->
                        <div x-show="!canClaim" class="absolute inset-0 bg-slate-950/40 backdrop-blur-[2px] flex flex-col items-center justify-center pointer-events-none">
                            <div class="relative w-20 h-20 md:w-24 md:h-24 mb-4">
                                <svg class="w-full h-full transform -rotate-90">
                                    <circle cx="40" cy="40" r="32" stroke="currentColor" stroke-width="6" fill="transparent" class="text-white/10 md:hidden" />
                                    <circle cx="48" cy="48" r="40" stroke="currentColor" stroke-width="8" fill="transparent" class="text-white/10 hidden md:block" />
                                    
                                    <!-- Mobile Path -->
                                    <circle cx="40" cy="40" r="32" stroke="currentColor" stroke-width="6" fill="transparent" 
                                        class="text-indigo-500 timer-circle md:hidden"
                                        stroke-dasharray="201"
                                        :stroke-dashoffset="201 * (timer / 30)" />
                                        
                                    <!-- Desktop Path -->
                                    <circle cx="48" cy="48" r="40" stroke="currentColor" stroke-width="8" fill="transparent" 
                                        class="text-indigo-500 timer-circle hidden md:block"
                                        stroke-dasharray="251.2"
                                        :stroke-dashoffset="251.2 * (timer / 30)" />
                                </svg>
                                <span class="absolute inset-0 flex items-center justify-center font-black text-xl md:text-2xl" x-text="timer"></span>
                            </div>
                            <p class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.2em] text-indigo-300">Wait for Reward</p>
                        </div>

                        <!-- Success UI -->
                        <div x-show="canClaim" x-cloak class="absolute inset-0 bg-indigo-600/90 backdrop-blur-md flex flex-col items-center justify-center animate-in fade-in duration-500">
                            <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-4xl mb-4 shadow-2xl">⚡</div>
                            <h3 class="text-2xl font-black mb-6">Ad Complete!</h3>
                            <form action="{{ url('core:claim_ad_reward') }}" method="POST">
                                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                <button type="submit" class="bg-white text-indigo-600 font-black px-10 py-4 rounded-2xl hover:bg-slate-100 transition-all shadow-2xl uppercase tracking-widest text-xs">
                                    Claim ₹0.50 Credit
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats & History -->
            <div class="space-y-6">
                <div class="bg-indigo-600 rounded-[2rem] p-8 shadow-xl shadow-indigo-600/20">
                    <p class="text-indigo-200 text-[10px] font-black uppercase tracking-widest mb-1">Your Balance</p>
                    <p class="text-4xl font-black tracking-tighter mb-4">₹{{ request.user.wallet_balance }}</p>
                    <div class="h-px bg-white/10 mb-4"></div>
                    <p class="text-xs text-indigo-100 font-medium leading-relaxed">Watching ads helps keep RankJee free for everyone. Thank you for your support!</p>
                </div>

                <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-[2rem] p-6">
                    <h4 class="text-xs font-black uppercase tracking-widest mb-4 text-slate-400">Live Community Earning</h4>
                    <div class="space-y-4">
                        {% for i in range(3) %}
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-xs">👤</div>
                            <div class="flex-grow">
                                <p class="text-[11px] font-bold">User_{{ i }} earned ₹0.50</p>
                                <p class="text-[9px] text-slate-500">Just now</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Refresh the page after 2 seconds on success message
    if (document.querySelector('.bg-indigo-50')) {
        setTimeout(() => {
            window.location.reload();
        }, 2000);
    }
</script>
{% endblock %}
