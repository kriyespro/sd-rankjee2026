{% extends "base.jinja" %}
{% block title %}Login to Request a Tutor - RankJee{% endblock %}

{% block content %}
<section class="bg-slate-100 border-b border-slate-200/80 pt-12 pb-12 px-4">
    <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600 mb-2">Request a tutor</p>
        <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight mb-3">
            Login with Google to continue
        </h1>
        <p class="text-slate-600 text-sm md:text-base max-w-2xl mx-auto">
            We require Google login before opening the tutor requirement form to reduce spam and keep tutor matching quality high.
        </p>
    </div>
</section>

<section class="max-w-3xl mx-auto px-4 py-10">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm text-center">
        <a href="{{ google_login_url }}"
           class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-black uppercase tracking-wider text-white hover:bg-indigo-500 transition-colors">
            Continue with Google
        </a>
        <p class="mt-3 text-xs text-slate-500 font-medium">
            After login, you will be redirected to the tutor request form.
        </p>
        {% if request.user.is_authenticated and google_only_mode %}
        <p class="mt-2 text-xs text-amber-700 font-bold">
            Your current account is signed in, but this form accepts Google-authenticated accounts only.
        </p>
        {% endif %}
    </div>
</section>
{% endblock %}
