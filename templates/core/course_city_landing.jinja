{% extends "base.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "{{ course.title|e }}",
  "description": "{{ (course.short_description or course.description or 'RankJee course')|e }}",
  "provider": {
    "@type": "Organization",
    "name": "RankJee"
  },
  "offers": {
    "@type": "Offer",
    "price": "{{ course.price_inr }}",
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "url": "{{ canonical_url }}"
  }
}
</script>
{% if faq_items %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq_items %}
    {
      "@type": "Question",
      "name": "{{ item.q|e }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ item.a|e }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}

{% block content %}
<section class="bg-slate-100 border-b border-slate-200/80 pt-10 pb-10 px-4">
    <div class="max-w-6xl mx-auto">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600 mb-2">Course city landing</p>
        <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight mb-2">
            {{ course.title }} Course in {{ city_label }}
        </h1>
        <p class="text-slate-600 text-sm md:text-base max-w-3xl">
            Build practical skills with a structured learning path in {{ city_label }}. Enroll now to get started.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
            {% for city in related_cities %}
            <a href="{{ url('core:course_city_landing', slug=course.slug, city_slug=city|lower|replace(' ', '-')) }}"
               class="inline-flex items-center rounded-full border border-indigo-200 bg-white px-3 py-1 text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-50">
                {{ course.title }} in {{ city }}
            </a>
            {% endfor %}
        </div>
    </div>
</section>

<section class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <article class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-sm p-6">
            <h2 class="text-xl font-black text-slate-900">{{ course.title }}</h2>
            <p class="mt-2 text-slate-600 text-sm">{{ course.short_description }}</p>
            {% if course.description %}
            <div class="mt-4 text-sm text-slate-700 whitespace-pre-line">{{ course.description }}</div>
            {% endif %}
        </article>
        <aside class="rounded-2xl border border-indigo-200 bg-indigo-50 p-6">
            <h3 class="text-lg font-black text-indigo-900">Enroll in {{ city_label }}</h3>
            <p class="text-sm text-indigo-800 mt-1">Duration: {{ course.duration_weeks }} weeks</p>
            <p class="text-sm text-indigo-800">Fee: ₹{{ course.price_inr }}</p>
            <a href="{{ url('core:course_detail', slug=course.slug) }}"
               class="mt-4 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">
                Register interest
            </a>
        </aside>
    </div>
</section>

{% if faq_items %}
<section class="max-w-6xl mx-auto px-4 pb-10">
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-black text-slate-900 mb-4">Frequently asked questions</h2>
        <div class="space-y-4">
            {% for item in faq_items %}
            <div class="rounded-xl border border-slate-100 bg-slate-50 p-4">
                <h3 class="text-sm font-black text-slate-800">{{ item.q }}</h3>
                <p class="mt-1 text-sm text-slate-600">{{ item.a }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
{% endblock %}
