{# ─── Course buy card — sticky sidebar ─────────────────────── #}
<div class="cd-buy-card rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-200/80 overflow-hidden">

  {% if course.thumbnail_url %}
  <div class="aspect-video overflow-hidden">
    <img src="{{ course.thumbnail_url }}" alt="{{ course.title }}" loading="lazy" decoding="async" class="w-full h-full object-cover">
  </div>
  {% else %}
  <div class="aspect-video relative overflow-hidden flex items-center justify-center"
       style="background:linear-gradient(135deg,var(--ca1) 0%,var(--ca2) 60%,color-mix(in srgb,var(--ca2) 60%,#000) 100%);">
    <div style="background:rgba(255,255,255,.07);width:200px;height:200px;border-radius:50%;position:absolute;top:-60px;right:-60px;"></div>
    <svg class="h-16 w-16 text-white/25 relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
    </svg>
    <div class="absolute bottom-3 left-3 right-3">
      <p class="text-white font-black text-sm leading-tight">{{ course.title }}</p>
      <p class="text-white/60 text-xs mt-0.5">{{ course.level }} · {{ course.duration_weeks }} weeks</p>
    </div>
  </div>
  {% endif %}

  <div class="cd-buy-card-body p-5">

    <div class="cd-buy-top">
      <div class="flex items-end justify-between gap-2 mb-3">
        <div>
          {% if referral_price_unlocked %}
          <p class="cd-buy-price text-4xl font-black tracking-tight" style="color:var(--ca1);">₹{{ course_checkout_price_inr }}</p>
          <p class="text-sm text-slate-400 line-through leading-none mt-0.5">₹{{ course_list_price_inr }}</p>
          {% else %}
          <p class="cd-buy-price text-4xl font-black tracking-tight text-slate-900">₹{{ course_list_price_inr }}</p>
          {% endif %}
        </div>
        <div class="flex flex-col items-end gap-1">
          {% if referral_price_unlocked %}
          <span class="inline-flex rounded-full bg-emerald-100 border border-emerald-200 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-emerald-800">
            {{ referral_lead_discount_pct }}% OFF
          </span>
          {% endif %}
          {% if course.salary_after_max %}
          <span class="cd-buy-salary-pill inline-flex rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider"
                style="background:var(--ca3);color:var(--ca1);">
            ↑ ₹{{ course.salary_after_max|int }}L salary
          </span>
          {% endif %}
        </div>
      </div>

      {% if owns_course %}
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3.5 text-center mb-3">
        <p class="text-sm font-black text-emerald-800 flex items-center justify-center gap-2">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          You own this course
        </p>
      </div>
      {% elif request.user.is_authenticated %}
      {% if course.course_type == 'HYBRID' %}
      <button type="button" class="cd-btn-secondary w-full mb-2.5"
              hx-post="{{ url('core:course_request_demo', course.slug) }}"
              hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
              hx-target="#cd-demo-result" hx-swap="innerHTML">
        Request live demo class
      </button>
      {% else %}
      <button type="button" class="cd-btn-secondary w-full mb-2.5"
              hx-post="{{ url('core:course_request_demo', course.slug) }}"
              hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
              hx-target="#cd-demo-result" hx-swap="innerHTML">
        Watch free preview
      </button>
      {% endif %}
      <div id="cd-demo-result"></div>
      <form method="post" action="{{ url('core:course_cart_add', course.id) }}" class="m-0 mb-2.5">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
        <button type="submit" class="cd-btn-primary w-full"
                style="box-shadow:0 8px 24px -8px color-mix(in srgb, var(--ca2) 55%, transparent);">
          Add to cart — ₹{% if referral_price_unlocked %}{{ course_checkout_price_inr }}{% else %}{{ course_list_price_inr }}{% endif %}
        </button>
      </form>
      <a href="{{ url('core:course_cart') }}" class="cd-btn-secondary w-full">View cart</a>
      {% else %}
      <a href="{{ url('users:signup') }}?next={{ course.get_absolute_url() }}" class="cd-btn-primary w-full mb-2">
        Get started free
      </a>
      <a href="{{ url('users:login') }}?next={{ course.get_absolute_url() }}" class="cd-btn-secondary w-full mb-2.5">
        Log in
      </a>
      {% endif %}

      <div class="cd-buy-social flex items-center justify-center gap-2 mb-3">
        <div class="flex -space-x-1.5">
          <span class="w-6 h-6 rounded-full border-2 border-white bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-[9px] font-black text-white">A</span>
          <span class="w-6 h-6 rounded-full border-2 border-white bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-[9px] font-black text-white">P</span>
          <span class="w-6 h-6 rounded-full border-2 border-white bg-gradient-to-br from-rose-500 to-pink-600 flex items-center justify-center text-[9px] font-black text-white">R</span>
        </div>
        <p class="text-[11px] font-semibold text-slate-500">
          <strong class="text-slate-800">{{ (course.testimonials or [])|length * 12 + 47 }}+</strong> learners enrolled
        </p>
      </div>
    </div>

    <div class="cd-buy-middle">
      <div class="cd-buy-middle-inner">
        {% if course.job_roles %}
        <div class="cd-buy-career">
          <p class="cd-buy-career-label">Ideal career paths</p>
          <div class="cd-buy-career-chips">
            {% for role in course.job_roles.split(',') %}
            {% if loop.index <= 4 and role.strip() %}
            <span class="cd-buy-career-chip">{{ role.strip() }}</span>
            {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endif %}


        {% if course.curriculum and course.curriculum|length > 0 %}
        <p class="cd-buy-starts">
          <span class="cd-buy-starts-label">Starts with</span>
          <span class="cd-buy-starts-title">{{ course.curriculum[0].title }}</span>
        </p>
        <a href="#curriculum" class="cd-buy-syllabus-link">Browse full curriculum →</a>
        {% endif %}

        {% set _reviews = course.testimonials or [] %}
        {% if _reviews|length > 0 and _reviews[0].text %}
        <blockquote class="cd-buy-quote">
          <p>"{{ _reviews[0].text|truncate(120, true, '…') }}"</p>
          <footer>— {{ _reviews[0].name }}{% if _reviews[0].role %}, {{ _reviews[0].role }}{% endif %}</footer>
        </blockquote>
        {% endif %}
      </div>
    </div>

    <div class="cd-buy-bottom">
      <div class="cd-buy-mini-lines">
        {% for perk in gain_perks %}
        <div class="cd-buy-mini-line">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <span>{{ perk }}</span>
        </div>
        {% endfor %}
      </div>

      {% if course.salary_after_min and course.salary_after_max %}
      <div class="cd-buy-salary rounded-xl overflow-hidden mb-2"
           style="background:linear-gradient(135deg,var(--ca3),color-mix(in srgb,var(--ca3) 50%,white));">
        <div class="px-3 py-2.5 flex items-center justify-between gap-2">
          <div>
            <p class="text-[10px] font-black uppercase tracking-wider" style="color:var(--ca1);">Salary after course</p>
            <p class="text-sm font-black mt-0.5" style="color:var(--ca1);">₹{{ course.salary_after_min|int }}–{{ course.salary_after_max|int }} LPA</p>
          </div>
          <svg class="h-7 w-7 opacity-30 shrink-0" style="color:var(--ca1);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
      </div>
      {% endif %}

      <p class="cd-buy-guarantee text-center text-[10px] text-slate-500 font-semibold">✓ 30-day satisfaction guarantee</p>
    </div>

    <div class="cd-buy-includes border-t border-slate-100 pt-4 space-y-2.5 mt-4">
      <p class="text-[10px] font-black uppercase tracking-[.2em] text-slate-400 mb-3">This course includes</p>
      {% for label in course_includes %}
      <div class="flex items-center gap-2.5">
        <span style="color:var(--ca2);" class="shrink-0">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </span>
        <span class="text-xs text-slate-700 font-semibold">{{ label }}</span>
      </div>
      {% endfor %}
    </div>

    {% if pending_course_referrer_code and not referral_price_unlocked %}
    <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-[11px] text-amber-800 font-bold leading-snug">
      Enroll to unlock <strong>{{ referral_lead_discount_pct }}% off</strong> via referral at checkout.
    </p>
    {% endif %}

  </div>
</div>
