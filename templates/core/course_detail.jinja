{% extends "base.jinja" %}
{% block title %}{{ seo_title if seo_title is defined and seo_title else course.title + ' – RankJee' }}{% endblock %}

{% block extra_head %}
<style>{% set _t = course.title|lower %}{% if 'seo' in _t or 'search' in _t %}:root{--ca1:#0369a1;--ca2:#0284c7;--ca3:#e0f2fe;--ca4:#38bdf8}{% elif 'social' in _t or 'instagram' in _t %}:root{--ca1:#7c3aed;--ca2:#8b5cf6;--ca3:#ede9fe;--ca4:#a78bfa}{% elif 'email' in _t %}:root{--ca1:#b45309;--ca2:#d97706;--ca3:#fef3c7;--ca4:#fbbf24}{% elif 'ecommerce' in _t or 'amazon' in _t or 'shopify' in _t %}:root{--ca1:#0f766e;--ca2:#0d9488;--ca3:#ccfbf1;--ca4:#2dd4bf}{% elif 'prompt' in _t or 'chatgpt' in _t or 'claude' in _t %}:root{--ca1:#6d28d9;--ca2:#7c3aed;--ca3:#ede9fe;--ca4:#a78bfa}{% elif 'agent' in _t or 'langchain' in _t or 'agentic' in _t %}:root{--ca1:#1e3a8a;--ca2:#1d4ed8;--ca3:#dbeafe;--ca4:#60a5fa}{% elif 'performance' in _t or 'paid' in _t %}:root{--ca1:#be123c;--ca2:#e11d48;--ca3:#ffe4e6;--ca4:#fb7185}{% elif 'marketing' in _t or 'digital' in _t or 'branding' in _t or 'content' in _t or 'ads' in _t %}:root{--ca1:#c2410c;--ca2:#ea580c;--ca3:#fff7ed;--ca4:#fb923c}{% else %}:root{--ca1:#4f46e5;--ca2:#6366f1;--ca3:#e0e7ff;--ca4:#818cf8}{% endif %}</style>
<link rel="stylesheet" href="{{ static('css/course-detail.min.css') }}">
{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context":"https://schema.org","@type":"Course",
  "name":"{{ course.title|e }}",
  "description":"{{ (course.short_description or '')|e }}",
  "provider":{"@type":"Organization","name":"RankJee","url":"https://rankjee.com"},
  "offers":{
    "@type":"Offer","price":"{{ course.price_inr }}","priceCurrency":"INR",
    "availability":"https://schema.org/InStock",
    "url":"{{ request.build_absolute_uri(request.path) }}"
  }
{% if course.salary_after_min and course.salary_after_max %}
  ,"educationalCredentialAwarded":"Certificate of Completion"
{% endif %}
}
</script>
{% endblock %}

{% block content %}
{% set total_topics = course.curriculum|map(attribute='topics')|map('length')|sum if course.curriculum else 0 %}
{% set review_count = (course.testimonials or [])|length %}

{# ═══════════════════════════════════════════════════════════
   TOP ACCENT BAR
══════════════════════════════════════════════════════════════ #}
<div style="background:linear-gradient(90deg,var(--ca1),var(--ca2),var(--ca4));height:5px;"></div>

{# ═══════════════════════════════════════════════════════════
   HERO — dark gradient full bleed  (upGrad-inspired)
══════════════════════════════════════════════════════════════ #}
<div class="cd-hero">
  <div class="cd-hero-inner">

    {# ── Left column ── #}
    <div class="cd-hero-main min-w-0">

      {# ── Credibility trust badges ── #}
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1.5">
          <svg class="h-3.5 w-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
          <span class="text-xs font-bold text-emerald-700">Verified Curriculum</span>
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-3 py-1.5">
          <svg class="h-3.5 w-3.5 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <span class="text-xs font-bold text-amber-700">5.0 Rated</span>
        </span>
        {% if course.salary_after_max %}
        <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5"
              style="background:color-mix(in srgb,var(--ca3) 60%,white);border-color:color-mix(in srgb,var(--ca4) 45%,white)">
          <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="color:var(--ca1)"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          <span class="text-xs font-bold" style="color:var(--ca1)">₹{{ course.salary_after_max|int }} LPA potential</span>
        </span>
        {% endif %}
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 border border-blue-200 px-3 py-1.5">
          <svg class="h-3.5 w-3.5 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span class="text-xs font-bold text-blue-700">Lifetime Access</span>
        </span>
      </div>

      {# Breadcrumb #}
      <p class="cd-hero-eyebrow mb-3">
        <a href="{{ url('core:courses') }}">Courses</a>
        <span class="mx-1.5 text-slate-300">/</span>
        <span>{{ course.level or 'Online Learning' }}</span>
      </p>

      {# Title #}
      <h1 class="cd-hero-title">{{ course.title }}</h1>

      {# Short description #}
      {% if course.short_description %}
      <p class="cd-hero-lead">{{ course.short_description }}</p>
      {% endif %}

      {# ── USP bullet points (admin: hero_usps JSON or auto) ── #}
      <div class="cd-hero-usps space-y-2.5 mb-6">
        {% for usp in hero_usps %}
        <div class="flex items-start gap-3">
          <span class="mt-0.5 h-5 w-5 rounded-full bg-emerald-100 border border-emerald-300 flex items-center justify-center shrink-0">
            <svg class="h-3 w-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>
          <span class="cd-hero-usp">{{ format_bold_markers(usp)|safe }}</span>
        </div>
        {% endfor %}
      </div>

      {# ── Alumni trust row ── #}
      <div class="flex flex-wrap items-center gap-4 mb-5">
        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            <span class="w-8 h-8 rounded-full border-2 border-white bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-[10px] font-black text-white">A</span>
            <span class="w-8 h-8 rounded-full border-2 border-white bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-[10px] font-black text-white">P</span>
            <span class="w-8 h-8 rounded-full border-2 border-white bg-gradient-to-br from-rose-500 to-pink-600 flex items-center justify-center text-[10px] font-black text-white">R</span>
            <span class="w-8 h-8 rounded-full border-2 border-white bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center text-[10px] font-black text-white">S</span>
          </div>
          <div>
            <p class="text-sm font-black text-slate-900 leading-none">
              {{ (course.testimonials or [])|length * 12 + 47 }}+ learners enrolled
            </p>
            <div class="flex items-center gap-1 mt-0.5">
              {% for _ in range(5) %}<svg class="h-3 w-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>{% endfor %}
              <span class="text-xs text-slate-500 ml-1">5.0 ({{ review_count }} reviews)</span>
            </div>
          </div>
        </div>
      </div>

      <div class="cd-hero-grow">
        {% include "core/partials/_course_hero_gain.jinja" %}
      </div>

      {# ── Course meta grid ── #}
      <div class="cd-meta-grid">
        <div class="cd-meta-cell">
          <span class="cd-meta-label">Type</span>
          <span class="cd-meta-value">{{ course.level or 'Online' }}</span>
        </div>
        <div class="cd-meta-cell">
          <span class="cd-meta-label">Duration</span>
          <span class="cd-meta-value">{{ course.duration_weeks }} weeks</span>
        </div>
        <div class="cd-meta-cell">
          <span class="cd-meta-label">Format</span>
          <span class="cd-meta-value">Self-paced</span>
        </div>
        <div class="cd-meta-cell">
          <span class="cd-meta-label">Modules</span>
          <span class="cd-meta-value">{{ course.curriculum|length if course.curriculum else '—' }}</span>
        </div>
      </div>

      {# ── CTAs (mobile / tablet) ── #}
      <div class="cd-hero-actions">
        {% if owns_course %}
        <a href="{{ url('dashboard:index') }}" class="cd-btn-primary">Go to dashboard</a>
        {% elif request.user.is_authenticated %}
        {% if course.course_type == 'HYBRID' %}
        <button type="button" class="cd-btn-secondary"
                hx-post="{{ url('core:course_request_demo', course.slug) }}"
                hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
                hx-target="#cd-demo-result-mobile" hx-swap="innerHTML">Request live demo class</button>
        {% else %}
        <button type="button" class="cd-btn-secondary"
                hx-post="{{ url('core:course_request_demo', course.slug) }}"
                hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
                hx-target="#cd-demo-result-mobile" hx-swap="innerHTML">Watch free preview</button>
        {% endif %}
        <form method="post" action="{{ url('core:course_cart_add', course.id) }}" class="m-0">
          <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
          <button type="submit" class="cd-btn-primary">
            Enroll — ₹{% if referral_price_unlocked %}{{ course_checkout_price_inr }}{% else %}{{ course_list_price_inr }}{% endif %}
          </button>
        </form>
        {% else %}
        <a href="{{ url('users:signup') }}?next={{ course.get_absolute_url() }}" class="cd-btn-primary">Get started free</a>
        {% endif %}
        <a href="#curriculum" class="cd-btn-secondary">View curriculum</a>
        {% if referral_price_unlocked %}
        <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1.5 text-xs font-semibold text-emerald-700">
          {{ referral_lead_discount_pct }}% off applied
        </span>
        {% endif %}
      </div>
      <div id="cd-demo-result-mobile" class="mt-2"></div>

    </div>{# /left #}

    {# ── Right: preview + enroll card ── #}
    <aside class="cd-hero-aside">
      <div class="cd-hero-preview">
        <div class="cd-hero-preview-media">
          {% if course.thumbnail_url %}
          <img src="{{ course.thumbnail_url }}" alt="{{ course.title }}">
          {% else %}
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="h-14 w-14 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443"/>
            </svg>
          </div>
          {% endif %}
          <span class="cd-hero-preview-badge">
            <svg class="h-3.5 w-3.5" style="color:var(--ca1)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {{ course.level or 'Online' }} · {{ course.duration_weeks }} weeks
          </span>
        </div>
        <div class="cd-hero-preview-stats">
          <div class="cd-hero-preview-stat">
            <strong>{{ course.curriculum|length if course.curriculum else '—' }}</strong>
            <span>Modules</span>
          </div>
          <div class="cd-hero-preview-stat">
            <strong>{{ total_topics }}+</strong>
            <span>Topics</span>
          </div>
          <div class="cd-hero-preview-stat">
            <strong>Cert</strong>
            <span>Included</span>
          </div>
        </div>
      </div>

      <div class="cd-hero-buy-wrap rj-sticky">
        {% include "core/partials/_course_buy_card.jinja" %}
      </div>
    </aside>

  </div>
</div>{# /cd-hero #}

{# ═══════════════════════════════════════════════════════════
   SECTION ANCHOR NAV (sticky)
══════════════════════════════════════════════════════════════ #}
<div class="cd-sec-nav shadow-sm">
  <div class="cd-sec-nav-inner">
    <nav class="cd-sec-nav-links" aria-label="Course sections">
      <a href="#overview" class="cd-anc active">Overview</a>
      {% if course.curriculum %}
      <a href="#curriculum" class="cd-anc">Curriculum</a>
      {% endif %}
      {% if course.salary_after_min or course.job_roles %}
      <a href="#career" class="cd-anc">Career</a>
      {% endif %}
      {% if course.testimonials %}
      <a href="#reviews" class="cd-anc">Reviews</a>
      {% endif %}
    </nav>
    <a href="#enroll" class="cd-nav-cta">Enroll now</a>
  </div>
</div>

{# ═══════════════════════════════════════════════════════════
   BODY  (main + sidebar)
══════════════════════════════════════════════════════════════ #}
<div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 lg:flex lg:gap-10 lg:items-start">

  {# ── MAIN column ── #}
  <div class="flex-1 min-w-0 space-y-10" id="overview">

    {# ── 1. What you'll learn ── #}
    {% if course.curriculum %}
    <section>
      <div class="cd-sec-hd">
        <span class="cd-sec-icon">
          <svg class="h-4 w-4" style="color:var(--ca1);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        </span>
        <div>
          <h2 class="text-xl font-black text-slate-900">What you'll learn</h2>
          <p class="text-xs text-slate-500 mt-0.5">{{ course.curriculum|length }} modules · {{ total_topics }} topics covered</p>
        </div>
      </div>
      <div style="background:var(--ca3);border:1px solid color-mix(in srgb,var(--ca2) 22%,transparent);"
           class="rounded-2xl p-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {% for mod in course.curriculum %}
          <div class="cd-learn-item">
            <span class="cd-learn-check">
              <svg class="h-3 w-3" style="color:var(--ca2);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </span>
            <span class="text-sm text-slate-800 font-medium leading-snug">{{ mod.title }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    {# ── 2. Program overview ── #}
    {% if course_description_sections %}
    <section>
      <div class="cd-sec-hd">
        <span class="cd-sec-icon">
          <svg class="h-4 w-4" style="color:var(--ca1);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </span>
        <h2 class="text-xl font-black text-slate-900">Program overview</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for section in course_description_sections %}
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md transition-shadow"
             style="border-left:3px solid var(--ca2);">
          <p class="text-[10px] font-black uppercase tracking-[.18em] mb-3" style="color:var(--ca2);">{{ section.title }}</p>
          <div class="rj-md">{{ section.html }}</div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# ── 3. Curriculum ── #}
    {% if course.curriculum %}
    <section id="curriculum">
      <div class="cd-sec-hd">
        <span class="cd-sec-icon">
          <svg class="h-4 w-4" style="color:var(--ca1);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
        </span>
        <div>
          <h2 class="text-xl font-black text-slate-900">Course curriculum</h2>
          <p class="text-xs text-slate-500 mt-0.5">
            {{ course.curriculum|length }} modules · {{ total_topics }} topics
            · <span style="color:var(--ca1);" class="font-bold">first 2 modules free preview</span>
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden divide-y divide-slate-100">
        {% for mod in course.curriculum %}
        {% set is_preview = loop.index <= 2 %}
        <div class="acc-item">
          <input type="checkbox" id="m{{ loop.index }}" class="sr-only" {% if is_preview %}checked{% endif %}>
          <label for="m{{ loop.index }}"
                 class="flex w-full cursor-pointer items-center gap-4 px-5 py-4 hover:bg-slate-50/80 transition-colors select-none group">

            {# Module number bubble #}
            <span class="acc-num shrink-0 h-9 w-9 rounded-xl flex items-center justify-center text-sm font-black transition-colors
                         {{ 'text-white' if is_preview else 'text-slate-500 group-hover:text-white' }}"
                  style="{{ 'background:var(--ca1);' if is_preview else 'background:#f1f5f9;' }}">
              {{ loop.index }}
            </span>

            <div class="flex-1 min-w-0">
              <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Module {{ loop.index }}</p>
              <p class="text-sm font-black text-slate-900 leading-snug truncate">{{ mod.title }}</p>
            </div>

            <div class="flex items-center gap-2.5 shrink-0">
              {% if is_preview %}
              <span class="hidden sm:inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-emerald-700">
                Free preview
              </span>
              {% else %}
              <svg class="hidden sm:block h-3.5 w-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              {% endif %}
              <span class="hidden sm:inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold"
                    style="background:var(--ca3);color:var(--ca1);">
                {{ mod.topics|length }} topics
              </span>
              <svg class="acc-chevron h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </label>

          <div class="acc-body">
            <div class="px-5 pb-5 pt-1 space-y-1.5">
              {% for topic in mod.topics %}
              <div class="cd-topic">
                <span class="shrink-0 h-6 w-6 rounded-full flex items-center justify-center text-[10px] font-black flex-shrink-0"
                      style="background:var(--ca3);color:var(--ca1);">{{ loop.index }}</span>
                {% if is_preview %}
                <svg class="h-3.5 w-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {% else %}
                <svg class="h-3.5 w-3.5 text-slate-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                {% endif %}
                <span class="text-sm text-slate-700 flex-1">{{ topic }}</span>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# ── 4. Career outcomes ── #}
    {% if course.salary_after_min or course.job_roles %}
    <section id="career">
      <div class="cd-sec-hd">
        <span class="cd-sec-icon" style="background:#d1fae5;">
          <svg class="h-4 w-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </span>
        <h2 class="text-xl font-black text-slate-900">Career outcomes</h2>
      </div>

      <div class="rounded-2xl border border-emerald-200 bg-white shadow-sm overflow-hidden">
        {% if course.salary_after_min and course.salary_after_max %}
        <div class="p-6 border-b border-emerald-100 bg-gradient-to-br from-emerald-50/80 to-teal-50/50">
          <p class="text-[11px] font-black uppercase tracking-[.2em] text-emerald-700 mb-4">Expected salary · India market 2025</p>
          <div class="flex flex-col sm:flex-row sm:items-end gap-5">
            <div>
              <div class="flex items-baseline gap-2">
                <span class="text-5xl font-black text-slate-900 tracking-tight">₹{{ course.salary_after_min|int }}</span>
                <span class="text-2xl font-black text-slate-400">–</span>
                <span class="text-5xl font-black text-emerald-700 tracking-tight">{{ course.salary_after_max|int }}</span>
                <span class="text-xl font-bold text-slate-400 pb-1">LPA</span>
              </div>
              <p class="text-xs text-slate-500 mt-2">Lakh Per Annum · entry-level to senior roles</p>
            </div>
            <div class="flex gap-3 sm:ml-auto">
              <div class="rounded-xl border border-emerald-200 bg-white px-4 py-3 text-center min-w-[90px]">
                <p class="text-xl font-black text-emerald-700">₹{{ course.salary_after_min|int }}L</p>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-0.5">Entry</p>
              </div>
              <div class="rounded-xl bg-emerald-600 px-4 py-3 text-center min-w-[90px] shadow-md shadow-emerald-500/20">
                <p class="text-xl font-black text-white">₹{{ course.salary_after_max|int }}L</p>
                <p class="text-[10px] font-bold text-emerald-100 uppercase tracking-wider mt-0.5">Senior</p>
              </div>
            </div>
          </div>
        </div>
        {% endif %}

        {% if course.job_roles %}
        <div class="p-5 md:p-6">
          <p class="cd-career-roles-label">Job roles you can apply for</p>
          <div class="cd-role-chips">
            {% for role in course.job_roles.split(',') %}
            {% if role.strip() %}
            <span class="cd-role-chip">
              <svg fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
              {{ role.strip() }}
            </span>
            {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    {# ── 5. Student testimonials ── #}
    {% if course.testimonials %}
    <section id="reviews">
      <div class="cd-sec-hd">
        <span class="cd-sec-icon" style="background:#fef3c7;">
          <svg class="h-4 w-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </span>
        <div>
          <h2 class="text-xl font-black text-slate-900">Student success stories</h2>
          <div class="flex items-center gap-1 mt-0.5">
            {% for _ in range(5) %}
            <svg class="h-3.5 w-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {% endfor %}
            <span class="text-xs font-black text-slate-700 ml-1">5.0 / 5.0</span>
            <span class="text-xs text-slate-500 ml-1">from {{ review_count }} student{{ 's' if review_count != 1 }}</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {% set av_grads = ['from-indigo-600 to-violet-600','from-emerald-600 to-teal-600','from-rose-600 to-pink-600','from-amber-500 to-orange-500','from-sky-600 to-blue-600'] %}
        {% for t in course.testimonials %}
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md transition-shadow p-5 flex flex-col gap-3 relative overflow-hidden">
          {# corner accent #}
          <div style="background:var(--ca3);width:72px;height:72px;border-radius:50%;position:absolute;top:-24px;right:-24px;opacity:.55;"></div>
          {# big quote mark #}
          <svg class="h-8 w-8 opacity-15 relative z-10" style="color:var(--ca2);" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          <p class="text-sm text-slate-700 leading-relaxed flex-1 relative z-10">"{{ t.text }}"</p>
          <div class="flex gap-0.5 mt-1">
            {% for _ in range(t.rating) %}
            <svg class="h-3.5 w-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {% endfor %}
          </div>
          <div class="flex items-center gap-3 pt-3 border-t border-slate-100">
            <div class="h-10 w-10 rounded-full bg-gradient-to-br {{ av_grads[loop.index0 % 5] }} flex items-center justify-center text-white font-black text-sm shrink-0 shadow-sm">
              {{ t.name[0] }}
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-black text-slate-900 leading-none truncate">{{ t.name }}</p>
              <p class="text-[11px] text-slate-500 mt-0.5 truncate">{{ t.role }} · {{ t.city }}</p>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# ── 6. Enroll / CTA section ── #}
    <section id="enroll"
             style="background:linear-gradient(135deg,var(--ca1),var(--ca2));"
             class="rounded-2xl p-6 md:p-8 text-white relative overflow-hidden">
      <div style="background:rgba(255,255,255,.05);width:220px;height:220px;border-radius:50%;position:absolute;top:-70px;right:-50px;pointer-events:none;"></div>
      <div style="background:rgba(255,255,255,.03);width:140px;height:140px;border-radius:50%;position:absolute;bottom:-40px;left:-30px;pointer-events:none;"></div>

      <div class="relative">
        {% if owns_course %}
        <div class="text-center">
          <div class="inline-flex items-center gap-2 rounded-2xl bg-white/15 border border-white/25 px-5 py-3 mb-4">
            <svg class="h-5 w-5 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-white font-black">You're already enrolled!</span>
          </div>
          <p class="text-white/70 text-sm mb-4">Head to your dashboard to access course content.</p>
          <a href="{{ url('dashboard:index') }}"
             class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-black uppercase tracking-wider"
             style="color:var(--ca1);">
            Go to dashboard →
          </a>
        </div>
        {% elif request.user.is_authenticated %}
        <h2 class="text-xl font-black mb-1">Ready to start learning?</h2>
        <p class="text-sm opacity-80 mb-5">Add to cart and enroll in under 60 seconds.</p>
        {% if pending_course_referrer_code %}
        <p class="mb-4 inline-flex items-center rounded-full bg-white/15 border border-white/25 px-3 py-1 text-[11px] font-black uppercase tracking-wider">
          🎁 Referral active: {{ pending_course_referrer_code }}
          — {{ referral_lead_discount_pct }}% off at checkout
        </p>
        {% endif %}
        <div class="flex flex-wrap gap-3">
          <form method="post" action="{{ url('core:course_cart_add', course.id) }}" class="m-0">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-black uppercase tracking-wider hover:opacity-90 transition-opacity"
                    style="color:var(--ca1);">
              <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              Add to cart — ₹{% if referral_price_unlocked %}{{ course_checkout_price_inr }}{% else %}{{ course_list_price_inr }}{% endif %}
            </button>
          </form>
          {% if course.allow_monthly and course.monthly_price_inr %}
          <form method="post" action="{{ url('core:course_cart_add', course.id) }}" class="m-0">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <input type="hidden" name="monthly" value="1">
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl border-2 border-white/70 px-6 py-3 text-sm font-black uppercase tracking-wider text-white hover:bg-white/10 transition-colors">
              Monthly — ₹{{ course.monthly_price_inr }}/mo
            </button>
          </form>
          {% endif %}
          <a href="{{ url('core:course_cart') }}"
             class="inline-flex items-center rounded-xl border border-white/30 px-5 py-3 text-sm font-bold text-white/80 hover:bg-white/10 transition-colors">
            View cart →
          </a>
        </div>
        {# Referral lead form (only if a valid referrer is in session) #}
        {% if pending_course_referrer_code %}
        <div class="mt-5 border-t border-white/15 pt-5">
          <p class="text-xs text-white/60 mb-3">Or register your interest with referral discount locked in:</p>
          <form method="post" class="flex flex-col sm:flex-row gap-2">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <input type="text" name="lead_name" placeholder="Your name"
                   class="flex-1 rounded-xl bg-white/15 border border-white/20 px-4 py-2.5 text-sm text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/30">
            <input type="email" name="lead_email" placeholder="Email" required
                   value="{{ request.user.email if request.user.is_authenticated else '' }}"
                   class="flex-1 rounded-xl bg-white/15 border border-white/20 px-4 py-2.5 text-sm text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/30">
            <button type="submit"
                    class="shrink-0 rounded-xl bg-white/20 border border-white/30 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-white hover:bg-white/30 transition-colors">
              Confirm interest →
            </button>
          </form>
        </div>
        {% endif %}
        {% else %}
        <h2 class="text-xl font-black mb-1">Ready to get started?</h2>
        <p class="text-sm opacity-80 mb-5">Create a free RankJee account and enroll in minutes.</p>
        <div class="flex flex-wrap gap-3">
          <a href="{{ url('users:signup') }}?next={{ course.get_absolute_url() }}"
             class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-black uppercase tracking-wider hover:opacity-90 transition-opacity"
             style="color:var(--ca1);">
            Sign up free →
          </a>
          <a href="{{ url('users:login') }}?next={{ course.get_absolute_url() }}"
             class="inline-flex items-center rounded-xl border border-white/30 px-5 py-3 text-sm font-bold text-white/80 hover:bg-white/10 transition-colors">
            Log in
          </a>
        </div>
        {% endif %}
      </div>
    </section>

  </div>{# /main #}

</div>{# /body #}

{# mobile spacer #}
<div class="h-24 lg:hidden"></div>

{# ═══════════════════════════════════════════════════════════
   MOBILE FIXED BOTTOM BAR
══════════════════════════════════════════════════════════════ #}
{% if not owns_course %}
<div class="rj-mob-bar lg:hidden">
  <div class="max-w-lg mx-auto px-4 py-2.5 flex items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="text-[10px] font-black uppercase tracking-wider text-slate-500 truncate leading-none">
        {{ course.title|truncate(28, true, '…') }}
      </p>
      <p class="text-lg font-black leading-tight mt-0.5" style="color:var(--ca1);">
        ₹{% if referral_price_unlocked %}{{ course_checkout_price_inr }}{% else %}{{ course_list_price_inr }}{% endif %}
        {% if referral_price_unlocked %}
        <span class="text-xs font-bold text-slate-400 line-through ml-1">₹{{ course_list_price_inr }}</span>
        {% endif %}
      </p>
    </div>
    {% if request.user.is_authenticated %}
    <form method="post" action="{{ url('core:course_cart_add', course.id) }}" class="m-0 shrink-0">
      <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
      <button type="submit" class="cd-btn-primary">
        <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        Add to cart
      </button>
    </form>
    {% else %}
    <a href="{{ url('users:signup') }}?next={{ course.get_absolute_url() }}" class="cd-btn-primary shrink-0">
      Sign up &amp; enroll
    </a>
    {% endif %}
  </div>
</div>
{% endif %}

{% endblock %}
