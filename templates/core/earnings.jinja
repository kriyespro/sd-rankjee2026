{% extends "base.jinja" %}
{% block title %}Freelance Earnings - SkillLoop{% endblock %}
{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    <!-- Header Area: Referral Focus -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-8 bg-indigo-600 p-8 rounded-3xl shadow-xl shadow-indigo-100 text-white relative overflow-hidden">
        <div class="relative z-10 text-center md:text-left">
            <h2 class="text-3xl md:text-4xl font-black tracking-tight leading-tight">Refer & Earn 💰</h2>
            <p class="text-indigo-100 mt-2 font-medium max-w-sm">Help your friends master new skills. Get ₹50 for every verified registration!</p>
        </div>
        
        <div class="relative z-10 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 min-w-[200px] text-center shadow-lg">
            <p class="text-[10px] text-indigo-200 font-bold uppercase tracking-widest mb-1">Total Rewards Earned</p>
            <p class="text-4xl font-black text-white tracking-tight">₹{{ total_earned }}</p>
        </div>
        
        <!-- Decorative blob -->
        <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full blur-3xl"></div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Referral Link Area -->
        <div class="lg:col-span-2 space-y-8">
            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl p-6 md:p-8">
                <h3 class="text-lg font-black text-slate-900 mb-6 flex items-center gap-2">
                    <span class="p-1.5 bg-indigo-50 text-indigo-600 rounded-lg">🔗</span>
                    Your Personal Invite Link
                </h3>
                
                <div x-data="{ copied: false, link: '{{ referral_link }}' }" class="space-y-4">
                    <div class="relative group">
                        <input type="text" x-model="link" readonly
                               class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl px-4 py-3.5 pr-32 font-mono text-sm text-slate-600 focus:outline-none focus:border-indigo-300 transition-all select-all">
                        <button @click="navigator.clipboard.writeText(link); copied = true; setTimeout(() => copied = false, 2000)"
                                class="absolute right-2 top-2 bottom-2 bg-indigo-600 text-white px-5 rounded-lg text-xs font-bold hover:bg-indigo-700 transition active:scale-95 flex items-center gap-2">
                            <span x-text="copied ? 'Copied!' : 'Copy Link'"></span>
                        </button>
                    </div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest text-center">Share this link via WhatsApp, Email, or Social Media</p>
                </div>
            </div>

            <!-- Referral List Table -->
            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                    <h3 class="font-black text-slate-900">Your Referrals</h3>
                    <span class="text-xs font-black text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">{{ referral_count }} Joined</span>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50/50 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                            <tr>
                                <th class="px-6 py-4">User</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Joined On</th>
                                <th class="px-6 py-4 text-right">Commission</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            {% for ref in referrals %}
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-900">{{ ref.username }}</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wide {{ 'bg-emerald-50 text-emerald-600 border border-emerald-100' if ref.is_active else 'bg-amber-50 text-amber-600 border border-amber-100' }}">
                                        {{ 'Verified' if ref.is_active else 'Pending' }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-500 font-medium">
                                    {{ ref.date_joined.strftime('%d %b, %Y') }}
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <span class="font-bold text-emerald-600">+₹50</span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center">
                                    <div class="text-3xl mb-3">🤝</div>
                                    <p class="text-slate-400 font-medium italic">No referrals yet. Start sharing to earn!</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar: Stats/Rules -->
        <div class="space-y-6">
            <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-xl">
                <h4 class="text-xs font-black uppercase tracking-widest text-indigo-400 mb-4">How it works</h4>
                <ul class="space-y-4">
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px] font-black">1</span>
                        <p class="text-xs leading-relaxed text-slate-200">Share your invite link with friends who want to learn tech & exams.</p>
                    </li>
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px] font-black">2</span>
                        <p class="text-xs leading-relaxed text-slate-200">Wait for them to sign up and verify their email/account.</p>
                    </li>
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px] font-black">3</span>
                        <p class="text-xs leading-relaxed text-slate-200">Instantly receive <span class="text-indigo-400 font-bold">₹50 credits</span> in your wallet for every lead.</p>
                    </li>
                </ul>
            </div>

            <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-6 text-center">
                <p class="text-[10px] font-black text-indigo-400 uppercase tracking-widest mb-1.5">Network Strength</p>
                <p class="text-4xl font-black text-indigo-600 mb-1 tracking-tight">{{ referral_count }}</p>
                <p class="text-xs font-bold text-indigo-400 italic">Friends Invited</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
