{% extends "base.jinja" %}
{% block title %}Freelance Earnings - RankJee{% endblock %}
{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    <!-- Header Area: Referral Focus -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-8 bg-indigo-600 p-8 rounded-3xl shadow-xl shadow-indigo-100 text-white relative overflow-hidden">
        <div class="relative z-10 text-center md:text-left">
            <h2 class="text-3xl md:text-4xl font-black tracking-tight leading-tight">Refer & Earn 💰</h2>
            <p class="text-indigo-100 mt-2 font-medium max-w-sm">Help your friends master new skills. Get ₹50 for every verified registration!</p>
        </div>
        
        <div class="relative z-10 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 min-w-[200px] text-center shadow-lg">
            <p class="text-xs text-indigo-200 font-bold uppercase tracking-widest mb-1">Total Rewards Earned</p>
            <p class="text-4xl font-black text-white tracking-tight">₹{{ total_earned }}</p>
        </div>
        
        <!-- Decorative blob -->
        <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full blur-3xl"></div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Referral Link Area -->
        <div class="lg:col-span-2 space-y-8">
            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl p-6 md:p-8">
                <h3 class="text-lg font-black text-slate-900 mb-6 flex items-center gap-2">
                    <span class="p-1.5 bg-indigo-50 text-indigo-600 rounded-lg">🔗</span>
                    Your Personal Invite Link
                </h3>
                
                <div x-data="{ copied: false, link: '{{ referral_link }}' }" class="space-y-4">
                    <div class="relative group">
                        <input type="text" x-model="link" readonly
                               class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl px-4 py-3.5 pr-32 font-mono text-xs md:text-sm text-slate-600 focus:outline-none focus:border-indigo-300 transition-all select-all">
                        <button @click="navigator.clipboard.writeText(link); copied = true; setTimeout(() => copied = false, 2000)"
                                class="absolute right-2 top-2 bottom-2 bg-indigo-600 text-white px-5 rounded-lg text-xs font-bold hover:bg-indigo-700 transition active:scale-95 flex items-center gap-2">
                            <span x-text="copied ? 'Copied!' : 'Copy'"></span>
                        </button>
                    </div>
                    
                    <div class="flex flex-col sm:flex-row gap-3">
                        <a :href="'https://wa.me/?text=' + encodeURIComponent('Bhai, check this! I just earned ₹50 for watching ads on RankJee. Take a 5-min test and start earning too! Join here: ' + link)" 
                           target="_blank"
                           class="flex-1 bg-[#25D366] text-white py-4 rounded-xl font-black text-xs uppercase tracking-widest flex items-center justify-center gap-3 hover:bg-[#20bd5a] transition-all shadow-lg shadow-green-100 active:scale-95">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.399-4.437 9.884-9.838 9.884"/></svg>
                            Invite via WhatsApp
                        </a>
                        <button @click="navigator.share({ title: 'Join RankJee', text: 'Earn ₹50 per referral!', url: link })"
                                class="bg-slate-900 md:hidden text-white px-6 rounded-xl text-xl hover:bg-slate-800 transition active:scale-95">
                            📤
                        </button>
                    </div>
                </div>
            </div>

            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl p-6 md:p-8">
                <h3 class="text-lg font-black text-slate-900 mb-2 flex items-center gap-2">
                    <span class="p-1.5 bg-indigo-50 text-indigo-600 rounded-lg">🎓</span>
                    Course referral links (30% commission)
                </h3>
                <p class="text-sm text-slate-600 mb-5">Share course-specific links. On successful enrollment, you earn 30% commission.</p>
                <div class="space-y-3">
                    {% for c in active_courses %}
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3" x-data="{ copied: false, link: '{{ course_ref_links.get(c.id, '') }}' }">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
                            <div>
                                <p class="text-sm font-black text-slate-900">{{ c.title }}</p>
                                <p class="text-xs text-slate-500">Price: ₹{{ c.price_inr }}</p>
                            </div>
                            <a href="{{ url('core:course_detail', c.slug) }}" class="text-xs font-black text-indigo-700 hover:text-indigo-500">View course</a>
                        </div>
                        <div class="mt-2 relative">
                            <input type="text" x-model="link" readonly class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 pr-24 text-xs text-slate-600 font-mono">
                            <button @click="navigator.clipboard.writeText(link); copied = true; setTimeout(() => copied = false, 2000)" class="absolute right-1.5 top-1.5 bottom-1.5 px-3 rounded-md bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700">
                                <span x-show="!copied">Copy</span>
                                <span x-show="copied" x-cloak>Copied</span>
                            </button>
                        </div>
                    </div>
                    {% else %}
                    <p class="text-sm text-slate-500">No active courses available yet.</p>
                    {% endfor %}
                </div>
            </div>

            <!-- Referral List Table -->
            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden mt-8">
                <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                    <h3 class="font-black text-slate-900">Your Referrals</h3>
                    <span class="text-xs font-black text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">{{ referral_count }} Joined</span>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50/50 text-xs font-bold text-slate-600 uppercase tracking-widest">
                            <tr>
                                <th class="px-6 py-4">User</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Joined On</th>
                                <th class="px-6 py-4 text-right">Commission</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            {% for ref in referrals %}
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-900">{{ ref.username }}</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wide {{ 'bg-emerald-50 text-emerald-600 border border-emerald-100' if ref.is_active else 'bg-amber-50 text-amber-600 border border-amber-100' }}">
                                        {{ 'Verified' if ref.is_active else 'Pending' }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-500 font-medium">
                                    {{ ref.date_joined.strftime('%d %b, %Y') }}
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <span class="font-bold text-emerald-600">+₹50</span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center">
                                    <div class="text-3xl mb-3">🤝</div>
                                    <p class="text-slate-400 font-medium italic">No referrals yet. Start sharing to earn!</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Wallet Transactions History Table -->
            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden mt-8">
                <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                    <h3 class="font-black text-slate-900">Wallet Transactions</h3>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50/50 text-xs font-bold text-slate-600 uppercase tracking-widest">
                            <tr>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Type</th>
                                <th class="px-6 py-4 text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            {% for tx in transactions %}
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 text-slate-500 font-medium whitespace-nowrap">
                                    {{ tx.created_at.strftime('%d %b, %I:%M %p') }}
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-900">{{ tx.get_transaction_type_display() }}</div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <span class="font-bold {% if tx.amount < 0 %}text-red-600{% else %}text-emerald-600{% endif %}">
                                        {% if tx.amount > 0 %}+{% endif %}₹{{ tx.amount }}
                                    </span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="3" class="px-6 py-12 text-center">
                                    <div class="text-3xl mb-3">🧾</div>
                                    <p class="text-slate-400 font-medium italic">No transactions yet.</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar: Stats/Rules -->
        <div class="space-y-6">
            <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-xl">
                <h4 class="text-xs font-black uppercase tracking-widest text-indigo-400 mb-4">How it works</h4>
                <ul class="space-y-4">
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-black">1</span>
                        <p class="text-xs leading-relaxed text-slate-200">Share your invite link with friends who want to learn tech & exams.</p>
                    </li>
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-black">2</span>
                        <p class="text-xs leading-relaxed text-slate-200">Wait for them to sign up and verify their email/account.</p>
                    </li>
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-black">3</span>
                        <p class="text-xs leading-relaxed text-slate-200">Instantly receive <span class="text-indigo-400 font-bold">₹50 credits</span> in your wallet for every lead.</p>
                    </li>
                </ul>
            </div>

            <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-6 text-center">
                <p class="text-xs font-black text-indigo-400 uppercase tracking-widest mb-1.5">Network Strength</p>
                <p class="text-4xl font-black text-indigo-600 mb-1 tracking-tight">{{ referral_count }}</p>
                <p class="text-xs font-bold text-indigo-400 italic">Friends Invited</p>
            </div>

            <!-- Withdrawal Section -->
            <div class="bg-white border text-center border-slate-200 rounded-2xl p-6 shadow-sm">
                <h4 class="text-xs font-black uppercase tracking-widest text-slate-800 mb-4">Request Withdrawal</h4>
                
                <form action="{{ url('core:request_withdrawal') }}" method="POST" class="space-y-4">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    
                    <div class="text-left">
                        <label class="block text-xs font-bold text-slate-600 mb-1">Amount (₹)</label>
                        <input type="number" name="amount" min="100" max="{{ total_earned }}" value="{{ total_earned }}"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm text-slate-800 focus:outline-none focus:border-indigo-400">
                    </div>
                    
                    <div class="text-left">
                        <label class="block text-xs font-bold text-slate-600 mb-1">Your UPI ID</label>
                        <input type="text" name="upi_id" placeholder="e.g. 9876543210@paytm" required
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm text-slate-800 focus:outline-none focus:border-indigo-400">
                    </div>
                    
                    <button type="submit" 
                            class="w-full bg-indigo-600 text-white py-3 rounded-xl font-bold text-xs uppercase tracking-wide hover:bg-indigo-700 transition active:scale-95 disabled:opacity-50"
                            {% if total_earned < 100 %}disabled{% endif %}>
                        {% if total_earned < 100 %}
                            Min ₹100 Required
                        {% else %}
                            Withdraw Now
                        {% endif %}
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
