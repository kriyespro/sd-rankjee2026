{% extends "base.jinja" %}
{% block title %}Courses - RankJee{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-slate-900">Courses</h1>
        <p class="text-slate-600 mt-2">Explore job-focused courses. Successful referral enrollment pays 30% commission.</p>
        {% if pending_course_referrer_code %}
        <p class="mt-2 inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-xs font-black uppercase tracking-wider text-indigo-700">
            Referral code active: {{ pending_course_referrer_code }}
        </p>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {% for c in courses %}
        <article class="rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md transition-all p-5 flex flex-col">
            {% if c.thumbnail_url %}
            <img src="{{ c.thumbnail_url }}" alt="{{ c.title }}" class="w-full h-40 object-cover rounded-xl mb-4">
            {% endif %}
            <h2 class="text-xl font-black text-slate-900">{{ c.title }}</h2>
            <p class="text-sm text-slate-500 mt-2">{{ c.short_description or c.description[:140] }}</p>
            <div class="mt-4 flex items-center justify-between text-xs text-slate-600 font-semibold">
                <span>{{ c.level or "All levels" }}</span>
                <span>{{ c.duration_weeks }} weeks</span>
            </div>
            <div class="mt-3 text-lg font-black text-emerald-700">₹{{ c.price_inr }}</div>
            <p class="mt-1 text-xs text-indigo-700 font-bold">Referral commission: 30%</p>
        </article>
        {% else %}
        <div class="md:col-span-2 xl:col-span-3 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-900">
            No active courses yet. Add from admin CMS.
        </div>
        {% endfor %}
    </div>

    <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6">
        <h3 class="text-lg font-black text-slate-900 mb-1">Register Course Interest (for referral tracking)</h3>
        <p class="text-sm text-slate-600 mb-5">When enrollment completes, admin marks success and 30% commission is credited.</p>
        <form method="post" class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <select name="course_id" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm md:col-span-1" required>
                <option value="">Select course</option>
                {% for c in courses %}
                <option value="{{ c.id }}">{{ c.title }} (₹{{ c.price_inr }})</option>
                {% endfor %}
            </select>
            <input type="text" name="lead_name" placeholder="Student name" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm md:col-span-1">
            <input type="email" name="lead_email" placeholder="Student email" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm md:col-span-1" required>
            <button type="submit" class="rounded-xl bg-indigo-600 text-white text-sm font-black uppercase tracking-wider px-4 py-2.5 hover:bg-indigo-500">
                Submit
            </button>
        </form>
    </div>
</div>
{% endblock %}
