{% extends "base.jinja" %}
{% block title %}{{ seo_title if seo_title is defined and seo_title else 'Courses - RankJee' }}{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="{{ static('css/courses-list.min.css') }}">
{% endblock %}
{% block content %}
<div class="cl-accent-bar" aria-hidden="true"></div>

<section class="cl-hero">
  <div class="cl-hero-inner">
    <p class="cl-eyebrow">RankJee · Job-ready programs</p>
    <h1 class="cl-title">Courses</h1>
    <p class="cl-lead">Explore practical, outcome-focused programs — clear pricing, duration, and career paths on every course page.</p>
    {% if request.GET.get('purchased') == '1' %}
    <div class="cl-alert" role="status">
      Payment successful — your courses are unlocked. We&apos;ll follow up with access details by email where applicable.
    </div>
    {% endif %}
  </div>
</section>

<div class="cl-main">
  <div class="mb-4 flex flex-wrap gap-2">
    <a href="{{ url('core:courses') }}" class="rounded-full border px-4 py-1.5 text-xs font-black uppercase tracking-wide {% if not active_type %}border-indigo-600 bg-indigo-600 text-white{% else %}border-slate-200 bg-white text-slate-600{% endif %}">All</a>
    <a href="{{ url('core:courses') }}?type=recorded" class="rounded-full border px-4 py-1.5 text-xs font-black uppercase tracking-wide {% if active_type == 'RECORDED' %}border-indigo-600 bg-indigo-600 text-white{% else %}border-slate-200 bg-white text-slate-600{% endif %}">🎥 Recorded</a>
    <a href="{{ url('core:courses') }}?type=hybrid" class="rounded-full border px-4 py-1.5 text-xs font-black uppercase tracking-wide {% if active_type == 'HYBRID' %}border-indigo-600 bg-indigo-600 text-white{% else %}border-slate-200 bg-white text-slate-600{% endif %}">🏫 Hybrid</a>
  </div>
  <div class="cl-grid">
    {% for c in courses %}
    <article class="cl-card">
      <a href="{{ url('core:course_detail', c.slug) }}" class="cl-card-thumb">
        {% if c.is_featured %}
        <span class="cl-featured">Featured</span>
        {% endif %}
        {% if c.thumbnail_url %}
        <img src="{{ c.thumbnail_url }}" alt="" loading="lazy">
        {% else %}
        <span class="cl-card-thumb-placeholder" aria-hidden="true">{{ c.title[:1] }}</span>
        {% endif %}
      </a>
      <div class="cl-card-body">
        <h2 class="cl-card-title">
          <a href="{{ url('core:course_detail', c.slug) }}">{{ c.title }}</a>
        </h2>
        <p class="cl-card-desc">{{ c.short_description or c.description[:200] }}</p>

        {% if c.salary_after_min and c.salary_after_max %}
        <p class="cl-salary-pill">
          <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd"/></svg>
          ₹{{ c.salary_after_min|int }}–{{ c.salary_after_max|int }} LPA
        </p>
        {% endif %}

        <div class="cl-meta-grid">
          <div class="cl-meta-cell">
            <span class="cl-meta-label">Level</span>
            <span class="cl-meta-value">{{ c.level or 'All levels' }}</span>
          </div>
          <div class="cl-meta-cell">
            <span class="cl-meta-label">Duration</span>
            <span class="cl-meta-value">{{ c.duration_weeks }} weeks</span>
          </div>
          <div class="cl-meta-cell">
            <span class="cl-meta-label">Format</span>
            <span class="cl-meta-value">Self-paced</span>
          </div>
          <div class="cl-meta-cell">
            <span class="cl-meta-label">Modules</span>
            <span class="cl-meta-value">{{ c.curriculum|length if c.curriculum else '—' }}</span>
          </div>
        </div>

        <div class="cl-price-row">
          <p class="cl-price{% if not c.price_inr or c.price_inr <= 0 %} cl-price-free{% endif %}">
            {% if c.price_inr and c.price_inr > 0 %}₹{{ c.price_inr|int }}{% else %}Free{% endif %}
          </p>
        </div>

        <div class="cl-card-actions">
          {% if request.user.is_authenticated and c.id not in course_purchased_ids %}
          <div class="cl-card-actions-row mb-2">
            {% if c.course_type == 'HYBRID' %}
            <button type="button"
                    class="cd-btn-secondary w-full"
                    hx-post="{{ url('core:course_request_demo', c.slug) }}"
                    hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
                    hx-target="#demo-result-{{ c.id }}"
                    hx-swap="innerHTML">Request live demo</button>
            {% else %}
            <button type="button"
                    class="cd-btn-secondary w-full"
                    hx-post="{{ url('core:course_request_demo', c.slug) }}"
                    hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
                    hx-target="#demo-result-{{ c.id }}"
                    hx-swap="innerHTML">Watch free preview</button>
            {% endif %}
          </div>
          <div id="demo-result-{{ c.id }}"></div>
          {% endif %}
          <div class="cl-card-actions-row">
            <a href="{{ url('core:course_detail', c.slug) }}" class="cd-btn-secondary">View course</a>
            {% if request.user.is_authenticated %}
              {% if c.id in course_purchased_ids %}
              <span class="cl-owned">Owned</span>
              {% else %}
              <form method="post" action="{{ url('core:course_cart_add', c.id) }}" class="m-0" style="flex:1;">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <button type="submit" class="cd-btn-primary w-full">Add to cart</button>
              </form>
              {% endif %}
            {% else %}
            <a href="{{ url('users:login') }}?next={{ url('core:course_detail', c.slug) }}" class="cd-btn-primary w-full">Log in to buy</a>
            {% endif %}
          </div>
        </div>
      </div>
    </article>
    {% else %}
    <p class="cl-empty">No active courses yet. Add courses from the admin CMS.</p>
    {% endfor %}
  </div>
</div>
{% endblock %}
