{% extends "base.jinja" %}
{% block title %}{{ legal_page_title }} - RankJee{% endblock %}

{% block content %}
<main class="max-w-4xl mx-auto px-4 py-10 md:py-12">
    <article class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
        <h1 class="text-3xl md:text-4xl font-black tracking-tight text-slate-900">{{ legal_page_title }}</h1>
        <p class="mt-6 whitespace-pre-line text-sm md:text-base leading-7 text-slate-700">{{ legal_page_content }}</p>
    </article>
</main>
{% endblock %}
