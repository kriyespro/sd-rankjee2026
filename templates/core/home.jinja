                <div>
                    <span class="home-bento-tag-line font-black text-xs md:text-xs uppercase tracking-[0.2em] mb-3 md:mb-4 block">03. Certification</span>
                    <h3 class="text-xl md:text-2xl font-black mb-3 md:mb-4">Mastery Badges.</h3>
                    <p class="home-bento-muted text-sm md:text-base leading-relaxed">Score 80%+ on your weak areas to unlock verified credentials.</p>
                </div>
                <div class="home-bento-icon-gold w-12 h-12 md:w-16 md:h-16 backdrop-blur-md rounded-xl md:rounded-2xl flex items-center justify-center text-xl md:text-2xl">🏆</div>
            </div>

            <!-- Wide Row: Earn -->
            <div class="md:col-span-2 bento-card home-bento-earn rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 flex flex-col md:flex-row items-center justify-between shadow-xl overflow-hidden relative min-h-[300px] md:min-h-0">
                <div class="relative z-10 md:max-w-md w-full">
                    <span class="home-bento-tag-line font-black text-xs md:text-xs uppercase tracking-[0.2em] mb-3 md:mb-4 block">04. Monetization</span>
                    <h3 class="text-2xl md:text-3xl font-black mb-3 md:mb-4">Direct Task Rewards.</h3>
                    <p class="text-white/90 text-sm md:text-base leading-relaxed mb-6 md:mb-0">Access the task marketplace once your skills are verified. Get paid for your expertise.</p>
                </div>
                <div class="relative z-10 bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20 w-full md:w-auto">
                    <p class="text-xs font-black uppercase mb-1">CASH EARNED</p>
