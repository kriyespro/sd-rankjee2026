{% extends "base.jinja" %}
{% block title %}Master Your Skills, Unlock Your Future - RankJee{% endblock %}

{% block extra_head %}
<style>
    .jackpot-gradient {
        background: radial-gradient(circle at top right, #4f46e5, #7c3aed, #020617);
    }
    .text-gradient {
        background: linear-gradient(to right, #818cf8, #c084fc, #fb7185);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .bento-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .bento-card:hover {
        transform: translateY(-5px) scale(1.01);
        border-color: rgba(99, 102, 241, 0.4);
        box-shadow: 0 20px 40px -20px rgba(79, 70, 229, 0.4);
    }
</style>
{% endblock %}

{% block content %}
<!-- Hero Section -->
<section class="jackpot-gradient text-white pt-20 pb-16 px-4 relative overflow-hidden">
    <!-- Animated shapes -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
        <div class="absolute -top-[10%] -right-[10%] w-[60%] h-[60%] rounded-full bg-indigo-600/20 blur-[120px] animate-pulse"></div>
        <div class="absolute top-[20%] -left-[10%] w-[40%] h-[40%] rounded-full bg-fuchsia-600/10 blur-[100px]"></div>
    </div>

    <div class="max-w-6xl mx-auto text-center relative z-10 px-4">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-xl border border-white/20 rounded-full px-5 py-2 text-xs font-black uppercase tracking-[0.2em] mb-10 text-indigo-200 shadow-2xl">
            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
            Intelligence at Scale
        </div>
        
        <h1 class="text-6xl md:text-9xl font-black leading-[0.85] mb-8 tracking-tighter">
            Skill up. <br>
            <span class="text-gradient">Stand out.</span>
        </h1>
        
        <p class="text-lg md:text-2xl text-slate-300 max-w-3xl mx-auto mb-10 font-medium leading-relaxed">
            Eliminate your weak spots with AI-driven diagnostics. <br class="hidden md:block"> Earn direct cash rewards for every milestone.
        </p>
        
        <div class="bg-white/5 backdrop-blur-3xl border border-white/10 p-4 rounded-[2.5rem] max-w-fit mx-auto shadow-2xl">
            <div class="flex flex-col sm:flex-row gap-4 items-center">
                <a href="{{ url('users:signup') }}"
                   class="w-full sm:w-auto bg-white text-slate-900 font-black px-12 py-5 rounded-2xl hover:bg-slate-100 transition-all shadow-2xl shadow-white/10 text-sm tracking-wide active:scale-95 uppercase">
                    {{ uil.get_started }}
                </a>
                <a href="{{ url('core:watch_ads') }}"
                   class="w-full sm:w-auto bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 font-black px-12 py-5 rounded-2xl hover:bg-indigo-600 hover:text-white transition-all text-sm tracking-wide active:scale-95 uppercase">
                    {{ uil.watch_earn }}
                </a>
            </div>
        </div>

        {% if jackpot %}
        <div class="max-w-xl mx-auto mt-14 rounded-2xl border border-white/25 bg-white/10 backdrop-blur-xl px-6 py-6 text-center shadow-xl">
            <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-200 mb-2">Tonight&apos;s jackpot</p>
            <p class="text-2xl md:text-3xl font-black text-white">₹{{ jackpot.prize_pool|int }} <span class="text-indigo-200 text-lg font-bold">pool</span></p>
            <p class="text-sm text-white/80 mt-1 font-semibold">{{ jackpot.skill.name }}</p>
            {% if jackpot_time_to_go > 0 %}
            <div class="mt-4" x-data="{ t: {{ jackpot_time_to_go }} }" x-init="setInterval(() => { if (t > 0) t-- }, 1000)">
                <p class="text-xs font-black text-white/70 uppercase tracking-widest mb-1">Starts in</p>
                <p class="text-3xl font-black text-white font-mono tracking-tight" x-text="String(Math.floor(t/3600)).padStart(2,'0') + ':' + String(Math.floor((t%3600)/60)).padStart(2,'0') + ':' + String(t%60).padStart(2,'0')"></p>
            </div>
            {% else %}
            <p class="mt-4 text-emerald-300 font-black text-sm uppercase tracking-widest">Live now — join before it settles</p>
            {% endif %}
            <a href="{{ url('assessment:jackpot_lobby') }}" class="mt-5 inline-flex items-center justify-center gap-2 bg-white text-indigo-900 font-black text-xs uppercase tracking-widest px-8 py-3 rounded-xl hover:bg-indigo-50 transition-colors shadow-lg">
                {{ uil.enter_jackpot }}
            </a>
        </div>
        {% endif %}

        <!-- Trusted by sub-row -->
        <div class="flex flex-col items-center gap-6 opacity-30">
            <p class="text-xs md:text-sm font-black text-white/70 uppercase tracking-[0.25em]">RELIABLE & SECURE PAYMENT PARTNERS</p>
            <div class="flex flex-wrap justify-center gap-8 md:gap-12 items-center grayscale">
                <span class="text-xl md:text-2xl font-black text-white tracking-widest">VISA</span>
                <span class="text-xl md:text-2xl font-black text-white tracking-widest">STRIPE</span>
                <span class="text-xl md:text-2xl font-black text-white tracking-widest">RAZORPAY</span>
            </div>
        </div>
    </div>
</section>

<!-- Trust Section -->
<div class="bg-indigo-900/10 backdrop-blur-md border-y border-indigo-100/10 py-6 md:py-8">
    <div class="max-w-6xl mx-auto px-4 flex flex-wrap justify-center md:justify-between items-center gap-6 md:gap-8 opacity-50 grayscale hover:grayscale-0 transition-all duration-700">
        <span class="text-lg md:text-xl font-black text-slate-400 tracking-tighter">APPLE</span>
        <span class="text-lg md:text-xl font-black text-slate-400 tracking-tighter">GOOGLE</span>
        <span class="text-lg md:text-xl font-black text-slate-400 tracking-tighter">STRIPE</span>
        <span class="text-lg md:text-xl font-black text-slate-400 tracking-tighter text-indigo-400">RAZORPAY</span>
    </div>
</div>

<!-- Bento Grid Features -->
<section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12 md:mb-16 px-4">
            <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mb-4">Engineering your success.</h2>
            <p class="text-slate-600 text-sm md:text-base font-medium max-w-xl mx-auto">We've automated the learning process so you can focus on mastering high-value skills.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-auto">
            <!-- Big Feature: Diagnose -->
            <div class="md:col-span-2 bento-card bg-white rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 flex flex-col justify-between overflow-hidden relative shadow-sm min-h-[300px] md:min-h-0">
                <div class="relative z-10">
                    <span class="text-indigo-600 font-black text-xs md:text-xs uppercase tracking-[0.2em] mb-3 md:mb-4 block">01. Intelligent Diagnosis</span>
                    <h3 class="text-2xl md:text-3xl font-black text-slate-900 mb-3 md:mb-4 max-w-xs">AI-Powered Skill Gap Analysis.</h3>
                    <p class="text-slate-600 text-sm md:text-base max-w-xs leading-relaxed">Our system identifies your specific weaknesses across 500+ topics instantly.</p>
                </div>
                <div class="absolute bottom-[-5%] right-[-5%] w-[60%] h-[60%] bg-indigo-50 rounded-tl-[3rem] p-6 border-l border-t border-indigo-100/50 shadow-inner hidden md:block">
                    <div class="space-y-4">
                        <div class="h-4 w-full bg-indigo-200/50 rounded-full animate-pulse"></div>
                        <div class="h-4 w-[80%] bg-indigo-200/30 rounded-full"></div>
                        <div class="h-10 w-full bg-white border border-indigo-100 rounded-xl flex items-center px-4 gap-3">
                            <span class="text-xs text-indigo-500 font-black">Score: 82%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Square: Learn -->
            <div class="bento-card bg-slate-900 rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 flex flex-col justify-between text-white shadow-xl min-h-[250px] md:min-h-0">
                <div>
                    <span class="text-indigo-400 font-black text-xs md:text-xs uppercase tracking-[0.2em] mb-3 md:mb-4 block">02. Micro-Learning</span>
                    <h3 class="text-xl md:text-2xl font-black mb-3 md:mb-4">5-Min Turbo Lessons.</h3>
                    <p class="text-slate-300 text-sm md:text-base leading-relaxed">No fluff. Only the concepts you failed in the diagnostic test.</p>
                </div>
                <div class="w-12 h-12 md:w-16 md:h-16 bg-indigo-600 rounded-xl md:rounded-2xl flex items-center justify-center text-xl md:text-2xl shadow-lg shadow-indigo-500/20">📚</div>
            </div>

            <!-- Square: Master -->
            <div class="bento-card bg-indigo-600 rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 flex flex-col justify-between text-white shadow-xl min-h-[250px] md:min-h-0">
                <div>
                    <span class="text-indigo-200 font-black text-xs md:text-xs uppercase tracking-[0.2em] mb-3 md:mb-4 block">03. Certification</span>
                    <h3 class="text-xl md:text-2xl font-black mb-3 md:mb-4">Mastery Badges.</h3>
                    <p class="text-indigo-100 text-sm md:text-base leading-relaxed">Score 80%+ on your weak areas to unlock verified credentials.</p>
                </div>
                <div class="w-12 h-12 md:w-16 md:h-16 bg-white/20 backdrop-blur-md rounded-xl md:rounded-2xl flex items-center justify-center text-xl md:text-2xl">🏆</div>
            </div>

            <!-- Wide Row: Earn -->
            <div class="md:col-span-2 bento-card bg-emerald-500 rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 flex flex-col md:flex-row items-center justify-between text-white shadow-xl overflow-hidden relative min-h-[300px] md:min-h-0">
                <div class="relative z-10 md:max-w-md w-full">
                    <span class="text-emerald-100 font-black text-xs md:text-xs uppercase tracking-[0.2em] mb-3 md:mb-4 block">04. Monetization</span>
                    <h3 class="text-2xl md:text-3xl font-black mb-3 md:mb-4">Direct Task Rewards.</h3>
                    <p class="text-emerald-50 text-sm md:text-base leading-relaxed mb-6 md:mb-0">Access the task marketplace once your skills are verified. Get paid for your expertise.</p>
                </div>
                <div class="relative z-10 bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20 w-full md:w-auto">
                    <p class="text-xs font-black uppercase mb-1">CASH EARNED</p>
                    <p class="text-3xl md:text-4xl font-black tracking-tighter">₹5,240.00</p>
                </div>
                <!-- Abstract coins -->
                <div class="absolute right-[-20px] top-[-20px] text-7xl md:text-9xl opacity-10 rotate-12">💰</div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="py-32 bg-slate-950 text-center px-4 relative overflow-hidden">
    <div class="max-w-3xl mx-auto relative z-10">
        <h2 class="text-5xl md:text-7xl font-black text-white mb-8 tracking-tighter leading-tight">Master the platform. <br> <span class="text-indigo-500">Master your life.</span></h2>
        <p class="text-slate-400 text-lg mb-12 font-medium">Join thousands of students who have optimized their learning path and started earning from home.</p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="{{ url('users:signup') }}"
               class="bg-indigo-600 text-white font-black px-12 py-5 rounded-2xl hover:bg-indigo-500 transition-all shadow-2xl shadow-indigo-600/30">
                START NOW &rarr;
            </a>
        </div>
    </div>
    
    <!-- Decorative light beam -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-[50%] bg-indigo-600/10 blur-[150px] rounded-t-full"></div>
</section>
{% endblock %}
