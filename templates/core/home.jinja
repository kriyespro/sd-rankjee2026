                    <div class="space-y-4">
                        <div class="h-4 w-full home-mock-bar-on rounded-full animate-pulse"></div>
                        <div class="h-4 w-[80%] home-mock-bar-off rounded-full"></div>
                        <div class="h-10 w-full bg-white home-mock-score rounded-xl flex items-center px-4 gap-3">
                            <span class="text-xs font-black"><strong>Score:</strong> 82%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Square: Learn -->
            <div class="bento-card home-bento-card-navy rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 flex flex-col justify-between shadow-xl min-h-[250px] md:min-h-0">
                <div>
                    <span class="home-bento-tag-line font-black text-xs md:text-xs uppercase tracking-[0.2em] mb-3 md:mb-4 block">02. Micro-Learning</span>
