                <div class="absolute right-[-20px] top-[-20px] text-7xl md:text-9xl opacity-10 rotate-12">💰</div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="home-final-cta py-32 text-center px-4 relative overflow-hidden">
    <div class="max-w-3xl mx-auto relative z-10">
        <h2 class="text-5xl md:text-7xl font-black text-white mb-8 tracking-tighter leading-tight">Master the platform. <br> <span class="home-final-head-accent">Master your life.</span></h2>
