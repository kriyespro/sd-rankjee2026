{% extends "base.jinja" %}
{% block extra_head %}
<style>
.hero-gradient {
    background: linear-gradient(135deg, #020617 0%, #0f172a 50%, #1e1b4b 100%);
}
.glass-effect {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
}
.card-hover {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(99, 102, 241, 0.15);
}
.text-gradient {
    background: linear-gradient(100deg, #a5b4fc, #d8b4fe);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
</style>
{% endblock %}

{% block content %}
<!-- Hero Section -->
<section class="hero-gradient text-white pt-20 pb-16 px-4 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 z-0">
        <div class="absolute -top-[10%] -right-[5%] w-[50%] h-[50%] rounded-full bg-indigo-500/10 blur-[100px]"></div>
        <div class="absolute -bottom-[10%] -left-[5%] w-[40%] h-[40%] rounded-full bg-purple-500/10 blur-[100px]"></div>
        <div class="absolute top-[20%] left-[20%] w-2 h-2 rounded-full bg-indigo-400/50 animate-ping"></div>
    </div>

    <div class="max-w-5xl mx-auto items-center text-center relative z-10">
        <div class="inline-flex items-center gap-2 glass-effect rounded-full px-4 py-1.5 text-xs font-semibold mb-6 shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="tracking-wide text-indigo-100/90 uppercase">Live: 10,000+ Skills Mastered</span>
        </div>
        
        <h1 class="text-5xl sm:text-6xl font-black leading-[1.1] mb-5 tracking-tight text-white drop-shadow-sm">
            Master the rules.<br>
            <span class="text-gradient">Break the limits.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-indigo-100/70 max-w-2xl mx-auto mb-8 font-medium leading-relaxed">
            The next-generation platform for targeted learning. Discover your weak spots automatically, learn efficiently, and earn direct rewards.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="{{ url('users:signup') }}"
               class="bg-white text-slate-900 font-bold px-8 py-3.5 rounded-xl hover:bg-slate-50 transition-all shadow-[0_4px_20px_rgba(255,255,255,0.15)] ring-1 ring-white/30 text-sm">
                Start Your Journey ✨
            </a>
            <a href="{{ url('users:login') }}"
               class="glass-effect text-white font-semibold px-8 py-3.5 rounded-xl hover:bg-white/10 transition-all text-sm">
                Member Login
            </a>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="py-16 bg-slate-50 relative border-b border-slate-200/50">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12">
            <span class="text-indigo-600 font-extrabold tracking-widest text-xs uppercase block mb-1">Methodology</span>
            <h2 class="text-3xl font-black text-slate-900 tracking-tight">The Perfect Learning Loop</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            {% for step in [
                ('1', 'Diagnose', 'Take AI-powered MCQ tests to map your knowledge gaps.', 'text-blue-600', 'bg-blue-50/50 border-blue-100'),
                ('2', 'Learn', 'Watch 5-minute video lessons curated for your weak concepts.', 'text-purple-600', 'bg-purple-50/50 border-purple-100'),
                ('3', 'Master', 'Retest on your weak areas. Score 80%+ to unlock mastery badges.', 'text-indigo-600', 'bg-indigo-50/50 border-indigo-100'),
                ('4', 'Earn', 'Apply your verified skills on real-world tasks and earn direct payouts.', 'text-emerald-600', 'bg-emerald-50/50 border-emerald-100'),
            ] %}
            <div class="card-hover bg-white border border-slate-200/60 rounded-2xl p-6 relative overflow-hidden group">
                <div class="absolute -right-3 -top-3 text-7xl font-black text-slate-50 opacity-60 group-hover:scale-105 transition-transform duration-500">{{ step[0] }}</div>
                <div class="relative z-10 flex flex-col h-full">
                    <div class="w-12 h-12 {{ step[4] }} {{ step[3] }} border rounded-xl flex items-center justify-center font-black mb-4 shadow-sm">
                        {{ step[0] }}
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">{{ step[1] }}</h3>
                    <p class="text-slate-500 text-sm leading-relaxed border-t border-slate-100 pt-2 mt-auto">{{ step[2] }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Stats Banner -->
<section class="py-12 bg-indigo-900 text-white relative border-y border-indigo-800/50">
    <div class="max-w-5xl mx-auto px-4 relative z-10 text-center">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-indigo-800/80">
            <div class="pt-4 md:pt-0">
                <p class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-teal-300 mb-1">₹5K+</p>
                <p class="text-indigo-200/80 font-bold text-xs tracking-widest uppercase">Top Earner</p>
            </div>
            <div class="pt-4 md:pt-0">
                <p class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-indigo-300 mb-1">80%</p>
                <p class="text-indigo-200/80 font-bold text-xs tracking-widest uppercase">Pass Required</p>
            </div>
            <div class="pt-4 md:pt-0">
                <p class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-300 to-pink-300 mb-1">24h</p>
                <p class="text-indigo-200/80 font-bold text-xs tracking-widest uppercase">Avg Payout Time</p>
            </div>
        </div>
    </div>
</section>

<!-- Trending Topics -->
<section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex justify-between items-end mb-8 border-b border-slate-100 pb-4">
            <div>
                <span class="text-indigo-600 font-extrabold tracking-widest text-xs uppercase block mb-1">Premium Topics</span>
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Available Skill Paths</h2>
            </div>
            <a href="{{ url('assessment:index') }}" class="text-indigo-600 font-bold text-sm flex items-center gap-1 hover:text-indigo-800 group">
                All Paths <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {% for skill in [
                ('🚀', 'Digital Marketing', 'SEO, SMM, Copy', true),
                ('🏛️', 'SSC Exams', 'CGL, CHSL, MTS', true),
                ('💰', 'Banking', 'IBPS, SBI PO', true),
                ('🚆', 'Railway', 'RRB NTPC, Group D', true),
            ] %}
            <div class="group border border-slate-200 rounded-2xl p-5 card-hover flex flex-col text-left">
                <div class="w-12 h-12 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center text-xl mb-4 group-hover:scale-110 shadow-sm transition-transform">
                    {{ skill[0] }}
                </div>
                <h3 class="font-bold text-slate-900 mb-1">{{ skill[1] }}</h3>
                <p class="text-slate-500 text-xs mb-4 flex-grow">{{ skill[2] }}</p>
                
                {% if skill[3] %}
                <a href="{{ url('assessment:index') }}" class="w-full text-center bg-indigo-50/50 text-indigo-700 text-xs font-bold py-2 rounded-lg hover:bg-indigo-600 hover:text-white border border-indigo-100 hover:border-indigo-600 transition-all">
                    Start Path
                </a>
                {% else %}
                <span class="w-full text-center bg-slate-50 text-slate-400 text-xs font-bold py-2 rounded-lg border border-slate-200 cursor-not-allowed">
                    Coming Soon
                </span>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="py-16 bg-slate-900 text-center px-4">
    <div class="max-w-2xl mx-auto">
        <h2 class="text-4xl font-black text-white mb-4 tracking-tight">Stop Scrolling. <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">Start Earning.</span></h2>
        <p class="text-sm text-slate-400 mb-8 font-medium">Join the fastest growing community turning knowledge into direct financial rewards.</p>
        <a href="{{ url('users:signup') }}"
           class="bg-white text-slate-900 text-sm font-bold px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors shadow-lg">
            Create Free Account
        </a>
    </div>
</section>
{% endblock %}
