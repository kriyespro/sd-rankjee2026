{% extends "base.jinja" %}
{% block title %}Course cart - RankJee{% endblock %}
{% block extra_head %}
<style>
    .cart-summary {
        border-color: color-mix(in srgb, var(--rj-navy) 18%, #c7d2fe);
        background: linear-gradient(135deg, color-mix(in srgb, var(--rj-navy) 8%, #fff) 0%, #fff 65%);
    }
</style>
{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto px-4 py-8 md:py-10">
    {% include "partials/_breadcrumb.jinja" %}
    <h1 class="mt-4 text-2xl md:text-3xl font-black text-slate-900">Your Course Cart</h1>
    <p class="mt-2 text-sm text-slate-600">Review selected courses and complete secure checkout with Razorpay (UPI, cards, wallets).</p>

    {% if payment_dummy %}
    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900">
        Dummy checkout — simulate payment without live Razorpay keys.
    </div>
    {% endif %}

    {% if cart_has_referral_savings %}
    <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-900 leading-relaxed">
        Referral pricing applied on eligible courses — <strong>{{ referral_lead_discount_pct }}% off</strong> list price where you enrolled with a referrer link.
    </div>
    {% endif %}

    {% if not cart_courses %}
    <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-8 text-center text-slate-600">
        Your cart is empty. <a href="{{ url('core:courses') }}" class="font-black text-indigo-700 hover:underline">Browse courses</a>
    </div>
    {% else %}
    <div class="mt-6 grid gap-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-slate-500">
                <span>Items in cart</span>
                <span>{{ cart_courses|length }} course{{ '' if cart_courses|length == 1 else 's' }}</span>
            </div>
        </div>
    </div>
    <ul class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white shadow-sm">
        {% for c in cart_courses %}
        <li class="flex flex-wrap items-center justify-between gap-3 p-3 md:p-4">
            <div class="flex items-center gap-3">
                {% if c.thumbnail_url %}
                <a href="{{ url('core:course_detail', c.slug) }}" class="block">
                    <img src="{{ c.thumbnail_url }}" alt="{{ c.title }}" class="h-12 w-16 md:h-14 md:w-20 rounded-lg object-cover border border-slate-200">
                </a>
                {% endif %}
                <div>
                <p class="font-black text-slate-900">
                    <a href="{{ url('core:course_detail', c.slug) }}" class="rj-link-accent transition-colors">{{ c.title }}</a>
                </p>
                <p class="text-xs text-slate-500">{{ c.duration_weeks }} weeks · {{ c.level or 'All levels' }}</p>
                </div>
            </div>
            <div class="flex flex-col items-end gap-0.5 text-right">
                {% set pay_p = cart_unit_prices.get(c.id, c.price_inr) %}
                {% set list_p = c.price_inr %}
                {% if pay_p < list_p %}
                <span class="text-xs font-bold text-slate-400 line-through">₹{{ list_p }}</span>
                <span class="font-black text-emerald-700 text-base">₹{{ pay_p }}</span>
                <span class="text-[10px] font-black uppercase tracking-wide text-emerald-700">{{ referral_lead_discount_pct }}% referral off</span>
                {% else %}
                <span class="font-black text-emerald-700">₹{{ list_p }}</span>
                {% endif %}
                <form method="post" action="{{ url('core:course_cart_remove', c.id) }}">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    <button type="submit" class="text-xs font-black uppercase tracking-wider text-rose-600 hover:text-rose-500">Remove</button>
                </form>
            </div>
        </li>
        {% endfor %}
    </ul>

    <div class="cart-summary mt-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border p-4 md:p-5">
        <div>
            <p class="text-xs font-black uppercase tracking-wider text-indigo-700">Order total</p>
            <p class="text-lg font-black text-indigo-900">₹{{ cart_total_inr }}</p>
        </div>
        {% if request.user.is_authenticated %}
        <button type="button" id="course-pay-btn"
                class="rj-cta-primary w-full sm:w-auto px-6 py-3 font-black uppercase text-white">
            Proceed to payment
        </button>
        {% endif %}
    </div>
    {% endif %}
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
function getCookie(name) {
    let v = null;
    if (document.cookie && document.cookie !== '') {
        document.cookie.split(';').forEach(function (c) {
            c = c.trim();
            if (c.startsWith(name + '=')) v = decodeURIComponent(c.slice(name.length + 1));
        });
    }
    return v;
}
async function verifyCoursePayment(payload) {
    const csrftoken = getCookie('csrftoken');
    const body = new URLSearchParams(payload);
    const resp = await fetch('{{ url("core:course_checkout_verify") }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRFToken': csrftoken || '',
        },
        credentials: 'same-origin',
        body: body,
    });
    let data;
    try {
        data = await resp.json();
    } catch (e) {
        alert('Invalid server response after payment.');
        return;
    }
    if (data.status === 'success') {
        window.location.href = '{{ checkout_success_url }}';
    } else {
        alert(data.error || 'Verification failed');
    }
}
async function startCourseCheckout() {
    const csrftoken = getCookie('csrftoken');
    const resp = await fetch('{{ url("core:course_checkout_create") }}', {
        method: 'POST',
        headers: { 'X-CSRFToken': csrftoken || '' },
        credentials: 'same-origin',
    });
    let data;
    try {
        data = await resp.json();
    } catch (e) {
        alert('Could not start checkout.');
        return;
    }
    if (data.error) {
        alert(data.error);
        return;
    }
    if (data.checkout_mode === 'free') {
        window.location.href = data.redirect || '{{ checkout_success_url }}';
        return;
    }
    if (data.checkout_mode === 'dummy') {
        if (!confirm('Simulate successful payment for these courses?')) return;
        await verifyCoursePayment({
            razorpay_order_id: data.order_id,
            razorpay_payment_id: 'pay_dummy_' + Date.now(),
            razorpay_signature: 'dummy',
        });
        return;
    }
    const options = {
        key: data.key,
        amount: data.amount,
        currency: 'INR',
        name: data.name || 'RankJee Courses',
        description: data.description || 'Courses',
        order_id: data.order_id,
        handler: async function (response) {
            await verifyCoursePayment({
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_signature: response.razorpay_signature,
            });
        },
        modal: { ondismiss: function () {} },
        prefill: { name: data.user_name, email: data.user_email },
        theme: { color: '#4F46E5' },
    };
    const rzp = new Razorpay(options);
    rzp.on('payment.failed', function (resp) {
        const desc = (resp.error && resp.error.description) ? resp.error.description : 'Payment failed';
        alert(desc);
    });
    rzp.open();
}
document.getElementById('course-pay-btn')?.addEventListener('click', startCourseCheckout);
</script>
{% endblock %}
