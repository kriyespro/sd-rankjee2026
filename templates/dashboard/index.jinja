{% extends "base.jinja" %}
{% block title %}Dashboard - SkillLoop{% endblock %}
{% block content %}
<div class="max-w-6xl mx-auto flex flex-col gap-5 py-6 px-4">
    {# Large Recharge Hero #}
    <div class="bg-gradient-to-br from-indigo-700 via-violet-800 to-fuchsia-900 rounded-2xl p-6 shadow-xl shadow-indigo-100/50 flex flex-col md:flex-row justify-between items-center text-white gap-6 border-4 border-white overflow-hidden relative group">
        <!-- Abstract background elements -->
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-3xl transition-transform group-hover:scale-150 duration-700"></div>
        <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-white/5 rounded-full blur-3xl"></div>
        
        <div class="relative z-10 flex flex-col items-center md:items-start text-center md:text-left">
            <div class="flex items-center gap-2 mb-2">
                <span class="bg-emerald-500/20 text-emerald-300 text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-full border border-emerald-500/30">Wallet Status</span>
                <span class="text-white/40 font-mono text-xs">ID: {{ user.pk|string|truncate(4, True, '') }}...</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-black mb-2 tracking-tight">Need More Credits? <span class="text-emerald-400">⚡</span></h2>
            <p class="text-indigo-100 text-sm md:text-base max-w-md font-medium">Recharge your wallet to unlock premium tests and high-paying earning tasks instantly.</p>
        </div>

        <div class="relative z-10 flex flex-col items-center gap-4 bg-white/10 p-5 rounded-xl border border-white/20 backdrop-blur-sm min-w-[200px]">
            <div class="text-center">
                <p class="text-[10px] uppercase tracking-widest font-black text-white/50 mb-1">Your Balance</p>
                <p class="text-4xl font-black text-white">₹{{ user.wallet_balance }}</p>
            </div>
            <form action="{{ url('dashboard:recharge') }}" method="POST" class="w-full">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <button type="submit" class="w-full bg-white text-indigo-900 hover:bg-emerald-50 Transition-all py-3 px-6 rounded-lg font-black text-sm shadow-lg hover:shadow-emerald-500/20 active:scale-95 flex items-center justify-center gap-2 group/btn">
                    <span>ADD ₹100 NOW</span>
                    <span class="group-hover/btn:translate-x-1 group-hover/btn:scale-110 transition-transform">🚀</span>
                </button>
            </form>
        </div>
    </div>

    {# Header #}
    <div class="flex justify-between items-center flex-wrap gap-3 pb-4 border-b border-slate-200">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Hi, {{ user.username }} 👋</h1>
            <p class="text-slate-500 text-sm font-medium">Your learning and earning command center.</p>
        </div>
        <div class="flex items-center gap-3">
            {% if user.streak_days > 0 %}
            <div class="flex items-center gap-1 bg-orange-50 border border-orange-200 text-orange-600 px-2.5 py-1.5 rounded-md text-xs font-bold shadow-sm">
                🔥 {{ user.streak_days }} Day Streak
            </div>
            {% endif %}
            
            <a href="{{ url('dashboard:notifications') }}" class="relative inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 rounded-md text-slate-600 hover:text-indigo-600 hover:border-indigo-300 transition-colors shadow-sm text-sm font-medium">
                Notifications
                {% if unread_notifications > 0 %}
                <span class="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-[10px] w-4 h-4 flex items-center justify-center rounded-full font-bold shadow-sm ring-2 ring-white">{{ unread_notifications }}</span>
                {% endif %}
            </a>
            <a href="{{ url('users:profile') }}" class="px-3 py-1.5 bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200 rounded-md text-sm font-bold transition-colors">Profile</a>
        </div>
    </div>

    {# Compact Stats Row #}
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
        <!-- Balance -->
        <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-sm flex flex-col hover:border-emerald-300 transition-colors">
            <div class="flex justify-between items-start mb-1">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider">Wallet Balance</span>
                <span class="text-emerald-500 bg-emerald-50 p-1 rounded">💰</span>
            </div>
            <p class="text-2xl font-black text-slate-800">₹{{ user.wallet_balance }}</p>
            <div class="flex items-center gap-2 mt-auto pt-2">
                <a href="{{ url('core:earnings') }}" class="text-[10px] text-emerald-600 hover:text-emerald-800 font-bold uppercase tracking-wider flex items-center gap-1 group">Earn More <span class="group-hover:translate-x-0.5 transition-transform">→</span></a>
                <span class="text-slate-200">|</span>
                <form action="{{ url('dashboard:recharge') }}" method="POST" class="inline">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    <button type="submit" class="text-[10px] text-indigo-600 hover:text-indigo-800 font-bold uppercase tracking-wider flex items-center gap-0.5 group">
                        Recharge <span class="group-hover:scale-110 transition-transform">⚡</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Trials -->
        <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-sm flex flex-col hover:border-pink-300 transition-colors">
            <div class="flex justify-between items-start mb-1">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider">Test Trials</span>
                <span class="text-pink-500 bg-pink-50 p-1 rounded">🧪</span>
            </div>
            <p class="text-2xl font-black text-slate-800">{{ user.trial_tests_left }}</p>
            <div class="mt-auto pt-2">
                {% if user.trial_tests_left > 0 %}
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Free uses left</span>
                {% else %}
                    <span class="text-[10px] font-bold text-rose-500 uppercase tracking-wider">Costs ₹10/test</span>
                {% endif %}
            </div>
        </div>

        <!-- XP Points -->
        <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-sm flex flex-col hover:border-indigo-300 transition-colors">
            <div class="flex justify-between items-start mb-1">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider">XP Points</span>
                <span class="text-indigo-500 bg-indigo-50 p-1 rounded">⭐</span>
            </div>
            <p class="text-2xl font-black text-slate-800">{{ user.xp_points }}</p>
            <a href="{{ url('dashboard:leaderboard') }}" class="mt-auto pt-2 text-[10px] text-indigo-600 hover:text-indigo-800 font-bold uppercase tracking-wider flex items-center gap-1 group">Leaderboard <span class="group-hover:translate-x-0.5 transition-transform">→</span></a>
        </div>

        <!-- Completion -->
        <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-sm flex flex-col hidden md:flex hover:border-blue-300 transition-colors">
            <div class="flex justify-between items-start mb-1">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider">Completion</span>
                <span class="text-blue-500 bg-blue-50 p-1 rounded">📈</span>
            </div>
            <p class="text-2xl font-black text-slate-800">{{ progress }}%</p>
            <div class="mt-auto pt-2">
                <div class="bg-slate-100 rounded-full h-1.5 w-full overflow-hidden">
                    <div class="bg-blue-500 h-1.5 rounded-full" style="width: {{ progress }}%"></div>
                </div>
            </div>
        </div>

        <!-- Weak Areas -->
        <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-sm flex flex-col hover:border-rose-300 transition-colors">
            <div class="flex justify-between items-start mb-1">
                <span class="text-slate-500 text-[10px] font-bold uppercase tracking-wider">Weak Areas</span>
                <span class="text-rose-500 bg-rose-50 p-1 rounded">🎯</span>
            </div>
            {% if weak_areas %}
                <p class="text-2xl font-black text-rose-600">{{ weak_areas|length }}</p>
                <a href="{{ url('learning:index') }}" class="mt-auto pt-2 text-[10px] text-rose-600 hover:text-rose-800 font-bold uppercase tracking-wider flex items-center gap-1 group">Study Now <span class="group-hover:translate-x-0.5 transition-transform">→</span></a>
            {% else %}
                <p class="text-2xl font-black text-emerald-600">0</p>
                <p class="mt-auto pt-2 text-[10px] font-bold text-emerald-600 uppercase tracking-wider">All Clear! 🎉</p>
            {% endif %}
        </div>
    </div>

    {# Student Learning Ladder Board #}
    <div class="bg-indigo-50/50 p-6 rounded-2xl border border-indigo-100 shadow-sm">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
            <div class="w-full">
                <h2 class="text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                    <span class="p-2 bg-indigo-600 text-white rounded-lg shadow-lg shadow-indigo-200">🚀</span>
                    Your Learning Journey
                </h2>
                <p class="text-slate-500 text-xs font-medium mt-1 uppercase tracking-wider">Pass each topic with 80% to unlock the next level.</p>
                
                {# Path Tabs #}
                <div class="flex flex-wrap gap-2 mt-5">
                    {% for path in all_paths %}
                        <a href="?path={{ path.id }}" 
                           class="px-4 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all border-2 {{ 'bg-indigo-600 text-white border-indigo-600 shadow-lg shadow-indigo-100' if selected_path.id == path.id else 'bg-white text-slate-400 border-slate-100 hover:border-indigo-200 hover:text-indigo-500' }}">
                            {{ path.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
            <div class="flex items-center gap-4 bg-white px-4 py-2 rounded-xl border border-indigo-100 shadow-sm whitespace-nowrap">
                <div class="text-center border-r border-indigo-50 pr-4">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Selected Goal</p>
                    <p class="text-xs font-black text-indigo-600 truncate max-w-[100px]">{{ selected_path.name }}</p>
                </div>
                <div class="text-center">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Levels</p>
                    <p class="text-lg font-black text-slate-800">{{ learning_path|length }}</p>
                </div>
            </div>
        </div>

        {% include "dashboard/components/progress_table.jinja" %}
    </div>

    {# Main Grid Layout (2 cols left, 1 col right) #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

        <div class="lg:col-span-2 flex flex-col gap-5">
            {# Quick Actions #}
            <div class="bg-white rounded-lg border border-slate-200 shadow-sm p-4">
                <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-3 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> Quick Actions</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <a href="{{ url('assessment:index') }}" class="group flex items-start gap-3 p-3 border border-slate-100 bg-slate-50 rounded-lg hover:bg-white hover:border-indigo-200 hover:shadow-sm transition-all">
                        <div class="bg-indigo-100 text-indigo-600 p-2 rounded-md group-hover:scale-110 transition-transform">🧪</div>
                        <div>
                            <p class="font-bold text-sm text-slate-800 group-hover:text-indigo-700 transition-colors">Take Diagnostic Test</p>
                            <p class="text-xs text-slate-500 font-medium leading-snug">Discover hidden weak areas</p>
                        </div>
                    </a>
                    <a href="{{ url('learning:index') }}" class="group flex items-start gap-3 p-3 border border-slate-100 bg-slate-50 rounded-lg hover:bg-white hover:border-purple-200 hover:shadow-sm transition-all">
                        <div class="bg-purple-100 text-purple-600 p-2 rounded-md group-hover:scale-110 transition-transform">📚</div>
                        <div>
                            <p class="font-bold text-sm text-slate-800 group-hover:text-purple-700 transition-colors">Start Learning</p>
                            <p class="text-xs text-slate-500 font-medium leading-snug">Watch curated micro-lessons</p>
                        </div>
                    </a>
                    <a href="{{ url('core:earnings') }}" class="group flex items-start gap-3 p-3 border border-slate-100 bg-slate-50 rounded-lg hover:bg-white hover:border-emerald-200 hover:shadow-sm transition-all">
                        <div class="bg-emerald-100 text-emerald-600 p-2 rounded-md group-hover:scale-110 transition-transform">💰</div>
                        <div>
                            <p class="font-bold text-sm text-slate-800 group-hover:text-emerald-700 transition-colors">Task Marketplace</p>
                            <p class="text-xs text-slate-500 font-medium leading-snug">Submit proof, get payouts</p>
                        </div>
                    </a>
                    <a href="{{ url('dashboard:leaderboard') }}" class="group flex items-start gap-3 p-3 border border-slate-100 bg-slate-50 rounded-lg hover:bg-white hover:border-amber-200 hover:shadow-sm transition-all">
                        <div class="bg-amber-100 text-amber-600 p-2 rounded-md group-hover:scale-110 transition-transform">🏆</div>
                        <div>
                            <p class="font-bold text-sm text-slate-800 group-hover:text-amber-700 transition-colors">Leaderboard Ranking</p>
                            <p class="text-xs text-slate-500 font-medium leading-snug">Track your XP globally</p>
                        </div>
                    </a>
                </div>
            </div>

            {# Badges Panel #}
            <div class="bg-white rounded-lg border border-slate-200 shadow-sm p-4">
                <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-3 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span> Mastery Badges</h2>
                {% if user_badges %}
                    <div class="flex flex-wrap gap-2">
                    {% for ub in user_badges %}
                        <div class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold pl-2 pr-3 py-1.5 rounded-md hover:bg-white hover:border-slate-300 transition-colors cursor-help group relative" title="{{ ub.badge.description }}">
                            <span class="text-base drop-shadow-sm group-hover:scale-110 transition-transform">{{ ub.badge.icon }}</span> 
                            {{ ub.badge.title }}
                        </div>
                    {% endfor %}
                    </div>
                {% else %}
                    <div class="bg-slate-50 border border-slate-100 rounded-md p-4 text-center">
                        <p class="text-slate-400 text-xs font-semibold mb-2">Your badge collection is empty.</p>
                        <a href="{{ url('assessment:index') }}" class="text-indigo-600 hover:text-indigo-700 text-xs font-bold inline-flex items-center gap-1">Take a test to earn <span aria-hidden="true">&rarr;</span></a>
                    </div>
                {% endif %}
            </div>
            
            {# Referral Banner - Compact #}
            <div class="bg-gradient-to-r from-slate-900 via-indigo-900 to-indigo-800 rounded-lg p-4 text-white shadow-lg flex flex-col sm:flex-row justify-between items-center gap-4">
                <div>
                    <h2 class="text-sm font-black mb-0.5 flex items-center gap-2">🤝 Refer & Earn Instantly</h2>
                    <p class="text-indigo-200 text-xs font-medium">Get +₹50 and +20 XP for every successful signup.</p>
                </div>
                <div class="flex items-center gap-2">
                    <code class="bg-black/30 px-3 py-1.5 rounded-md font-mono font-bold text-sm tracking-widest text-indigo-100 border border-white/10">{{ user.referral_code }}</code>
                    <button onclick="navigator.clipboard.writeText('{{ request.scheme }}://{{ request.get_host() }}/users/signup/?ref={{ user.referral_code }}'); let o = this.innerHTML; this.innerHTML='<span class=\'text-emerald-400\'>✓ Copied</span>'; setTimeout(()=>this.innerHTML=o,2000)"
                        class="bg-white/10 text-white text-xs font-bold px-3 py-1.5 rounded-md hover:bg-white/20 border border-white/20 transition-all whitespace-nowrap">
                        Copy Link
                    </button>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-5">
            {# Latest Test Result #}
            <div class="bg-white rounded-lg border border-slate-200 shadow-sm p-4 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50 rounded-full blur-3xl -mr-16 -mt-16 z-0"></div>
                <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-4 flex items-center gap-2 relative z-10"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Recent Test</h2>
                
                {% if latest_attempt %}
                    <div class="text-center relative z-10 border border-slate-100 bg-slate-50/50 rounded-lg p-5">
                        <p class="text-slate-500 text-xs font-bold uppercase tracking-wider truncate mb-2">{{ latest_attempt.skill.name }}</p>
                        <p class="text-5xl font-black mb-1 {% if latest_attempt.passed %}text-emerald-500{% else %}text-rose-500{% endif %}">{{ latest_attempt.score }}%</p>
                        <div class="inline-flex items-center gap-1.5 bg-white px-2.5 py-1 rounded-full border border-slate-200 shadow-sm text-xs font-bold {% if latest_attempt.passed %}text-emerald-600{% else %}text-rose-600{% endif %}">
                            {% if latest_attempt.passed %}
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Passed
                            {% else %}
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span> Needs ≥ 80%
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="text-center py-6 bg-slate-50 border border-slate-100 rounded-lg relative z-10">
                        <p class="text-slate-400 text-xs font-semibold mb-2">No tests taken.</p>
                        <a href="{{ url('assessment:index') }}" class="text-indigo-600 text-xs font-bold hover:underline">Start Assessment &rarr;</a>
                    </div>
                {% endif %}
            </div>

            {# Mini Leaderboard #}
            <div class="bg-white rounded-lg border border-slate-200 shadow-sm p-4 flex flex-col flex-grow">
                <div class="flex justify-between items-center mb-3">
                    <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Top Earners</h2>
                    <a href="{{ url('dashboard:leaderboard') }}" class="text-[10px] uppercase tracking-wider font-bold text-indigo-500 hover:text-indigo-700 transition-colors">View All</a>
                </div>
                <div class="flex flex-col gap-2">
                {% for u in top_users %}
                    <div class="flex items-center justify-between p-2 rounded-md transition-colors {% if u.pk == user.pk %}bg-indigo-50 border border-indigo-100{% else %}bg-slate-50 border border-slate-100 hover:border-slate-300{% endif %}">
                        <div class="flex items-center gap-2.5">
                            <span class="text-xs font-black w-4 text-center {% if loop.index == 1 %}text-amber-500{% elif loop.index == 2 %}text-slate-400{% elif loop.index == 3 %}text-amber-700{% else %}text-slate-300{% endif %}">{{ loop.index }}</span>
                            <span class="font-bold text-xs {% if u.pk == user.pk %}text-indigo-700{% else %}text-slate-700{% endif %} truncate max-w-[100px]">
                                {{ u.username }}{% if u.pk == user.pk %} <span class="text-[9px] text-indigo-400 uppercase tracking-wider ml-1">(You)</span>{% endif %}
                            </span>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-wider {% if u.pk == user.pk %}text-indigo-600{% else %}text-slate-500{% endif %} bg-white px-2 py-0.5 rounded shadow-sm">{{ u.xp_points }} XP</span>
                    </div>
                {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
