{% extends "base.jinja" %}
{% block title %}Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 pb-10 pt-6 sm:px-6">

    {% include "dashboard/partials/_user_identity_bar.jinja" %}

    {% if server_buy_success %}
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-900" role="status">
        {{ server_buy_success_message }}
    </div>
    {% endif %}

    {# ── Stats strip ─────────────────────────────────────────────────────── #}
    {% set kpi_cards = role_stat_cards %}
    {% include "dashboard/partials/_dash_kpi_strip.jinja" %}

    {# ── TODAY'S FOCUS — 3-column priority row ────────────────────────────── #}
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">

        {# Col 1: Pending LMS assignments — what student must do NOW #}
        <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-4">
            <div class="mb-3 flex items-center justify-between">
                <p class="text-[10px] font-black uppercase tracking-wider text-amber-800">Pending assignments</p>
                {% if lms_pending_assignments %}
                <span class="rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-black text-white">{{ lms_pending_assignments|length }}</span>
                {% endif %}
            </div>
            {% if lms_pending_assignments %}
            <div class="space-y-2">
                {% for asgn in lms_pending_assignments[:5] %}
                <a href="{{ url('lms:assignment_detail', pk=asgn.pk) }}"
                   class="flex items-start justify-between gap-2 rounded-lg border border-amber-100 bg-white p-2.5 hover:border-amber-300 hover:bg-amber-50 transition-colors">
                    <div class="min-w-0">
                        <p class="text-sm font-black text-slate-900 truncate">{{ asgn.title }}</p>
                        <p class="text-[10px] font-semibold text-slate-500 truncate">
                            {{ asgn.course.name }}{% if asgn.topic %} · {{ asgn.topic.title }}{% endif %}
                        </p>
                    </div>
                    <span class="shrink-0 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-black uppercase text-amber-800">Submit</span>
                </a>
                {% endfor %}
                {% if lms_pending_assignments|length > 5 %}
                <a href="{{ url('lms:home') }}" class="block text-center text-[11px] font-black uppercase tracking-wider text-amber-800 underline">
                    +{{ lms_pending_assignments|length - 5 }} more
                </a>
                {% endif %}
            </div>
            {% elif lms_enrolled_courses %}
            <div class="flex flex-col items-center justify-center py-6">
                <span class="text-2xl mb-1">✅</span>
                <p class="text-xs font-bold text-emerald-700">All caught up!</p>
                <p class="text-[11px] text-slate-500 text-center mt-0.5">No pending assignments.</p>
            </div>
            {% else %}
            <div class="flex flex-col items-center justify-center py-6">
                <span class="text-2xl mb-1">📚</span>
                <p class="text-xs font-bold text-slate-600">No LMS courses yet</p>
                <p class="text-[11px] text-slate-400 text-center mt-0.5">Your faculty will enroll you soon.</p>
            </div>
            {% endif %}
        </div>

        {# Col 2: Last test score + skill progress #}
        <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="mb-3 flex items-center justify-between">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Last test</p>
                <a href="{{ url('assessment:index') }}" class="rounded-md bg-slate-900 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-white hover:bg-slate-700">Take test</a>
            </div>
            {% if latest_attempt %}
            <div class="mb-3 flex items-end gap-3">
                <p class="text-5xl font-black tabular-nums leading-none {{ 'text-emerald-600' if latest_attempt.passed else 'text-rose-600' }}">
                    {{ latest_attempt.score }}<span class="text-xl text-slate-400">%</span>
                </p>
                <div class="pb-1">
                    <p class="text-sm font-black text-slate-900">{{ latest_attempt.skill.name if latest_attempt.skill else '—' }}</p>
                    <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-black uppercase {{ 'bg-emerald-50 text-emerald-700' if latest_attempt.passed else 'bg-rose-50 text-rose-700' }}">
                        {{ 'Passed' if latest_attempt.passed else 'Need retry' }}
                    </span>
                </div>
            </div>
            {% else %}
            <div class="flex flex-col items-center justify-center py-4">
                <p class="text-xs font-bold text-slate-400">No test taken yet</p>
            </div>
            {% endif %}
            <div class="border-t border-slate-100 pt-3">
                <div class="flex items-center justify-between">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Overall mastery</p>
                    <p class="text-sm font-black text-slate-900">{{ progress }}%</p>
                </div>
                <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                    <div class="h-full rounded-full bg-indigo-500 transition-all" style="width:{{ progress }}%"></div>
                </div>
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
                <a href="{{ url('assessment:index') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Tests</a>
                <a href="{{ url('learning:index') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Videos</a>
                <a href="{{ url('dashboard:leaderboard') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Rank #{{ xp_rank_india }}</a>
            </div>
        </div>

        {# Col 3: Streak + notifications + quick links #}
        <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="mb-3 flex items-center justify-between">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Quick links</p>
                {% if unread_notifications > 0 %}
                <a href="{{ url('dashboard:notifications') }}" class="flex items-center gap-1 rounded-full bg-rose-100 px-2 py-0.5 text-[10px] font-black text-rose-800 hover:bg-rose-200">
                    {{ unread_notifications }} new
                </a>
                {% endif %}
            </div>

            <div class="mb-4 flex items-center gap-3 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2.5">
                <span class="text-xl">🔥</span>
                <div>
                    <p class="text-xs font-black text-slate-900">{{ user.streak_days }}-day streak</p>
                    <p class="text-[10px] text-slate-500">Keep it going — study daily</p>
                </div>
            </div>

            <div class="space-y-1.5">
                {% if lms_enrolled_courses %}
                <a href="{{ url('lms:home') }}" class="flex items-center justify-between rounded-lg border border-indigo-100 bg-indigo-50 px-3 py-2 hover:bg-indigo-100 transition-colors">
                    <span class="text-[11px] font-black uppercase tracking-wider text-indigo-800">My LMS workspace</span>
                    <span class="text-indigo-400 text-xs">→</span>
                </a>
                {% endif %}
                <a href="{{ url('dashboard:study') }}" class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 hover:bg-slate-100 transition-colors">
                    <span class="text-[11px] font-black uppercase tracking-wider text-slate-800">Study notes</span>
                    <span class="text-slate-400 text-xs">→</span>
                </a>
                <a href="{{ url('assessment:index') }}" class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 hover:bg-slate-100 transition-colors">
                    <span class="text-[11px] font-black uppercase tracking-wider text-slate-800">Practice tests</span>
                    <span class="text-slate-400 text-xs">→</span>
                </a>
                <a href="{{ url('learning:index') }}" class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 hover:bg-slate-100 transition-colors">
                    <span class="text-[11px] font-black uppercase tracking-wider text-slate-800">Video lessons</span>
                    <span class="text-slate-400 text-xs">→</span>
                </a>
                <a href="{{ url('hometutor:my_demo_requests') }}" class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 hover:bg-slate-100 transition-colors">
                    <span class="text-[11px] font-black uppercase tracking-wider text-slate-800">My demos{% if hometutor_my_pending_sent %} ({{ hometutor_my_pending_sent }}){% endif %}</span>
                    <span class="text-slate-400 text-xs">→</span>
                </a>
                <a href="{{ url('core:earnings') }}" class="flex items-center justify-between rounded-lg border border-emerald-100 bg-emerald-50 px-3 py-2 hover:bg-emerald-100 transition-colors">
                    <span class="text-[11px] font-black uppercase tracking-wider text-emerald-800">Earn rewards</span>
                    <span class="text-emerald-400 text-xs">→</span>
                </a>
                {% if user.show_server_buy_button %}
                <a href="{{ url('server_buy:checkout') }}" class="flex items-center justify-between rounded-lg border border-violet-100 bg-violet-50 px-3 py-2 hover:bg-violet-100 transition-colors">
                    <span class="text-[11px] font-black uppercase tracking-wider text-violet-800">Server buy</span>
                    <span class="text-violet-400 text-xs">→</span>
                </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── MY LMS COURSES ────────────────────────────────────────────────────── #}
    {% if lms_enrolled_courses %}
    <section class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4 shadow-sm md:p-5">
        <div class="mb-4 flex items-center justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-700">LMS</p>
                <h2 class="text-lg font-black tracking-tight text-slate-900">My Courses</h2>
            </div>
            <a href="{{ url('lms:home') }}" class="inline-flex items-center rounded-xl border border-indigo-200 bg-white px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-50">
                Open LMS →
            </a>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {% for course in lms_enrolled_courses %}
            {% set ns = namespace(pending=0) %}
            {% for asgn in lms_pending_assignments %}{% if asgn.course_id == course.pk %}{% set ns.pending = ns.pending + 1 %}{% endif %}{% endfor %}
            <a href="{{ url('lms:home') }}" class="group flex flex-col gap-2 rounded-xl border border-indigo-100 bg-white p-4 shadow-sm hover:border-indigo-300 hover:shadow-md transition-all">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                        <p class="text-sm font-black text-slate-900 leading-snug">{{ course.name }}</p>
                        {% if course.owner %}
                        <p class="mt-0.5 text-[10px] font-semibold text-slate-500">Faculty: {{ course.owner.get_full_name() or course.owner.username }}</p>
                        {% endif %}
                    </div>
                    <span class="shrink-0 flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-100 text-base">📖</span>
                </div>
                <div class="flex flex-wrap gap-1.5 border-t border-slate-100 pt-2">
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-black text-slate-600">
                        {{ course.assignment_count }} assignment{{ 's' if course.assignment_count != 1 else '' }}
                    </span>
                    {% if ns.pending %}
                    <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-black text-amber-800">
                        {{ ns.pending }} pending
                    </span>
                    {% else %}
                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-black text-emerald-700">
                        All done ✓
                    </span>
                    {% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── RECENT GRADES & FACULTY FEEDBACK ──────────────────────────────────── #}
    {% if lms_recent_feedback %}
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
        <div class="mb-4 flex items-center justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">LMS feedback</p>
                <h2 class="text-base font-black tracking-tight text-slate-900">Recent grades & faculty remarks</h2>
            </div>
            <a href="{{ url('lms:home') }}" class="text-[11px] font-black uppercase tracking-wider text-indigo-600 hover:underline">See all →</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {% for sub in lms_recent_feedback %}
            <a href="{{ url('lms:assignment_detail', pk=sub.assignment_id) }}#sub-{{ sub.pk }}"
               class="flex flex-col gap-1.5 rounded-xl border p-3 hover:shadow-sm transition-shadow
               {{ 'border-emerald-200 bg-emerald-50/60' if sub.status == 'APPROVED' else ('border-amber-200 bg-amber-50/60' if sub.status == 'CHANGES_REQUESTED' else 'border-slate-200 bg-slate-50') }}">
                <div class="flex items-start justify-between gap-2">
                    <p class="text-sm font-black text-slate-900 leading-snug truncate">{{ sub.assignment.title }}</p>
                    {% if sub.marks is not none %}
                    <span class="shrink-0 rounded-full px-2 py-0.5 text-sm font-black
                        {{ 'text-emerald-700 bg-emerald-100' if sub.marks >= 70 else ('text-amber-700 bg-amber-100' if sub.marks >= 40 else 'text-rose-700 bg-rose-100') }}">
                        {{ sub.marks }}/100
                    </span>
                    {% endif %}
                </div>
                <p class="text-[10px] font-semibold text-slate-500">{{ sub.assignment.course.name }}</p>
                {% if sub.remark %}
                <p class="text-[11px] text-slate-700 leading-snug line-clamp-2">"{{ sub.remark }}"</p>
                {% endif %}
                <span class="w-fit rounded-md px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider
                    {{ 'bg-emerald-100 text-emerald-700' if sub.status == 'APPROVED' else ('bg-amber-100 text-amber-800' if sub.status == 'CHANGES_REQUESTED' else 'bg-slate-100 text-slate-600') }}">
                    {{ sub.get_status_display() }}
                </span>
            </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── LEARNING JOURNEY (skill path) ────────────────────────────────────── #}
    <section class="rounded-xl border border-indigo-100 bg-indigo-50/50 p-4 shadow-sm md:p-5">
        <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-700">Skills</p>
                <h2 class="text-lg font-black tracking-tight text-slate-900">Learning journey</h2>
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Complete each skill to unlock the next.</p>
            </div>
            <a href="{{ url('assessment:index') }}" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-slate-700">
                Take diagnostic test
            </a>
        </div>

        <div class="mb-4 flex w-fit flex-wrap gap-1 rounded-xl border border-indigo-100 bg-white p-1">
            {% for path in all_paths %}
            <a href="?path={{ path.id }}"
               class="rounded-lg px-3 py-2 text-[11px] font-black uppercase tracking-wider transition-all {{ 'bg-indigo-600 text-white' if (selected_path and selected_path.id == path.id) else 'text-slate-500 hover:text-indigo-600' }}">
                {{ path.name }}
            </a>
            {% endfor %}
        </div>

        {% if learning_path %}
            {% include "dashboard/components/progress_table.jinja" %}
        {% else %}
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center">
            <p class="text-sm font-black text-slate-800 mb-2">No modules yet</p>
            <p class="text-xs text-slate-500">Skills and tests will appear here once added.</p>
        </div>
        {% endif %}
    </section>

    {# ── EXAM HISTORY (compact) ──────────────────────────────────────────── #}
    {% if my_exam_performance_rows %}
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-xs font-black uppercase tracking-wider text-slate-700">Exam history</h2>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-black text-slate-600">Last {{ my_exam_performance_rows|length }}</span>
        </div>
        <div class="space-y-1.5">
            {% for row in my_exam_performance_rows[:6] %}
            {% set attempt = row.attempt %}
            <div class="flex items-center gap-3 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2">
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-black text-slate-900 truncate">{{ attempt.skill.name if attempt.skill else 'General Test' }}</p>
                    <p class="text-[10px] text-slate-500">{{ attempt.attempt_date.strftime('%d %b %Y · %H:%M') }}</p>
                </div>
                <span class="shrink-0 text-sm font-black tabular-nums {{ 'text-emerald-600' if attempt.passed else 'text-rose-600' }}">{{ attempt.score }}%</span>
                <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-black {{ 'bg-emerald-50 text-emerald-700' if attempt.passed else 'bg-rose-50 text-rose-700' }}">{{ 'Pass' if attempt.passed else 'Retry' }}</span>
                {% if not attempt.passed and attempt.skill %}
                <a href="{{ url('assessment:take_test', attempt.skill.id) }}" class="shrink-0 rounded-md border border-indigo-200 bg-indigo-50 px-2 py-1 text-[10px] font-black text-indigo-700 hover:bg-indigo-100">Retry</a>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── WEAK-AREA TUTOR RECOMMENDATIONS ─────────────────────────────────── #}
    {% if weak_topic_tutor_cards %}
    <section class="rounded-xl border border-indigo-100 bg-indigo-50/50 p-4 shadow-sm md:p-5">
        <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-700">Smart match</p>
                <h2 class="text-lg font-black text-slate-900">Tutors for your weak areas</h2>
                {% if weak_terms %}
                <p class="mt-0.5 text-xs text-slate-600">Based on: {{ weak_terms|join(', ') }}</p>
                {% endif %}
            </div>
            <a href="{{ url('assessment:index') }}" class="inline-flex rounded-xl border border-indigo-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Retake diagnostic</a>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
            {% set enable_compare = false %}
            {% set dashboard_mode = true %}
            {% for t in weak_topic_tutor_cards %}
            {% include "hometutor/partials/_tutor_card.jinja" %}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── TUTOR BOOKING — compact two-col ──────────────────────────────────── #}
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

        {# Booking funnel #}
        <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="mb-3 flex items-center justify-between">
                <h2 class="text-xs font-black uppercase tracking-wider text-slate-700">Booking funnel</h2>
                <a href="{{ url('hometutor:my_demo_requests') }}" class="text-[11px] font-black uppercase text-indigo-600 hover:underline">View all →</a>
            </div>
            <div class="grid grid-cols-3 gap-2 mb-3">
                <div class="rounded-lg border border-slate-100 bg-slate-50 p-2.5 text-center">
                    <p class="text-lg font-black tabular-nums text-slate-900">{{ student_demo_pending }}</p>
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Pending</p>
                </div>
                <div class="rounded-lg border border-slate-100 bg-slate-50 p-2.5 text-center">
                    <p class="text-lg font-black tabular-nums text-slate-900">{{ student_active_engagements }}</p>
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Active</p>
                </div>
                <div class="rounded-lg border border-slate-100 bg-slate-50 p-2.5 text-center">
                    <p class="text-lg font-black tabular-nums text-slate-900">{{ student_paid_count }}</p>
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Paid</p>
                </div>
            </div>
            {% if student_recent_engagements %}
            <div class="space-y-2">
                {% for e in student_recent_engagements[:2] %}
                <div class="rounded-lg border border-slate-100 bg-slate-50 p-2.5">
                    <p class="text-sm font-black text-slate-900">{{ e.tutor_profile.display_name }}</p>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">{{ e.get_status_display() }}</p>
                    <div class="mt-1.5 flex gap-1.5">
                        <a href="{{ url('hometutor:engagement_room', pk=e.pk) }}" class="rounded-md border border-indigo-200 bg-indigo-50 px-2 py-1 text-[10px] font-black text-indigo-700 hover:bg-indigo-100">Open room</a>
                        {% if e.pk not in student_paid_engagement_ids and e.status == 'ACTIVE' %}
                        <a href="{{ url('hometutor_payments:pay_checkout', engagement_id=e.pk) }}" class="rounded-md border border-emerald-200 bg-emerald-50 px-2 py-1 text-[10px] font-black text-emerald-700 hover:bg-emerald-100">Pay now</a>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-xs text-slate-500">No active engagements yet.</p>
            {% endif %}
            {% if student_pending_demo_sla_risk_count > 0 %}
            <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-900">
                {{ student_pending_demo_sla_risk_count }} demo pending over 24h
            </p>
            {% endif %}
        </section>

        {# Find a tutor #}
        <section
            class="rounded-xl border border-emerald-100 bg-emerald-50/50 p-4 shadow-sm"
            x-data="{
                compare: [],
                toggleCompare(slug, name, url) {
                    const i = this.compare.findIndex((x) => x.slug === slug);
                    if (i >= 0) { this.compare.splice(i, 1); return; }
                    if (this.compare.length >= 3) this.compare.shift();
                    this.compare.push({ slug, name, url });
                }
            }"
        >
            <div class="mb-3 flex items-center justify-between">
                <h2 class="text-xs font-black uppercase tracking-wider text-emerald-800">Find a tutor</h2>
                <a href="{{ url('hometutor:tutor_list') }}" class="text-[11px] font-black uppercase text-emerald-700 hover:underline">Full list →</a>
            </div>
            <form
                class="mb-3 rounded-xl border border-emerald-200 bg-white p-3"
                hx-get="{{ url('hometutor:quick_tutor_search') }}"
                hx-target="#quick-tutor-results"
                hx-swap="innerHTML"
                hx-indicator="#quick-search-indicator"
            >
                <input type="hidden" name="parent_gate" value="{{ '1' if parent_gate_enabled else '0' }}">
                <div class="grid grid-cols-2 gap-2 mb-2">
                    <input type="text" name="subject" placeholder="Subject" class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-medium focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500">
                    <input type="text" name="city" value="{{ hometutor_pilot_city }}" placeholder="City" class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-medium focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500">
                </div>
                <button type="submit" class="w-full rounded-lg bg-emerald-600 py-1.5 text-xs font-black uppercase tracking-wider text-white hover:bg-emerald-500">Search tutors</button>
            </form>
            <div id="quick-search-indicator" class="htmx-indicator text-xs font-black text-emerald-700">Loading...</div>
            <div id="quick-tutor-results" class="max-h-64 overflow-y-auto">
                {% set tutor_cards = quick_tutor_cards %}
                {% set enable_compare = true %}
                {% set dashboard_mode = true %}
                {% include "hometutor/partials/_tutor_search_results.jinja" %}
            </div>
        </section>
    </div>

    {# ── ACTIVITY FEED ─────────────────────────────────────────────────────── #}
    {% if student_activity %}
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <h2 class="mb-3 text-xs font-black uppercase tracking-wider text-slate-700">Recent activity</h2>
        <div class="space-y-1.5">
            {% for item in student_activity[:6] %}
            <div class="flex items-center gap-3 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2">
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-bold text-slate-900">{{ item.title }}</p>
                </div>
                <p class="shrink-0 text-[10px] font-semibold text-slate-400">{{ item.meta.strftime('%d %b') }}</p>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── SERVER ORDER (rare, shown conditionally) ──────────────────────────── #}
    {% if user_role == 'STUDENT' and server_order_latest %}
    <section class="rounded-xl border border-indigo-200 bg-indigo-50/70 p-4 shadow-sm" aria-label="Server order details">
        <div class="flex items-center justify-between mb-3">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-700">Server order</p>
                <h2 class="text-base font-black text-slate-900">Your latest server</h2>
            </div>
            <span class="rounded-full bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-slate-700">{{ server_order_latest.status|lower }}</span>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
            <div class="rounded-lg border border-indigo-100 bg-white p-3">
                <p class="text-[10px] font-black uppercase text-slate-500">Domain</p>
                <p class="mt-1 text-sm font-bold text-slate-900">{{ server_order_latest.domain_name }}</p>
            </div>
            <div class="rounded-lg border border-indigo-100 bg-white p-3">
                <p class="text-[10px] font-black uppercase text-slate-500">Status</p>
                <p class="mt-1 text-sm font-semibold text-slate-800">{{ server_order_detail.status_message if server_order_detail and server_order_detail.status_message else server_order_default_message }}</p>
            </div>
        </div>
    </section>
    {% endif %}

</div>
{% endblock %}
