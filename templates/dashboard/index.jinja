{% extends "base.jinja" %}
{% block title %}Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto flex w-full max-w-[90rem] flex-col gap-10 px-5 pb-10 pt-8 sm:px-8 md:gap-12 md:px-10 md:pb-14 md:pt-10 lg:px-12 xl:px-14">
    
    {# Cleaner Top Header #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 pb-2">
        <div class="flex flex-col gap-1">
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-black text-slate-900 tracking-tight">Hi, {{ user.username }} 👋</h1>
                <span class="bg-slate-100 text-slate-700 text-[11px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider">{{ user_role|lower }}</span>
                {% if user.is_premium %}
                <span class="bg-gradient-to-r from-amber-400 to-orange-500 text-white text-xs font-black px-3 py-1 rounded-full shadow-lg shadow-orange-100 uppercase tracking-widest flex items-center gap-1.5">
                    <span class="text-xs">⭐</span> PRO MEMBER
                </span>
                {% endif %}
            </div>
            <p class="text-slate-600 font-medium max-w-2xl">{{ role_intro }}</p>
        </div>
        
        <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-end w-full md:w-auto md:flex-shrink-0">
            <a href="{{ url('dashboard:daily_class_log') }}" class="inline-flex items-center justify-center rounded-xl border-2 border-indigo-200 bg-indigo-50 px-4 py-3 text-xs font-black uppercase tracking-wider text-indigo-800 shadow-sm hover:bg-indigo-100 sm:py-2.5">
                + Add class log
            </a>
            {# Profile Summary — streak #}
            <div class="flex items-center gap-4 bg-white p-2 pl-4 border border-slate-200 rounded-2xl shadow-sm">
            <div class="flex flex-col text-right">
                <span class="text-xs uppercase font-black tracking-widest text-slate-400">Streak Status</span>
                <span class="text-sm font-black {{ 'text-orange-500' if user.streak_days > 0 else 'text-slate-300' }}">🔥 {{ user.streak_days }} Day Streak</span>
            </div>
            <a href="{{ url('users:profile') }}" class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-xs shadow-lg shadow-slate-200">
                {{ user.username[0]|upper }}
            </a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {% for item in role_stat_cards %}
        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
            <p class="text-[11px] uppercase font-black tracking-widest text-slate-400">{{ item.label }}</p>
            <p class="text-2xl font-black text-slate-900 mt-1">{{ item.value }}</p>
        </div>
        {% endfor %}
    </div>

    <div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-4">
        <p class="text-xs font-black uppercase tracking-widest text-indigo-700">Quick actions</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            <a href="{{ url('assessment:index') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-indigo-800 hover:bg-indigo-100">Take test</a>
            <a href="{{ url('learning:index') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-indigo-800 hover:bg-indigo-100">Watch videos</a>
            <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-indigo-800 hover:bg-indigo-100">Book tutor</a>
            <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-3 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">My demos</a>
        </div>
        {% if student_pending_demo_sla_risk_count > 0 %}
        <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800">
            {{ student_pending_demo_sla_risk_count }} pending demo request{% if student_pending_demo_sla_risk_count != 1 %}s{% endif %} older than 24h.
        </p>
        {% endif %}
        <div class="mt-3 flex flex-wrap gap-2">
            {% if parent_gate_enabled %}
            <a href="{{ url('dashboard:index') }}?parent_gate=0" class="inline-flex rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-amber-800 hover:bg-amber-100">Disable parent-approval mode</a>
            {% else %}
            <a href="{{ url('dashboard:index') }}?parent_gate=1" class="inline-flex rounded-lg border border-indigo-200 bg-white px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Enable parent-approval mode</a>
            {% endif %}
        </div>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between gap-3 border-b border-slate-100 pb-3">
            <h2 class="text-sm font-black uppercase tracking-widest text-slate-800">My Exam Score Performance</h2>
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-indigo-700">
                Last {{ my_exam_performance_rows|length }} attempts
            </span>
        </div>
        <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[820px] border-collapse text-left">
                <thead class="bg-slate-50 text-[11px] font-black uppercase tracking-widest text-slate-500">
                    <tr>
                        <th class="px-3 py-2">Date</th>
                        <th class="px-3 py-2">Skill</th>
                        <th class="px-3 py-2">Video Title</th>
                        <th class="px-3 py-2 text-right">Score</th>
                        <th class="px-3 py-2 text-right">Result</th>
                        <th class="px-3 py-2 text-right">Review</th>
                        <th class="px-3 py-2 text-right">Retry</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for row in my_exam_performance_rows %}
                    {% set attempt = row.attempt %}
                    <tr class="hover:bg-slate-50">
                        <td class="px-3 py-2 text-xs font-bold text-slate-600">
                            {{ attempt.attempt_date.strftime('%d %b %Y · %H:%M') }}
                        </td>
                        <td class="px-3 py-2 text-sm font-black text-slate-900">
                            {{ attempt.skill.name if attempt.skill else 'General Test' }}
                        </td>
                        <td class="px-3 py-2 text-xs font-bold text-slate-700">
                            {{ row.video_title if row.video_title else 'No linked video' }}
                        </td>
                        <td class="px-3 py-2 text-right text-sm font-black text-slate-900">
                            {{ attempt.score }}%
                        </td>
                        <td class="px-3 py-2 text-right">
                            <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-black uppercase tracking-wider {{ 'bg-emerald-50 text-emerald-700' if attempt.passed else 'bg-rose-50 text-rose-700' }}">
                                {{ 'Passed' if attempt.passed else 'Retry' }}
                            </span>
                        </td>
                        <td class="px-3 py-2 text-right">
                            {% if not attempt.passed %}
                            <a
                                href="{{ url('dashboard:attempt_review', attempt.id) }}"
                                class="inline-flex rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-amber-700 hover:bg-amber-100"
                            >
                                Wrong Q&A
                            </a>
                            {% else %}
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">—</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-2 text-right">
                            {% if attempt.skill %}
                            <a
                                href="{{ url('assessment:take_test', attempt.skill.id) }}{% if row.video_id %}?video_id={{ row.video_id }}{% endif %}"
                                class="inline-flex rounded-lg border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100"
                            >
                                Retry Test
                            </a>
                            {% else %}
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">N/A</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="px-3 py-8 text-center text-sm font-bold text-slate-500">
                            No exam attempts yet. Take your first test to see performance here.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase font-black tracking-widest text-slate-400">Learning health</p>
            <p class="mt-1 text-3xl font-black text-slate-900">{{ progress }}%</p>
            <p class="mt-1 text-sm text-slate-600">Mastery score from your completed skill path.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase font-black tracking-widest text-slate-400">Wallet + tests</p>
            <p class="mt-1 text-3xl font-black text-slate-900">₹{{ user.wallet_balance|int }}</p>
            <p class="mt-1 text-sm text-slate-600">{{ user.trial_tests_left }} free test uses left.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase font-black tracking-widest text-slate-400">Leaderboard rank</p>
            <p class="mt-1 text-3xl font-black text-slate-900">#{{ xp_rank_india }}</p>
            <a href="{{ url('dashboard:leaderboard') }}" class="mt-2 inline-flex text-xs font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Open leaderboard</a>
        </div>
    </div>
    {% if student_preview_mode %}
    <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3">
        <p class="text-xs font-black uppercase tracking-widest text-amber-800">
            Demo preview mode enabled because this account has no tutor-booking records yet.
        </p>
    </div>
    {% endif %}

    <section
        class="w-full rounded-3xl border border-emerald-100 bg-emerald-50/50 p-6 md:p-8 shadow-sm"
        x-data="{
            compare: [],
            toggleCompare(slug, name, url) {
                const i = this.compare.findIndex((x) => x.slug === slug);
                if (i >= 0) {
                    this.compare.splice(i, 1);
                    return;
                }
                if (this.compare.length >= 3) {
                    this.compare.shift();
                }
                this.compare.push({ slug, name, url });
            }
        }"
    >
        <div class="flex flex-col gap-6">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div>
                    <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-800 mb-1">Home tutors</p>
                    <h2 class="text-xl font-black text-slate-900 tracking-tight">Book Tutor Now</h2>
                    <p class="text-sm text-slate-600 mt-1">Fast shortlist and booking workflow for students and parents.</p>
                </div>
                <div class="flex flex-wrap gap-2 md:gap-3">
                    <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-white border border-emerald-200 text-emerald-900 text-xs font-black uppercase tracking-wider hover:bg-emerald-100/80 transition-colors">Full marketplace</a>
                    <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-black uppercase tracking-wider hover:bg-emerald-500 transition-colors shadow-sm">My demos{% if hometutor_my_pending_sent %} ({{ hometutor_my_pending_sent }}){% endif %}</a>
                </div>
            </div>

            <form
                class="rounded-2xl border border-emerald-200 bg-white p-4"
                hx-get="{{ url('hometutor:quick_tutor_search') }}"
                hx-target="#quick-tutor-results"
                hx-swap="innerHTML"
                hx-indicator="#quick-search-indicator"
            >
                <input type="hidden" name="parent_gate" value="{{ '1' if parent_gate_enabled else '0' }}">
                <div class="grid grid-cols-1 gap-3 md:grid-cols-5">
                    <input type="text" name="subject" placeholder="Subject (Math, Physics)" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                    <input type="number" name="class_min" min="1" max="12" placeholder="Class" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                    <select name="mode" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                        <option value="">Any mode</option>
                        <option value="ONLINE">Online</option>
                        <option value="OFFLINE">Offline</option>
                        <option value="HYBRID">Hybrid</option>
                    </select>
                    <input type="text" name="city" value="{{ hometutor_pilot_city }}" placeholder="City" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                    <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-emerald-500">Find tutors</button>
                </div>
                <p class="mt-2 text-xs text-slate-500">Tip: Click "View full profile" to request demo instantly.</p>
            </form>

            <div id="quick-search-indicator" class="htmx-indicator text-xs font-black uppercase tracking-widest text-emerald-700">Loading tutors...</div>
            <div id="quick-tutor-results">
                {% set tutor_cards = quick_tutor_cards %}
                {% set enable_compare = true %}
                {% set dashboard_mode = true %}
                {% include "hometutor/partials/_tutor_search_results.jinja" %}
            </div>

            <div x-show="compare.length > 0" x-cloak class="rounded-2xl border border-indigo-200 bg-indigo-50 p-4">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <p class="text-xs font-black uppercase tracking-widest text-indigo-700">Shortlist compare</p>
                        <p class="text-sm text-slate-700">Compare up to 3 tutors and open profiles in new tabs.</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button
                            type="button"
                            @click="window.location.href='{{ url('hometutor:compare_tutors') }}?' + compare.map((x) => 't=' + encodeURIComponent(x.slug)).join('&')"
                            class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500"
                        >
                            Compare now
                        </button>
                        <button type="button" @click="compare = []" class="rounded-lg border border-indigo-200 bg-white px-3 py-1.5 text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Clear</button>
                    </div>
                </div>
                <div class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-3">
                    <template x-for="item in compare" :key="item.slug">
                        <a :href="item.url" target="_blank" class="rounded-xl border border-indigo-200 bg-white px-3 py-2 text-sm font-bold text-slate-800 hover:bg-indigo-100" x-text="item.name"></a>
                    </template>
                </div>
            </div>
        </div>
    </section>

    <section class="w-full rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500 mb-1">Booking funnel</p>
                <h2 class="text-xl font-black text-slate-900 tracking-tight">From request to confirmed learning</h2>
                <p class="mt-1 text-sm text-slate-600">Track where your tutor booking is currently blocked or moving.</p>
            </div>
            <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-100">Open my requests</a>
        </div>

        <div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-5">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">Requested</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ student_demo_pending }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">Accepted</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ student_demo_accepted }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">Active</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ student_active_engagements }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">Paid</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ student_paid_count }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-500">Declined</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ student_demo_declined }}</p>
            </div>
        </div>
        {% if parent_gate_enabled %}
        <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800">
            Parent-approval mode is active. {{ student_parent_approval_pending }} action{% if student_parent_approval_pending != 1 %}s{% endif %} may require parent sign-off before payment continuity.
        </p>
        {% endif %}

        <div class="mt-5 grid gap-4 md:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="text-sm font-black text-slate-900">Recent demo requests</h3>
                {% if student_recent_demos %}
                <div class="mt-3 space-y-2">
                    {% for d in student_recent_demos %}
                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="text-sm font-black text-slate-900">{{ d.tutor.display_name }}</p>
                        <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">{{ d.get_status_display() }}</p>
                        {% if d.scheduled_at %}
                        <p class="mt-1 text-xs text-slate-500">Scheduled: {{ d.scheduled_at.strftime('%d %b %Y %H:%M') }}</p>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="mt-3 text-sm text-slate-500">No demo requests yet. Start by booking a tutor above.</p>
                {% endif %}
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="text-sm font-black text-slate-900">Post-booking continuity</h3>
                {% if student_recent_engagements %}
                <div class="mt-3 space-y-2">
                    {% for e in student_recent_engagements %}
                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="text-sm font-black text-slate-900">{{ e.tutor_profile.display_name }}</p>
                        <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">{{ e.get_status_display() }}</p>
                        <div class="mt-2 flex flex-wrap gap-2">
                            <a href="{{ url('hometutor:engagement_room', pk=e.pk) }}" class="inline-flex rounded-lg border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Open room</a>
                            {% if e.pk not in student_paid_engagement_ids and e.status == 'ACTIVE' %}
                            <a href="{{ url('hometutor_payments:pay_checkout', engagement_id=e.pk) }}" class="inline-flex rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100">Complete payment</a>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="mt-3 text-sm text-slate-500">No active engagements yet. Accept and confirm a demo to continue.</p>
                {% endif %}
            </div>
        </div>
    </section>

    {% if weak_topic_tutor_cards %}
    <section class="w-full rounded-3xl border border-indigo-100 bg-indigo-50/50 p-6 shadow-sm md:p-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-700 mb-1">Weak-area support</p>
                <h2 class="text-xl font-black text-slate-900 tracking-tight">Recommended tutors for your weak topics</h2>
                {% if weak_terms %}
                <p class="mt-1 text-sm text-slate-600">Based on recent weak concepts: {{ weak_terms|join(', ') }}</p>
                {% endif %}
            </div>
            <a href="{{ url('assessment:index') }}" class="inline-flex items-center justify-center rounded-xl border border-indigo-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Retake diagnostic</a>
        </div>
        <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
            {% set enable_compare = false %}
            {% set dashboard_mode = true %}
            {% for t in weak_topic_tutor_cards %}
            {% include "hometutor/partials/_tutor_card.jinja" %}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# Main + sidebar: flex gives the journey card all remaining width; sidebar fixed narrow #}
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-8 xl:gap-10">
        
        {# Main: learning path + secondary row — grows to fill #}
        <div class="min-w-0 w-full flex flex-1 flex-col gap-8">
            
            <section class="scroll-mt-24 w-full rounded-3xl border border-indigo-100 bg-indigo-50/50 p-6 shadow-sm md:p-8">
                <div class="mb-8 flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
                    <div>
                        <h2 class="text-2xl font-black text-slate-900 tracking-tight">Learning Journey</h2>
                        <p class="text-slate-500 text-xs font-black mt-1 uppercase tracking-widest leading-none">Clear path: complete current skill to unlock next.</p>
                    </div>
                </div>

                {# Path Tabs - Simplified #}
                <div class="flex flex-wrap gap-2 mb-8 bg-white p-1.5 rounded-2xl border border-indigo-100 w-fit shadow-sm">
                    {% for path in all_paths %}
                        <a href="?path={{ path.id }}" 
                           class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all {{ 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' if selected_path.id == path.id else 'text-slate-400 hover:text-indigo-600' }}">
                            {{ path.name }}
                        </a>
                    {% endfor %}
                </div>

                {% if learning_path %}
                    {% include "dashboard/components/progress_table.jinja" %}
                {% else %}
                    <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center">
                        <p class="text-sm font-black text-slate-800 mb-2">No modules available yet</p>
                        <p class="text-xs font-bold text-slate-500 mb-5">Add skills and questions in /sd/ to build the learning path.</p>
                        <a href="/sd/assessment/skill/add/" class="inline-block bg-indigo-600 text-white text-xs font-black px-6 py-3 rounded-xl uppercase tracking-widest hover:bg-indigo-700">Add a skill in /sd/</a>
                    </div>
                {% endif %}

                <div class="mt-8 flex flex-col sm:flex-row gap-4">
                    <a href="{{ url('assessment:index') }}" class="flex-grow bg-slate-900 text-white p-5 rounded-2xl flex items-center justify-between hover:scale-[1.02] transition-transform group">
                        <div class="flex items-center gap-4">
                            <span class="text-2xl drop-shadow-sm group-hover:rotate-12 transition-transform">🎓</span>
                            <div>
                                <p class="text-sm font-black">Take Diagnostic Test</p>
                                <p class="text-xs text-white/70 font-bold uppercase tracking-widest">Identify Weak Areas Instantly</p>
                            </div>
                        </div>
                        <span class="text-white/20 group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </section>

            <section class="w-full rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
                <h2 class="text-xl font-black text-slate-900 tracking-tight">Activity timeline</h2>
                {% if student_activity %}
                <div class="mt-4 space-y-3">
                    {% for item in student_activity %}
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                        <p class="text-sm font-bold text-slate-900">{{ item.title }}</p>
                        <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ item.meta.strftime('%d %b %Y %H:%M') }}</p>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="mt-3 text-sm text-slate-500">No recent activity yet. Start with a test or tutor booking.</p>
                {% endif %}
            </section>

            {# Secondary Actions Grid #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <a href="{{ url('learning:index') }}" class="group bg-white p-5 rounded-2xl border border-slate-200 flex items-center gap-4 hover:border-purple-300 transition-colors shadow-sm">
                    <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">📚</div>
                    <div>
                        <p class="text-sm font-black text-slate-900 leading-tight">Video Library</p>
                        <p class="text-xs font-bold text-slate-600 mt-1">Watch micro-lessons</p>
                    </div>
                </a>
                <a href="{{ url('core:earnings') }}" class="group bg-white p-5 rounded-2xl border border-slate-200 flex items-center gap-4 hover:border-emerald-300 transition-colors shadow-sm">
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">💰</div>
                    <div>
                        <p class="text-sm font-black text-slate-900 leading-tight">Earn Rewards</p>
                        <p class="text-xs font-bold text-slate-600 mt-1">Unlock high-paying tasks</p>
                    </div>
                </a>
            </div>

            {% if user_role == 'TUTOR' %}
            <div class="rounded-2xl border border-sky-100 bg-sky-50/70 p-5">
                <p class="text-xs font-black uppercase tracking-widest text-sky-700 mb-2">Role action</p>
                <h3 class="text-lg font-black text-slate-900">Invite students to online practice</h3>
                <p class="text-sm text-slate-600 mt-1">Share your referral link with students to unlock tests and track progress digitally.</p>
            </div>
            {% elif user_role == 'PARENT' %}
            <div class="rounded-2xl border border-amber-100 bg-amber-50/70 p-5">
                <p class="text-xs font-black uppercase tracking-widest text-amber-700 mb-2">Role action</p>
                <h3 class="text-lg font-black text-slate-900">Track your child’s prep rhythm</h3>
                <p class="text-sm text-slate-600 mt-1">Use test results and tutor demos together to choose the best academic path.</p>
            </div>
            {% elif user_role == 'CITY_ADMIN' %}
            <div class="rounded-2xl border border-fuchsia-100 bg-fuchsia-50/70 p-5">
                <p class="text-xs font-black uppercase tracking-widest text-fuchsia-700 mb-2">Role action</p>
                <h3 class="text-lg font-black text-slate-900">Monitor your city tutor operations</h3>
                <p class="text-sm text-slate-600 mt-1">Review local tutor quality, disputes, and active demo conversions with staff workflows.</p>
            </div>
            {% elif user_role == 'GLOBAL_ADMIN' %}
            <div class="rounded-2xl border border-slate-200 bg-slate-100/70 p-5">
                <p class="text-xs font-black uppercase tracking-widest text-slate-700 mb-2">Role action</p>
                <h3 class="text-lg font-black text-slate-900">Run platform-wide growth and quality ops</h3>
                <p class="text-sm text-slate-600 mt-1">Track network metrics, trust & safety, and monetization health across all regions.</p>
            </div>
            {% else %}
            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-5">
                <p class="text-xs font-black uppercase tracking-widest text-indigo-700 mb-2">Role action</p>
                <h3 class="text-lg font-black text-slate-900">Practice tests + tutor support</h3>
                <p class="text-sm text-slate-600 mt-1">Take diagnostics, fix weak areas, and request demos when you need guided help.</p>
            </div>
            {% endif %}
        </div>

        {# Right Sidebar: keep only useful summary blocks #}
        <aside class="flex w-full shrink-0 flex-col gap-5 lg:w-[17rem] lg:max-w-[17rem] xl:w-[18rem] xl:max-w-[18rem]">
            {% if unread_notifications > 0 %}
            <a href="{{ url('dashboard:notifications') }}" class="group flex items-center justify-between rounded-2xl border border-rose-200 bg-rose-50 p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <span class="p-2 bg-rose-500 text-white rounded-lg animate-pulse">🔔</span>
                    <span class="text-xs font-black text-rose-700">{{ unread_notifications }} New Notifications</span>
                </div>
                <span class="text-rose-300 group-hover:translate-x-1 transition-transform">→</span>
            </a>
            {% endif %}

            <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:rounded-3xl lg:p-6">
                <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50 rounded-full blur-3xl -mr-16 -mt-16 z-0"></div>
                <h3 class="relative z-10 mb-5 text-xs font-black uppercase tracking-widest text-slate-600 lg:mb-6">Last Test Result</h3>
                {% if latest_attempt %}
                    <div class="flex flex-col items-center relative z-10 text-center">
                        <p class="text-xs font-black text-slate-600 uppercase tracking-widest mb-1">{{ latest_attempt.skill.name }}</p>
                        <p class="text-6xl font-black mb-3 {% if latest_attempt.passed %}text-emerald-500{% else %}text-rose-500{% endif %}">
                            {{ latest_attempt.score }}<span class="text-2xl">%</span>
                        </p>
                        <div class="inline-flex items-center justify-center gap-2 bg-slate-50 px-4 py-2 rounded-xl border border-slate-100 text-xs font-black {% if latest_attempt.passed %}text-emerald-600{% else %}text-rose-600{% endif %}">
                            {% if latest_attempt.passed %}✓ COMPLETED{% else %}⚠ RE-TEST REQUIRED{% endif %}
                        </div>
                    </div>
                {% else %}
                    <p class="text-xs font-bold text-slate-300 text-center py-8">No tests taken yet. Start with a module!</p>
                {% endif %}
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-600">Useful links</h3>
                <div class="mt-3 space-y-2">
                    <a href="{{ url('hometutor:my_demo_requests') }}" class="block rounded-lg border border-slate-200 px-3 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-100">My demo requests</a>
                    <a href="{{ url('learning:index') }}" class="block rounded-lg border border-slate-200 px-3 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-100">Video library</a>
                    <a href="{{ url('assessment:index') }}" class="block rounded-lg border border-slate-200 px-3 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-100">Take test</a>
                </div>
            </div>

        </aside>
    </div>
</div>
{% endblock %}
