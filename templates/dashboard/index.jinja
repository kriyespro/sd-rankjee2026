{% extends "base.jinja" %}
{% block title %}Dashboard - RankJEE{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto py-6 px-4 flex flex-col gap-8">
    
    {# Cleaner Top Header #}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 pb-2">
        <div class="flex flex-col gap-1">
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-black text-slate-900 tracking-tight">Hi, {{ user.username }} 👋</h1>
                {% if user.is_premium %}
                <span class="bg-gradient-to-r from-amber-400 to-orange-500 text-white text-[10px] font-black px-3 py-1 rounded-full shadow-lg shadow-orange-100 uppercase tracking-widest flex items-center gap-1.5">
                    <span class="text-xs">⭐</span> PRO MEMBER
                </span>
                {% endif %}
            </div>
            <p class="text-slate-500 font-medium max-w-md">Ready to master your next skill? Your goal is to reach <span class="text-indigo-600 font-bold">100% Mastery</span>.</p>
        </div>
        
        {# Profile Summary #}
        <div class="flex items-center gap-4 bg-white p-2 pl-4 border border-slate-200 rounded-2xl shadow-sm">
            <div class="flex flex-col text-right">
                <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">Streak Status</span>
                <span class="text-sm font-black {{ 'text-orange-500' if user.streak_days > 0 else 'text-slate-300' }}">🔥 {{ user.streak_days }} Day Streak</span>
            </div>
            <a href="{{ url('users:profile') }}" class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-xs shadow-lg shadow-slate-200">
                {{ user.username[0]|upper }}
            </a>
        </div>
    </div>

    {# Simplified Status Bar #}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Balance & Recharge -->
        <div class="bg-indigo-600 rounded-2xl p-5 text-white shadow-xl shadow-indigo-100 flex flex-col justify-between group overflow-hidden relative">
            <div class="absolute -top-6 -right-6 w-20 h-20 bg-white/10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
            <div class="relative z-10">
                <p class="text-[10px] uppercase font-black tracking-widest text-indigo-200 mb-1">Total Credits</p>
                <p class="text-3xl font-black">₹{{ user.wallet_balance|int }}</p>
            </div>
            <form action="{{ url('dashboard:recharge') }}" method="POST" class="mt-4 relative z-10 w-full">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <button type="submit" class="w-full bg-white/20 hover:bg-white/30 border border-white/20 backdrop-blur-md text-white text-[10px] font-black uppercase py-2.5 rounded-xl transition-all flex items-center justify-center gap-2">
                    ⚡ Instant Topup
                </button>
            </form>
        </div>

        <!-- Mastery Progress -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
                <p class="text-[10px] uppercase font-black tracking-widest text-slate-400 mb-1">Mastery Score</p>
                <p class="text-3xl font-black text-slate-900">{{ progress }}%</p>
            </div>
            <div class="mt-4">
                <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                    <div class="bg-indigo-500 h-full transition-all duration-1000" style="width: {{ progress }}%"></div>
                </div>
            </div>
        </div>

        <!-- XP & Ranking -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between group">
            <div>
                <p class="text-[10px] uppercase font-black tracking-widest text-slate-400 mb-1">Total XP</p>
                <p class="text-3xl font-black text-slate-900">{{ user.xp_points }} <span class="text-sm font-bold text-slate-300">PTS</span></p>
            </div>
            <a href="{{ url('dashboard:leaderboard') }}" class="mt-4 text-[10px] font-black uppercase text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
                View Global Leaderboard 🏆
            </a>
        </div>

        <!-- Remaining Trials -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
                <p class="text-[10px] uppercase font-black tracking-widest text-slate-400 mb-1">Free Test Uses</p>
                <p class="text-3xl font-black text-slate-900">{{ user.trial_tests_left }}</p>
            </div>
            <div class="mt-4">
                {% if user.trial_tests_left > 0 %}
                    <span class="text-[9px] font-black bg-emerald-50 text-emerald-600 px-2 py-1 rounded-md border border-emerald-100">Ready to test!</span>
                {% else %}
                    <span class="text-[9px] font-black bg-rose-50 text-rose-600 px-2 py-1 rounded-md border border-rose-100">₹10 Per test used</span>
                {% endif %}
            </div>
        </div>
    </div>

    {# Main Layout Grid #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        {# Left Content: The Main Learning Path #}
        <div class="lg:col-span-2 flex flex-col gap-8">
            
            <section class="bg-indigo-50/50 rounded-3xl p-6 border border-indigo-100 shadow-sm">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
                    <div>
                        <h2 class="text-3xl font-black text-slate-900 tracking-tighter flex items-center gap-2">
                             Your Learning Journey
                        </h2>
                        <p class="text-slate-500 text-xs font-black mt-1 uppercase tracking-widest leading-none">Complete each module to unlock the next level.</p>
                    </div>
                </div>

                {# Path Tabs - Simplified #}
                <div class="flex flex-wrap gap-2 mb-8 bg-white p-1.5 rounded-2xl border border-indigo-100 w-fit shadow-sm">
                    {% for path in all_paths %}
                        <a href="?path={{ path.id }}" 
                           class="px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all {{ 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' if selected_path.id == path.id else 'text-slate-400 hover:text-indigo-600' }}">
                            {{ path.name }}
                        </a>
                    {% endfor %}
                </div>

                {% include "dashboard/components/progress_table.jinja" %}

                <div class="mt-8 flex flex-col sm:flex-row gap-4">
                    <a href="{{ url('assessment:index') }}" class="flex-grow bg-slate-900 text-white p-5 rounded-2xl flex items-center justify-between hover:scale-[1.02] transition-transform group">
                        <div class="flex items-center gap-4">
                            <span class="text-2xl drop-shadow-sm group-hover:rotate-12 transition-transform">🎓</span>
                            <div>
                                <p class="text-sm font-black">Take Diagnostic Test</p>
                                <p class="text-[10px] text-white/50 font-bold uppercase tracking-widest">Identify Weak Areas Instantly</p>
                            </div>
                        </div>
                        <span class="text-white/20 group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </section>

            {# Secondary Actions Grid #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <a href="{{ url('learning:index') }}" class="group bg-white p-5 rounded-2xl border border-slate-200 flex items-center gap-4 hover:border-purple-300 transition-colors shadow-sm">
                    <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">📚</div>
                    <div>
                        <p class="text-sm font-black text-slate-900 leading-tight">Video Library</p>
                        <p class="text-[10px] font-bold text-slate-400 mt-1">Watch micro-lessons</p>
                    </div>
                </a>
                <a href="{{ url('core:earnings') }}" class="group bg-white p-5 rounded-2xl border border-slate-200 flex items-center gap-4 hover:border-emerald-300 transition-colors shadow-sm">
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-110 transition-transform">💰</div>
                    <div>
                        <p class="text-sm font-black text-slate-900 leading-tight">Earn Rewards</p>
                        <p class="text-[10px] font-bold text-slate-400 mt-1">Unlock high-paying tasks</p>
                    </div>
                </a>
            </div>
        </div>

        {# Right Sidebar: Social & Progress Widgets #}
        <aside class="flex flex-col gap-6">
            
            {# Notifications Flyout (Integrated) #}
            {% if unread_notifications > 0 %}
            <a href="{{ url('dashboard:notifications') }}" class="bg-rose-50 border border-rose-200 p-4 rounded-2xl flex items-center justify-between group shadow-sm">
                <div class="flex items-center gap-3">
                    <span class="p-2 bg-rose-500 text-white rounded-lg animate-pulse">🔔</span>
                    <span class="text-xs font-black text-rose-700">{{ unread_notifications }} New Notifications</span>
                </div>
                <span class="text-rose-300 group-hover:translate-x-1 transition-transform">→</span>
            </a>
            {% endif %}

            {# Recent Performance Widget #}
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 overflow-hidden relative">
                <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50 rounded-full blur-3xl -mr-16 -mt-16 z-0"></div>
                <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-6 relative z-10">Last Test Result</h3>
                {% if latest_attempt %}
                    <div class="flex flex-col items-center relative z-10 text-center">
                        <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">{{ latest_attempt.skill.name }}</p>
                        <p class="text-6xl font-black mb-3 {% if latest_attempt.passed %}text-emerald-500{% else %}text-rose-500{% endif %}">
                            {{ latest_attempt.score }}<span class="text-2xl">%</span>
                        </p>
                        <div class="inline-flex items-center justify-center gap-2 bg-slate-50 px-4 py-2 rounded-xl border border-slate-100 text-[10px] font-black {% if latest_attempt.passed %}text-emerald-600{% else %}text-rose-600{% endif %}">
                            {% if latest_attempt.passed %}✓ COMPLETED{% else %}⚠ RE-TEST REQUIRED{% endif %}
                        </div>
                    </div>
                {% else %}
                    <p class="text-xs font-bold text-slate-300 text-center py-8">No tests taken yet. Start with a module!</p>
                {% endif %}
            </div>

            {# Certificate Collection #}
            {% if user_certificates %}
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 overflow-hidden">
                <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-6 flex justify-between items-center">
                    My Certificates
                    <span class="bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded text-[8px]">{{ user_certificates|length }} EARNED</span>
                </h3>
                <div class="space-y-4">
                    {% for cert in user_certificates[:3] %}
                    <a href="{{ url('assessment:view_certificate', certificate_id=cert.certificate_id) }}" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-lg group-hover:scale-110 transition-transform">📜</div>
                        <div class="flex-grow">
                            <p class="text-[11px] font-black text-slate-900 leading-none mb-1">{{ cert.skill.name }}</p>
                            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Verified Achievement</p>
                        </div>
                        <span class="text-slate-300 group-hover:text-indigo-600 transition-colors">→</span>
                    </a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Integrated Referral #}
            <div class="bg-slate-900 rounded-3xl p-6 text-white shadow-xl shadow-slate-200 relative overflow-hidden group">
                <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-indigo-500/20 rounded-full blur-3xl transition-transform group-hover:scale-150 duration-700"></div>
                <h3 class="text-[10px] font-black uppercase tracking-widest text-white/30 mb-4">Invite Friends</h3>
                <p class="text-sm font-black mb-2 leading-snug">Give ₹50, Get ₹50</p>
                <p class="text-[10px] text-white/40 mb-6 group-hover:text-indigo-200 transition-colors">Instant credits for every lead.</p>
                
                <div class="flex gap-2">
                    <code class="flex-grow bg-white/5 border border-white/10 px-4 py-3 rounded-xl font-mono font-black text-sm text-indigo-100 text-center uppercase tracking-widest leading-none flex items-center justify-center">
                        {{ user.referral_code }}
                    </code>
                    <button onclick="navigator.clipboard.writeText('{{ request.scheme }}://{{ request.get_host() }}/users/signup/?ref={{ user.referral_code }}'); let o = this.innerHTML; this.innerHTML='<span class=\'text-indigo-400\'>✓</span>'; setTimeout(()=>this.innerHTML=o,2000)"
                            class="p-3 bg-white text-slate-900 rounded-xl hover:bg-indigo-50 transition-all font-black flex items-center justify-center" title="Copy Link">
                        📋
                    </button>
                    <a href="https://wa.me/?text=Check%20out%20SkillLoop%20and%20earn%20%E2%82%B950!%20Sign%20up%20here:%20{{ request.scheme }}://{{ request.get_host() }}/users/signup/?ref={{ user.referral_code }}" target="_blank"
                       class="p-3 bg-emerald-500 text-white rounded-xl hover:bg-emerald-600 shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center" title="Share to WhatsApp">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12.031 0C5.385 0 0 5.385 0 12.031c0 2.128.552 4.137 1.547 5.918L.044 24l6.19-1.624A11.97 11.97 0 0012.031 24c6.646 0 12.031-5.385 12.031-12.031S18.677 0 12.031 0zm0 22.012a9.966 9.966 0 01-5.088-1.39l-3.642.955.972-3.551A9.957 9.957 0 012.04 12.03c0-5.513 4.488-10.001 10.001-10.001 5.513 0 10.001 4.488 10.001 10.001S17.544 22.012 12.031 22.012zm5.558-7.551c-.304-.152-1.802-.89-2.08-.992-.278-.102-.482-.152-.684.152-.203.303-.786.992-.963 1.194-.177.203-.355.228-.659.076-.304-.152-1.284-.473-2.448-1.51-1.164-1.037-1.95-2.315-2.127-2.618-.177-.303-.019-.467.133-.619.153-.153.304-.304.456-.456.152-.153.203-.254.304-.456.101-.203.051-.355-.025-.508-.076-.152-.684-1.65-.938-2.261-.253-.611-.508-.508-.684-.508-.178 0-.38-.025-.583-.025s-.532.076-.811.38c-.278.304-1.064 1.039-1.064 2.536 0 1.496 1.089 2.94 1.242 3.143.153.203 2.146 3.279 5.2 4.59.306.132.545.211.732.269.875.279 1.672.24 2.301.146.629-.094 1.802-.736 2.054-1.446.253-.71.253-1.318.178-1.446-.076-.127-.279-.203-.583-.355z"/></svg>
                    </a>
                </div>
            </div>

            {# Top Earners Mini #}
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 overflow-hidden">
                <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-6">Top Rankers</h3>
                <div class="flex flex-col gap-4">
                    {% for u in top_users %}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="text-[10px] font-black w-4 text-slate-300">#{{ loop.index }}</span>
                            <span class="text-xs font-black {{ 'text-indigo-600' if u.pk == user.pk else 'text-slate-700' }}">{{ u.username }}</span>
                        </div>
                        <span class="text-[10px] font-black text-slate-400">{{ u.xp_points }} XP</span>
                    </div>
                    {% endfor %}
                </div>
                <a href="{{ url('dashboard:leaderboard') }}" class="block text-center mt-6 text-[9px] font-black uppercase tracking-widest text-slate-400 hover:text-indigo-600 transition-colors">View Ranking Board &rarr;</a>
            </div>

            {# Badge Collection Quickview #}
            {% if user_badges %}
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 overflow-hidden">
                <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-4">My Collection</h3>
                <div class="flex flex-wrap gap-2">
                    {% for ub in user_badges[:4] %}
                    <div class="w-8 h-8 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-center text-lg shadow-sm hover:scale-110 transition-transform cursor-help" title="{{ ub.badge.title }}">
                        {{ ub.badge.icon }}
                    </div>
                    {% endfor %}
                    {% if user_badges|length > 4 %}
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-[10px] font-black text-indigo-600">
                        +{{ user_badges|length - 4 }}
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}

        </aside>
    </div>
</div>
{% endblock %}
