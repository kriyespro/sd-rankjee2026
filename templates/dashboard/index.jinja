{% extends "base.jinja" %}
{% block title %}Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 pb-8 pt-6 sm:px-6 md:gap-7 md:pb-10 md:pt-7">

    {% if server_buy_success %}
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-900" role="status">
        {{ server_buy_success_message }}
    </div>
    {% endif %}
    {% if user_role == 'STUDENT' and server_order_latest %}
    <section class="rounded-xl border border-indigo-200 bg-indigo-50/70 p-4 shadow-sm md:p-5" aria-label="Server order details">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-700">Server order</p>
                <h2 class="text-base font-black tracking-tight text-slate-900 md:text-lg">Your latest server status</h2>
            </div>
            <span class="inline-flex w-fit rounded-full bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-slate-700">
                {{ server_order_latest.status|lower }}
            </span>
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-2">
            <div class="rounded-lg border border-indigo-100 bg-white p-3">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Order summary</p>
                <p class="mt-1 text-sm font-bold text-slate-900">Domain: {{ server_order_latest.domain_name }}</p>
                {% if server_order_latest.package %}
                <p class="mt-1 text-xs font-semibold text-slate-700">{{ server_order_latest.package.title }}</p>
                {% endif %}
                <p class="mt-1 text-xs font-semibold text-slate-600">Amount: ₹{{ server_order_latest.total_inr }}</p>
            </div>
            <div class="rounded-lg border border-indigo-100 bg-white p-3">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Status message</p>
                <p class="mt-1 text-sm font-semibold text-slate-800">
                    {{ server_order_detail.status_message if server_order_detail and server_order_detail.status_message else server_order_default_message }}
                </p>
            </div>
        </div>
        {% if server_order_detail %}
        <div class="mt-3 grid gap-3 md:grid-cols-2">
            {% if server_order_detail.server_ip %}
            <div class="rounded-lg border border-slate-200 bg-white p-3">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Server IP</p>
                <p class="mt-1 text-sm font-bold text-slate-900">{{ server_order_detail.server_ip }}</p>
            </div>
            {% endif %}
            {% if server_order_detail.panel_url %}
            <div class="rounded-lg border border-slate-200 bg-white p-3">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Panel URL</p>
                <a href="{{ server_order_detail.panel_url }}" target="_blank" rel="noopener" class="mt-1 inline-flex text-sm font-bold text-indigo-700 underline hover:text-indigo-800">
                    Open panel
                </a>
            </div>
            {% endif %}
            {% if server_order_detail.login_username %}
            <div class="rounded-lg border border-slate-200 bg-white p-3">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Login username</p>
                <p class="mt-1 text-sm font-bold text-slate-900">{{ server_order_detail.login_username }}</p>
            </div>
            {% endif %}
            {% if server_order_detail.login_password %}
            <div class="rounded-lg border border-slate-200 bg-white p-3">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Login password</p>
                <p class="mt-1 text-sm font-bold text-slate-900">{{ server_order_detail.login_password }}</p>
            </div>
            {% endif %}
            {% if server_order_detail.nameservers %}
            <div class="rounded-lg border border-slate-200 bg-white p-3 md:col-span-2">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Nameservers</p>
                <p class="mt-1 whitespace-pre-line text-sm font-semibold text-slate-800">{{ server_order_detail.nameservers }}</p>
            </div>
            {% endif %}
            {% if server_order_detail.extra_details %}
            <div class="rounded-lg border border-slate-200 bg-white p-3 md:col-span-2">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Extra details</p>
                <p class="mt-1 whitespace-pre-line text-sm font-semibold text-slate-800">{{ server_order_detail.extra_details }}</p>
            </div>
            {% endif %}
        </div>
        {% endif %}
    </section>
    {% endif %}

    {# Overview canvas: identity + KPIs + shortcuts in one scannable panel #}
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5" aria-label="Dashboard overview">
        <div class="flex flex-col gap-3 border-b border-slate-100 pb-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-xl font-black tracking-tight text-slate-900 md:text-2xl">Hi, {{ user.username }}</h1>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-slate-600">{{ user_role|lower }}</span>
                    {% if user.is_premium %}
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-800">Pro</span>
                    {% endif %}
                </div>
                <p class="mt-1 text-xs leading-snug text-slate-600 line-clamp-2 md:text-sm">{{ role_intro }}</p>
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-2">
                {% if user_role == 'STUDENT' %}
                <a href="{{ url('dashboard:blog_post_create') }}" class="inline-flex items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-emerald-800 hover:bg-emerald-100">Add post</a>
                {% if user.show_server_buy_button %}
                <a href="{{ url('server_buy:checkout') }}" class="inline-flex items-center justify-center rounded-lg border border-violet-200 bg-violet-50 px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-violet-800 hover:bg-violet-100">Server buy now</a>
                {% endif %}
                {% endif %}
                <a href="{{ url('dashboard:daily_class_log') }}" class="inline-flex items-center justify-center rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-indigo-800 hover:bg-indigo-100">Class log</a>
                <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2 py-1">
                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-500">Streak</span>
                    <span class="text-xs font-black text-slate-900">{{ user.streak_days }}d</span>
                    <a href="{{ url('users:profile') }}" class="flex h-8 w-8 items-center justify-center rounded-md bg-slate-900 text-[11px] font-black text-white" title="Profile">{{ user.username[0]|upper }}</a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            {% set kpi_cards = role_stat_cards %}
            {% include "dashboard/partials/_dash_kpi_strip.jinja" %}
        </div>
        <div class="mt-3 border-t border-slate-100 pt-3">
            <p class="mb-2 text-[10px] font-black uppercase tracking-wider text-slate-500">Quick links</p>
            <div class="flex flex-wrap gap-1.5">
                <a href="{{ url('dashboard:study') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Study</a>
                <a href="{{ url('assessment:index') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Test</a>
                <a href="{{ url('learning:index') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Videos</a>
                <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Tutors</a>
                <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex rounded-md bg-indigo-600 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-white hover:bg-indigo-500">Demos{% if hometutor_my_pending_sent %} {{ hometutor_my_pending_sent }}{% endif %}</a>
                <a href="{{ url('dashboard:leaderboard') }}" class="inline-flex rounded-md border border-slate-200 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Rank</a>
            </div>
            {% if student_pending_demo_sla_risk_count > 0 %}
            <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-900">
                {{ student_pending_demo_sla_risk_count }} demo request{% if student_pending_demo_sla_risk_count != 1 %}s{% endif %} pending over 24h.
            </p>
            {% endif %}
            <div class="mt-2 flex flex-wrap gap-1.5">
                {% if parent_gate_enabled %}
                <a href="{{ url('dashboard:index') }}?parent_gate=0" class="inline-flex rounded-md border border-amber-200 bg-amber-50 px-2 py-1 text-[10px] font-black uppercase tracking-wider text-amber-800 hover:bg-amber-100" title="Practice how parent sign-off would work">Practice approval off</a>
                {% else %}
                <a href="{{ url('dashboard:index') }}?parent_gate=1" class="inline-flex rounded-md border border-slate-200 px-2 py-1 text-[10px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50" title="Preview parent sign-off copy on demo buttons">Practice approval on</a>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
        <div class="flex flex-col gap-2 border-b border-slate-100 pb-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
            <h2 class="text-xs font-black uppercase tracking-wider text-slate-700 md:text-sm md:tracking-widest">Exam scores</h2>
            <span class="w-fit rounded-full bg-indigo-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-indigo-700">
                Last {{ my_exam_performance_rows|length }} attempts
            </span>
        </div>
        <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[820px] border-collapse text-left">
                <thead class="bg-slate-50 text-[11px] font-black uppercase tracking-widest text-slate-500">
                    <tr>
                        <th class="px-3 py-2">Date</th>
                        <th class="px-3 py-2">Skill</th>
                        <th class="px-3 py-2">Video Title</th>
                        <th class="px-3 py-2 text-right">Score</th>
                        <th class="px-3 py-2 text-right">Result</th>
                        <th class="px-3 py-2 text-right">Review</th>
                        <th class="px-3 py-2 text-right">Retry</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for row in my_exam_performance_rows %}
                    {% set attempt = row.attempt %}
                    <tr class="hover:bg-slate-50">
                        <td class="px-3 py-2 text-xs font-bold text-slate-600">
                            {{ attempt.attempt_date.strftime('%d %b %Y · %H:%M') }}
                        </td>
                        <td class="px-3 py-2 text-sm font-black text-slate-900">
                            {{ attempt.skill.name if attempt.skill else 'General Test' }}
                        </td>
                        <td class="px-3 py-2 text-xs font-bold text-slate-700">
                            {{ row.video_title if row.video_title else 'No linked video' }}
                        </td>
                        <td class="px-3 py-2 text-right text-sm font-black text-slate-900">
                            {{ attempt.score }}%
                        </td>
                        <td class="px-3 py-2 text-right">
                            <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-black uppercase tracking-wider {{ 'bg-emerald-50 text-emerald-700' if attempt.passed else 'bg-rose-50 text-rose-700' }}">
                                {{ 'Passed' if attempt.passed else 'Retry' }}
                            </span>
                        </td>
                        <td class="px-3 py-2 text-right">
                            {% if not attempt.passed %}
                            <a
                                href="{{ url('dashboard:attempt_review', attempt.id) }}"
                                class="inline-flex rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-amber-700 hover:bg-amber-100"
                            >
                                Wrong Q&A
                            </a>
                            {% else %}
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">—</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-2 text-right">
                            {% if attempt.skill %}
                            <a
                                href="{{ url('assessment:take_test', attempt.skill.id) }}{% if row.video_id %}?video_id={{ row.video_id }}{% endif %}"
                                class="inline-flex rounded-lg border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100"
                            >
                                Retry Test
                            </a>
                            {% else %}
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">N/A</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="px-3 py-8 text-center text-sm font-bold text-slate-500">
                            No exam attempts yet. Take your first test to see performance here.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {% if student_preview_mode %}
    <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 md:px-4">
        <p class="text-[11px] font-bold leading-snug text-amber-900 md:text-xs md:font-black md:uppercase md:tracking-wider">
            Preview: sample tutor activity is shown until you book your first demo.
        </p>
    </div>
    {% endif %}

    <section
        class="w-full rounded-xl border border-emerald-100 bg-emerald-50/50 p-4 shadow-sm md:p-5"
        x-data="{
            compare: [],
            toggleCompare(slug, name, url) {
                const i = this.compare.findIndex((x) => x.slug === slug);
                if (i >= 0) {
                    this.compare.splice(i, 1);
                    return;
                }
                if (this.compare.length >= 3) {
                    this.compare.shift();
                }
                this.compare.push({ slug, name, url });
            }
        }"
    >
        <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                <div class="min-w-0">
                    <p class="text-[10px] font-black uppercase tracking-wider text-emerald-800">Home tutors</p>
                    <h2 class="mt-0.5 text-lg font-black tracking-tight text-slate-900 md:text-xl">Find a tutor</h2>
                    <p class="mt-1 text-xs text-slate-600 md:text-sm">Search pilot-city listings and request a demo.</p>
                </div>
                <div class="flex flex-wrap gap-2 md:gap-3">
                    <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-white border border-emerald-200 text-emerald-900 text-xs font-black uppercase tracking-wider hover:bg-emerald-100/80 transition-colors">Full marketplace</a>
                    <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-black uppercase tracking-wider hover:bg-emerald-500 transition-colors shadow-sm">My demos{% if hometutor_my_pending_sent %} ({{ hometutor_my_pending_sent }}){% endif %}</a>
                </div>
            </div>

            <form
                class="rounded-xl border border-emerald-200 bg-white p-3 md:p-4"
                hx-get="{{ url('hometutor:quick_tutor_search') }}"
                hx-target="#quick-tutor-results"
                hx-swap="innerHTML"
                hx-indicator="#quick-search-indicator"
            >
                <input type="hidden" name="parent_gate" value="{{ '1' if parent_gate_enabled else '0' }}">
                <div class="grid grid-cols-1 gap-3 md:grid-cols-5">
                    <input type="text" name="subject" placeholder="Subject (Math, Physics)" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                    <input type="number" name="class_min" min="1" max="12" placeholder="Class" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                    <select name="mode" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                        <option value="">Any mode</option>
                        <option value="ONLINE">Online</option>
                        <option value="OFFLINE">Offline</option>
                        <option value="HYBRID">Hybrid</option>
                    </select>
                    <input type="text" name="city" value="{{ hometutor_pilot_city }}" placeholder="City" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                    <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-emerald-500">Find tutors</button>
                </div>
                <p class="mt-2 text-xs text-slate-500">Tip: Click "View full profile" to request demo instantly.</p>
            </form>

            <div id="quick-search-indicator" class="htmx-indicator text-xs font-black uppercase tracking-widest text-emerald-700">Loading tutors...</div>
            <div id="quick-tutor-results">
                {% set tutor_cards = quick_tutor_cards %}
                {% set enable_compare = true %}
                {% set dashboard_mode = true %}
                {% include "hometutor/partials/_tutor_search_results.jinja" %}
            </div>

            <div x-show="compare.length > 0" x-cloak class="rounded-xl border border-indigo-200 bg-indigo-50 p-3 md:p-4">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <p class="text-xs font-black uppercase tracking-widest text-indigo-700">Shortlist compare</p>
                        <p class="text-sm text-slate-700">Compare up to 3 tutors and open profiles in new tabs.</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button
                            type="button"
                            @click="window.location.href='{{ url('hometutor:compare_tutors') }}?' + compare.map((x) => 't=' + encodeURIComponent(x.slug)).join('&')"
                            class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500"
                        >
                            Compare now
                        </button>
                        <button type="button" @click="compare = []" class="rounded-lg border border-indigo-200 bg-white px-3 py-1.5 text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Clear</button>
                    </div>
                </div>
                <div class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-3">
                    <template x-for="item in compare" :key="item.slug">
                        <a :href="item.url" target="_blank" class="rounded-xl border border-indigo-200 bg-white px-3 py-2 text-sm font-bold text-slate-800 hover:bg-indigo-100" x-text="item.name"></a>
                    </template>
                </div>
            </div>
        </div>
    </section>

    <section class="w-full rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Booking funnel</p>
                <h2 class="text-lg font-black tracking-tight text-slate-900">Request to confirmed learning</h2>
                <p class="mt-0.5 text-xs text-slate-600">Where your tutor booking stands.</p>
            </div>
            <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-100">Open my requests</a>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-2 lg:grid-cols-5">
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Requested</p>
                <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ student_demo_pending }}</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Accepted</p>
                <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ student_demo_accepted }}</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Active</p>
                <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ student_active_engagements }}</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Paid</p>
                <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ student_paid_count }}</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Declined</p>
                <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ student_demo_declined }}</p>
            </div>
        </div>
        {% if parent_gate_enabled %}
        <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold text-amber-900">
            <span class="font-black uppercase tracking-wider">Practice mode:</span> demo buttons show parent-approval copy. Real parent accounts approve demos from <a href="{{ url('hometutor:my_demo_requests') }}" class="text-amber-800 underline">My demos</a>.
        </p>
        {% endif %}

        <div class="mt-4 grid gap-3 md:grid-cols-2">
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Recent demos</h3>
                {% if student_recent_demos %}
                <div class="mt-3 space-y-2">
                    {% for d in student_recent_demos %}
                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="text-sm font-black text-slate-900">{{ d.tutor.display_name }}</p>
                        <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">{{ d.get_status_display() }}</p>
                        {% if d.scheduled_at %}
                        <p class="mt-1 text-xs text-slate-500">Scheduled: {{ d.scheduled_at.strftime('%d %b %Y %H:%M') }}</p>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="mt-3 text-sm text-slate-500">No demo requests yet. Start by booking a tutor above.</p>
                {% endif %}
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Engagements</h3>
                {% if student_recent_engagements %}
                <div class="mt-3 space-y-2">
                    {% for e in student_recent_engagements %}
                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="text-sm font-black text-slate-900">{{ e.tutor_profile.display_name }}</p>
                        <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">{{ e.get_status_display() }}</p>
                        <div class="mt-2 flex flex-wrap gap-2">
                            <a href="{{ url('hometutor:engagement_room', pk=e.pk) }}" class="inline-flex rounded-lg border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Open room</a>
                            {% if e.pk not in student_paid_engagement_ids and e.status == 'ACTIVE' %}
                            <a href="{{ url('hometutor_payments:pay_checkout', engagement_id=e.pk) }}" class="inline-flex rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100">Complete payment</a>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="mt-3 text-sm text-slate-500">No active engagements yet. Accept and confirm a demo to continue.</p>
                {% endif %}
            </div>
        </div>
    </section>

    {% if weak_topic_tutor_cards %}
    <section class="w-full rounded-xl border border-indigo-100 bg-indigo-50/50 p-4 shadow-sm md:p-5">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-700 mb-1">Weak-area support</p>
                <h2 class="text-xl font-black text-slate-900 tracking-tight">Recommended tutors for your weak topics</h2>
                {% if weak_terms %}
                <p class="mt-1 text-sm text-slate-600">Based on recent weak concepts: {{ weak_terms|join(', ') }}</p>
                {% endif %}
            </div>
            <a href="{{ url('assessment:index') }}" class="inline-flex items-center justify-center rounded-xl border border-indigo-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">Retake diagnostic</a>
        </div>
        <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
            {% set enable_compare = false %}
            {% set dashboard_mode = true %}
            {% for t in weak_topic_tutor_cards %}
            {% include "hometutor/partials/_tutor_card.jinja" %}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# Main + sidebar: flex gives the journey card all remaining width; sidebar fixed narrow #}
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-6">
        
        {# Main: learning path + secondary row — grows to fill #}
        <div class="min-w-0 flex w-full flex-1 flex-col gap-6">

            <section class="scroll-mt-24 w-full rounded-xl border border-indigo-100 bg-indigo-50/50 p-4 shadow-sm md:p-5">
                <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-lg font-black tracking-tight text-slate-900">Learning journey</h2>
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Complete each skill to unlock the next.</p>
                    </div>
                </div>

                <div class="mb-4 flex w-fit flex-wrap gap-1 rounded-xl border border-indigo-100 bg-white p-1">
                    {% for path in all_paths %}
                        <a href="?path={{ path.id }}"
                           class="rounded-lg px-3 py-2 text-[11px] font-black uppercase tracking-wider transition-all {{ 'bg-indigo-600 text-white' if (selected_path and selected_path.id == path.id) else 'text-slate-500 hover:text-indigo-600' }}">
                            {{ path.name }}
                        </a>
                    {% endfor %}
                </div>

                {% if learning_path %}
                    {% include "dashboard/components/progress_table.jinja" %}
                {% else %}
                    <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center">
                        <p class="text-sm font-black text-slate-800 mb-2">No modules available yet</p>
                        <p class="text-xs font-bold text-slate-500 mb-5">Add skills and questions in /sd/ to build the learning path.</p>
                        <a href="/sd/assessment/skill/add/" class="inline-block bg-indigo-600 text-white text-xs font-black px-6 py-3 rounded-xl uppercase tracking-widest hover:bg-indigo-700">Add a skill in /sd/</a>
                    </div>
                {% endif %}

                <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                    <a href="{{ url('assessment:index') }}" class="flex flex-1 items-center justify-between gap-3 rounded-xl bg-slate-900 p-4 text-white hover:bg-slate-800">
                        <div>
                            <p class="text-sm font-black">Diagnostic test</p>
                            <p class="text-[10px] font-bold uppercase tracking-wider text-white/70">Find weak areas</p>
                        </div>
                        <span class="text-white/40" aria-hidden="true">→</span>
                    </a>
                </div>
            </section>

            <section class="w-full rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
                <h2 class="text-sm font-black uppercase tracking-wider text-slate-700">Activity</h2>
                {% if student_activity %}
                <div class="mt-3 space-y-2">
                    {% for item in student_activity %}
                    <div class="rounded-lg border border-slate-100 bg-slate-50 px-3 py-2">
                        <p class="text-sm font-bold text-slate-900">{{ item.title }}</p>
                        <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ item.meta.strftime('%d %b %Y %H:%M') }}</p>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="mt-3 text-sm text-slate-500">No recent activity yet. Start with a test or tutor booking.</p>
                {% endif %}
            </section>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <a href="{{ url('learning:index') }}" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-colors hover:border-indigo-200 hover:bg-indigo-50/40">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-xs font-black text-indigo-700">Vid</div>
                    <div class="min-w-0">
                        <p class="text-sm font-black text-slate-900">Video library</p>
                        <p class="text-[11px] font-semibold text-slate-600">Micro-lessons</p>
                    </div>
                </a>
                <a href="{{ url('core:earnings') }}" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-colors hover:border-emerald-200 hover:bg-emerald-50/50">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-xs font-black text-emerald-800">Earn</div>
                    <div class="min-w-0">
                        <p class="text-sm font-black text-slate-900">Earn rewards</p>
                        <p class="text-[11px] font-semibold text-slate-600">Tasks & wallet</p>
                    </div>
                </a>
            </div>

            <div class="rounded-xl border border-indigo-100 bg-indigo-50/70 p-4">
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-700">Student path</p>
                <h3 class="mt-1 text-base font-black text-slate-900 md:text-lg">Tests + tutors</h3>
                <p class="mt-1 text-xs leading-snug text-slate-600 md:text-sm">Use diagnostics and demos together when you want guided help.</p>
            </div>
        </div>

        {# Sidebar: use widths that exist in built app.css (see tailwind build) #}
        <aside class="flex w-full shrink-0 flex-col gap-4 lg:w-[17rem] lg:max-w-[17rem]">
            {% if unread_notifications > 0 %}
            <a href="{{ url('dashboard:notifications') }}" class="group flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 p-3 shadow-sm">
                <span class="text-xs font-black text-rose-800">{{ unread_notifications }} new notification{% if unread_notifications != 1 %}s{% endif %}</span>
                <span class="text-rose-400 group-hover:translate-x-0.5 transition-transform text-sm" aria-hidden="true">→</span>
            </a>
            {% endif %}

            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <h3 class="mb-3 text-[10px] font-black uppercase tracking-wider text-slate-500">Last test</h3>
                {% if latest_attempt %}
                    <div class="text-center">
                        <p class="text-[11px] font-black uppercase tracking-wider text-slate-600">{{ latest_attempt.skill.name }}</p>
                        <p class="my-2 text-4xl font-black tabular-nums {% if latest_attempt.passed %}text-emerald-600{% else %}text-rose-600{% endif %}">
                            {{ latest_attempt.score }}<span class="text-lg">%</span>
                        </p>
                        <p class="text-[10px] font-black uppercase tracking-wider {% if latest_attempt.passed %}text-emerald-700{% else %}text-rose-700{% endif %}">
                            {% if latest_attempt.passed %}Passed{% else %}Retry{% endif %}
                        </p>
                    </div>
                {% else %}
                    <p class="text-xs font-bold text-slate-300 text-center py-8">No tests taken yet. Start with a module!</p>
                {% endif %}
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <h3 class="text-[10px] font-black uppercase tracking-wider text-slate-500">Shortcuts</h3>
                <div class="mt-2 space-y-1.5">
                    <a href="{{ url('hometutor:my_demo_requests') }}" class="block rounded-lg border border-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Demos</a>
                    <a href="{{ url('learning:index') }}" class="block rounded-lg border border-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Videos</a>
                    <a href="{{ url('assessment:index') }}" class="block rounded-lg border border-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Tests</a>
                </div>
            </div>

        </aside>
    </div>
</div>
{% endblock %}
