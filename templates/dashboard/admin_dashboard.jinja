{% extends "base.jinja" %}
{% block title %}Command Centre - RankJee Admin{% endblock %}

{% block content %}
<div class="flex flex-col lg:flex-row min-h-[calc(100vh-3.5rem)] bg-slate-50" x-data="{ sidebarOpen: false }">
    
    {# Mobile Header #}
    <div class="lg:hidden bg-slate-900 text-white p-4 flex justify-between items-center border-b border-slate-800">
        <h2 class="text-sm font-black tracking-tighter uppercase">RankJee Admin</h2>
        <button @click="sidebarOpen = !sidebarOpen" class="p-2 bg-slate-800 rounded-lg">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
    </div>

    {# Sidebar #}
    <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'" 
           class="fixed lg:relative z-40 w-64 h-full bg-slate-900 text-slate-400 border-r border-slate-800 transition-transform duration-300 ease-in-out flex flex-col">
        
        <div class="p-6 border-b border-slate-800/50">
            <div class="flex items-center gap-2 mb-6 text-white">
                <span class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-black text-xs shadow-lg shadow-indigo-500/20">A</span>
                <h2 class="text-sm font-black uppercase tracking-widest leading-none">Command Center</h2>
            </div>

            <nav class="flex flex-col gap-1">
                <a href="{{ url('dashboard:index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-slate-800 text-white font-bold transition-all border border-slate-700">
                    <span class="text-sm opacity-70">📊</span> Dashboard
                </a>
                <a href="{{ url('dashboard:cms_home') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🧩</span> Content CMS
                </a>
                <a href="/sd/users/customuser/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">👥</span> Students Management
                </a>
                <a href="{{ url('dashboard:students_score_table') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">📈</span> Students Score Table
                </a>
                <a href="{{ url('dashboard:admin_student_daily_logs') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">📓</span> Student Daily Log
                </a>
                {% if request.user.is_superuser %}
                <a href="{{ url('dashboard:users_referral_table') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🤝</span> Users Referral Table
                </a>
                <a href="{{ url('dashboard:seo_smart_view') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🧠</span> SEO Smart View
                </a>
                {% endif %}
                <a href="/sd/assessment/skillpath/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🛤️</span> Skill Paths
                </a>
                <a href="/sd/assessment/skill/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🎯</span> Skill Inventory
                </a>
                <a href="/sd/assessment/question/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">📝</span> Question Bank
                </a>
                <a href="/sd/assessment/dailyjackpot/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🎰</span> Daily Jackpot
                </a>
                <a href="/sd/core/earningtask/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">💰</span> Freelance Tasks
                </a>
                <a href="/sd/core/course/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🎓</span> Courses CMS
                </a>
                <a href="/sd/core/coursereferral/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🤝</span> Course Referrals
                </a>
                <a href="/sd/users/withdrawalrequest/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🏧</span> UPI Withdrawals
                </a>
                <a href="/sd/users/wallettransaction/" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">📒</span> Wallet ledger
                </a>
                <a href="{{ url('dashboard:import_questions') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">📥</span> Import Questions (CSV)
                </a>
                <a href="{{ url('dashboard:ai_generate_mcqs') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-all">
                    <span class="text-sm opacity-70">🤖</span> AI MCQ Generator
                </a>
            </nav>
        </div>

        <div class="p-6">
            <h3 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-4">Quick Shortcuts</h3>
            <div class="flex flex-col gap-2">
                <a href="/sd/assessment/question/add/" class="text-xs font-bold hover:text-indigo-400 flex items-center gap-2"><span>➕</span> Add Question</a>
                <a href="/sd/learning/conceptvideo/add/" class="text-xs font-bold hover:text-indigo-400 flex items-center gap-2"><span>🎬</span> New Video</a>
                <a href="/sd/core/earningtask/add/" class="text-xs font-bold hover:text-indigo-400 flex items-center gap-2"><span>💵</span> Post Task</a>
            </div>
        </div>

        <div class="p-6 mt-auto">
            <div class="bg-slate-800/40 rounded-xl p-4 border border-slate-700/30">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-black uppercase tracking-widest text-slate-500">Live Health</span>
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                </div>
                <div class="flex items-center gap-2 mb-3">
                    <p class="text-xs font-bold text-slate-300">DB Consistency</p>
                    <div class="flex-grow h-1 bg-slate-700 rounded-full overflow-hidden">
                        <div class="bg-emerald-500 h-full w-[94%]"></div>
                    </div>
                </div>
                <a href="/sd/" class="block text-center text-xs font-black uppercase tracking-widest py-2 bg-slate-700 rounded-lg text-slate-300 hover:bg-slate-600 border border-slate-600/50 transition-all">
                    Advanced Admin /sd/
                </a>
            </div>
        </div>
    </aside>

    {# Main Content #}
    <main class="flex-grow p-4 lg:p-6 overflow-y-auto">
        
        {# Welcome Box #}
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-3">
                    Platform Overview 
                    <span class="bg-white border border-slate-200 text-slate-500 text-xs uppercase font-black px-2 py-0.5 rounded-full shadow-sm">Real-time</span>
                    <span class="bg-fuchsia-50 border border-fuchsia-200 text-fuchsia-700 text-xs uppercase font-black px-2 py-0.5 rounded-full shadow-sm">{{ admin_role|replace('_', ' ') }}</span>
                </h1>
                <p class="text-slate-600 text-sm font-medium">Scope: <strong>{{ admin_scope_label }}</strong>. Hello {{ request.user.username }}, you have <strong>{{ pending_count }}</strong> tasks awaiting review{% if pending_withdrawals_count %}; <strong>{{ pending_withdrawals_count }}</strong> UPI withdrawal(s) pending{% endif %}.</p>
            </div>
            
            <div class="flex items-center gap-3 w-full md:w-auto">
                <form action="" method="GET" class="relative flex-grow md:w-64">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 opacity-40">🔍</span>
                    <input type="text" name="q" value="{{ search_query }}" placeholder="Search students..." 
                           class="w-full bg-white border border-slate-200 rounded-lg pl-9 pr-4 py-2 text-sm focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 outline-none transition-all shadow-sm">
                </form>
                <div class="hidden sm:flex h-10 w-10 rounded-full bg-slate-900 text-white items-center justify-center font-black text-xs ring-4 ring-slate-100">
                    {{ request.user.username[0]|upper }}
                </div>
            </div>
        </div>

        {# Core Performance Cards #}
        <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">
            <div class="p-4 border-b border-slate-100 bg-emerald-50/40 flex justify-between items-center">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-800 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Tutor Requirement Requests
                </h3>
                <span class="text-xs font-black text-slate-600">{{ tutor_requests_count }} total</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left min-w-[880px]">
                    <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600 border-b">
                        <tr>
                            <th class="px-5 py-3">Created</th>
                            <th class="px-5 py-3">Requester</th>
                            <th class="px-5 py-3">Type</th>
                            <th class="px-5 py-3">Location</th>
                            <th class="px-5 py-3">Requirement</th>
                            <th class="px-5 py-3">Budget</th>
                            <th class="px-5 py-3">Status</th>
                            <th class="px-5 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for row in latest_tutor_requests %}
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-5 py-3 text-xs font-bold text-slate-600 whitespace-nowrap">{{ row.created_at.strftime('%d %b %Y · %H:%M') }}</td>
                            <td class="px-5 py-3">
                                <p class="text-xs font-black text-slate-900">{{ row.full_name }}</p>
                                <p class="text-[11px] text-slate-500">{{ row.phone }}{% if row.email %} · {{ row.email }}{% endif %}</p>
                            </td>
                            <td class="px-5 py-3 text-xs font-bold text-slate-700">{{ row.get_requester_type_display() }}</td>
                            <td class="px-5 py-3 text-xs font-bold text-slate-700">{{ row.city }}{% if row.area %} · {{ row.area }}{% endif %}</td>
                            <td class="px-5 py-3 text-xs text-slate-700">
                                {{ row.subjects }}{% if row.class_grade %} · Class {{ row.class_grade }}{% endif %}{% if row.board %} · {{ row.board }}{% endif %}
                            </td>
                            <td class="px-5 py-3 text-xs font-black text-emerald-700">{% if row.budget_inr %}₹{{ row.budget_inr }}{% else %}N/A{% endif %}</td>
                            <td class="px-5 py-3">
                                <span class="inline-flex rounded-full px-2 py-1 text-[11px] font-black bg-indigo-100 text-indigo-700">{{ row.get_status_display() }}</span>
                            </td>
                            <td class="px-5 py-3 text-right">
                                <div class="flex justify-end gap-2">
                                    <form method="post" action="{{ url('dashboard:update_tutor_request_status', request_id=row.id) }}" class="inline">
                                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                        <input type="hidden" name="status" value="NEW">
                                        <button type="submit" class="inline-flex rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-100">New</button>
                                    </form>
                                    <form method="post" action="{{ url('dashboard:update_tutor_request_status', request_id=row.id) }}" class="inline">
                                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                        <input type="hidden" name="status" value="CONTACTED">
                                        <button type="submit" class="inline-flex rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-amber-700 hover:bg-amber-100">Contacted</button>
                                    </form>
                                    <form method="post" action="{{ url('dashboard:update_tutor_request_status', request_id=row.id) }}" class="inline">
                                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                        <input type="hidden" name="status" value="CLOSED">
                                        <button type="submit" class="inline-flex rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100">Closed</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="px-5 py-8 text-center text-slate-400 font-bold text-sm">No tutor requirement requests yet.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col hover:shadow-md transition-shadow group">
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-black uppercase text-slate-600 tracking-widest">Total Payouts</span>
                    <span class="bg-emerald-50 text-emerald-600 p-1.5 rounded-lg text-lg ring-1 ring-emerald-100">💰</span>
                </div>
                <p class="text-2xl font-black text-slate-900">₹{{ "{:,.0f}".format(total_payouts) }}</p>
                <p class="text-xs text-slate-500 font-bold mt-2 flex items-center gap-1">
                    <span class="text-emerald-500">↑ 12%</span> vs last month
                </p>
            </div>
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col hover:shadow-md transition-shadow group">
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-black uppercase text-slate-600 tracking-widest">Platform Density</span>
                    <span class="bg-indigo-50 text-indigo-600 p-1.5 rounded-lg text-lg ring-1 ring-indigo-100">⚡</span>
                </div>
                <p class="text-2xl font-black text-slate-900">{{ total_questions }} Qs / {{ total_videos }} Vs</p>
                <div class="w-full bg-slate-100 h-1 rounded-full mt-3 overflow-hidden">
                    <div class="bg-indigo-500 h-full w-[65%]"></div>
                </div>
            </div>
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col hover:shadow-md transition-shadow group">
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-black uppercase text-slate-600 tracking-widest">Growth Velocity</span>
                    <span class="bg-amber-50 text-amber-600 p-1.5 rounded-lg text-lg ring-1 ring-amber-100">🚀</span>
                </div>
                <p class="text-2xl font-black text-slate-900">+{{ recent_registrations }} New</p>
                <p class="text-xs text-slate-500 font-bold mt-2 uppercase">Last 7 Days activity</p>
            </div>
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col hover:shadow-md transition-shadow group">
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-black uppercase text-slate-600 tracking-widest">Awaiting Review</span>
                    <span class="{{ 'bg-rose-50 text-rose-600' if pending_count > 0 else 'bg-slate-50 text-slate-400' }} p-1.5 rounded-lg text-lg ring-1 ring-slate-100">🛂</span>
                </div>
                <p class="text-2xl font-black {{ 'text-rose-600' if pending_count > 0 else 'text-slate-900' }}">{{ pending_count }} Tasks</p>
                <p class="text-xs text-slate-500 font-bold mt-2 uppercase">Action required ASAP</p>
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
            
            {# Left Side: Student Management & Review #}
            <div class="xl:col-span-2 space-y-6">
                
                {# Student Management Table #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="p-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                        <h3 class="text-xs font-black uppercase tracking-widest text-slate-800 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Student Directory
                        </h3>
                        <div class="flex gap-2 items-center">
                            <a href="{{ url('dashboard:students_score_table') }}" class="p-1.5 px-3 border border-indigo-200 bg-indigo-50 rounded text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">
                                Open students score view
                            </a>
                            {% if students_page.has_previous() %}
                                <a href="?page={{ students_page.previous_page_number() }}{% if search_query %}&q={{ search_query }}{% endif %}" class="p-1 px-2 border border-slate-200 rounded hover:bg-white text-xs font-bold">Prev</a>
                            {% endif %}
                            <span class="p-1 px-2 text-xs font-bold text-slate-600">Page {{ students_page.number }} of {{ students_page.paginator.num_pages }}</span>
                            {% if students_page.has_next() %}
                                <a href="?page={{ students_page.next_page_number() }}{% if search_query %}&q={{ search_query }}{% endif %}" class="p-1 px-2 border border-slate-200 rounded hover:bg-white text-xs font-bold">Next</a>
                            {% endif %}
                        </div>
                    </div>
                    <div class="overflow-x-auto overflow-y-auto max-h-[450px]">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50/80 sticky top-0 backdrop-blur-sm text-xs uppercase font-black tracking-widest text-slate-600 border-b">
                                <tr>
                                    <th class="px-5 py-3">Student</th>
                                    <th class="px-5 py-3">Streak</th>
                                    <th class="px-5 py-3">Wallet</th>
                                    <th class="px-5 py-3 text-right">Activity</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for s in students_page %}
                                <tr class="hover:bg-indigo-50/30 transition-colors">
                                    <td class="px-5 py-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-black border border-slate-200">
                                                {{ s.username[0]|upper }}
                                            </div>
                                            <div>
                                                <p class="text-xs font-black text-slate-900 leading-none">{{ s.username }}</p>
                                                <p class="text-xs text-slate-600 mt-1 uppercase tracking-tighter">{{ s.email|truncate(20) }}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-5 py-3">
                                        {% if s.streak_days > 0 %}
                                            <span class="inline-flex items-center gap-1 text-xs font-black text-orange-600 bg-orange-50 px-2 py-0.5 rounded-full ring-1 ring-orange-200/50">🔥 {{ s.streak_days }}</span>
                                        {% else %}
                                            <span class="text-xs font-bold text-slate-300">Inactive</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-5 py-3">
                                        <p class="text-xs font-black text-emerald-600">₹{{ s.wallet_balance|int }}</p>
                                    </td>
                                    <td class="px-5 py-3 text-right">
                                        <div class="flex flex-col items-end">
                                            <p class="text-xs font-black text-slate-900">{{ s.xp_points }} XP</p>
                                            <div class="flex gap-1 mt-1">
                                                <div class="w-2 h-0.5 bg-emerald-400 rounded-full" title="Active"></div>
                                                <div class="w-2 h-0.5 bg-slate-200 rounded-full"></div>
                                                <div class="w-2 h-0.5 bg-slate-200 rounded-full"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>

                {# Student daily class logs #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="p-4 border-b border-slate-100 bg-indigo-50/40 flex justify-between items-center">
                        <h3 class="text-xs font-black uppercase tracking-widest text-slate-800 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Student Daily Log
                        </h3>
                        <a href="{{ url('dashboard:admin_student_daily_logs') }}" class="text-xs font-black text-indigo-600 hover:underline">Open full log →</a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left min-w-[720px]">
                            <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600 border-b">
                                <tr>
                                    <th class="px-5 py-3">Date</th>
                                    <th class="px-5 py-3">Student</th>
                                    <th class="px-5 py-3">Topic</th>
                                    <th class="px-5 py-3">Attendance</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for row in recent_daily_class_logs %}
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-5 py-3 text-xs font-bold text-slate-600 whitespace-nowrap">{{ row.log_date.strftime('%d %b %Y') }}</td>
                                    <td class="px-5 py-3">
                                        <p class="text-xs font-black text-slate-900">{{ row.user.username }}</p>
                                        <p class="text-[11px] text-slate-500">{{ row.user.email|truncate(28) }}</p>
                                    </td>
                                    <td class="px-5 py-3 text-xs font-bold text-slate-800">{{ row.topic|truncate(48) }}</td>
                                    <td class="px-5 py-3 whitespace-nowrap">
                                        {% if row.attendance == 'PRESENT' %}
                                        <span class="inline-flex rounded-full px-2 py-1 text-[11px] font-black bg-emerald-100 text-emerald-700">Present</span>
                                        {% else %}
                                        <span class="inline-flex rounded-full px-2 py-1 text-[11px] font-black bg-rose-100 text-rose-700">Absent</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="px-5 py-8 text-center text-slate-400 font-bold text-sm">No student class logs yet.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>

                {# Latest failed attempts quick review #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="p-4 border-b border-slate-100 bg-amber-50/40 flex justify-between items-center">
                        <h3 class="text-xs font-black uppercase tracking-widest text-slate-800 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span> Latest failed attempts
                        </h3>
                        <a href="{{ url('dashboard:students_score_table') }}" class="text-xs font-black text-indigo-600 hover:underline">Open full score view →</a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600 border-b">
                                <tr>
                                    <th class="px-5 py-3">Student</th>
                                    <th class="px-5 py-3">Skill</th>
                                    <th class="px-5 py-3">Score</th>
                                    <th class="px-5 py-3">When</th>
                                    <th class="px-5 py-3 text-right">Review</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for a in recent_failed_attempts %}
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-5 py-3">
                                        <p class="text-xs font-black text-slate-900">{{ a.user.username }}</p>
                                        <p class="text-xs text-slate-600">{{ a.user.email|truncate(24) }}</p>
                                    </td>
                                    <td class="px-5 py-3 text-xs font-bold text-slate-800">{{ a.skill.name if a.skill else 'General Test' }}</td>
                                    <td class="px-5 py-3">
                                        <span class="inline-flex rounded-full px-2 py-1 text-xs font-black bg-rose-100 text-rose-700">
                                            {{ a.score }}%
                                        </span>
                                    </td>
                                    <td class="px-5 py-3 text-xs text-slate-600">{{ a.attempt_date.strftime('%d %b %Y · %H:%M') }}</td>
                                    <td class="px-5 py-3 text-right">
                                        <a href="{{ url('dashboard:student_attempt_review', a.id) }}" class="inline-flex rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-amber-700 hover:bg-amber-100">
                                            Wrong Q&A
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="px-5 py-8 text-center text-slate-400 font-bold text-sm">No failed attempts found recently.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>

                {# Task Approvals #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="p-4 border-b border-slate-100 bg-rose-50/30 flex justify-between items-center">
                        <h3 class="text-xs font-black uppercase tracking-widest text-slate-800 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> Tasks Awaiting Review
                        </h3>
                        <span class="text-xs font-black text-slate-600">{{ pending_count }} Submissions</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600 border-b">
                                <tr>
                                    <th class="px-5 py-3">User</th>
                                    <th class="px-5 py-3">Task Details</th>
                                    <th class="px-5 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for sub in pending_submissions %}
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-5 py-4">
                                        <p class="text-xs font-black text-slate-900">{{ sub.user.username }}</p>
                                        <p class="text-xs text-slate-600 uppercase">{{ sub.submitted_at.strftime('%d %b · %H:%M') }}</p>
                                    </td>
                                    <td class="px-5 py-4">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-indigo-700">{{ sub.task.title }}</span>
                                            <span class="text-xs font-bold bg-indigo-50 text-indigo-500 px-1.5 py-0.5 rounded">₹{{ sub.task.reward_amount }}</span>
                                        </div>
                                        <a href="{{ sub.proof_url }}" target="_blank" class="text-xs text-slate-600 hover:text-indigo-600 underline mt-1 block truncate max-w-xs">View Proof: {{ sub.proof_url }}</a>
                                    </td>
                                    <td class="px-5 py-4 text-right">
                                        <div class="flex justify-end gap-2">
                                            <form action="{{ url('core:admin_reject', sub.id) }}" method="POST" class="inline">
                                                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                                <button type="submit" class="p-2 border border-slate-200 text-rose-500 bg-white rounded-lg hover:bg-rose-50 transition-all opacity-60 hover:opacity-100">
                                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                </button>
                                            </form>
                                            <form action="{{ url('core:admin_approve', sub.id) }}" method="POST" class="inline">
                                                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                                <button type="submit" class="p-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-all shadow-sm shadow-emerald-200">
                                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr><td colspan="3" class="px-5 py-12 text-center text-slate-400 font-bold text-sm">No pending submissions. Great job!</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>

                {# Pending UPI withdrawals — process in /sd/ #}
                <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="p-4 border-b border-slate-100 bg-amber-50/40 flex justify-between items-center">
                        <h3 class="text-xs font-black uppercase tracking-widest text-slate-800 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span> UPI withdrawals
                        </h3>
                        <a href="/sd/users/withdrawalrequest/" class="text-xs font-black text-indigo-600 hover:underline">Open in /sd/ →</a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600 border-b">
                                <tr>
                                    <th class="px-5 py-3">User</th>
                                    <th class="px-5 py-3">Amount</th>
                                    <th class="px-5 py-3">UPI ID</th>
                                    <th class="px-5 py-3">Requested</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for w in pending_withdrawals %}
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-5 py-3 text-xs font-black text-slate-900">{{ w.user.username }}</td>
                                    <td class="px-5 py-3 text-xs font-bold text-emerald-600">₹{{ w.amount }}</td>
                                    <td class="px-5 py-3 text-xs font-mono text-slate-600 break-all max-w-[140px]">{{ w.upi_id }}</td>
                                    <td class="px-5 py-3 text-xs text-slate-600">{{ w.requested_at.strftime('%d %b %Y · %H:%M') }}</td>
                                </tr>
                                {% else %}
                                <tr><td colspan="4" class="px-5 py-8 text-center text-slate-400 font-bold text-sm">No pending withdrawals.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="px-4 py-2 text-xs text-slate-500 bg-slate-50 border-t border-slate-100">Mark processed or rejected using Actions in Django Admin after manual UPI transfer.</p>
                </section>
            </div>

            {# Right Side: Platform Analytics & Trends #}
            <aside class="space-y-6">
                
                {# Difficult Skills #}
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
                    <h3 class="text-xs font-black uppercase tracking-widest text-slate-800 mb-4 flex items-center justify-between">
                        Hurdle Topics
                        <span class="text-xs text-rose-500 bg-rose-50 px-2 py-0.5 rounded border border-rose-100">Attention Required</span>
                    </h3>
                    <div class="space-y-3">
                        {% for s in difficult_skills %}
                        <div class="flex flex-col gap-1.5 p-3 bg-slate-50 border border-slate-100 rounded-xl">
                            <div class="flex justify-between items-center">
                                <span class="text-xs font-black text-slate-900 truncate w-32">{{ s.name }}</span>
                                <span class="text-xs font-black text-rose-600">{{ "{:,.0f}%".format(s.avg_score) }} Avg</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="flex-grow bg-slate-200 h-1 rounded-full overflow-hidden">
                                    <div class="bg-rose-500 h-full" style="width: {{ s.avg_score }}%"></div>
                                </div>
                                <span class="text-xs font-bold text-slate-600 whitespace-nowrap">{{ s.total_attempts }} Tries</span>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                {# Platform Trends #}
                <div class="bg-slate-900 rounded-xl p-5 text-white shadow-xl shadow-slate-200 relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/10 rounded-full blur-3xl -mr-16 -mt-16"></div>
                    <h3 class="text-xs font-black uppercase tracking-widest text-white/50 mb-5">7-Day Engagement Trend</h3>
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-6 h-6 rounded-full bg-indigo-700 border border-slate-900 flex items-center justify-center text-xs font-black">S</div>
                        <div class="w-6 h-6 rounded-full bg-slate-800 border-2 border-slate-900 flex items-center justify-center text-xs font-black">+{{ total_users - 2 }}</div>
                    </div>
                    <p class="text-xs font-bold text-slate-400 italic">Antigravity V1.0 Core</p>
                </div>

            </aside>
        </div>
    </main>
</div>
{% endblock %}
