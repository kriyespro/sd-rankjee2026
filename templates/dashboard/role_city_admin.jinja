{% extends "base.jinja" %}
{% block title %}City Admin Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8">
    <div class="mb-8">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-fuchsia-700">City operations</p>
        <h1 class="mt-2 text-3xl font-black text-slate-900">Run local quality and growth</h1>
        <p class="mt-2 text-sm text-slate-600">Track verification backlog, dispute queue, and payout risk signals.</p>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {% for card in kpi_cards %}
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">{{ card.label }}</p>
            <p class="mt-1 text-2xl font-black text-slate-900">{{ card.value }}</p>
        </div>
        {% endfor %}
    </div>

    <div class="mt-6 rounded-2xl border border-fuchsia-200 bg-fuchsia-50 p-4">
        <p class="text-xs font-black uppercase tracking-widest text-fuchsia-700">Quick actions</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
            <a href="{{ url('study:student_hub') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-fuchsia-800 hover:bg-fuchsia-100">Study</a>
            <a href="/sd/hometutor/tutorprofile/?verification_status__exact=PENDING" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-fuchsia-800 hover:bg-fuchsia-100">Review KYC queue</a>
            <a href="/sd/hometutor/engagementdispute/" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-fuchsia-800 hover:bg-fuchsia-100">Resolve disputes</a>
            <a href="/sd/users/withdrawalrequest/?status__exact=PENDING" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-fuchsia-800 hover:bg-fuchsia-100">Check withdrawals</a>
            <a href="{{ url('dashboard:index') }}" class="inline-flex items-center justify-center rounded-xl bg-fuchsia-600 px-3 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-fuchsia-500">Refresh city board</a>
        </div>
        {% if city_sla_risk_count > 0 %}
        <p class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-black uppercase tracking-wider text-rose-800">
            {{ city_sla_risk_count }} city ops item{% if city_sla_risk_count != 1 %}s{% endif %} breached SLA windows.
        </p>
        {% endif %}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a href="{{ url('dashboard:index') }}" class="rounded-2xl border border-fuchsia-200 bg-fuchsia-50 p-5">
            <p class="text-xs font-black uppercase tracking-widest text-fuchsia-700">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Clear tutor verification queue</h2>
            <p class="mt-1 text-sm text-slate-600">{{ pending_verification }} tutor profiles are pending review.</p>
        </a>
        <a href="{{ url('dashboard:index') }}" class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-black uppercase tracking-widest text-slate-500">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Stabilize dispute and withdrawal queue</h2>
            <p class="mt-1 text-sm text-slate-600">{{ pending_disputes }} disputes and {{ pending_withdrawals }} withdrawals need action.</p>
        </a>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Priority queue</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li>• Review pending tutor KYC and approvals daily.</li>
            <li>• Keep dispute resolution SLA below target threshold.</li>
            <li>• Identify demand hotspots and local tutor shortages weekly.</li>
        </ul>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-black text-slate-900">City funnel and revenue health</h3>
            <span class="text-[11px] font-black uppercase tracking-widest text-slate-500">Last 30 days</span>
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Total demos</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ city_total_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Accepted rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ city_accepted_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ city_accepted_demos }} / {{ city_total_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Active rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ city_active_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ city_active_engagements }} / {{ city_accepted_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Paid rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ city_paid_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ city_paid_count }} / {{ city_active_engagements }}</p>
            </div>
        </div>
        <p class="mt-3 text-sm font-bold text-slate-700">City GMV (30d): ₹{{ city_gmv_30d }}</p>
    </div>

    <div class="mt-6 rounded-2xl border border-fuchsia-200 bg-fuchsia-50 p-5">
        <h3 class="text-sm font-black text-fuchsia-900">Recommended next actions</h3>
        <ul class="mt-3 space-y-2 text-sm text-fuchsia-900">
            {% for item in city_next_actions %}
            <li>• {{ item }}</li>
            {% endfor %}
        </ul>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Verification queue</h3>
                <a href="/sd/hometutor/tutorprofile/?verification_status__exact=PENDING" class="text-xs font-black uppercase tracking-wider text-fuchsia-700 hover:text-fuchsia-900">Open /sd/</a>
            </div>
            {% if latest_pending_tutors %}
            <div class="mt-3 space-y-3">
                {% for t in latest_pending_tutors %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ t.display_name }}</p>
                    {% if t.pk in city_verification_sla_risk_ids %}
                    <p class="mt-1 inline-flex rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-rose-800">SLA risk</p>
                    {% endif %}
                    <p class="mt-1 text-xs text-slate-600">{{ t.subjects|truncate(60) }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">Updated: {{ t.updated_at.strftime('%d %b %Y %H:%M') }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No pending tutor verifications.</p>
            {% endif %}
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Dispute queue</h3>
                <a href="/sd/hometutor/engagementdispute/?status__in=OPEN&status__in=IN_REVIEW" class="text-xs font-black uppercase tracking-wider text-fuchsia-700 hover:text-fuchsia-900">Open /sd/</a>
            </div>
            {% if latest_disputes %}
            <div class="mt-3 space-y-3">
                {% for d in latest_disputes %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ d.engagement.tutor_profile.display_name }} ↔ {{ d.engagement.student.get_username() }}</p>
                    {% if d.pk in city_dispute_sla_risk_ids %}
                    <p class="mt-1 inline-flex rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-rose-800">SLA risk</p>
                    {% endif %}
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">{{ d.get_status_display() }}</p>
                    <p class="mt-1 text-[11px] text-slate-500">{{ d.reason|truncate(90) }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No active disputes right now.</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Activity timeline</h3>
        {% if activity_timeline %}
        <div class="mt-3 space-y-3">
            {% for item in activity_timeline %}
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-sm font-bold text-slate-900">{{ item.title }}</p>
                <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ item.meta.strftime('%d %b %Y %H:%M') }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="mt-3 text-sm text-slate-500">No recent activity yet.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
