{% extends "base.jinja" %}
{% block title %}Daily class log - RankJee{% endblock %}

{% block content %}
<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 pb-10 pt-7 sm:px-8">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <a href="{{ url('dashboard:index') }}" class="text-xs font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-500">← Dashboard</a>
            <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900">Daily class log</h1>
            <p class="mt-1 text-sm text-slate-600">Record what you covered each day and whether you attended.</p>
        </div>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <h2 class="text-xs font-black uppercase tracking-widest text-slate-500">New entry</h2>
        <p class="mt-1 text-xs text-slate-500">One entry per calendar day. Submitting again for the same date updates that entry.</p>

        {% if form.non_field_errors() %}
        <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-800">
            {% for err in form.non_field_errors() %}<p>{{ err }}</p>{% endfor %}
        </div>
        {% endif %}

        <form method="post" class="mt-3 space-y-2.5">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <div class="grid gap-3 md:grid-cols-3">
                <div>
                    <label for="{{ form.log_date.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-widest text-slate-400">Date</label>
                    <input type="date" name="{{ form.log_date.name }}" id="{{ form.log_date.id_for_label }}" value="{{ form.log_date.value() or '' }}" class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-sm bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500">
                    {% if form.log_date.errors %}<div class="mt-1 text-xs font-bold text-rose-600">{% for err in form.log_date.errors %}{{ err }}{% endfor %}</div>{% endif %}
                </div>
                <div>
                    <label for="{{ form.topic.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-widest text-slate-400">Topic</label>
                    <input type="text" name="{{ form.topic.name }}" id="{{ form.topic.id_for_label }}" value="{{ form.topic.value() or '' }}" class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-sm bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500">
                    {% if form.topic.errors %}<div class="mt-1 text-xs font-bold text-rose-600">{% for err in form.topic.errors %}{{ err }}{% endfor %}</div>{% endif %}
                </div>
                <div>
                    <label for="{{ form.attendance.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-widest text-slate-400">Attendance</label>
                    <select name="{{ form.attendance.name }}" id="{{ form.attendance.id_for_label }}" class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-sm bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500">
                        <option value="PRESENT" {% if form.attendance.value() == 'PRESENT' %}selected{% endif %}>Present</option>
                        <option value="ABSENT" {% if form.attendance.value() == 'ABSENT' %}selected{% endif %}>Absent</option>
                    </select>
                    {% if form.attendance.errors %}<div class="mt-1 text-xs font-bold text-rose-600">{% for err in form.attendance.errors %}{{ err }}{% endfor %}</div>{% endif %}
                </div>
            </div>
            <div>
                <label for="{{ form.details.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-widest text-slate-400">Details</label>
                <textarea name="{{ form.details.name }}" id="{{ form.details.id_for_label }}" rows="2" class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-sm bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500">{{ form.details.value() or '' }}</textarea>
                {% if form.details.errors %}<div class="mt-1 text-xs font-bold text-rose-600">{% for err in form.details.errors %}{{ err }}{% endfor %}</div>{% endif %}
            </div>
            <button type="submit" class="w-full rounded-xl bg-indigo-600 py-2 text-xs font-black uppercase tracking-widest text-white hover:bg-indigo-500 sm:w-auto sm:px-8">
                Save log
            </button>
        </form>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
            <h2 class="text-xs font-black uppercase tracking-widest text-slate-800">Your daily logs</h2>
            <div class="flex items-center gap-2">
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-slate-600">{{ logs_page.paginator.count }} total</span>
                <a href="{{ url('dashboard:daily_class_log') }}?view=list" class="rounded-lg border px-3 py-1 text-[11px] font-black uppercase tracking-wider {{ 'border-indigo-300 bg-indigo-50 text-indigo-700' if view_mode == 'list' else 'border-slate-200 text-slate-600 hover:bg-slate-50' }}">List view</a>
                <a href="{{ url('dashboard:daily_class_log') }}?view=calendar&month={{ calendar_month_value }}" class="rounded-lg border px-3 py-1 text-[11px] font-black uppercase tracking-wider {{ 'border-indigo-300 bg-indigo-50 text-indigo-700' if view_mode == 'calendar' else 'border-slate-200 text-slate-600 hover:bg-slate-50' }}">Calendar view</a>
            </div>
        </div>
        {% if view_mode == 'calendar' %}
        <div class="mt-3">
            <div class="mb-3 flex items-center justify-between gap-2">
                <a href="{{ url('dashboard:daily_class_log') }}?view=calendar&month={{ calendar_prev_month }}" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-black text-slate-600 hover:bg-slate-50">← Prev</a>
                <p class="text-sm font-black text-slate-800">{{ calendar_month_label }} <span class="text-xs text-slate-500">({{ calendar_total_logs }} logs)</span></p>
                <a href="{{ url('dashboard:daily_class_log') }}?view=calendar&month={{ calendar_next_month }}" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-black text-slate-600 hover:bg-slate-50">Next →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px] table-fixed border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-[11px] font-black uppercase tracking-widest text-slate-500">
                            <th class="border border-slate-100 px-2 py-1.5">Mon</th>
                            <th class="border border-slate-100 px-2 py-1.5">Tue</th>
                            <th class="border border-slate-100 px-2 py-1.5">Wed</th>
                            <th class="border border-slate-100 px-2 py-1.5">Thu</th>
                            <th class="border border-slate-100 px-2 py-1.5">Fri</th>
                            <th class="border border-slate-100 px-2 py-1.5">Sat</th>
                            <th class="border border-slate-100 px-2 py-1.5">Sun</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for week in calendar_weeks %}
                        <tr>
                            {% for day in week %}
                            <td class="h-24 align-top border border-slate-100 p-1.5 {{ 'bg-white' if day.in_month else 'bg-slate-50/60' }}">
                                <p class="text-[11px] font-black {{ 'text-slate-800' if day.in_month else 'text-slate-400' }}">{{ day.date.day }}</p>
                                <div class="mt-1 space-y-1">
                                    {% for row in day.logs[:2] %}
                                    <div class="rounded border px-1.5 py-0.5 text-[10px] font-bold {{ 'border-green-200 bg-green-50 text-green-700' if row.attendance == 'PRESENT' else 'border-red-200 bg-red-50 text-red-700' }}">
                                        {{ row.topic|truncate(16) }}
                                    </div>
                                    {% endfor %}
                                    {% if day.logs|length > 2 %}
                                    <p class="text-[10px] font-black text-slate-500">+{{ day.logs|length - 2 }} more</p>
                                    {% endif %}
                                </div>
                            </td>
                            {% endfor %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% else %}
        <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[560px] border-collapse text-left">
                <thead class="bg-slate-50 text-[11px] font-black uppercase tracking-widest text-slate-500">
                    <tr>
                        <th class="px-2.5 py-1.5">Date</th>
                        <th class="px-2.5 py-1.5">Topic</th>
                        <th class="px-2.5 py-1.5">Attendance</th>
                        <th class="px-2.5 py-1.5">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for row in logs_page %}
                    <tr class="align-top hover:bg-slate-50">
                        <td class="px-2.5 py-1.5 text-[11px] font-bold text-slate-600 whitespace-nowrap">{{ row.log_date.strftime('%d %b %Y') }}</td>
                        <td class="px-2.5 py-1.5 text-xs font-black text-slate-900">{{ row.topic }}</td>
                        <td class="px-2.5 py-1.5 whitespace-nowrap">
                            {% if row.attendance == 'PRESENT' %}
                            <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-green-700 shadow-[0_0_0_1px_rgba(34,197,94,0.25),0_0_10px_rgba(34,197,94,0.25)]">Present</span>
                            {% else %}
                            <span class="inline-flex rounded-full bg-red-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-red-700 shadow-[0_0_0_1px_rgba(239,68,68,0.25),0_0_10px_rgba(239,68,68,0.25)]">Absent</span>
                            {% endif %}
                        </td>
                        <td class="px-2.5 py-1.5 text-[11px] text-slate-600 max-w-xs">{{ row.details|truncate(120) if row.details else '—' }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="px-3 py-8 text-center text-sm font-bold text-slate-500">No entries yet. Add your first log above.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if logs_page.has_other_pages() %}
        <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4 text-xs font-bold text-slate-600">
            {% if logs_page.has_previous() %}
            <a href="?view=list&page={{ logs_page.previous_page_number() }}" class="rounded-lg border border-slate-200 px-3 py-1.5 hover:bg-slate-50">Previous</a>
            {% endif %}
            <span>Page {{ logs_page.number }} of {{ logs_page.paginator.num_pages }}</span>
            {% if logs_page.has_next() %}
            <a href="?view=list&page={{ logs_page.next_page_number() }}" class="rounded-lg border border-slate-200 px-3 py-1.5 hover:bg-slate-50">Next</a>
            {% endif %}
        </div>
        {% endif %}
        {% endif %}
    </section>
</div>
{% endblock %}
