{% extends "base.jinja" %}
{% block title %}Tutor Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">

    <section class="mb-5 rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5" aria-label="Dashboard overview">
        <div class="flex flex-col gap-2 border-b border-slate-100 pb-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
                <p class="text-[10px] font-black uppercase tracking-wider text-emerald-700">Tutor workspace</p>
                <h1 class="text-xl font-black tracking-tight text-slate-900">Overview</h1>
                <p class="mt-0.5 text-xs text-slate-600">Respond to demos, confirm engagements, track payouts.</p>
            </div>
        </div>

    {% include "dashboard/partials/_user_identity_bar.jinja" %}

        <div class="mt-3">
            {% if priority_items %}
            <p class="mb-2 text-[10px] font-black uppercase tracking-wider text-slate-500">Today's priorities</p>
            <ul class="space-y-1.5">
                {% for item in priority_items %}
                <li>
                    <a href="{{ item.url }}" class="flex items-center justify-between gap-3 rounded-lg border px-3 py-2 text-xs font-bold transition
                        {% if item.tone == 'rose' %}border-rose-200 bg-rose-50 text-rose-900 hover:bg-rose-100
                        {% elif item.tone == 'amber' %}border-amber-200 bg-amber-50 text-amber-900 hover:bg-amber-100
                        {% else %}border-indigo-200 bg-indigo-50 text-indigo-900 hover:bg-indigo-100{% endif %}">
                        <span>{{ item.label }}</span>
                        <span class="shrink-0 text-[10px] font-black uppercase tracking-wider">Go &rarr;</span>
                    </a>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-900">You're all caught up — no urgent action needed right now.</p>
            {% endif %}
        </div>

        <div class="mt-3">
            {% include "dashboard/partials/_dash_kpi_strip.jinja" %}
        </div>
        <div class="mt-3 border-t border-slate-100 pt-3">
            <p class="mb-2 text-[10px] font-black uppercase tracking-wider text-slate-500">Quick links</p>
            <div class="flex flex-wrap gap-1.5">
                <a href="{{ url('lms:courses') }}" class="inline-flex rounded-md bg-indigo-600 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-white hover:bg-indigo-500">LMS courses</a>
                <a href="{{ url('lms:assignment_create') }}" class="inline-flex rounded-md border border-indigo-200 bg-white px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-50">+ New assignment</a>
                <a href="{{ url('lms:courses') }}#attendance" class="inline-flex rounded-md border border-emerald-200 bg-emerald-50 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100">📅 Attendance</a>
                <a href="{{ url('study:tutor_dashboard') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Study</a>
                <a href="{{ url('hometutor:tutor_demos') }}" class="inline-flex rounded-md bg-emerald-600 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-white hover:bg-emerald-500">Inbox{% if pending_incoming %} {{ pending_incoming }}{% endif %}</a>
                <a href="{{ url('hometutor:my_profile') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Listing</a>
                <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex rounded-md border border-slate-200 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Marketplace</a>
            </div>
        </div>
    </section>

    <section class="mb-5 rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5" aria-label="My students">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-emerald-700">Roster</p>
                <h2 class="text-lg font-black tracking-tight text-slate-900">My students ({{ unified_student_count }})</h2>
            </div>
            <p class="text-[11px] text-slate-500">LMS courses + active marketplace engagements, in one place.</p>
        </div>
        {% if unified_students %}
        <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[520px] text-left text-xs">
                <thead>
                    <tr class="text-[10px] font-black uppercase tracking-wider text-slate-400">
                        <th class="pb-2 pr-3">Student</th>
                        <th class="pb-2 pr-3">LMS courses</th>
                        <th class="pb-2 pr-3">Marketplace</th>
                        <th class="pb-2 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for row in unified_students[:10] %}
                    <tr>
                        <td class="py-2 pr-3 font-bold text-slate-900">{{ row.student.get_username() }}</td>
                        <td class="py-2 pr-3 text-slate-600">
                            {% if row.lms_courses %}{{ row.lms_courses|join(', ') }}{% else %}<span class="text-slate-400">—</span>{% endif %}
                        </td>
                        <td class="py-2 pr-3 text-slate-600">
                            {% if row.engagement %}<span class="rounded border border-emerald-200 bg-emerald-50 px-1.5 py-0.5 text-[10px] font-black uppercase tracking-wider text-emerald-800">Active</span>{% else %}<span class="text-slate-400">—</span>{% endif %}
                        </td>
                        <td class="py-2 text-right">
                            {% if row.engagement %}
                            <a href="{{ url('hometutor:engagement_room', pk=row.engagement.pk) }}" class="text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Room</a>
                            {% elif row.lms_courses %}
                            <a href="{{ url('lms:courses') }}" class="text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Courses</a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if unified_student_count > 10 %}
            <p class="mt-2 text-[11px] text-slate-500">+{{ unified_student_count - 10 }} more student{% if unified_student_count - 10 != 1 %}s{% endif %}.</p>
            {% endif %}
        </div>
        {% else %}
        <p class="mt-3 text-xs text-slate-500">No students yet — enroll students in an LMS course or accept a demo request to get started.</p>
        {% endif %}
    </section>

    <section class="mb-5 rounded-xl border border-indigo-200 bg-indigo-50/40 p-4 shadow-sm md:p-5" aria-label="LMS teaching overview">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-indigo-100 pb-3">
            <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-indigo-700">LMS teaching</p>
                <h2 class="text-lg font-black tracking-tight text-slate-900">Your courses &amp; grading</h2>
            </div>
            <div class="flex flex-wrap gap-1.5">
                <a href="{{ url('lms:courses') }}" class="rounded-md bg-indigo-600 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-white hover:bg-indigo-500">Manage courses</a>
                <a href="{{ url('lms:assignment_create') }}" class="rounded-md border border-indigo-200 bg-white px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-50">+ New assignment</a>
            </div>
        </div>

        {% if lms_course_count == 0 %}
        <div class="mt-3 rounded-xl border border-indigo-200 bg-white px-3 py-3">
            <p class="text-sm font-bold text-slate-900">You haven't created a course yet.</p>
            <p class="mt-1 text-xs text-slate-600">Create your first course to enroll students, post assignments, and link recorded lectures or tests to it.</p>
            <a href="{{ url('lms:courses') }}" class="mt-2 inline-flex rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">Create your first course</a>
        </div>
        {% else %}
        <div class="mt-3 grid gap-2 sm:grid-cols-4">
            <div class="rounded-lg border border-indigo-100 bg-white px-2.5 py-2">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Courses</p>
                <p class="text-lg font-black tabular-nums text-slate-900">{{ lms_course_count }}</p>
            </div>
            <div class="rounded-lg border border-indigo-100 bg-white px-2.5 py-2">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Students</p>
                <p class="text-lg font-black tabular-nums text-slate-900">{{ lms_student_count }}</p>
            </div>
            <div class="rounded-lg border border-indigo-100 bg-white px-2.5 py-2">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Assignments</p>
                <p class="text-lg font-black tabular-nums text-slate-900">{{ lms_assignment_count }}</p>
            </div>
            <div class="rounded-lg border {% if lms_pending_review_count > 0 %}border-rose-200 bg-rose-50{% else %}border-indigo-100 bg-white{% endif %} px-2.5 py-2">
                <p class="text-[10px] font-black uppercase tracking-wider {% if lms_pending_review_count > 0 %}text-rose-700{% else %}text-slate-500{% endif %}">Needs grading</p>
                <p class="text-lg font-black tabular-nums {% if lms_pending_review_count > 0 %}text-rose-700{% else %}text-slate-900{% endif %}">{{ lms_pending_review_count }}</p>
            </div>
        </div>

        <div class="mt-3 grid gap-4 md:grid-cols-3">
            <div id="lms-grading" class="rounded-xl border border-indigo-100 bg-white p-3">
                <div class="flex items-center justify-between gap-2">
                    <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Needs grading</h3>
                    {% if lms_pending_review_count > 5 %}<span class="text-[10px] font-bold text-slate-400">+{{ lms_pending_review_count - 5 }} more</span>{% endif %}
                </div>
                {% if lms_recent_pending_submissions %}
                <ul class="mt-2 space-y-2">
                    {% for s in lms_recent_pending_submissions %}
                    <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                        <p class="text-sm font-bold text-slate-900">{{ s.student.get_username() }}</p>
                        <p class="text-[11px] text-slate-600">{{ s.assignment.title }}{% if s.assignment.course %} · {{ s.assignment.course.name }}{% endif %}</p>
                        <a href="{{ url('lms:assignment_detail', pk=s.assignment.pk) }}" class="mt-1 inline-flex text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Review &amp; grade</a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="mt-2 text-xs text-slate-500">Nothing pending — you're caught up.</p>
                {% endif %}
            </div>
            <div class="rounded-xl border border-indigo-100 bg-white p-3">
                <div class="flex items-center justify-between gap-2">
                    <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Your courses</h3>
                    <a href="{{ url('lms:courses') }}" class="text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Manage</a>
                </div>
                {% if lms_courses_overview %}
                <ul class="mt-2 space-y-2">
                    {% for c in lms_courses_overview %}
                    <li class="flex items-center justify-between gap-2 rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                        <span class="text-sm font-bold text-slate-900">{{ c.name }}{% if not c.is_active %} <span class="text-[9px] font-black uppercase text-rose-600">Inactive</span>{% endif %}</span>
                        <span class="text-[11px] font-bold text-slate-500">{{ c.student_count }} student{% if c.student_count != 1 %}s{% endif %}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="mt-2 text-xs text-slate-500">No courses yet.</p>
                {% endif %}
            </div>
            <div class="rounded-xl border border-indigo-100 bg-white p-3">
                <div class="flex items-center justify-between gap-2">
                    <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Recent assignments</h3>
                    <a href="{{ url('lms:assignment_create') }}" class="text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">+ New</a>
                </div>
                {% if lms_recent_assignments %}
                <ul class="mt-2 space-y-2">
                    {% for a in lms_recent_assignments %}
                    <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                        <a href="{{ url('lms:assignment_detail', pk=a.pk) }}" class="text-sm font-bold text-slate-900 hover:text-indigo-700">{{ a.title }}</a>
                        <p class="text-[11px] text-slate-600">{{ a.course.name if a.course else 'Platform-wide' }}{% if a.due_at %} · Due {{ a.due_at.strftime('%d %b') }}{% endif %}</p>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="mt-2 text-xs text-slate-500">No assignments yet.</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </section>

    {# Flex layout: lg:col-span-8/4 are not always present in built app.css — flex keeps full width reliably #}
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:gap-6">
        <div class="min-w-0 w-full flex-1 space-y-4">
            <div class="grid gap-2 sm:grid-cols-4">
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Wallet</p>
                    <p class="text-base font-black tabular-nums text-slate-900">₹{{ tutor_current_balance }}</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">30d credits</p>
                    <p class="text-base font-black tabular-nums text-slate-900">₹{{ tutor_month_credits }}</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Lifetime</p>
                    <p class="text-base font-black tabular-nums text-slate-900">₹{{ tutor_total_credits }}</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Payout pending</p>
                    <p class="text-base font-black tabular-nums text-slate-900">₹{{ tutor_pending_payout }}</p>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h2 class="text-xs font-black uppercase tracking-wider text-slate-700">Conversion funnel</h2>
                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">Leads → paid</span>
                </div>
                <div class="mt-3 grid gap-2 sm:grid-cols-4">
                    <div class="rounded-lg border border-slate-100 bg-slate-50 px-2 py-2">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Leads</p>
                        <p class="text-lg font-black tabular-nums text-slate-900">{{ total_demos }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-100 bg-slate-50 px-2 py-2">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Accepted %</p>
                        <p class="text-lg font-black tabular-nums text-slate-900">{{ accepted_rate }}%</p>
                        <p class="text-[10px] text-slate-500">{{ accepted_demos }}/{{ total_demos }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-100 bg-slate-50 px-2 py-2">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Active %</p>
                        <p class="text-lg font-black tabular-nums text-slate-900">{{ active_rate }}%</p>
                        <p class="text-[10px] text-slate-500">{{ active_engagements }}/{{ accepted_demos }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-100 bg-slate-50 px-2 py-2">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Paid %</p>
                        <p class="text-lg font-black tabular-nums text-slate-900">{{ paid_rate }}%</p>
                        <p class="text-[10px] text-slate-500">{{ tutor_paid_count }}/{{ active_engagements }}</p>
                    </div>
                </div>
            </div>

            {% if todays_sessions %}
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center justify-between gap-2">
                    <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Today's sessions</h3>
                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">{{ todays_sessions|length }} logged</span>
                </div>
                <ul class="mt-2 grid gap-2 sm:grid-cols-2">
                    {% for sess in todays_sessions %}
                    <li class="flex items-center justify-between gap-2 rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                        <div class="min-w-0">
                            <p class="truncate text-sm font-bold text-slate-900">{{ sess.engagement.student.get_username() }}</p>
                            <p class="text-[11px] text-slate-600">{{ sess.scheduled_for.strftime('%H:%M') }} · {{ sess.get_status_display() }}</p>
                        </div>
                        <a href="{{ url('hometutor:engagement_room', pk=sess.engagement.pk) }}" class="shrink-0 text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Room</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Pending demos</h3>
                        <a href="{{ url('hometutor:tutor_demos') }}" class="text-[10px] font-black uppercase tracking-wider text-emerald-700 hover:text-emerald-900">Open</a>
                    </div>
                    {% if latest_pending_demos %}
                    <ul class="mt-2 space-y-2">
                        {% for d in latest_pending_demos %}
                        <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                            <p class="text-sm font-bold text-slate-900">{{ d.requester.get_username() }}</p>
                            {% if d.pk in tutor_demo_sla_risk_ids %}
                            <span class="mt-1 inline-block rounded border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-amber-800">SLA</span>
                            {% endif %}
                            <p class="mt-1 text-[11px] text-slate-600">{{ d.message|default('No message', true)|truncate(80) }}</p>
                            <p class="mt-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">{{ d.created_at.strftime('%d %b %H:%M') }}</p>
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="mt-2 text-xs text-slate-500">None pending.</p>
                    {% endif %}
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Active engagements</h3>
                        <a href="{{ url('hometutor:tutor_demos') }}" class="text-[10px] font-black uppercase tracking-wider text-emerald-700 hover:text-emerald-900">Manage</a>
                    </div>
                    {% if latest_active_engagements %}
                    <ul class="mt-2 space-y-2">
                        {% for e in latest_active_engagements %}
                        <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                            <p class="text-sm font-bold text-slate-900">{{ e.student.get_username() }}</p>
                            <p class="text-[11px] text-slate-600">{{ e.get_status_display() }}</p>
                            <a href="{{ url('hometutor:engagement_room', pk=e.pk) }}" class="mt-1 inline-flex text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Room</a>
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="mt-2 text-xs text-slate-500">None yet.</p>
                    {% endif %}
                </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Ledger</h3>
                        <a href="/sd/hometutor_payments/tutorledgerentry/" class="text-[10px] font-black uppercase tracking-wider text-slate-500 hover:text-slate-800">/sd/</a>
                    </div>
                    {% if tutor_recent_ledger %}
                    <ul class="mt-2 space-y-2">
                        {% for row in tutor_recent_ledger %}
                        <li class="rounded-lg border border-slate-100 px-2 py-2 text-[11px]">
                            <p class="font-bold text-slate-900">{{ row.description }}</p>
                            <p class="text-slate-600">₹{{ row.amount }} · bal ₹{{ row.balance_after }}</p>
                            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">{{ row.created_at.strftime('%d %b %H:%M') }}</p>
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="mt-2 text-xs text-slate-500">No ledger rows.</p>
                    {% endif %}
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Schedule health</h3>
                        <a href="{{ url('hometutor:my_profile') }}" class="text-[10px] font-black uppercase tracking-wider text-emerald-700 hover:text-emerald-900">Profile</a>
                    </div>
                    <div class="mt-2 grid grid-cols-2 gap-2">
                        <div class="rounded-lg border border-slate-100 bg-slate-50 px-2 py-2">
                            <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Upcoming</p>
                            <p class="text-lg font-black text-slate-900">{{ upcoming_sessions_count }}</p>
                        </div>
                        <div class="rounded-lg border border-slate-100 bg-slate-50 px-2 py-2">
                            <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Stale 7d+</p>
                            <p class="text-lg font-black text-slate-900">{{ stale_active_engagement_count }}</p>
                        </div>
                    </div>
                    {% if stale_active_engagement_count > 0 %}
                    <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2 py-1.5 text-[10px] font-bold text-amber-900">
                        {{ stale_active_engagement_count }} active engagement{% if stale_active_engagement_count != 1 %}s{% endif %} idle 7+ days.
                    </p>
                    {% endif %}
                </div>
            </div>
        </div>

        <aside class="w-full shrink-0 space-y-4 lg:w-[17rem] lg:max-w-[17rem]">
            <div class="rounded-xl border border-emerald-200 bg-emerald-50/80 p-4">
                <p class="text-[10px] font-black uppercase tracking-wider text-emerald-800">Next steps</p>
                <ul class="mt-2 list-inside list-disc space-y-1 text-[11px] text-slate-700">
                    <li>Inbox under 15 minutes when possible</li>
                    <li>Keep listing and slots current</li>
                    <li>Turn accepted demos into engagements</li>
                </ul>
                <div class="mt-3 flex flex-col gap-2">
                    <a href="{{ url('hometutor:tutor_demos') }}" class="rounded-lg bg-emerald-600 px-3 py-2 text-center text-[11px] font-black uppercase tracking-wider text-white hover:bg-emerald-500">Review demos ({{ pending_incoming }})</a>
                    <a href="{{ url('hometutor:my_profile') }}" class="rounded-lg border border-emerald-300 bg-white px-3 py-2 text-center text-[11px] font-black uppercase tracking-wider text-emerald-900 hover:bg-emerald-100">Edit listing</a>
                </div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Activity</h3>
                {% if activity_timeline %}
                <ul class="mt-2 space-y-2">
                    {% for item in activity_timeline %}
                    <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                        <p class="text-[11px] font-semibold text-slate-900">{{ item.title }}</p>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">{{ item.meta.strftime('%d %b %H:%M') }}</p>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="mt-2 text-xs text-slate-500">No recent activity.</p>
                {% endif %}
            </div>
        </aside>
    </div>
</div>
{% endblock %}
