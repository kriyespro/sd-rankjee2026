{% extends "base.jinja" %}
{% block title %}Tutor Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8">
    <div class="mb-8">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-700">Tutor workspace</p>
        <h1 class="mt-2 text-3xl font-black text-slate-900">Grow your tutoring business</h1>
        <p class="mt-2 text-sm text-slate-600">Respond fast, convert more demos, and keep students active.</p>
        {% if tutor_preview_mode %}
        <p class="mt-3 inline-flex rounded-xl border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-black uppercase tracking-wider text-amber-800">
            Demo preview mode: no tutor profile linked to this account yet.
        </p>
        {% endif %}
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {% for card in kpi_cards %}
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">{{ card.label }}</p>
            <p class="mt-1 text-2xl font-black text-slate-900">{{ card.value }}</p>
        </div>
        {% endfor %}
    </div>

    <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
        <p class="text-xs font-black uppercase tracking-widest text-emerald-700">Quick actions</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            <a href="{{ url('hometutor:tutor_demos') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-emerald-800 hover:bg-emerald-100">Open demo inbox</a>
            <a href="{{ url('hometutor:my_profile') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-emerald-800 hover:bg-emerald-100">Edit listing</a>
            <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-emerald-800 hover:bg-emerald-100">View marketplace</a>
            <a href="{{ url('dashboard:index') }}" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-3 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-emerald-500">Refresh workspace</a>
        </div>
        {% if tutor_demo_sla_risk_count > 0 %}
        <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800">
            {{ tutor_demo_sla_risk_count }} pending demo{% if tutor_demo_sla_risk_count != 1 %}s{% endif %} waiting over 24h.
        </p>
        {% endif %}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a href="{{ url('hometutor:tutor_demos') }}" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
            <p class="text-xs font-black uppercase tracking-widest text-emerald-700">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Review incoming demo requests</h2>
            <p class="mt-1 text-sm text-slate-600">You have {{ pending_incoming }} pending requests waiting for response.</p>
        </a>
        <a href="{{ url('hometutor:my_profile') }}" class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-black uppercase tracking-widest text-slate-500">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Optimize your tutor profile</h2>
            <p class="mt-1 text-sm text-slate-600">Keep pricing, classes, and availability updated to improve ranking.</p>
        </a>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Priority queue</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li>• Respond to new leads within 15 minutes for better conversion.</li>
            <li>• Keep your next 7 days availability updated.</li>
            <li>• Convert accepted demos into recurring engagements.</li>
        </ul>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Wallet balance</p>
            <p class="mt-1 text-2xl font-black text-slate-900">₹{{ tutor_current_balance }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Credits (30d)</p>
            <p class="mt-1 text-2xl font-black text-slate-900">₹{{ tutor_month_credits }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Lifetime credits</p>
            <p class="mt-1 text-2xl font-black text-slate-900">₹{{ tutor_total_credits }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Pending payout</p>
            <p class="mt-1 text-2xl font-black text-slate-900">₹{{ tutor_pending_payout }}</p>
        </div>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Earnings ledger</h3>
                <a href="/sd/hometutor_payments/tutorledgerentry/" class="text-xs font-black uppercase tracking-wider text-emerald-700 hover:text-emerald-900">Open /sd/</a>
            </div>
            {% if tutor_recent_ledger %}
            <div class="mt-3 space-y-3">
                {% for row in tutor_recent_ledger %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ row.description }}</p>
                    <p class="mt-1 text-xs text-slate-600">Amount: ₹{{ row.amount }} · Balance: ₹{{ row.balance_after }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ row.created_at.strftime('%d %b %Y %H:%M') }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No earnings ledger entries yet.</p>
            {% endif %}
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Schedule and availability health</h3>
                <a href="{{ url('hometutor:my_profile') }}" class="text-xs font-black uppercase tracking-wider text-emerald-700 hover:text-emerald-900">Update profile</a>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Upcoming sessions</p>
                    <p class="mt-1 text-2xl font-black text-slate-900">{{ upcoming_sessions_count }}</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Stale active engagements</p>
                    <p class="mt-1 text-2xl font-black text-slate-900">{{ stale_active_engagement_count }}</p>
                </div>
            </div>
            {% if stale_active_engagement_count > 0 %}
            <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800">
                {{ stale_active_engagement_count }} active engagement{% if stale_active_engagement_count != 1 %}s{% endif %} not updated for 7+ days.
            </p>
            {% endif %}
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-black text-slate-900">Lead conversion analytics</h3>
            <span class="text-[11px] font-black uppercase tracking-widest text-slate-500">MVP funnel</span>
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Total leads</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ total_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Accepted rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ accepted_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ accepted_demos }} / {{ total_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Active rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ active_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ active_engagements }} / {{ accepted_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Paid rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ paid_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ tutor_paid_count }} / {{ active_engagements }}</p>
            </div>
        </div>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Latest pending demos</h3>
                <a href="{{ url('hometutor:tutor_demos') }}" class="text-xs font-black uppercase tracking-wider text-emerald-700 hover:text-emerald-900">Open inbox</a>
            </div>
            {% if latest_pending_demos %}
            <div class="mt-3 space-y-3">
                {% for d in latest_pending_demos %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ d.requester.get_username() }}</p>
                    {% if d.pk in tutor_demo_sla_risk_ids %}
                    <p class="mt-1 inline-flex rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-800">SLA risk</p>
                    {% endif %}
                    <p class="mt-1 text-xs text-slate-600">{{ d.message|default('No message', true)|truncate(70) }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ d.created_at.strftime('%d %b %Y %H:%M') }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No pending demos right now.</p>
            {% endif %}
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Active student engagements</h3>
                <a href="{{ url('hometutor:tutor_demos') }}" class="text-xs font-black uppercase tracking-wider text-emerald-700 hover:text-emerald-900">Manage</a>
            </div>
            {% if latest_active_engagements %}
            <div class="mt-3 space-y-3">
                {% for e in latest_active_engagements %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ e.student.get_username() }}</p>
                    <p class="mt-1 text-xs text-slate-600">Status: {{ e.get_status_display() }}</p>
                    <a href="{{ url('hometutor:engagement_room', pk=e.pk) }}" class="mt-2 inline-flex text-xs font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Open engagement room</a>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No active engagements yet.</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Activity timeline</h3>
        {% if activity_timeline %}
        <div class="mt-3 space-y-3">
            {% for item in activity_timeline %}
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-sm font-bold text-slate-900">{{ item.title }}</p>
                <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ item.meta.strftime('%d %b %Y %H:%M') }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="mt-3 text-sm text-slate-500">No recent activity yet.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
