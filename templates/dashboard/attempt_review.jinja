{% extends "base.jinja" %}
{% block title %}Attempt Review - RankJee{% endblock %}
{% block content %}
<div class="max-w-5xl mx-auto px-4 py-8">
    {% set crumbs = [{'label': 'Dashboard', 'url': url('dashboard:index')}] + ([{'label': 'Students score table', 'url': url('dashboard:students_score_table')}] if is_staff_review else []) + [{'label': 'Wrong questions review'}] %}
    {% include "partials/_breadcrumb.jinja" %}
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-900">Wrong Questions Review</h1>
            <p class="text-sm text-slate-600 mt-1">
                {{ attempt.skill.name if attempt.skill else "Test" }} · {{ attempt.score }}% · {{ attempt.attempt_date.strftime('%d %b %Y %H:%M') }}
            </p>
            {% if is_staff_review %}
            <p class="text-xs font-black uppercase tracking-wider text-amber-700 mt-1">
                Student: {{ attempt.user.username }} ({{ attempt.user.email }})
            </p>
            {% endif %}
        </div>
    </div>

    {% if attempt.attempted_video %}
    <div class="mb-4 rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-3">
        <p class="text-xs font-black uppercase tracking-wider text-indigo-700">Linked lecture</p>
        <a href="{{ attempt.attempted_video.video_url }}" target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm font-bold text-indigo-800 hover:underline">
            {{ attempt.attempted_video.title }}
        </a>
    </div>
    {% endif %}

    {% if question_rows %}
    <div class="space-y-4">
        {% for item in question_rows %}
        <div class="rounded-2xl border border-rose-100 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3 mb-2">
                <span class="inline-flex rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-rose-700">
                    {{ item.question.concept_tag }}
                </span>
                <a href="{{ url('learning:index') }}?skill={{ attempt.skill.id }}&concept={{ item.question.concept_tag|urlencode }}" class="text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:underline">
                    Watch lesson
                </a>
            </div>
            <p class="text-sm font-bold text-slate-900">{{ item.question.text }}</p>
            <div class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2">
                <p class="text-xs font-black uppercase tracking-wider text-emerald-700">Correct answer</p>
                <p class="text-sm font-semibold text-emerald-900">{{ item.correct_text }}</p>
            </div>
            {% if item.question.explanation %}
            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                <p class="text-xs font-black uppercase tracking-wider text-slate-600">Explanation</p>
                <p class="text-sm text-slate-700">{{ item.question.explanation }}</p>
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-slate-500 font-semibold">
        No wrong-question details found for this attempt.
    </div>
    {% endif %}
</div>
{% endblock %}
