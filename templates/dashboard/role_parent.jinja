{% extends "base.jinja" %}
{% block title %}Parent Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8">
    <div class="mb-8">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-amber-700">Parent workspace</p>
        <h1 class="mt-2 text-3xl font-black text-slate-900">Manage learning with control</h1>
        <p class="mt-2 text-sm text-slate-600">Approve tutor bookings, track active learning, and handle support quickly.</p>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {% for card in kpi_cards %}
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">{{ card.label }}</p>
            <p class="mt-1 text-2xl font-black text-slate-900">{{ card.value }}</p>
        </div>
        {% endfor %}
    </div>

    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-4">
        <p class="text-xs font-black uppercase tracking-widest text-amber-700">Quick actions</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800 hover:bg-amber-100">Find tutors</a>
            <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800 hover:bg-amber-100">Review demos</a>
            <a href="{{ url('learning:index') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800 hover:bg-amber-100">Learning hub</a>
            <a href="{{ url('dashboard:index') }}" class="inline-flex items-center justify-center rounded-xl bg-amber-500 px-3 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-amber-400">Refresh dashboard</a>
        </div>
        {% if parent_demo_sla_risk_count > 0 %}
        <p class="mt-3 rounded-xl border border-amber-200 bg-amber-100 px-3 py-2 text-xs font-black uppercase tracking-wider text-amber-800">
            {{ parent_demo_sla_risk_count }} demo request{% if parent_demo_sla_risk_count != 1 %}s{% endif %} pending for more than 24h.
        </p>
        {% endif %}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a href="{{ url('hometutor:tutor_list') }}" class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-black uppercase tracking-widest text-amber-700">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Find and compare tutors</h2>
            <p class="mt-1 text-sm text-slate-600">Review tutor profiles, ratings, and request demos for better fit.</p>
        </a>
        <a href="{{ url('hometutor:my_demo_requests') }}" class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-black uppercase tracking-widest text-slate-500">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Track pending approvals</h2>
            <p class="mt-1 text-sm text-slate-600">{{ pending_sent }} requests are waiting for tutor response.</p>
        </a>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Priority queue</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li>• Review newly accepted demos and confirm schedule.</li>
            <li>• Watch active engagement count for continuity.</li>
            <li>• Resolve support cases early to avoid learning disruptions.</li>
        </ul>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Monthly spend</p>
            <p class="mt-1 text-2xl font-black text-slate-900">₹{{ parent_monthly_spend }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Total spend</p>
            <p class="mt-1 text-2xl font-black text-slate-900">₹{{ parent_total_spend }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Pending payment actions</p>
            <p class="mt-1 text-2xl font-black text-slate-900">{{ parent_pending_payment_count }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Attendance rate</p>
            <p class="mt-1 text-2xl font-black text-slate-900">{{ parent_attendance_rate }}%</p>
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Parent control center</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li>• Use monthly spend to decide tutor continuation and session frequency.</li>
            <li>• Clear pending payment actions quickly to avoid schedule disruptions.</li>
            <li>• Keep attendance above 80% for stable outcomes.</li>
        </ul>
    </div>

    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5">
        <h3 class="text-sm font-black text-amber-900">Recommended next actions</h3>
        <ul class="mt-3 space-y-2 text-sm text-amber-900">
            {% for item in parent_next_actions %}
            <li>• {{ item }}</li>
            {% endfor %}
        </ul>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Recent demo requests</h3>
                <a href="{{ url('hometutor:my_demo_requests') }}" class="text-xs font-black uppercase tracking-wider text-amber-700 hover:text-amber-900">View all</a>
            </div>
            {% if latest_demo_requests %}
            <div class="mt-3 space-y-3">
                {% for d in latest_demo_requests %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ d.tutor.display_name }}</p>
                    {% if d.pk in parent_demo_sla_risk_ids %}
                    <p class="mt-1 inline-flex rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-800">SLA risk</p>
                    {% endif %}
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">Status: {{ d.get_status_display() }}</p>
                    {% if d.scheduled_at %}
                    <p class="mt-1 text-xs text-slate-500">Scheduled: {{ d.scheduled_at.strftime('%d %b %Y %H:%M') }}</p>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No demo requests yet. Start by shortlisting tutors.</p>
            {% endif %}
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Learning engagements</h3>
                <a href="{{ url('hometutor:my_demo_requests') }}" class="text-xs font-black uppercase tracking-wider text-amber-700 hover:text-amber-900">Track</a>
            </div>
            {% if latest_learning_engagements %}
            <div class="mt-3 space-y-3">
                {% for e in latest_learning_engagements %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ e.tutor_profile.display_name }}</p>
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">{{ e.get_status_display() }}</p>
                    <a href="{{ url('hometutor:engagement_room', pk=e.pk) }}" class="mt-2 inline-flex text-xs font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Open engagement room</a>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No active learning engagement yet.</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Activity timeline</h3>
        {% if activity_timeline %}
        <div class="mt-3 space-y-3">
            {% for item in activity_timeline %}
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-sm font-bold text-slate-900">{{ item.title }}</p>
                <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ item.meta.strftime('%d %b %Y %H:%M') }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="mt-3 text-sm text-slate-500">No recent activity yet.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
