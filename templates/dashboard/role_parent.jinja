{% extends "base.jinja" %}
{% block title %}Parent Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">

    <section class="mb-5 rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:p-5" aria-label="Dashboard overview">
        <div class="border-b border-slate-100 pb-3">
            <p class="text-[10px] font-black uppercase tracking-wider text-amber-700">Parent workspace</p>
            <h1 class="text-xl font-black tracking-tight text-slate-900">Overview</h1>
            <p class="mt-0.5 text-xs text-slate-600">Demos, payments, and continuity in one glance.</p>
        </div>
        <div class="mt-3">
            {% include "dashboard/partials/_dash_kpi_strip.jinja" %}
        </div>
        <div class="mt-3 border-t border-slate-100 pt-3">
            <p class="mb-2 text-[10px] font-black uppercase tracking-wider text-slate-500">Quick links</p>
            <div class="flex flex-wrap gap-1.5">
                <a href="{{ url('dashboard:study') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Study</a>
                <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex rounded-md bg-slate-100 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Tutors</a>
                <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex rounded-md bg-amber-600 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-white hover:bg-amber-500">Demos{% if pending_sent %} {{ pending_sent }}{% endif %}</a>
                <a href="{{ url('learning:index') }}" class="inline-flex rounded-md border border-slate-200 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Learn</a>
            </div>
            {% if parent_demo_sla_risk_count > 0 %}
            <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-900">
                {{ parent_demo_sla_risk_count }} demo{% if parent_demo_sla_risk_count != 1 %}s{% endif %} pending over 24h.
            </p>
            {% endif %}
        </div>
    </section>

    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:gap-6">
        <div class="min-w-0 w-full flex-1 space-y-4">
            <div class="grid gap-2 sm:grid-cols-4">
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Spend 30d</p>
                    <p class="text-base font-black tabular-nums text-slate-900">₹{{ parent_monthly_spend }}</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Total spend</p>
                    <p class="text-base font-black tabular-nums text-slate-900">₹{{ parent_total_spend }}</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Pay pending</p>
                    <p class="text-base font-black tabular-nums text-slate-900">{{ parent_pending_payment_count }}</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 shadow-sm">
                    <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Attendance</p>
                    <p class="text-base font-black tabular-nums text-slate-900">{{ parent_attendance_rate }}%</p>
                </div>
            </div>

            <div class="rounded-xl border border-amber-100 bg-amber-50/90 p-4">
                <h2 class="text-xs font-black uppercase tracking-wider text-amber-900">Suggested actions</h2>
                <ul class="mt-2 list-inside list-disc space-y-1 text-[11px] text-amber-950">
                    {% for item in parent_next_actions %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Booking funnel</p>
                        <h2 class="text-lg font-black tracking-tight text-slate-900">Request to confirmed learning</h2>
                        <p class="mt-0.5 text-xs text-slate-600">Where your tutor search stands.</p>
                    </div>
                    <a href="{{ url('hometutor:my_demo_requests') }}" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-100">Open my demos</a>
                </div>
                <div class="mt-4 grid grid-cols-2 gap-2 lg:grid-cols-5">
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Requested</p>
                        <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ pending_sent }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Accepted</p>
                        <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ accepted_sent }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Active</p>
                        <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ active_learning }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Paid</p>
                        <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ parent_paid_count }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Declined</p>
                        <p class="mt-0.5 text-lg font-black tabular-nums text-slate-900">{{ parent_demo_declined }}</p>
                    </div>
                </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Demo requests</h3>
                        <a href="{{ url('hometutor:my_demo_requests') }}" class="text-[10px] font-black uppercase tracking-wider text-amber-700 hover:text-amber-900">All</a>
                    </div>
                    {% if latest_demo_requests %}
                    <ul class="mt-2 space-y-2">
                        {% for d in latest_demo_requests %}
                        <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                            <p class="text-sm font-bold text-slate-900">{{ d.tutor.display_name }}</p>
                            {% if d.pk in parent_demo_sla_risk_ids %}
                            <span class="mt-1 inline-block rounded border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-amber-800">SLA</span>
                            {% endif %}
                            <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-600">{{ d.get_status_display() }}</p>
                            {% if d.scheduled_at %}
                            <p class="text-[10px] text-slate-500">{{ d.scheduled_at.strftime('%d %b %Y %H:%M') }}</p>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="mt-2 text-xs text-slate-500">No demos yet.</p>
                    {% endif %}
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Engagements</h3>
                        <a href="{{ url('hometutor:my_demo_requests') }}" class="text-[10px] font-black uppercase tracking-wider text-amber-700 hover:text-amber-900">Track</a>
                    </div>
                    {% if latest_learning_engagements %}
                    <ul class="mt-2 space-y-2">
                        {% for e in latest_learning_engagements %}
                        <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                            <p class="text-sm font-bold text-slate-900">{{ e.tutor_profile.display_name }}</p>
                            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-600">{{ e.get_status_display() }}</p>
                            <a href="{{ url('hometutor:engagement_room', pk=e.pk) }}" class="mt-1 inline-flex text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:text-indigo-900">Room</a>
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="mt-2 text-xs text-slate-500">No engagements yet.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <aside class="w-full shrink-0 space-y-4 lg:w-[17rem] lg:max-w-[17rem]">
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Checklist</p>
                <ul class="mt-2 space-y-1.5 text-[11px] text-slate-700">
                    <li>Confirm schedules when tutors accept</li>
                    <li>Clear payments before sessions slip</li>
                    <li>Keep attendance above ~80%</li>
                </ul>
                <div class="mt-3 flex flex-col gap-2">
                    <a href="{{ url('hometutor:tutor_list') }}" class="rounded-lg bg-amber-600 px-3 py-2 text-center text-[11px] font-black uppercase tracking-wider text-white hover:bg-amber-500">Find tutors</a>
                    <a href="{{ url('hometutor:my_demo_requests') }}" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-center text-[11px] font-black uppercase tracking-wider text-slate-800 hover:bg-slate-50">My demos</a>
                </div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <h3 class="text-xs font-black uppercase tracking-wider text-slate-700">Activity</h3>
                {% if activity_timeline %}
                <ul class="mt-2 space-y-2">
                    {% for item in activity_timeline %}
                    <li class="rounded-lg border border-slate-100 bg-slate-50 px-2.5 py-2">
                        <p class="text-[11px] font-semibold text-slate-900">{{ item.title }}</p>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">{{ item.meta.strftime('%d %b %H:%M') }}</p>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="mt-2 text-xs text-slate-500">No recent activity.</p>
                {% endif %}
            </div>
        </aside>
    </div>
</div>
{% endblock %}
