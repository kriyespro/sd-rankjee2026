{% extends "base.jinja" %}
{% block title %}{{ title }} - CMS{% endblock %}
{% block content %}
<div class="max-w-3xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-black text-slate-900">{{ title }}</h1>
    <a href="{{ url('dashboard:cms_home') }}" class="text-sm font-bold text-indigo-600 hover:underline">← CMS</a>
  </div>
  <form method="post" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-2xl p-6 space-y-5">
    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
    {% if form.non_field_errors() %}
      <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-800">
        {% for e in form.non_field_errors() %}<div>{{ e }}</div>{% endfor %}
      </div>
    {% endif %}

    <div class="grid grid-cols-1 gap-4">
      {% for field in form %}
        <div class="space-y-1.5">
          <label for="{{ field.id_for_label }}" class="block text-[11px] font-black uppercase tracking-widest text-slate-500">
            {{ field.label }}{% if field.field.required %} <span class="text-rose-500">*</span>{% endif %}
          </label>
          {{ field }}
          {% if field.help_text %}
            <div class="text-xs text-slate-500">{{ field.help_text }}</div>
          {% endif %}
          {% if field.errors %}
            <div class="text-xs font-bold text-rose-600">
              {% for e in field.errors %}<div>{{ e }}</div>{% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <button type="submit" class="w-full bg-slate-900 text-white font-black text-xs uppercase tracking-widest py-3 rounded-xl hover:bg-indigo-600">Save</button>
  </form>
</div>
{% endblock %}

