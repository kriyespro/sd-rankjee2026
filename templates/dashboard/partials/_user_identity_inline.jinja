{#
  Inline identity chip — avatar initial · username · email · role badge.
  No card wrapper. Drop this inside any flex header row.
  Role colour tokens follow the same palette as _user_identity_bar.jinja.
#}
{% set _role = request.user.role if request.user.role else ('SUPERADMIN' if request.user.is_superuser else '') %}
{% set _initial = request.user.username[0]|upper if request.user.username else '?' %}

{% if _role in ['TUTOR', 'FACULTY'] %}
  {% set _pill = 'bg-emerald-100 text-emerald-800 border-emerald-200' %}
  {% set _avatar = 'bg-emerald-100 text-emerald-700' %}
{% elif _role == 'PARENT' %}
  {% set _pill = 'bg-amber-100 text-amber-800 border-amber-200' %}
  {% set _avatar = 'bg-amber-100 text-amber-700' %}
{% elif _role == 'CITY_ADMIN' %}
  {% set _pill = 'bg-fuchsia-100 text-fuchsia-800 border-fuchsia-200' %}
  {% set _avatar = 'bg-fuchsia-100 text-fuchsia-700' %}
{% elif _role == 'GLOBAL_ADMIN' %}
  {% set _pill = 'bg-slate-200 text-slate-800 border-slate-300' %}
  {% set _avatar = 'bg-slate-200 text-slate-700' %}
{% elif _role == 'SUPERADMIN' or request.user.is_superuser %}
  {% set _pill = 'bg-indigo-100 text-indigo-800 border-indigo-200' %}
  {% set _avatar = 'bg-indigo-100 text-indigo-700' %}
{% elif _role == 'STUDENT' %}
  {% set _pill = 'bg-sky-100 text-sky-800 border-sky-200' %}
  {% set _avatar = 'bg-sky-100 text-sky-700' %}
{% else %}
  {% set _pill = 'bg-slate-100 text-slate-700 border-slate-200' %}
  {% set _avatar = 'bg-slate-100 text-slate-600' %}
{% endif %}

<div class="flex items-center gap-2 flex-shrink-0">
    <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full text-xs font-black {{ _avatar }}">{{ _initial }}</span>
    <div class="min-w-0">
        <p class="text-xs font-black text-slate-900 leading-tight truncate">{{ request.user.username }}</p>
        {% if request.user.email %}<p class="text-[10px] text-slate-400 truncate leading-none">{{ request.user.email }}</p>{% endif %}
    </div>
    <span class="flex-shrink-0 rounded-full border px-2.5 py-0.5 text-[10px] font-black uppercase tracking-widest {{ _pill }}">{{ _role or 'USER' }}</span>
</div>
