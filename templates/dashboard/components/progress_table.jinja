<div class="overflow-x-auto bg-white rounded-2xl shadow-sm border border-gray-100">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-gray-50 border-b border-gray-100">
                <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">Topic / Skill</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">Best Score</th>
                <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider text-right">Action</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
            {% for item in learning_path %}
            <tr class="hover:bg-gray-50/50 transition-colors {{ 'opacity-50 grayscale-[0.5]' if item.status == 'LOCKED' else '' }}">
                <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold {{ 'bg-green-100 text-green-600' if item.status == 'PASSED' else 'bg-indigo-100 text-indigo-600' }}">
                            {{ loop.index }}
                        </div>
                        <div>
                            <span class="block font-bold text-gray-900">{{ item.skill.name }}</span>
                            <span class="text-xs text-gray-500">{{ item.skill.description|truncate(50) }}</span>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4">
                    {% if item.status == 'PASSED' %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                            Completed
                        </span>
                    {% elif item.status == 'LOCKED' %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
                            Locked
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                            In Progress
                        </span>
                    {% endif %}
                </td>
                <td class="px-6 py-4">
                    <div class="flex items-center gap-2">
                        <div class="flex-grow bg-slate-100 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-indigo-600 h-full transition-all duration-500" 
                                 style="width: {{ (item.passed_sets / item.total_sets * 100)|int if item.total_sets > 0 else 0 }}%"></div>
                        </div>
                        <span class="text-[10px] font-black text-slate-500 whitespace-nowrap">
                            {{ item.passed_sets }} / {{ item.total_sets }}
                        </span>
                    </div>
                </td>
                <td class="px-6 py-4 text-right">
                    {% if item.status == 'PASSED' %}
                        <span class="text-xs font-black text-emerald-600 uppercase tracking-widest flex items-center justify-end gap-1">
                            Mastered <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </span>
                    {% elif item.status == 'UNLOCKED' %}
                        <div class="flex flex-col items-end gap-1">
                            <a href="{{ url('assessment:take_test', item.skill.id) }}" 
                               class="bg-indigo-600 hover:bg-indigo-700 text-white text-[10px] font-black px-3 py-1.5 rounded-lg shadow-sm shadow-indigo-100 transition-all uppercase tracking-widest">
                                {% if item.passed_sets > 0 %}Resume: Set {{ item.passed_sets + 1 }}{% else %}Start Set 1{% endif %}
                            </a>
                            {% if item.next_set %}
                                <span class="text-[9px] font-bold text-indigo-400 uppercase tracking-tighter">Next: {{ item.next_set.name.split(' - ')[1] }}</span>
                            {% endif %}
                        </div>
                    {% else %}
                        <span class="text-xs font-black text-slate-300 uppercase tracking-widest flex items-center justify-end gap-1">
                            Locked <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                        </span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
