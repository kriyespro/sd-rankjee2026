<div class="overflow-hidden bg-white rounded-xl shadow-sm border border-slate-100">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
                <th class="px-5 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest">Module / Topic</th>
                <th class="px-4 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest">Status</th>
                <th class="px-4 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest">Mastery</th>
                <th class="px-5 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest text-right">Action</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
            {% for item in learning_path %}
            <tr class="hover:bg-slate-50/60 transition-colors {{ 'opacity-60 grayscale-[0.3]' if item.status == 'LOCKED' else '' }}">
                <td class="px-5 py-5">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-black shrink-0 {{ 'bg-emerald-100 text-emerald-600 border border-emerald-200 shadow-sm shadow-emerald-50' if item.status == 'PASSED' else 'bg-indigo-100 text-indigo-600 border border-indigo-200 shadow-sm shadow-indigo-50' }}">
                            {{ loop.index }}
                        </div>
                        <div class="truncate">
                            <span class="block font-black text-sm text-slate-900 tracking-tight leading-tight mb-1">{{ item.skill.name }}</span>
                            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-normal">{{ item.skill.description|truncate(50) }}</span>
                        </div>
                    </div>
                </td>
                <td class="px-4 py-5">
                    {% if item.status == 'PASSED' %}
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-widest text-emerald-500">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Mastered
                        </span>
                    {% elif item.status == 'LOCKED' %}
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-widest text-slate-300">
                            Locked
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-widest text-amber-500">
                            Current
                        </span>
                    {% endif %}
                </td>
                <td class="px-4 py-5 min-w-[120px]">
                    <div class="flex flex-col gap-2">
                        <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden border border-slate-200">
                            <div class="bg-indigo-600 h-full shadow-[0_0_8px_rgba(79,70,229,0.3)]" 
                                 style="width: {{ (item.passed_sets / item.total_sets * 100)|int if item.total_sets > 0 else 0 }}%"></div>
                        </div>
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider">
                            {{ item.passed_sets }} / {{ item.total_sets }} Modules
                        </span>
                    </div>
                </td>
                <td class="px-5 py-5 text-right">
                    {% if item.status == 'PASSED' %}
                        <span class="text-xl">🏆</span>
                    {% elif item.status == 'UNLOCKED' %}
                        <a href="{{ url('assessment:take_test', item.skill.id) }}" 
                           class="inline-block bg-indigo-600 hover:bg-slate-900 text-white text-[10px] font-black px-5 py-2.5 rounded-xl shadow-lg shadow-indigo-200 hover:shadow-indigo-300 hover:-translate-y-0.5 transition-all uppercase tracking-widest">
                            {% if item.passed_sets > 0 %}Resume{% else %}Start Now{% endif %}
                        </a>
                    {% else %}
                        <span class="text-xs text-slate-200 opacity-30">🔒</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

