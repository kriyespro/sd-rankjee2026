{% extends "base.jinja" %}
{% block title %}Leaderboard – SkillLoop{% endblock %}
{% block content %}
<div class="max-w-3xl mx-auto py-8 px-4">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">🏆 Leaderboard</h1>
            <p class="text-gray-500 text-sm mt-1">Top learners ranked by XP points</p>
        </div>
        <a href="{{ url('dashboard:index') }}" class="text-sm text-indigo-600 hover:underline font-semibold">← Dashboard</a>
    </div>

    {% if user_rank %}
    <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 mb-6 flex items-center justify-between">
        <p class="font-semibold text-indigo-800">Your Current Rank</p>
        <span class="text-2xl font-black text-indigo-700">#{{ user_rank }}</span>
    </div>
    {% endif %}

    <div class="bg-white rounded-xl shadow overflow-hidden">
        <div class="grid grid-cols-12 bg-gray-50 border-b px-4 py-3 text-xs font-bold text-gray-500 uppercase">
            <div class="col-span-2">Rank</div>
            <div class="col-span-5">User</div>
            <div class="col-span-3 text-right">XP Points</div>
            <div class="col-span-2 text-right">Wallet</div>
        </div>
        {% for u in users %}
        <div class="grid grid-cols-12 px-4 py-3 border-b last:border-0 items-center {% if u.pk == request.user.pk %}bg-indigo-50{% else %}hover:bg-gray-50{% endif %} transition">
            <div class="col-span-2">
                {% if loop.index == 1 %}
                    <span class="text-xl">🥇</span>
                {% elif loop.index == 2 %}
                    <span class="text-xl">🥈</span>
                {% elif loop.index == 3 %}
                    <span class="text-xl">🥉</span>
                {% else %}
                    <span class="text-sm font-bold text-gray-400">#{{ loop.index }}</span>
                {% endif %}
            </div>
            <div class="col-span-5 font-semibold text-sm {% if u.pk == request.user.pk %}text-indigo-700{% endif %}">
                {{ u.username }}{% if u.pk == request.user.pk %} <span class="text-xs bg-indigo-100 text-indigo-600 px-1.5 py-0.5 rounded ml-1">you</span>{% endif %}
                {% if u.streak_days >= 7 %}<span class="ml-1 text-xs text-orange-500">🔥{{ u.streak_days }}d</span>{% endif %}
            </div>
            <div class="col-span-3 text-right">
                <span class="font-bold text-indigo-700 bg-indigo-50 px-2 py-1 rounded-full text-xs">{{ u.xp_points }} XP</span>
            </div>
            <div class="col-span-2 text-right text-sm font-semibold text-green-600">₹{{ u.wallet_balance }}</div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
