{% extends "base.jinja" %}
{% block title %}Notifications – RankJee{% endblock %}
{% block content %}
<div class="max-w-2xl mx-auto py-8 px-4">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-extrabold text-gray-900">🔔 Notifications</h1>
        <a href="{{ url('dashboard:index') }}" class="text-sm text-indigo-600 hover:underline font-semibold">← Dashboard</a>
    </div>

    {% if notifications %}
    <div class="space-y-3">
        {% for note in notifications %}
        <div class="bg-white border rounded-xl p-4 flex items-start gap-3 shadow-sm {% if not note.is_read %}border-indigo-300 bg-indigo-50{% endif %}">
            <div class="flex-grow">
                <p class="text-sm font-medium text-gray-800">{{ note.message }}</p>
                <p class="text-xs text-gray-400 mt-1">{{ note.created_at.strftime('%d %b %Y, %I:%M %p') }}</p>
            </div>
            {% if not note.is_read %}
            <span class="w-2 h-2 rounded-full bg-indigo-500 mt-1.5 flex-shrink-0"></span>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="text-center py-16 text-gray-400">
        <p class="text-5xl mb-3">🔔</p>
        <p class="font-semibold">No notifications yet</p>
        <p class="text-sm mt-1">Complete a test or task to get your first notification!</p>
        <a href="{{ url('assessment:index') }}" class="mt-4 inline-block bg-indigo-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-indigo-700 transition">Take a Test</a>
    </div>
    {% endif %}
</div>
{% endblock %}
