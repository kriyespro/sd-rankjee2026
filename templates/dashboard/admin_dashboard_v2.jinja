{% extends "base.jinja" %}
{% block title %}Superadmin Overview — RankJee{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto px-4 py-6">

    {# ── Compact inline header: title · identity · search ── #}
    {% set _role = request.user.role if request.user.role else ('SUPERADMIN' if request.user.is_superuser else '') %}
    {% set _initial = request.user.username[0]|upper if request.user.username else '?' %}
    <div class="mb-4 flex flex-wrap items-center gap-3">
        {# Title — compact #}
        <div class="min-w-0 flex-shrink-0">
            <p class="text-[9px] font-black uppercase tracking-[0.2em] text-indigo-500 leading-none mb-0.5">RankJee · Command Center</p>
            <h1 class="text-lg font-black text-slate-900 tracking-tight leading-tight">Superadmin Overview</h1>
            <p class="text-[11px] font-medium text-slate-400 leading-none mt-0.5">Pending queues · real revenue · real growth.</p>
        </div>

        {# Divider #}
        <div class="hidden sm:block h-8 w-px bg-slate-200 flex-shrink-0"></div>

        {# Inline identity: avatar + username/email + role badge #}
        <div class="flex items-center gap-2 flex-shrink-0">
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xs font-black text-indigo-700">{{ _initial }}</span>
            <div class="min-w-0">
                <p class="text-xs font-black text-slate-900 leading-tight truncate">{{ request.user.username }}</p>
                {% if request.user.email %}<p class="text-[10px] text-slate-400 truncate leading-none">{{ request.user.email }}</p>{% endif %}
            </div>
            <span class="flex-shrink-0 rounded-full bg-indigo-100 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-widest text-indigo-800 border border-indigo-200">{{ _role or 'SUPERADMIN' }}</span>
        </div>

        {# Search — pushed right #}
        <form action="/sd/users/customuser/" method="GET" class="relative ml-auto w-full sm:w-52 flex-shrink-0">
            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 opacity-40 text-xs">🔍</span>
            <input type="text" name="q" placeholder="Find a user…"
                   class="w-full bg-white border border-slate-200 rounded-xl pl-8 pr-3 py-2 text-xs focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 outline-none shadow-sm">
        </form>
    </div>

    {# ============ QUICK ACTIONS ============ #}
    <div class="mb-8 flex flex-wrap gap-2">
        <a href="{{ url('lms:courses') }}" class="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-3 py-1.5 text-xs font-black text-white hover:bg-indigo-500 shadow-sm">📚 LMS Setup</a>
        <a href="{{ url('lms:attendance_admin') }}" class="inline-flex items-center gap-1.5 rounded-xl border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-black text-sky-700 hover:bg-sky-100 shadow-sm">📅 Attendance</a>
        <a href="{{ url('dashboard:cms_home') }}" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 hover:bg-slate-50 shadow-sm">🧩 Content CMS</a>
        <a href="/sd/assessment/question/add/" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 hover:bg-slate-50 shadow-sm">➕ Add question</a>
        <a href="/sd/learning/conceptvideo/add/" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 hover:bg-slate-50 shadow-sm">🎬 New video</a>
        <a href="/sd/core/earningtask/add/" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 hover:bg-slate-50 shadow-sm">💵 Post task</a>
        <a href="{{ url('dashboard:seo_smart_view') }}" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 hover:bg-slate-50 shadow-sm">🧠 SEO</a>
        <a href="{{ url('dashboard:backup_center') }}" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-700 hover:bg-slate-50 shadow-sm">🗃️ Backup</a>
        <a href="/sd/" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-500 hover:bg-slate-50 shadow-sm">⚙️ /sd/</a>
    </div>

    {# ============ 3-COLUMN: ACTION CENTER · DEMO REQUESTS · TUTOR LEADS ============ #}
    <div class="mb-8 grid grid-cols-1 lg:grid-cols-3 gap-4 items-start">

    {# COL 1: Action Center #}
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden" x-data="{ showClear: false }">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between gap-3"
             style="background: linear-gradient(135deg, #fff7f7 0%, #fff 100%);">
            <div class="flex items-center gap-3">
                <h2 class="text-xs font-black uppercase tracking-widest text-slate-800">Needs your attention</h2>
                {% if action_hot %}
                <span class="inline-flex items-center justify-center h-5 min-w-[1.25rem] px-1.5 rounded-full bg-rose-600 text-white text-[10px] font-black">{{ action_hot | length }}</span>
                {% else %}
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-black text-emerald-700">✓ All clear</span>
                {% endif %}
            </div>
            {% if action_clear %}
            <button @click="showClear = !showClear"
                    class="text-[10px] font-black uppercase tracking-wider text-slate-400 hover:text-slate-600 transition-colors">
                <span x-text="showClear ? 'Hide cleared' : '{{ action_clear | length }} cleared ↓'"></span>
            </button>
            {% endif %}
        </div>

        {% if action_hot %}
        <div class="divide-y divide-slate-100">
            {% for item in action_hot %}
            {% set is_critical = item.priority == 'critical' %}
            {% set is_warning = item.priority == 'warning' %}
            <div class="flex items-center justify-between gap-2 px-3 py-2
                        {{ 'border-l-4 border-rose-500 bg-rose-50/30' if is_critical else 'border-l-4 border-amber-400 bg-amber-50/20' if is_warning else 'border-l-4 border-indigo-300 bg-indigo-50/10' }}">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-sm leading-none flex-shrink-0">{{ item.icon }}</span>
                    <div class="min-w-0">
                        <p class="text-xs font-bold text-slate-800 leading-snug truncate">{{ item.label }}</p>
                        {% if item.amount is not none and item.amount > 0 %}
                        <p class="text-[10px] font-black text-emerald-700">₹{{ "{:,.0f}".format(item.amount) }}</p>
                        {% endif %}
                    </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                    <span class="inline-flex h-5 w-5 items-center justify-center rounded-full
                                 {{ 'bg-rose-600 text-white' if is_critical else 'bg-amber-500 text-white' if is_warning else 'bg-indigo-600 text-white' }}
                                 text-[10px] font-black flex-shrink-0">{{ item.count }}</span>
                    {% if item.url %}
                    <a href="{{ item.url }}"
                       class="whitespace-nowrap rounded-md px-2 py-1 text-[10px] font-black uppercase tracking-wider transition-colors
                              {{ 'bg-rose-600 text-white hover:bg-rose-700' if is_critical else 'bg-amber-500 text-white hover:bg-amber-600' if is_warning else 'bg-indigo-600 text-white hover:bg-indigo-700' }}">
                        Open →
                    </a>
                    {% elif item.anchor %}
                    <a href="{{ item.anchor }}"
                       class="whitespace-nowrap rounded-md px-2 py-1 text-[10px] font-black uppercase tracking-wider transition-colors
                              {{ 'bg-rose-600 text-white hover:bg-rose-700' if is_critical else 'bg-amber-500 text-white hover:bg-amber-600' if is_warning else 'bg-indigo-600 text-white hover:bg-indigo-700' }}">
                        Review ↓
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="px-4 py-4 text-center">
            <p class="text-xl mb-0.5">🎉</p>
            <p class="text-xs font-bold text-emerald-700">Everything's under control.</p>
        </div>
        {% endif %}

        {# Collapsed "all clear" items #}
        {% if action_clear %}
        <div x-show="showClear" class="border-t border-slate-100">
            <div class="divide-y divide-slate-100/70">
                {% for item in action_clear %}
                <div class="flex items-center justify-between gap-2 px-3 py-1.5 opacity-60">
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="text-xs leading-none flex-shrink-0">{{ item.icon }}</span>
                        <p class="text-[11px] font-bold text-slate-500 truncate">{{ item.label }}</p>
                    </div>
                    <span class="text-[10px] font-black uppercase tracking-wider text-emerald-600 flex-shrink-0">✓</span>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </section>
    {# END COL 1 #}

    {# COL 2: Demo Requests #}
    <section id="demo-requests" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-20">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between gap-2"
             style="background: linear-gradient(135deg, #eef2ff 0%, #fff 100%);">
            <h3 class="text-xs font-black uppercase tracking-widest text-slate-800">📅 Demo requests</h3>
            {% set demo_count = latest_demo_requests | length %}
            {% if demo_count > 0 %}
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-white text-[10px] font-black">{{ demo_count }}</span>
            {% endif %}
        </div>
        <div class="divide-y divide-slate-100 max-h-[28rem] overflow-y-auto">
            {% for d in latest_demo_requests %}
            <div class="px-4 py-3">
                <div class="flex items-start justify-between gap-2 mb-2">
                    <div class="min-w-0">
                        <p class="text-xs font-black text-slate-900 truncate">{{ d.requester.get_username() }}</p>
                        <p class="text-[10px] text-slate-500 truncate">{{ d.contact_phone or d.requester.email or '—' }}</p>
                        <a href="{{ url('hometutor:tutor_detail', slug=d.tutor.slug) }}" target="_blank"
                           class="text-[10px] font-bold text-indigo-600 hover:underline truncate block">→ {{ d.tutor.display_name }}</a>
                    </div>
                </div>
                <div class="flex gap-1.5">
                    <form method="post" action="{{ url('dashboard:update_demo_request_status', demo_id=d.id) }}" class="flex-1">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <input type="hidden" name="status" value="DECLINED">
                        <button type="submit" class="w-full rounded-lg border border-rose-200 bg-rose-50 py-1.5 text-[10px] font-black uppercase tracking-wider text-rose-700 hover:bg-rose-100">Decline</button>
                    </form>
                    <form method="post" action="{{ url('dashboard:update_demo_request_status', demo_id=d.id) }}" class="flex-1">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <input type="hidden" name="status" value="ACCEPTED">
                        <button type="submit" class="w-full rounded-lg border border-emerald-200 bg-emerald-50 py-1.5 text-[10px] font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100">Accept</button>
                    </form>
                </div>
            </div>
            {% else %}
            <div class="px-4 py-8 text-center text-slate-400 text-xs font-bold">No demo requests pending.</div>
            {% endfor %}
        </div>
    </section>
    {# END COL 2 #}

    {# COL 3: Tutor Leads #}
    <section id="tutor-leads" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-20">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between gap-2"
             style="background: linear-gradient(135deg, #f0fdf4 0%, #fff 100%);">
            <h3 class="text-xs font-black uppercase tracking-widest text-slate-800">🎯 Tutor leads</h3>
            {% set lead_count = latest_tutor_requests | length %}
            {% if lead_count > 0 %}
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-600 text-white text-[10px] font-black">{{ lead_count }}</span>
            {% endif %}
        </div>
        <div class="divide-y divide-slate-100 max-h-[28rem] overflow-y-auto">
            {% for row in latest_tutor_requests %}
            <div class="flex items-center gap-2 px-3 py-2">
                {# Lead info — left #}
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-black text-slate-900 truncate leading-tight">{{ row.full_name }}</p>
                    <p class="text-[10px] text-slate-500 truncate">{{ row.phone }}{% if row.email %} · {{ row.email }}{% endif %}</p>
                    <p class="text-[10px] text-indigo-600 truncate">{{ row.city }}{% if row.area %} · {{ row.area }}{% endif %} — {{ row.subjects }}{% if row.class_grade %} · Cls {{ row.class_grade }}{% endif %}</p>
                </div>
                {# Action buttons — right, compact inline #}
                <div class="flex flex-shrink-0 gap-1">
                    <form method="post" action="{{ url('dashboard:update_tutor_request_status', request_id=row.id) }}">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <input type="hidden" name="status" value="CONTACTED">
                        <button type="submit" class="rounded-md border border-amber-200 bg-amber-50 px-2 py-1 text-[10px] font-black uppercase tracking-wider text-amber-700 hover:bg-amber-100 whitespace-nowrap">✉ Done</button>
                    </form>
                    <form method="post" action="{{ url('dashboard:update_tutor_request_status', request_id=row.id) }}">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <input type="hidden" name="status" value="CLOSED">
                        <button type="submit" class="rounded-md border border-emerald-200 bg-emerald-50 px-2 py-1 text-[10px] font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100 whitespace-nowrap">✓ Close</button>
                    </form>
                </div>
            </div>
            {% else %}
            <div class="px-4 py-8 text-center text-slate-400 text-xs font-bold">No new leads.</div>
            {% endfor %}
        </div>
    </section>
    {# END COL 3 #}

    </div>{# end 3-col grid #}

    {# ============ ATTENDANCE PULSE — faculty + student, compact, side by side ============ #}
    <div class="mb-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="mb-3 flex items-center justify-between">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-800">🧑‍🏫 Faculty attendance</h3>
                <span class="text-[10px] font-black uppercase text-slate-400">Today</span>
            </div>
            <div class="flex items-end gap-4">
                <p class="text-2xl font-black text-emerald-600">{{ faculty_attendance_today.marked }}<span class="text-sm text-slate-400">/{{ faculty_attendance_today.total }}</span></p>
                <p class="text-[10px] font-black uppercase text-slate-500 pb-1">Marked today</p>
                {% if faculty_attendance_today.pending_count > 0 %}
                <span class="ml-auto shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-black text-amber-800">{{ faculty_attendance_today.pending_count }} pending</span>
                {% endif %}
            </div>
            {% if faculty_attendance_today.pending_faculty %}
            <div class="mt-3 flex flex-wrap gap-1.5">
                {% for f in faculty_attendance_today.pending_faculty %}
                <span class="rounded-md bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600">{{ f.get_full_name() or f.username }}</span>
                {% endfor %}
            </div>
            {% endif %}
        </section>
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="mb-3 flex items-center justify-between">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-800">🎓 Student attendance</h3>
                <span class="text-[10px] font-black uppercase text-slate-400">Today</span>
            </div>
            {% if student_attendance_today.total %}
            <div class="flex items-end gap-4">
                <p class="text-2xl font-black text-indigo-600">{{ student_attendance_today.rate }}<span class="text-sm text-slate-400">%</span></p>
                <div class="flex flex-wrap gap-x-3 gap-y-1 pb-1 text-[10px] font-black uppercase">
                    <span class="text-emerald-600">{{ student_attendance_today.present }} present</span>
                    <span class="text-amber-600">{{ student_attendance_today.late }} late</span>
                    <span class="text-rose-600">{{ student_attendance_today.absent }} absent</span>
                </div>
            </div>
            {% else %}
            <p class="py-2 text-xs font-bold text-slate-400">No attendance marked yet today.</p>
            {% endif %}
        </section>
    </div>

    {# ============ FACULTY & COURSE QUICK SETUP ============ #}
    <section class="mb-8 bg-slate-50 rounded-2xl border border-indigo-100 shadow-sm overflow-hidden"
             x-data="{ tab: 'create' }">

        {# Header #}
        <div class="p-4 border-b border-indigo-100 bg-indigo-100/60 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-3">
                <h2 class="text-xs font-black uppercase tracking-widest text-slate-800">Faculty &amp; Course Quick Setup</h2>
                {% if lms_stats.needs_attention > 0 %}
                <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-black text-amber-700">⚠ {{ lms_stats.needs_attention }} need setup</span>
                {% endif %}
            </div>
            <a href="{{ url('lms:courses') }}" class="text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:underline">Full LMS manager →</a>
        </div>

        {# LMS Pulse Bar #}
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 divide-x divide-indigo-100 border-b border-indigo-100 bg-white/80">
            <div class="px-4 py-3 text-center">
                <p class="text-xl font-black text-slate-900">{{ lms_stats.total_courses }}</p>
                <p class="text-[10px] font-black uppercase text-slate-500 mt-0.5">Active courses</p>
            </div>
            <div class="px-4 py-3 text-center">
                <p class="text-xl font-black {{ 'text-amber-600' if lms_stats.courses_no_faculty > 0 else 'text-slate-400' }}">{{ lms_stats.courses_no_faculty }}</p>
                <p class="text-[10px] font-black uppercase text-slate-500 mt-0.5">No faculty</p>
            </div>
            <div class="px-4 py-3 text-center">
                <p class="text-xl font-black {{ 'text-amber-600' if lms_stats.courses_no_students > 0 else 'text-slate-400' }}">{{ lms_stats.courses_no_students }}</p>
                <p class="text-[10px] font-black uppercase text-slate-500 mt-0.5">No students</p>
            </div>
            <div class="px-4 py-3 text-center">
                <p class="text-xl font-black {{ 'text-amber-600' if lms_stats.courses_no_assignments > 0 else 'text-slate-400' }}">{{ lms_stats.courses_no_assignments }}</p>
                <p class="text-[10px] font-black uppercase text-slate-500 mt-0.5">No assignments</p>
            </div>
            <div class="px-4 py-3 text-center">
                <p class="text-xl font-black text-indigo-700">{{ lms_stats.total_students }}</p>
                <p class="text-[10px] font-black uppercase text-slate-500 mt-0.5">Total students</p>
            </div>
            <div class="px-4 py-3 text-center">
                <p class="text-xl font-black {{ 'text-rose-600' if lms_stats.pending_grading > 0 else 'text-slate-400' }}">{{ lms_stats.pending_grading }}</p>
                <p class="text-[10px] font-black uppercase text-slate-500 mt-0.5">Pending grades</p>
            </div>
        </div>

        {# Tabs #}
        <div class="flex border-b border-indigo-100 overflow-x-auto bg-white/60">
            <button @click="tab='create'"
                    :class="tab==='create' ? 'border-b-2 border-indigo-600 text-indigo-700 bg-indigo-50/40' : 'text-slate-500 hover:text-slate-800'"
                    class="px-5 py-3 text-[11px] font-black uppercase tracking-wider whitespace-nowrap transition-colors flex-shrink-0">
                ➕ Create course
            </button>
            <button @click="tab='bulk'"
                    :class="tab==='bulk' ? 'border-b-2 border-indigo-600 text-indigo-700 bg-indigo-50/40' : 'text-slate-500 hover:text-slate-800'"
                    class="px-5 py-3 text-[11px] font-black uppercase tracking-wider whitespace-nowrap transition-colors flex-shrink-0">
                👥 Bulk enroll students
            </button>
            <button @click="tab='student'"
                    :class="tab==='student' ? 'border-b-2 border-indigo-600 text-indigo-700 bg-indigo-50/40' : 'text-slate-500 hover:text-slate-800'"
                    class="px-5 py-3 text-[11px] font-black uppercase tracking-wider whitespace-nowrap transition-colors flex-shrink-0">
                👤 Add one student
            </button>
            <button @click="tab='topic'"
                    :class="tab==='topic' ? 'border-b-2 border-indigo-600 text-indigo-700 bg-indigo-50/40' : 'text-slate-500 hover:text-slate-800'"
                    class="px-5 py-3 text-[11px] font-black uppercase tracking-wider whitespace-nowrap transition-colors flex-shrink-0">
                📝 Add topic
            </button>
            <button @click="tab='content'"
                    :class="tab==='content' ? 'border-b-2 border-indigo-600 text-indigo-700 bg-indigo-50/40' : 'text-slate-500 hover:text-slate-800'"
                    class="px-5 py-3 text-[11px] font-black uppercase tracking-wider whitespace-nowrap transition-colors flex-shrink-0">
                📚 Add content
            </button>
            <button @click="tab='faculty'"
                    :class="tab==='faculty' ? 'border-b-2 border-indigo-600 text-indigo-700 bg-indigo-50/40' : 'text-slate-500 hover:text-slate-800'"
                    class="px-5 py-3 text-[11px] font-black uppercase tracking-wider whitespace-nowrap transition-colors flex-shrink-0">
                🔄 Reassign faculty
            </button>
            <button @click="tab='courses'"
                    :class="tab==='courses' ? 'border-b-2 border-indigo-600 text-indigo-700 bg-indigo-50/40' : 'text-slate-500 hover:text-slate-800'"
                    class="px-5 py-3 text-[11px] font-black uppercase tracking-wider whitespace-nowrap transition-colors flex-shrink-0">
                📊 Course health
            </button>
        </div>

        {# ── Tab: Create course ── #}
        <div x-show="tab==='create'" x-cloak class="p-5 bg-slate-50/80">
            <datalist id="lms-dash-student-options">
                {% for s in lms_student_options %}
                <option value="{{ s.username }}{% if s.email %} · {{ s.email }}{% endif %}">
                {% endfor %}
            </datalist>
            <p class="mb-3 text-xs font-bold text-slate-500">Create a new course and assign the faculty who will teach it. The course appears in that faculty's LMS dashboard immediately.</p>
            <form method="post" action="{{ url('lms:courses') }}" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="create_course">
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500">Course name <span class="text-rose-500">*</span></label>
                    {{ lms_course_form.name }}
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500">Faculty / tutor</label>
                    {{ lms_course_form.owner }}
                </div>
                {% if lms_course_form.catalog_course %}
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500">Link to paid course</label>
                    {{ lms_course_form.catalog_course }}
                </div>
                {% endif %}
                <div class="sm:col-span-2 lg:col-span-3 flex flex-wrap items-center gap-4">
                    {% if lms_course_form.is_default_for_catalog %}
                    <label class="flex items-center gap-2 text-xs font-bold text-slate-700">
                        {{ lms_course_form.is_default_for_catalog }} Auto-enroll paid course buyers
                    </label>
                    {% endif %}
                    <label class="flex items-center gap-2 text-xs font-bold text-slate-700">
                        {{ lms_course_form.is_active }} Active (visible to faculty &amp; students)
                    </label>
                    <button type="submit" class="ml-auto rounded-xl bg-indigo-600 px-5 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500 whitespace-nowrap">Create course →</button>
                </div>
            </form>
        </div>

        {# ── Tab: Bulk enroll students ── #}
        <div x-show="tab==='bulk'" x-cloak class="p-5 bg-slate-50/80">
            <p class="mb-4 text-xs font-bold text-slate-500">
                Select a course to see all platform students. Check boxes to enroll or remove.
                One student can be in multiple courses — no limit.
            </p>
            {% if lms_quick_courses %}
            <form method="post" action="{{ url('lms:bulk_enroll') }}" id="bulk-enroll-form">
                {{ csrf_input }}
                <input type="hidden" name="next" value="{{ request.path }}">

                {# Step 1: pick a course — HTMX loads student list #}
                <div class="mb-4">
                    <label class="mb-1.5 block text-[10px] font-black uppercase tracking-wider text-slate-600">
                        Step 1 — Select course <span class="text-rose-500">*</span>
                    </label>
                    <select name="course_id" required
                            hx-get=""
                            hx-trigger="change"
                            hx-target="#bulk-student-list"
                            hx-swap="innerHTML"
                            hx-indicator="#bulk-loading"
                            @change="
                                const v = $event.target.value;
                                if (v) {
                                    htmx.ajax('GET', '/admin/lms/courses/' + v + '/students/', {target: '#bulk-student-list', swap: 'innerHTML'});
                                } else {
                                    document.getElementById('bulk-student-list').innerHTML = '';
                                }
                            "
                            class="w-full max-w-md rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-100 outline-none">
                        <option value="">Pick a course…</option>
                        {% for c in lms_quick_courses %}
                        <option value="{{ c.pk }}">
                            {{ c.name }}{% if c.owner %} ({{ c.owner.get_username() }}){% endif %}
                        </option>
                        {% endfor %}
                    </select>
                    <span id="bulk-loading" class="htmx-indicator ml-3 text-xs font-bold text-indigo-600">Loading students…</span>
                </div>

                {# Step 2: student list loads here via HTMX #}
                <div class="mb-2">
                    <label class="mb-1.5 block text-[10px] font-black uppercase tracking-wider text-slate-600">
                        Step 2 — Select students
                    </label>
                    <div id="bulk-student-list" class="min-h-[3rem]">
                        <p class="text-xs text-slate-400 italic">↑ Pick a course above to load its student list.</p>
                    </div>
                </div>
            </form>
            {% else %}
            <p class="text-xs text-slate-400 py-6 text-center">No courses yet. Create a course first using the "Create course" tab.</p>
            {% endif %}
        </div>

        {# ── Tab: Add one student (quick single enroll) ── #}
        <div x-show="tab==='student'" x-cloak class="p-5 bg-slate-50/80">
            <p class="mb-3 text-xs font-bold text-slate-500">
                Quick single-student enroll. For many students at once, use the <button @click="tab='bulk'" class="text-indigo-600 underline font-bold">Bulk enroll</button> tab.
            </p>
            <form method="post" action="{{ url('lms:courses') }}" class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="add_member">
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500">Course <span class="text-rose-500">*</span></label>
                    <select name="course_id" required class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-100 outline-none">
                        <option value="">Pick a course…</option>
                        {% for c in lms_quick_courses %}
                        <option value="{{ c.pk }}">
                            {{ c.name }}{% if c.owner %} · {{ c.owner.get_username() }}{% endif %}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500">Student username or email <span class="text-rose-500">*</span></label>
                    <input type="text" name="username" required list="lms-dash-student-options"
                           placeholder="Type to search students…"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-100 outline-none">
                </div>
                <button type="submit" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500 whitespace-nowrap">Enroll →</button>
            </form>
            <p class="mt-2 text-[10px] text-slate-400">{{ lms_student_options | length }} student accounts in typeahead.</p>
        </div>

        {# ── Tab: Add topic ── #}
        <div x-show="tab==='topic'" x-cloak class="p-5 bg-slate-50/80">
            <p class="mb-3 text-xs font-bold text-slate-500">Create a curriculum topic scoped to a specific course. It shows in that course's LMS sidebar immediately — no assignment needed first.</p>
            <form method="post" action="{{ url('lms:topic_create') }}" class="grid gap-3 sm:grid-cols-[2fr_2fr_auto] sm:items-end">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500">Topic title <span class="text-rose-500">*</span></label>
                    <input type="text" name="title" required placeholder="e.g. Week 1 — Fundamentals"
                           class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-100 outline-none">
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500">Course</label>
                    <select name="course" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-100 outline-none">
                        <option value="">Platform-wide (all courses)</option>
                        {% for c in lms_quick_courses %}
                        <option value="{{ c.pk }}">{{ c.name }}{% if c.owner %} · {{ c.owner.get_username() }}{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500 whitespace-nowrap">Add topic →</button>
            </form>
        </div>

        {# ── Tab: Add content (topics, notes, exams, videos) — superadmin only ── #}
        <div x-show="tab==='content'" x-cloak class="p-5 bg-slate-50/80">
            <p class="mb-4 text-xs font-bold text-slate-500">
                Superadmin adds all curriculum content. Faculty only gives assignments and grades submissions.
            </p>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {# Add topic #}
                <div class="rounded-xl border border-indigo-100 bg-white p-4">
                    <div class="mb-3 flex items-center gap-2">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-100 text-base">📝</span>
                        <p class="text-xs font-black uppercase tracking-wider text-slate-700">New Topic</p>
                    </div>
                    <p class="mb-3 text-[10px] text-slate-500 leading-snug">Adds a topic to the LMS sidebar for a course.</p>
                    <form method="post" action="{{ url('lms:topic_create') }}" class="space-y-2">
                        {{ csrf_input }}
                        <input type="text" name="title" required placeholder="Topic title…"
                               class="w-full rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs focus:ring-1 focus:ring-indigo-200 outline-none">
                        <select name="course" class="w-full rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs focus:ring-1 focus:ring-indigo-200 outline-none">
                            <option value="">All courses (platform-wide)</option>
                            {% for c in lms_quick_courses %}
                            <option value="{{ c.pk }}">{{ c.name }}{% if c.owner %} · {{ c.owner.get_username() }}{% endif %}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="w-full rounded-lg bg-indigo-600 py-1.5 text-[11px] font-black uppercase tracking-wider text-white hover:bg-indigo-500">Add topic →</button>
                    </form>
                </div>

                {# Add study notes #}
                <div class="rounded-xl border border-emerald-100 bg-white p-4">
                    <div class="mb-3 flex items-center gap-2">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-base">📖</span>
                        <p class="text-xs font-black uppercase tracking-wider text-slate-700">Study Notes</p>
                    </div>
                    <p class="mb-3 text-[10px] text-slate-500 leading-snug">Add notes/study material in the study hub.</p>
                    <div class="space-y-2">
                        <a href="{{ url('dashboard:study') }}" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-black text-emerald-800 hover:bg-emerald-100">
                            Study hub <span>→</span>
                        </a>
                        <a href="{{ url('dashboard:blog_post_create') }}" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-black text-slate-700 hover:bg-slate-100">
                            Add blog/article <span>→</span>
                        </a>
                        <a href="{{ url('dashboard:cms_home') }}" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-black text-slate-700 hover:bg-slate-100">
                            Content CMS <span>→</span>
                        </a>
                    </div>
                </div>

                {# Add video lecture #}
                <div class="rounded-xl border border-violet-100 bg-white p-4">
                    <div class="mb-3 flex items-center gap-2">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-100 text-base">🎬</span>
                        <p class="text-xs font-black uppercase tracking-wider text-slate-700">Video Lecture</p>
                    </div>
                    <p class="mb-3 text-[10px] text-slate-500 leading-snug">Add recorded lectures to /learning/ library.</p>
                    <div class="space-y-2">
                        <a href="/sd/learning/conceptvideo/add/" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-xs font-black text-violet-800 hover:bg-violet-100">
                            Add video lecture <span>→</span>
                        </a>
                        <a href="{{ url('learning:index') }}" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-black text-slate-700 hover:bg-slate-100">
                            Video library <span>→</span>
                        </a>
                    </div>
                </div>

                {# Add exam / test #}
                <div class="rounded-xl border border-amber-100 bg-white p-4">
                    <div class="mb-3 flex items-center gap-2">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-base">📋</span>
                        <p class="text-xs font-black uppercase tracking-wider text-slate-700">Exam / Test</p>
                    </div>
                    <p class="mb-3 text-[10px] text-slate-500 leading-snug">Add MCQ skills and questions for exams.</p>
                    <div class="space-y-2">
                        <a href="/sd/assessment/skill/add/" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-black text-amber-800 hover:bg-amber-100">
                            Add skill/exam <span>→</span>
                        </a>
                        <a href="/sd/assessment/question/add/" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-black text-slate-700 hover:bg-slate-100">
                            Add question <span>→</span>
                        </a>
                        <a href="{{ url('assessment:index') }}" target="_blank"
                           class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-black text-slate-700 hover:bg-slate-100">
                            Test center <span>→</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# ── Tab: Reassign faculty ── #}
        <div x-show="tab==='faculty'" x-cloak class="p-5 bg-slate-50/80">
            <p class="mb-3 text-xs font-bold text-slate-500">Change which faculty/tutor teaches an existing course. Saves immediately. Warning: removing the owner means only a superuser can manage or grade it.</p>
            {% if lms_quick_courses %}
            <div class="space-y-2 max-h-96 overflow-y-auto pr-1">
                {% for c in lms_quick_courses %}
                <form method="post" action="{{ url('lms:courses') }}"
                      class="flex flex-wrap items-center gap-2 rounded-xl border
                             {{ 'border-amber-200 bg-amber-50/40' if not c.owner else 'border-slate-100 bg-slate-50/50' }}
                             px-3 py-2.5">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="reassign_owner">
                    <input type="hidden" name="course_id" value="{{ c.pk }}">
                    <div class="flex-1 min-w-[8rem]">
                        <p class="text-xs font-black text-slate-800 leading-snug">{{ c.name }}</p>
                        {% if c.catalog_course %}<p class="text-[10px] text-indigo-600">→ {{ c.catalog_course.title }}</p>{% endif %}
                        <p class="text-[10px] text-slate-400 mt-0.5">{{ c.enrollments.all()|length }} students · {{ c.assignment_count }} assignments</p>
                    </div>
                    <select name="owner_id" class="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs font-bold text-slate-700 min-w-[8rem]">
                        <option value="">No owner (platform-wide)</option>
                        {% for o in lms_owner_options %}
                        <option value="{{ o.pk }}" {% if c.owner_id == o.pk %}selected{% endif %}>{{ o.get_username() }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="rounded-lg bg-indigo-600 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-white hover:bg-indigo-500 whitespace-nowrap">Save</button>
                </form>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-xs text-slate-400 text-center py-6">No courses yet — create the first one using the "Create course" tab.</p>
            {% endif %}
        </div>

        {# ── Tab: Course health grid ── #}
        <div x-show="tab==='courses'" x-cloak>
            {% if lms_quick_courses %}
            <div class="overflow-x-auto">
                <table class="w-full text-left min-w-[640px]">
                    <thead class="bg-slate-50 border-b border-slate-100">
                        <tr class="text-[10px] font-black uppercase tracking-widest text-slate-500">
                            <th class="px-5 py-3">Course</th>
                            <th class="px-5 py-3">Faculty</th>
                            <th class="px-5 py-3 text-center">Students</th>
                            <th class="px-5 py-3 text-center">Topics</th>
                            <th class="px-5 py-3 text-center">Assignments</th>
                            <th class="px-5 py-3 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for c in lms_quick_courses %}
                        {% set sc = c.enrollments.all()|length %}
                        {% set tc = c.topic_count %}
                        {% set ac = c.assignment_count %}
                        {% set healthy = c.owner and sc > 0 and ac > 0 %}
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-5 py-3">
                                <p class="text-xs font-black text-slate-900 leading-snug">{{ c.name }}</p>
                                {% if c.catalog_course %}
                                <p class="text-[10px] text-indigo-600">→ {{ c.catalog_course.title }}</p>
                                {% endif %}
                                {% if not c.is_active %}
                                <span class="text-[9px] font-black uppercase text-rose-500">Inactive</span>
                                {% endif %}
                            </td>
                            <td class="px-5 py-3">
                                {% if c.owner %}
                                <span class="text-xs font-bold text-slate-700">{{ c.owner.get_username() }}</span>
                                {% else %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-black text-amber-700">⚠ None</span>
                                {% endif %}
                            </td>
                            <td class="px-5 py-3 text-center">
                                <span class="text-sm font-black {{ 'text-amber-600' if sc == 0 else 'text-slate-800' }}">{{ sc }}</span>
                            </td>
                            <td class="px-5 py-3 text-center">
                                <span class="text-sm font-black {{ 'text-amber-600' if tc == 0 else 'text-slate-800' }}">{{ tc }}</span>
                            </td>
                            <td class="px-5 py-3 text-center">
                                <span class="text-sm font-black {{ 'text-amber-600' if ac == 0 else 'text-slate-800' }}">{{ ac }}</span>
                            </td>
                            <td class="px-5 py-3 text-center">
                                {% if healthy %}
                                <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500" title="Ready"></span>
                                {% elif not c.owner %}
                                <span class="inline-flex h-2.5 w-2.5 rounded-full bg-rose-500" title="No faculty assigned"></span>
                                {% else %}
                                <span class="inline-flex h-2.5 w-2.5 rounded-full bg-amber-400" title="Needs setup"></span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if lms_quick_courses | length == 20 %}
            <p class="px-5 py-2 text-[10px] text-slate-400 border-t border-slate-100">Showing latest 20 courses. <a href="{{ url('lms:courses') }}" class="underline text-indigo-600">See all →</a></p>
            {% endif %}
            {% else %}
            <p class="px-5 py-8 text-xs text-slate-400 text-center">No courses yet — use the "Create course" tab to add the first one.</p>
            {% endif %}
        </div>
    </section>

    {# ============ REVENUE + GROWTH side by side ============ #}
    <div class="mb-4 grid grid-cols-1 lg:grid-cols-2 gap-4">

        {# LEFT: Revenue #}
        <section>
            <h2 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-3">💰 Revenue (SUCCESS payments only)</h2>
            <div class="grid grid-cols-3 gap-3 mb-3">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-[10px] font-black uppercase text-slate-500 tracking-widest mb-1">Today</p>
                    <p class="text-xl font-black text-slate-900">₹{{ "{:,.0f}".format(revenue.totals.today) }}</p>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-[10px] font-black uppercase text-slate-500 tracking-widest mb-1">7 days
                        {% if wow.revenue_pct_change is not none %}
                        <span class="block {{ 'text-emerald-600' if wow.revenue_pct_change >= 0 else 'text-rose-600' }} normal-case">{{ '▲' if wow.revenue_pct_change >= 0 else '▼' }} {{ wow.revenue_pct_change|abs }}%</span>
                        {% endif %}
                    </p>
                    <p class="text-xl font-black text-slate-900">₹{{ "{:,.0f}".format(revenue.totals.week) }}</p>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-[10px] font-black uppercase text-slate-500 tracking-widest mb-1">30 days</p>
                    <p class="text-xl font-black text-slate-900">₹{{ "{:,.0f}".format(revenue.totals.month) }}</p>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <table class="w-full text-left">
                    <thead class="bg-slate-50 text-[10px] uppercase font-black tracking-widest text-slate-600 border-b">
                        <tr>
                            <th class="px-4 py-2.5">Source</th>
                            <th class="px-3 py-2.5 text-right">Today</th>
                            <th class="px-3 py-2.5 text-right">7d</th>
                            <th class="px-3 py-2.5 text-right">30d</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for row in revenue.by_source %}
                        <tr>
                            <td class="px-4 py-2.5 text-xs font-bold text-slate-800">
                                {{ row.label }}
                                {% if row.key == 'hometutor' %}
                                <span class="block text-[10px] font-normal text-slate-400">Gross — tutor share paid separately</span>
                                {% endif %}
                            </td>
                            <td class="px-3 py-2.5 text-xs font-bold text-slate-700 text-right">₹{{ "{:,.0f}".format(row.today) }}</td>
                            <td class="px-3 py-2.5 text-xs font-bold text-slate-700 text-right">₹{{ "{:,.0f}".format(row.week) }}</td>
                            <td class="px-3 py-2.5 text-xs font-bold text-slate-700 text-right">₹{{ "{:,.0f}".format(row.month) }}</td>
                        </tr>
                        {% if row.key == 'hometutor' %}
                        <tr class="bg-emerald-50/40">
                            <td class="px-4 py-2 text-[10px] font-black text-emerald-700 pl-7">↳ platform net fee</td>
                            <td class="px-3 py-2 text-[10px] font-black text-emerald-700 text-right">₹{{ "{:,.0f}".format(revenue.hometutor_platform_fee.today) }}</td>
                            <td class="px-3 py-2 text-[10px] font-black text-emerald-700 text-right">₹{{ "{:,.0f}".format(revenue.hometutor_platform_fee.week) }}</td>
                            <td class="px-3 py-2 text-[10px] font-black text-emerald-700 text-right">₹{{ "{:,.0f}".format(revenue.hometutor_platform_fee.month) }}</td>
                        </tr>
                        {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {# RIGHT: Growth #}
        <section>
            <h2 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-3">📈 Growth</h2>
            <div class="grid grid-cols-3 gap-3 mb-3">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-xl font-black text-slate-900">{{ growth.total_users }}</p>
                    <p class="text-[10px] font-black uppercase text-slate-500 mt-1">Total users</p>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-xl font-black text-emerald-600">+{{ growth.new_today }}</p>
                    <p class="text-[10px] font-black uppercase text-slate-500 mt-1">Today</p>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-xl font-black text-emerald-600">+{{ growth.new_week }}</p>
                    <p class="text-[10px] font-black uppercase text-slate-500 mt-1">7d signups</p>
                    {% if wow.signups_pct_change is not none %}
                    <p class="text-[10px] font-black mt-0.5 {{ 'text-emerald-600' if wow.signups_pct_change >= 0 else 'text-rose-600' }}">{{ '▲' if wow.signups_pct_change >= 0 else '▼' }} {{ wow.signups_pct_change|abs }}%</p>
                    {% endif %}
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-xl font-black text-emerald-600">+{{ growth.new_month }}</p>
                    <p class="text-[10px] font-black uppercase text-slate-500 mt-1">30d signups</p>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm text-center col-span-2">
                    <p class="text-xl font-black text-indigo-600">{{ growth.active_week }}</p>
                    <p class="text-[10px] font-black uppercase text-slate-500 mt-1">Active last 7 days</p>
                </div>
            </div>
        </section>

    </div>

    {# ============ DAILY TREND CHARTS side by side ============ #}
    <div class="mb-8 grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-3">📊 Daily revenue — last 14 days</p>
            <div class="flex items-end gap-1.5 h-24">
                {% for row in revenue_trend %}
                <div class="flex-1 flex flex-col items-center justify-end h-full group relative">
                    <div class="w-full rounded-t bg-indigo-500 group-hover:bg-indigo-600 transition-colors" style="height: {{ row.pct }}%; min-height: {{ '2px' if row.amount == 0 else '4px' }};"></div>
                    <span class="absolute -top-6 hidden group-hover:block text-[10px] font-black bg-slate-900 text-white px-1.5 py-0.5 rounded whitespace-nowrap z-10">{{ row.date.strftime('%d %b') }}: ₹{{ "{:,.0f}".format(row.amount) }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-3">👥 Daily signups — last 14 days</p>
            <div class="flex items-end gap-1.5 h-24">
                {% for row in signup_trend %}
                <div class="flex-1 flex flex-col items-center justify-end h-full group relative">
                    <div class="w-full rounded-t bg-emerald-500 group-hover:bg-emerald-600 transition-colors" style="height: {{ row.pct }}%; min-height: {{ '2px' if row.count == 0 else '4px' }};"></div>
                    <span class="absolute -top-6 hidden group-hover:block text-[10px] font-black bg-slate-900 text-white px-1.5 py-0.5 rounded whitespace-nowrap z-10">{{ row.date.strftime('%d %b') }}: {{ row.count }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ============ BALANCE SHEET + CONTENT HEALTH ============ #}
    <section class="mb-8 grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
            <h2 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-4">Money the platform currently owes</h2>
            <div class="space-y-2.5">
                <div class="flex justify-between items-center text-sm">
                    <span class="font-bold text-slate-600">Student wallet balances (unwithdrawn)</span>
                    <span class="font-black text-slate-900">₹{{ "{:,.0f}".format(balance_sheet.wallet_liability) }}</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="font-bold text-slate-600">Pending UPI withdrawals</span>
                    <span class="font-black text-slate-900">₹{{ "{:,.0f}".format(balance_sheet.pending_withdrawals) }}</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="font-bold text-slate-600">Pending tutor payouts</span>
                    <span class="font-black text-slate-900">₹{{ "{:,.0f}".format(balance_sheet.pending_payouts) }}</span>
                </div>
                <div class="flex justify-between items-center text-sm pt-2.5 border-t border-slate-100">
                    <span class="font-black text-slate-800 uppercase text-xs tracking-wider">Total owed</span>
                    <span class="font-black text-rose-600 text-lg">₹{{ "{:,.0f}".format(balance_sheet.total_owed) }}</span>
                </div>
                <div class="flex justify-between items-center text-sm pt-1">
                    <span class="font-bold text-slate-600">Active Exam Pro subscriptions</span>
                    <span class="font-black text-indigo-700">{{ balance_sheet.active_subscriptions }}</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
            <h2 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-4 flex items-center justify-between">
                Hurdle topics <span class="text-rose-500 bg-rose-50 px-2 py-0.5 rounded border border-rose-100 normal-case text-[10px]">Content quality signal</span>
            </h2>
            <div class="space-y-2.5">
                {% for s in hurdle_skills %}
                <div class="flex items-center justify-between gap-3">
                    <span class="text-xs font-black text-slate-800 truncate">{{ s.name }}</span>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <div class="w-20 bg-slate-100 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-rose-500 h-full" style="width: {{ s.avg_score }}%"></div>
                        </div>
                        <span class="text-xs font-black text-rose-600 w-12 text-right">{{ "{:,.0f}%".format(s.avg_score) }}</span>
                        <span class="text-[10px] font-bold text-slate-400 w-16 text-right">{{ s.total_attempts }} tries</span>
                    </div>
                </div>
                {% else %}
                <p class="text-xs font-bold text-slate-400">No attempts recorded yet.</p>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ============ INLINE REVIEW: TASK SUBMISSIONS ============ #}
    <section id="task-review" class="mb-8 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-20">
        <div class="p-4 border-b border-slate-100 bg-rose-50/30 flex justify-between items-center">
            <h3 class="text-xs font-black uppercase tracking-widest text-slate-800">Freelance task submissions to review</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600 border-b">
                    <tr>
                        <th class="px-5 py-3">User</th>
                        <th class="px-5 py-3">Task</th>
                        <th class="px-5 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for sub in pending_submissions %}
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-5 py-3">
                            <p class="text-xs font-black text-slate-900">{{ sub.user.username }}</p>
                            <p class="text-[11px] text-slate-500">{{ sub.submitted_at.strftime('%d %b · %H:%M') }}</p>
                        </td>
                        <td class="px-5 py-3">
                            <span class="text-xs font-bold text-indigo-700">{{ sub.task.title }}</span>
                            <span class="text-xs font-bold bg-indigo-50 text-indigo-500 px-1.5 py-0.5 rounded ml-1">₹{{ sub.task.reward_amount }}</span>
                            <a href="{{ sub.proof_url }}" target="_blank" class="block text-[11px] text-slate-500 hover:text-indigo-600 underline mt-1 truncate max-w-xs">{{ sub.proof_url }}</a>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <div class="flex justify-end gap-2">
                                <form action="{{ url('core:admin_reject', sub.id) }}" method="POST" class="inline">
                                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                    <button type="submit" class="inline-flex rounded-lg border border-rose-200 bg-white px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-rose-600 hover:bg-rose-50">Reject</button>
                                </form>
                                <form action="{{ url('core:admin_approve', sub.id) }}" method="POST" class="inline">
                                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                                    <button type="submit" class="inline-flex rounded-lg bg-emerald-600 px-2.5 py-1.5 text-[11px] font-black uppercase tracking-wider text-white hover:bg-emerald-700">Approve</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="3" class="px-5 py-8 text-center text-slate-400 font-bold text-sm">Nothing pending. Great job!</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# ============ STUDENT DAILY CLASS LOG — full width, bottom of page ============ #}
    <section id="class-log" class="mb-8 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-20">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between gap-2"
             style="background: linear-gradient(135deg, #eef2ff 0%, #fff 100%);">
            <h3 class="text-xs font-black uppercase tracking-widest text-slate-800">🗒️ Student daily class log</h3>
            <a href="{{ url('dashboard:admin_student_daily_logs') }}" class="text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:underline whitespace-nowrap">Open full log →</a>
        </div>
        <div class="grid grid-cols-1 divide-y divide-slate-100 lg:grid-cols-2 lg:divide-y-0">
            {% for row in recent_daily_class_logs %}
            <div class="flex items-start justify-between gap-3 border-slate-100 px-4 py-3 lg:border-b lg:odd:border-r">
                <div class="min-w-0">
                    <p class="text-xs font-black text-slate-900 truncate">{{ row.user.get_full_name() or row.user.username }}</p>
                    <p class="text-[10px] text-slate-500 truncate">{{ row.log_date.strftime('%d %b %Y') }} · {{ row.topic|truncate(48) }}</p>
                </div>
                <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-black uppercase {{ 'bg-emerald-100 text-emerald-700' if row.attendance == 'PRESENT' else 'bg-rose-100 text-rose-700' }}">
                    {{ 'Present' if row.attendance == 'PRESENT' else 'Absent' }}
                </span>
            </div>
            {% else %}
            <div class="px-4 py-8 text-center text-slate-400 text-xs font-bold lg:col-span-2">No student class logs yet.</div>
            {% endfor %}
        </div>
    </section>

    {# ============ RECENT JOINS — entry + payment status per new signup, compact 2-col ============ #}
    <section class="mb-8 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-xs font-black uppercase tracking-widest text-slate-500">🆕 Recent joins — Student · Parent · Tutor · Faculty</h2>
            <a href="/sd/users/customuser/" class="text-[10px] font-black uppercase tracking-wider text-indigo-600 hover:underline">All users /sd/ →</a>
        </div>
        <div class="grid grid-cols-1 divide-y divide-slate-100 lg:grid-cols-2 lg:divide-y-0">
            {% for j in recent_joins %}
            <div class="flex items-center justify-between gap-3 border-slate-100 px-4 py-3 lg:border-b lg:odd:border-r">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <a href="/sd/users/customuser/{{ j.id }}/change/" class="text-xs font-black text-slate-900 hover:text-indigo-700 truncate">@{{ j.username }}</a>
                        <span class="rounded-full px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider
                            {% if j.role == 'TUTOR' or j.role == 'FACULTY' %}bg-violet-50 text-violet-700 ring-1 ring-violet-200
                            {% elif j.role == 'PARENT' %}bg-sky-50 text-sky-700 ring-1 ring-sky-200
                            {% else %}bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200{% endif %}">{{ j.role }}</span>
                        {% if j.onboarded %}
                        <span class="rounded-full bg-emerald-50 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-emerald-700">Onboarded</span>
                        {% else %}
                        <span class="rounded-full bg-amber-50 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-amber-700">Incomplete</span>
                        {% endif %}
                    </div>
                    <p class="mt-0.5 truncate text-[10px] text-slate-500">
                        {{ j.joined.strftime('%d %b %H:%M') }} · {{ j.city or '—' }} ·
                        <span class="{% if j.phone %}text-slate-600 font-semibold{% else %}text-rose-500 font-bold{% endif %}">{{ j.phone or 'missing' }}</span>
                    </p>
                </div>
                <div class="shrink-0">
                    {% if j.has_paid %}
                    <span class="rounded-full bg-emerald-600 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-white whitespace-nowrap">Paid ₹{{ "{:,.0f}".format(j.paid_total) }}</span>
                    {% else %}
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-slate-500">Free</span>
                    {% endif %}
                </div>
            </div>
            {% else %}
            <div class="px-4 py-8 text-center text-slate-400 text-xs font-bold lg:col-span-2">No signups yet.</div>
            {% endfor %}
        </div>
    </section>

    {# ============ FOOTER: content inventory + backup health (reference only, de-emphasized) ============ #}
    <section class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-xs font-bold text-slate-500">
        <p>{{ content.total_questions }} questions · {{ content.total_videos }} videos · {{ content.total_skills }} active skills</p>
        {% if backup.is_stale %}
        <p class="text-rose-600">⚠ {% if backup.latest %}Last backup {{ backup.days_old }} day(s) ago{% else %}No backups yet{% endif %} — <a href="{{ url('dashboard:backup_center') }}" class="underline">open backup center</a></p>
        {% else %}
        <p class="text-emerald-600">✓ Last backup {{ backup.days_old }} day(s) ago</p>
        {% endif %}
        <a href="/sd/" class="text-indigo-700 hover:underline">Advanced admin /sd/ →</a>
    </section>

</div>
{% endblock %}
