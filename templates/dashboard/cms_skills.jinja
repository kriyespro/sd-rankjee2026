{% extends "dashboard/cms_list_base.jinja" %}
{% set title = "Skills" %}
{% set subtitle = "Keep names stable. Order controls progression." %}
{% set new_url = url('dashboard:cms_skill_new') %}
{% block list_content %}
<form method="get" class="mb-4 flex gap-2">
  <input name="q" value="{{ q }}" placeholder="Search skills..." class="flex-grow rounded-xl border border-slate-200 px-4 py-2 text-sm">
  <button class="rounded-xl bg-slate-900 text-white px-4 py-2 text-xs font-black uppercase tracking-widest">Search</button>
</form>
<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
  <table class="w-full text-left">
    <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600">
      <tr>
        <th class="px-5 py-3">Path</th>
        <th class="px-5 py-3">Order</th>
        <th class="px-5 py-3">Name</th>
        <th class="px-5 py-3">Active</th>
        <th class="px-5 py-3 text-right">Edit</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for it in items %}
      <tr class="hover:bg-slate-50">
        <td class="px-5 py-3 text-xs text-slate-600">{{ it.path.name if it.path else "—" }}</td>
        <td class="px-5 py-3 text-sm font-black">{{ it.order }}</td>
        <td class="px-5 py-3 text-sm font-bold text-slate-900">{{ it.name }}</td>
        <td class="px-5 py-3 text-sm">{{ "Yes" if it.is_active else "No" }}</td>
        <td class="px-5 py-3 text-right">
          <a class="text-indigo-600 font-bold text-sm hover:underline" href="{{ url('dashboard:cms_skill_edit', it.id) }}">Edit</a>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-5 py-10 text-center text-slate-500 font-bold">No skills yet.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

