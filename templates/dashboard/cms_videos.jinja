{% extends "dashboard/cms_list_base.jinja" %}
{% set title = "Concept videos" %}
{% set subtitle = "Keep concept_tag aligned with weak areas (Question.concept_tag)." %}
{% set new_url = url('dashboard:cms_video_new') %}
{% block list_content %}
<form method="get" class="mb-4 flex gap-2">
  <input name="q" value="{{ q }}" placeholder="Search video title..." class="flex-grow rounded-xl border border-slate-200 px-4 py-2 text-sm">
  <button class="rounded-xl bg-slate-900 text-white px-4 py-2 text-xs font-black uppercase tracking-widest">Search</button>
</form>
<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
  <table class="w-full text-left">
    <thead class="bg-slate-50 text-xs uppercase font-black tracking-widest text-slate-600">
      <tr>
        <th class="px-5 py-3">Skill</th>
        <th class="px-5 py-3">Concept</th>
        <th class="px-5 py-3">Title</th>
        <th class="px-5 py-3 text-right">Edit</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for it in items %}
      <tr class="hover:bg-slate-50">
        <td class="px-5 py-3 text-xs text-slate-600">{{ it.skill.name if it.skill else "—" }}</td>
        <td class="px-5 py-3 text-xs font-mono text-slate-600">{{ it.concept_tag }}</td>
        <td class="px-5 py-3 text-sm font-bold text-slate-900">{{ it.title|truncate(80) }}</td>
        <td class="px-5 py-3 text-right">
          <a class="text-indigo-600 font-bold text-sm hover:underline" href="{{ url('dashboard:cms_video_edit', it.id) }}">Edit</a>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="4" class="px-5 py-10 text-center text-slate-500 font-bold">No videos yet.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

