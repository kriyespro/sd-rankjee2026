{% extends "base.jinja" %}
{% block title %}Student daily log - RankJee Admin{% endblock %}

{% block content %}
<div class="mx-auto max-w-[90rem] px-5 pb-12 pt-8 sm:px-8">
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            {% set crumbs = [{'label': 'Dashboard', 'url': url('dashboard:index')}, {'label': 'Student daily log'}] %}
            {% include "partials/_breadcrumb.jinja" %}
            <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900">Student daily log</h1>
            <p class="mt-1 text-sm text-slate-600">Per-student class attendance and topics submitted from the student dashboard.</p>
        </div>
    </div>

    <form method="get" class="mb-6 flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:flex-row md:flex-wrap md:items-end">
        <div class="min-w-[200px] flex-1">
            <label class="mb-1 block text-[11px] font-black uppercase tracking-widest text-slate-400">Search</label>
            <input type="text" name="q" value="{{ search_query }}" placeholder="Student email, username, or topic…"
                   class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
        </div>
        <div class="min-w-[200px] flex-1">
            <label class="mb-1 block text-[11px] font-black uppercase tracking-widest text-slate-400">Filter by student</label>
            <select name="student_id" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
                <option value="">All students</option>
                {% for u in student_options %}
                <option value="{{ u.id }}" {% if student_filter_id == u.id %}selected{% endif %}>{{ u.username }} — {{ u.email|truncate(36) }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">Apply</button>
            <a href="{{ url('dashboard:admin_student_daily_logs') }}" class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Reset</a>
        </div>
    </form>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-4 py-3">
            <p class="text-xs font-black uppercase tracking-widest text-slate-700">Student daily log view</p>
            <div class="flex items-center gap-2">
                <a href="{{ url('dashboard:admin_student_daily_logs') }}?q={{ search_query|urlencode }}{% if student_filter_id %}&student_id={{ student_filter_id }}{% endif %}&view=list" class="rounded-lg border px-3 py-1 text-[11px] font-black uppercase tracking-wider {{ 'border-indigo-300 bg-indigo-50 text-indigo-700' if view_mode == 'list' else 'border-slate-200 text-slate-600 hover:bg-slate-50' }}">List view</a>
                <a href="{{ url('dashboard:admin_student_daily_logs') }}?q={{ search_query|urlencode }}{% if student_filter_id %}&student_id={{ student_filter_id }}{% endif %}&view=calendar&month={{ calendar_month_value }}" class="rounded-lg border px-3 py-1 text-[11px] font-black uppercase tracking-wider {{ 'border-indigo-300 bg-indigo-50 text-indigo-700' if view_mode == 'calendar' else 'border-slate-200 text-slate-600 hover:bg-slate-50' }}">Calendar view</a>
            </div>
        </div>
        {% if view_mode == 'calendar' %}
        <div class="p-4">
            <div class="mb-3 flex items-center justify-between gap-2">
                <a href="{{ url('dashboard:admin_student_daily_logs') }}?q={{ search_query|urlencode }}{% if student_filter_id %}&student_id={{ student_filter_id }}{% endif %}&view=calendar&month={{ calendar_prev_month }}" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-black text-slate-600 hover:bg-slate-50">← Prev</a>
                <p class="text-sm font-black text-slate-800">{{ calendar_month_label }} <span class="text-xs text-slate-500">({{ calendar_total_logs }} logs)</span></p>
                <a href="{{ url('dashboard:admin_student_daily_logs') }}?q={{ search_query|urlencode }}{% if student_filter_id %}&student_id={{ student_filter_id }}{% endif %}&view=calendar&month={{ calendar_next_month }}" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-black text-slate-600 hover:bg-slate-50">Next →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[920px] table-fixed border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-[11px] font-black uppercase tracking-widest text-slate-500">
                            <th class="border border-slate-100 px-2 py-1.5">Mon</th>
                            <th class="border border-slate-100 px-2 py-1.5">Tue</th>
                            <th class="border border-slate-100 px-2 py-1.5">Wed</th>
                            <th class="border border-slate-100 px-2 py-1.5">Thu</th>
                            <th class="border border-slate-100 px-2 py-1.5">Fri</th>
                            <th class="border border-slate-100 px-2 py-1.5">Sat</th>
                            <th class="border border-slate-100 px-2 py-1.5">Sun</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for week in calendar_weeks %}
                        <tr>
                            {% for day in week %}
                            <td class="h-28 align-top border border-slate-100 p-1.5 {{ 'bg-white' if day.in_month else 'bg-slate-50/60' }}">
                                <p class="text-[11px] font-black {{ 'text-slate-800' if day.in_month else 'text-slate-400' }}">{{ day.date.day }}</p>
                                <div class="mt-1 max-h-24 space-y-1 overflow-y-auto pr-1">
                                    {% for row in day.logs %}
                                    <div class="rounded border px-1.5 py-0.5 text-[10px] font-bold {{ 'border-green-200 bg-green-50 text-green-700' if row.attendance == 'PRESENT' else 'border-red-200 bg-red-50 text-red-700' }}">
                                        {{ row.user.username|truncate(10) }} · {{ row.topic|truncate(14) }}
                                    </div>
                                    {% endfor %}
                                </div>
                            </td>
                            {% endfor %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="w-full min-w-[920px] border-collapse text-left">
                <thead class="border-b border-slate-100 bg-slate-50 text-[11px] font-black uppercase tracking-widest text-slate-600">
                    <tr>
                        <th class="px-5 py-3">Date</th>
                        <th class="px-5 py-3">Student</th>
                        <th class="px-5 py-3">Topic</th>
                        <th class="px-5 py-3">Attendance</th>
                        <th class="px-5 py-3">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for row in logs_page %}
                    <tr class="align-top hover:bg-slate-50/80">
                        <td class="px-5 py-3 text-xs font-bold text-slate-600 whitespace-nowrap">{{ row.log_date.strftime('%d %b %Y') }}</td>
                        <td class="px-5 py-3">
                            <p class="text-xs font-black text-slate-900">{{ row.user.username }}</p>
                            <p class="text-[11px] text-slate-500">{{ row.user.email|truncate(40) }}</p>
                        </td>
                        <td class="px-5 py-3 text-sm font-bold text-slate-800">{{ row.topic }}</td>
                        <td class="px-5 py-3 whitespace-nowrap">
                            {% if row.attendance == 'PRESENT' %}
                            <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-emerald-700">Present</span>
                            {% else %}
                            <span class="inline-flex rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-rose-700">Absent</span>
                            {% endif %}
                        </td>
                        <td class="px-5 py-3 text-xs text-slate-600 max-w-md">{{ row.details|truncate(200) if row.details else '—' }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="px-5 py-12 text-center text-sm font-bold text-slate-400">No class logs match your filters.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if logs_page.has_other_pages() %}
        <div class="flex flex-wrap items-center gap-2 border-t border-slate-100 px-5 py-3 text-xs font-bold text-slate-600">
            {% if logs_page.has_previous() %}
            <a href="?page={{ logs_page.previous_page_number() }}{{ filter_querystring }}" class="rounded-lg border border-slate-200 px-3 py-1.5 hover:bg-slate-50">Previous</a>
            {% endif %}
            <span>Page {{ logs_page.number }} of {{ logs_page.paginator.num_pages }}</span>
            {% if logs_page.has_next() %}
            <a href="?page={{ logs_page.next_page_number() }}{{ filter_querystring }}" class="rounded-lg border border-slate-200 px-3 py-1.5 hover:bg-slate-50">Next</a>
            {% endif %}
        </div>
        {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
