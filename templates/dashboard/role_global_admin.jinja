{% extends "base.jinja" %}
{% block title %}Global Admin Dashboard - RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8">

    {% include "dashboard/partials/_user_identity_bar.jinja" %}

    <div class="mb-8">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-700">Global command center</p>
        <h1 class="mt-2 text-3xl font-black text-slate-900">Scale platform revenue and trust</h1>
        <p class="mt-2 text-sm text-slate-600">Monitor network growth, quality bottlenecks, and compliance risk.</p>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {% for card in kpi_cards %}
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">{{ card.label }}</p>
            <p class="mt-1 text-2xl font-black text-slate-900">{{ card.value }}</p>
        </div>
        {% endfor %}
    </div>

    <div class="mt-6 rounded-2xl border border-slate-300 bg-slate-100 p-4">
        <p class="text-xs font-black uppercase tracking-widest text-slate-700">Quick actions</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
            <a href="{{ url('study:student_hub') }}" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Study</a>
            <a href="/sd/hometutor/tutorprofile/?verification_status__exact=PENDING" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Review verifications</a>
            <a href="/sd/hometutor/engagementdispute/" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Review disputes</a>
            <a href="/sd/users/withdrawalrequest/?status__exact=PENDING" class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-xs font-black uppercase tracking-wider text-slate-800 hover:bg-slate-200">Review payouts</a>
            <a href="{{ url('dashboard:index') }}" class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-3 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-slate-700">Refresh command center</a>
        </div>
        {% if global_sla_risk_count > 0 %}
        <p class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-black uppercase tracking-wider text-rose-800">
            {{ global_sla_risk_count }} global ops item{% if global_sla_risk_count != 1 %}s{% endif %} currently in SLA risk.
        </p>
        {% endif %}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a href="{{ url('dashboard:index') }}" class="rounded-2xl border border-slate-300 bg-slate-100 p-5">
            <p class="text-xs font-black uppercase tracking-widest text-slate-700">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Reduce approval and dispute backlog</h2>
            <p class="mt-1 text-sm text-slate-600">{{ pending_verification }} verifications and {{ live_disputes }} disputes are active.</p>
        </a>
        <a href="{{ url('dashboard:index') }}" class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-black uppercase tracking-widest text-slate-500">Action</p>
            <h2 class="mt-2 text-lg font-black text-slate-900">Protect payout and trust operations</h2>
            <p class="mt-1 text-sm text-slate-600">{{ open_withdrawals }} withdrawal requests require governance review.</p>
        </a>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Priority queue</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li>• Review conversion funnel and repeat booking trends weekly.</li>
            <li>• Keep verification backlog under SLA across all city teams.</li>
            <li>• Track trust and safety incidents with strict escalation paths.</li>
        </ul>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-black text-slate-900">Latest failed attempts</h3>
            <a href="{{ url('dashboard:students_score_table') }}" class="text-xs font-black uppercase tracking-wider text-slate-700 hover:text-slate-900">Open full score view</a>
        </div>
        {% if recent_failed_attempts %}
        <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[760px] text-left">
                <thead class="bg-slate-50 text-[11px] font-black uppercase tracking-widest text-slate-500 border-b">
                    <tr>
                        <th class="px-3 py-2">Student</th>
                        <th class="px-3 py-2">Skill</th>
                        <th class="px-3 py-2">Score</th>
                        <th class="px-3 py-2">When</th>
                        <th class="px-3 py-2 text-right">Review</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for a in recent_failed_attempts %}
                    <tr class="hover:bg-slate-50">
                        <td class="px-3 py-2">
                            <p class="text-xs font-black text-slate-900">{{ a.user.username }}</p>
                            <p class="text-xs text-slate-600">{{ a.user.email|truncate(26) }}</p>
                        </td>
                        <td class="px-3 py-2 text-xs font-bold text-slate-800">{{ a.skill.name if a.skill else 'General Test' }}</td>
                        <td class="px-3 py-2">
                            <span class="inline-flex rounded-full px-2 py-1 text-xs font-black bg-rose-100 text-rose-700">{{ a.score }}%</span>
                        </td>
                        <td class="px-3 py-2 text-xs text-slate-600">{{ a.attempt_date.strftime('%d %b %Y · %H:%M') }}</td>
                        <td class="px-3 py-2 text-right">
                            <a href="{{ url('dashboard:student_attempt_review', a.id) }}" class="inline-flex rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-amber-700 hover:bg-amber-100">
                                Wrong Q&A
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="mt-3 text-sm text-slate-500">No failed attempts found recently.</p>
        {% endif %}
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-black text-slate-900">Global funnel and monetization</h3>
            <span class="text-[11px] font-black uppercase tracking-widest text-slate-500">Live snapshot</span>
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Total demos</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ global_total_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Accepted rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ global_accepted_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ global_accepted_demos }} / {{ global_total_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Active rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ global_active_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ global_active_engagements }} / {{ global_accepted_demos }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Paid rate</p>
                <p class="mt-1 text-2xl font-black text-slate-900">{{ global_paid_rate }}%</p>
                <p class="text-[11px] text-slate-500">{{ global_paid_count }} / {{ global_active_engagements }}</p>
            </div>
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-2">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">GMV (30d)</p>
                <p class="mt-1 text-2xl font-black text-slate-900">₹{{ global_gmv_30d }}</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">Platform revenue (30d)</p>
                <p class="mt-1 text-2xl font-black text-slate-900">₹{{ global_platform_rev_30d }}</p>
            </div>
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-300 bg-slate-100 p-5">
        <h3 class="text-sm font-black text-slate-900">Recommended next actions</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-800">
            {% for item in global_next_actions %}
            <li>• {{ item }}</li>
            {% endfor %}
        </ul>
    </div>

    <div class="mt-6 grid gap-4 xl:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Pending verifications</h3>
                <a href="/sd/hometutor/tutorprofile/?verification_status__exact=PENDING" class="text-xs font-black uppercase tracking-wider text-slate-700 hover:text-slate-900">Open /sd/</a>
            </div>
            {% if latest_pending_tutors %}
            <div class="mt-3 space-y-3">
                {% for t in latest_pending_tutors[:5] %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ t.display_name }}</p>
                    {% if t.pk in global_verification_sla_risk_ids %}
                    <p class="mt-1 inline-flex rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-rose-800">SLA risk</p>
                    {% endif %}
                    <p class="mt-1 text-xs text-slate-600">{{ t.city }} · {{ t.subjects|truncate(50) }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No pending verifications.</p>
            {% endif %}
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Live disputes</h3>
                <a href="/sd/hometutor/engagementdispute/" class="text-xs font-black uppercase tracking-wider text-slate-700 hover:text-slate-900">Open /sd/</a>
            </div>
            {% if latest_disputes %}
            <div class="mt-3 space-y-3">
                {% for d in latest_disputes[:5] %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ d.engagement.tutor_profile.display_name }}</p>
                    {% if d.pk in global_dispute_sla_risk_ids %}
                    <p class="mt-1 inline-flex rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-rose-800">SLA risk</p>
                    {% endif %}
                    <p class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">{{ d.get_status_display() }}</p>
                    <p class="mt-1 text-[11px] text-slate-500">{{ d.reason|truncate(70) }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No live disputes.</p>
            {% endif %}
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-black text-slate-900">Pending withdrawals</h3>
                <a href="/sd/users/withdrawalrequest/?status__exact=PENDING" class="text-xs font-black uppercase tracking-wider text-slate-700 hover:text-slate-900">Open /sd/</a>
            </div>
            {% if latest_withdrawals %}
            <div class="mt-3 space-y-3">
                {% for w in latest_withdrawals[:5] %}
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-sm font-black text-slate-900">{{ w.user.get_username() }}</p>
                    {% if w.pk in global_withdrawal_sla_risk_ids %}
                    <p class="mt-1 inline-flex rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-rose-800">SLA risk</p>
                    {% endif %}
                    <p class="mt-1 text-xs text-slate-600">₹{{ w.amount }} · {{ w.upi_id }}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ w.requested_at.strftime('%d %b %Y %H:%M') }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="mt-3 text-sm text-slate-500">No pending withdrawals.</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="text-sm font-black text-slate-900">Activity timeline</h3>
        {% if activity_timeline %}
        <div class="mt-3 grid gap-3 md:grid-cols-2">
            {% for item in activity_timeline %}
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-sm font-bold text-slate-900">{{ item.title }}</p>
                <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ item.meta.strftime('%d %b %Y %H:%M') }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="mt-3 text-sm text-slate-500">No recent activity yet.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
