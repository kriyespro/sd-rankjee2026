{% extends "base.jinja" %}
{% block title %}LMS · RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl px-4 py-4 sm:px-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <div class="min-w-0">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600">Classroom</p>
            <div class="mt-0.5 flex flex-wrap items-center gap-2">
                <h1 class="text-xl font-black tracking-tight text-slate-900">LMS Portfolio Feed</h1>
                {% if not is_staff_lms and lms_notify %}
                {% include "lms/partials/_notifications_bell.jinja" %}
                {% endif %}
                {% if is_staff_lms and admin_stats %}
                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wide text-emerald-800" title="Students who submitted at least once">
                    {{ admin_stats.students_submitted }} students
                </span>
                <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wide text-amber-800" title="Submissions awaiting review">
                    {{ admin_stats.pending }} pending
                </span>
                <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wide text-slate-700" title="Total assignments">
                    {{ admin_stats.total_assignments }} assignments
                </span>
                <span class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wide text-indigo-800" title="Topics with at least one assignment">
                    {{ admin_stats.topics_covered }} topics
                </span>
                <span class="inline-flex max-w-full items-center truncate rounded-full bg-rose-100 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wide text-rose-800"
                      title="Topics with pending review: {{ admin_stats.pending_topics_label }}">
                    {% if admin_stats.pending_topics %}
                    Pending: {{ admin_stats.pending_topics_label }}
                    {% else %}
                    No topic pending
                    {% endif %}
                </span>
                {% endif %}
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if is_staff_lms %}
            <a href="{{ url('lms:assignment_create') }}" class="inline-flex rounded-lg bg-indigo-600 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-white hover:bg-indigo-500">New assignment</a>
            <a href="{{ url('lms:batches') }}" class="inline-flex rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Batches</a>
            {% endif %}
            <a href="{{ url('dashboard:index') }}" class="inline-flex rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">Dashboard</a>
        </div>
    </div>

    {# LEFT | CENTER | RIGHT — side-by-side from lg (1024px) #}
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:gap-3">

        {# LEFT — Topics #}
        <aside class="w-full shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm lg:w-52">
            <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 px-3 py-2">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Topics</h2>
                {% if is_staff_lms %}
                <a href="{{ url('lms:topic_create') }}" class="rounded bg-indigo-600 px-2 py-0.5 text-[9px] font-black uppercase text-white hover:bg-indigo-500">+ New</a>
                {% endif %}
            </div>
            {% if topics %}
            <nav class="max-h-48 overflow-y-auto p-1.5 lg:max-h-[28rem]">
                <ul class="space-y-0.5">
                    {% for item in topics %}
                    <li>
                        <div class="flex items-center rounded-lg hover:bg-indigo-50">
                            <a href="{{ url('lms:topic_detail', pk=item.topic.pk) }}" class="flex min-w-0 flex-1 items-center gap-2 px-2 py-2">
                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-indigo-100 text-[10px] font-black text-indigo-700">
                                    {{ item.title[0]|upper }}
                                </span>
                                <span class="min-w-0">
                                    <span class="block truncate text-xs font-bold text-slate-900">{{ item.title }}</span>
                                    <span class="block text-[10px] text-slate-500">{{ item.assignments|length }} asgn</span>
                                </span>
                            </a>
                            {% if is_staff_lms and item.topic %}
                            <a href="{{ url('lms:topic_edit', pk=item.topic.pk) }}" class="mr-1.5 shrink-0 px-1.5 py-0.5 text-[8px] font-black uppercase text-slate-400 hover:text-indigo-600">Edit</a>
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </nav>
            {% else %}
            <p class="px-3 py-6 text-center text-xs text-slate-500">No topics yet.</p>
            {% endif %}
        </aside>

        {# CENTER — Feed #}
        <main class="min-w-0 flex-1 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-100 px-4 py-2.5">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Recent submissions</h2>
            </div>
            {% if recent_submissions %}
            <ul class="divide-y divide-slate-100">
                {% for s in recent_submissions %}
                <li class="flex items-start gap-3 px-4 py-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-xs font-black text-white">
                        {{ s.student.get_username()[0]|upper }}
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                            <p class="text-sm font-black text-slate-900">{{ s.student.get_username() }}</p>
                            {% if s.is_pinned %}
                            <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[9px] font-black uppercase text-amber-800">Pinned</span>
                            {% endif %}
                            <span class="text-[11px] font-semibold text-slate-400">{{ s.updated_at.strftime('%d %b · %H:%M') }}</span>
                        </div>
                        <p class="mt-0.5 text-xs text-slate-600">
                            submitted on
                            <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="font-bold text-indigo-600 hover:underline">{{ s.assignment.title }}</a>
                        </p>
                        {% if s.caption %}
                        <p class="mt-1 line-clamp-1 text-[11px] text-slate-500">{{ s.caption }}</p>
                        {% endif %}
                    </div>
                    <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}"
                       class="mt-0.5 inline-flex shrink-0 rounded-md border border-slate-200 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">
                        View
                    </a>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="px-4 py-12 text-center text-sm text-slate-500">No submissions yet.</p>
            {% endif %}
        </main>

        {# RIGHT — Insights (3 widgets stack on lg; grid on md when stacked below) #}
        <aside class="grid w-full shrink-0 grid-cols-1 gap-3 sm:grid-cols-3 lg:flex lg:w-60 lg:flex-col">

            <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-amber-100 bg-amber-50 px-3 py-2">
                    <h2 class="text-[10px] font-black uppercase tracking-widest text-amber-800">Top score</h2>
                </div>
                {% if top_scores %}
                <ul class="divide-y divide-slate-50">
                    {% for s in top_scores %}
                    <li>
                        <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="flex items-center gap-2 px-2.5 py-2 hover:bg-amber-50">
                            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-100 text-[10px] font-black text-amber-800">
                                {{ s.student.get_username()[0]|upper }}
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-xs font-bold text-slate-900">{{ s.student.get_username() }}</span>
                                <span class="block truncate text-[10px] text-slate-500">{{ s.assignment.title }}</span>
                            </span>
                            <span class="shrink-0 text-sm font-black text-amber-700">{{ s.marks }}</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="px-3 py-5 text-center text-[11px] text-slate-400">No marks yet.</p>
                {% endif %}
            </section>

            <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-rose-100 bg-rose-50 px-3 py-2">
                    <h2 class="text-[10px] font-black uppercase tracking-widest text-rose-800">Best likes</h2>
                </div>
                {% if best_likes %}
                <ul class="divide-y divide-slate-50">
                    {% for s in best_likes %}
                    <li>
                        <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="flex items-center gap-2 px-2.5 py-2 hover:bg-rose-50">
                            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-rose-100 text-[10px] font-black text-rose-700">
                                {{ s.student.get_username()[0]|upper }}
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-xs font-bold text-slate-900">{{ s.student.get_username() }}</span>
                                <span class="block truncate text-[10px] text-slate-500">{{ s.assignment.title }}</span>
                            </span>
                            <span class="shrink-0 text-xs font-black text-rose-600">❤️ {{ s.like_count }}</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="px-3 py-5 text-center text-[11px] text-slate-400">No likes yet.</p>
                {% endif %}
            </section>

            <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-indigo-100 bg-indigo-50 px-3 py-2">
                    <h2 class="text-[10px] font-black uppercase tracking-widest text-indigo-800">Latest comments</h2>
                </div>
                {% if latest_comments %}
                <ul class="divide-y divide-slate-50">
                    {% for c in latest_comments %}
                    <li>
                        <a href="{{ url('lms:assignment_detail', pk=c.submission.assignment_id) }}" class="block px-2.5 py-2 hover:bg-indigo-50">
                            <div class="flex items-center gap-1.5">
                                <span class="text-xs font-black text-slate-900">{{ c.user.get_username() }}</span>
                                <span class="text-[10px] text-slate-400">{{ c.created_at.strftime('%d %b') }}</span>
                            </div>
                            <p class="mt-0.5 line-clamp-2 text-[11px] leading-snug text-slate-600">{{ c.body }}</p>
                            <p class="mt-0.5 truncate text-[10px] font-semibold text-indigo-600">{{ c.submission.assignment.title }}</p>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="px-3 py-5 text-center text-[11px] text-slate-400">No comments yet.</p>
                {% endif %}
            </section>
        </aside>
    </div>
</div>
{% endblock %}
