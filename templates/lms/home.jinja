{% extends "base.jinja" %}
{% block title %}LMS · RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
        <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600">Classroom</p>
            <h1 class="text-2xl font-black tracking-tight text-slate-900">LMS Portfolio Feed</h1>
            <p class="mt-1 text-sm text-slate-600">Submit work, see classmates, like &amp; comment — Facebook-style.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if is_staff_lms %}
            <a href="{{ url('lms:assignment_create') }}" class="inline-flex rounded-xl bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">New assignment</a>
            <a href="{{ url('lms:batches') }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Batches</a>
            {% endif %}
            <a href="{{ url('dashboard:index') }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">Dashboard</a>
        </div>
    </div>

    <section class="mb-8">
        <div class="mb-3 flex items-center justify-between gap-2">
            <h2 class="text-xs font-black uppercase tracking-widest text-slate-500">Topics</h2>
            {% if is_staff_lms %}
            <a href="{{ url('lms:topic_create') }}" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">New topic</a>
            {% endif %}
        </div>
        {% if topics %}
        <div class="grid gap-4 sm:grid-cols-2">
            {% for item in topics %}
            <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <a href="{{ url('lms:topic_detail', pk=item.topic.pk) }}" class="text-lg font-black tracking-tight text-slate-900 hover:text-indigo-600">
                            {{ item.title }}
                        </a>
                        {% if item.description %}
                        <p class="mt-1 text-sm text-slate-600">{{ item.description }}</p>
                        {% endif %}
                    </div>
                    {% if is_staff_lms and item.topic %}
                    <a href="{{ url('lms:topic_edit', pk=item.topic.pk) }}" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Edit topic</a>
                    {% endif %}
                </div>
                <div class="mt-4 flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3">
                    <div>
                        <p class="text-sm font-black text-slate-900">{{ item.assignments|length }} assignment{% if item.assignments|length != 1 %}s{% endif %}</p>
                        <p class="mt-1 text-xs text-slate-500">Open the topic to view and edit assignments inside it.</p>
                    </div>
                    {% if item.topic %}
                    <a href="{{ url('lms:topic_detail', pk=item.topic.pk) }}" class="rounded-xl bg-indigo-600 px-4 py-2 text-[10px] font-black uppercase tracking-wider text-white hover:bg-indigo-500">Open topic</a>
                    {% endif %}
                </div>
            </section>
            {% endfor %}
        </div>
        {% else %}
        <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500">
            No topics yet.{% if is_staff_lms %} Create a topic and add assignments under it.{% endif %}
        </p>
        {% endif %}
    </section>

    <section>
        <h2 class="mb-3 text-xs font-black uppercase tracking-widest text-slate-500">Recent submissions</h2>
        {% if recent_submissions %}
        <ul class="space-y-3">
            {% for s in recent_submissions %}
            <li class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-black text-indigo-700">
                    {{ s.student.get_username()[0]|upper }}
                </div>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-black text-slate-900">{{ s.student.get_username() }}</p>
                    <p class="truncate text-xs text-slate-500">on <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="font-bold text-indigo-600 hover:underline">{{ s.assignment.title }}</a></p>
                </div>
                {% if s.is_pinned %}<span class="text-[10px] font-black uppercase text-amber-600">Pinned</span>{% endif %}
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="text-sm text-slate-500">No submissions yet — be the first on an assignment.</p>
        {% endif %}
    </section>
</div>
{% endblock %}
