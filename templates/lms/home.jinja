{% extends "base.jinja" %}
{% block title %}LMS · RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6">
    <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
        <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600">Classroom</p>
            <h1 class="text-2xl font-black tracking-tight text-slate-900">LMS Portfolio Feed</h1>
            <p class="mt-1 text-sm text-slate-600">Topics on the left · latest submissions on the right.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if is_staff_lms %}
            <a href="{{ url('lms:assignment_create') }}" class="inline-flex rounded-xl bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">New assignment</a>
            <a href="{{ url('lms:batches') }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Batches</a>
            {% endif %}
            <a href="{{ url('dashboard:index') }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">Dashboard</a>
        </div>
    </div>

    {# Two-pane: fixed left sidebar + fluid right feed #}
    <div class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm sm:flex-row sm:min-h-[32rem]">
        {# LEFT — topics sidebar #}
        <aside class="w-full shrink-0 border-b border-slate-200 bg-slate-50 sm:w-56 sm:border-b-0 sm:border-r lg:w-64">
            <div class="flex items-center justify-between gap-2 border-b border-slate-200/80 px-3 py-2.5">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Topics</h2>
                {% if is_staff_lms %}
                <a href="{{ url('lms:topic_create') }}" class="rounded border border-slate-200 bg-white px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-indigo-600 hover:bg-indigo-50">+ New</a>
                {% endif %}
            </div>
            {% if topics %}
            <nav class="max-h-64 overflow-y-auto p-2 sm:max-h-none sm:min-h-[28rem]">
                <ul class="space-y-0.5">
                    {% for item in topics %}
                    <li>
                        <div class="flex items-center gap-1 rounded-lg px-1.5 py-2 hover:bg-white">
                            <a href="{{ url('lms:topic_detail', pk=item.topic.pk) }}" class="flex min-w-0 flex-1 items-center gap-2">
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-[10px] font-black text-indigo-700">
                                    {{ item.title[0]|upper }}
                                </span>
                                <span class="min-w-0">
                                    <span class="block truncate text-xs font-bold text-slate-900">{{ item.title }}</span>
                                    <span class="block text-[10px] font-medium text-slate-500">{{ item.assignments|length }} assignment{% if item.assignments|length != 1 %}s{% endif %}</span>
                                </span>
                            </a>
                            {% if is_staff_lms and item.topic %}
                            <a href="{{ url('lms:topic_edit', pk=item.topic.pk) }}"
                               class="shrink-0 rounded px-1.5 py-0.5 text-[8px] font-black uppercase tracking-wider text-slate-400 hover:text-indigo-600"
                               title="Edit topic">Edit</a>
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </nav>
            {% else %}
            <p class="px-3 py-8 text-center text-xs text-slate-500">
                No topics yet.{% if is_staff_lms %} Create one to get started.{% endif %}
            </p>
            {% endif %}
        </aside>

        {# RIGHT — submissions feed #}
        <main class="min-w-0 flex-1 bg-white">
            <div class="border-b border-slate-100 px-4 py-3 sm:px-5 sm:py-4">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Recent submissions</h2>
                <p class="mt-0.5 text-xs text-slate-600 sm:text-sm">Latest student work across all topics.</p>
            </div>
            {% if recent_submissions %}
            <ul class="divide-y divide-slate-100">
                {% for s in recent_submissions %}
                <li class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-start sm:gap-4 sm:px-5">
                    <div class="flex min-w-0 flex-1 items-start gap-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-black text-white">
                            {{ s.student.get_username()[0]|upper }}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                <p class="text-sm font-black text-slate-900">{{ s.student.get_username() }}</p>
                                {% if s.is_pinned %}
                                <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[9px] font-black uppercase text-amber-800">Pinned</span>
                                {% endif %}
                                <span class="text-[11px] font-semibold text-slate-400">{{ s.updated_at.strftime('%d %b · %H:%M') }}</span>
                            </div>
                            <p class="mt-0.5 text-sm text-slate-600">
                                submitted on
                                <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="font-bold text-indigo-600 hover:underline">{{ s.assignment.title }}</a>
                            </p>
                            {% if s.caption %}
                            <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-slate-500">{{ s.caption }}</p>
                            {% endif %}
                        </div>
                    </div>
                    <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}"
                       class="inline-flex shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50 sm:mt-1">
                        View
                    </a>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="px-5 py-16 text-center text-sm text-slate-500">No submissions yet — pick a topic on the left and post on an assignment.</p>
            {% endif %}
        </main>
    </div>
</div>
{% endblock %}
