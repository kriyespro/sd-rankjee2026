{% extends "base.jinja" %}
{% block title %}LMS · RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl px-4 py-4 sm:px-6">
    {% if is_staff_lms or is_office_lms %}
    <div class="mb-3 flex flex-nowrap items-center gap-x-2 gap-y-1 overflow-x-auto pb-0.5">
        <div class="min-w-0 shrink-0">
            <p class="text-[9px] font-black uppercase tracking-[0.18em] text-indigo-600 leading-none">{% if is_office_lms %}Office · read-only{% else %}Classroom{% endif %}</p>
            <h1 class="mt-0.5 whitespace-nowrap text-base font-black tracking-tight text-slate-900 sm:text-lg">LMS Portfolio Feed</h1>
        </div>
        {% if admin_stats %}
        <div class="flex min-w-0 flex-nowrap items-center gap-1.5">
            <span class="inline-flex shrink-0 items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-wide text-emerald-800" title="Students who submitted at least once">
                {{ admin_stats.students_submitted }} students
            </span>
            <span class="inline-flex shrink-0 items-center rounded-full bg-amber-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-wide text-amber-800" title="Submissions awaiting review">
                {{ admin_stats.pending }} pending
            </span>
            <span class="inline-flex shrink-0 items-center rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-wide text-slate-700" title="Total assignments">
                {{ admin_stats.total_assignments }} assignments
            </span>
            <span class="inline-flex shrink-0 items-center rounded-full bg-indigo-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-wide text-indigo-800" title="Topics with at least one assignment">
                {{ admin_stats.topics_covered }} topics
            </span>
            <span class="inline-flex max-w-[12rem] shrink items-center truncate rounded-full bg-rose-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-wide text-rose-800 lg:max-w-[16rem]"
                  title="Topics with pending review: {{ admin_stats.pending_topics_label }}">
                {% if admin_stats.pending_topics %}
                Pending: {{ admin_stats.pending_topics_label }}
                {% else %}
                No topic pending
                {% endif %}
            </span>
        </div>
        {% endif %}
        <div class="ml-auto flex shrink-0 flex-nowrap items-center gap-1.5">
            {% if is_staff_lms %}
            <a href="{{ url('lms:assignment_create') }}" class="inline-flex whitespace-nowrap rounded-lg bg-indigo-600 px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-white hover:bg-indigo-500">New assignment</a>
            {% endif %}
            <a href="{{ url('lms:courses') }}" class="inline-flex whitespace-nowrap rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">{% if is_admin_lms or is_office_lms %}All courses{% else %}My courses{% endif %}</a>
            <a href="{{ url('dashboard:index') }}" class="inline-flex whitespace-nowrap rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">Dashboard</a>
        </div>
    </div>
    {% else %}
    {# Student — one compact row: title · bell · greeting · dashboard · assignment ticker #}
    <div class="mb-3 flex flex-nowrap items-center gap-2 overflow-hidden rounded-xl border border-slate-200 bg-white px-2 py-1.5 shadow-sm">
        <div class="hidden shrink-0 sm:block">
            <p class="text-[8px] font-black uppercase tracking-wider text-indigo-600 leading-none">LMS</p>
            <p class="whitespace-nowrap text-[11px] font-black text-slate-900">Portfolio</p>
        </div>
        {% if lms_notify %}
        <div class="shrink-0 border-r border-slate-100 pr-2">
            {% set student_name = request.user.first_name or request.user.username %}
            {% set compact_inline = true %}
            {% include "lms/partials/_notifications_bell.jinja" %}
        </div>
        {% endif %}
        <a href="{{ url('dashboard:index') }}" class="inline-flex shrink-0 whitespace-nowrap rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-100">Dashboard</a>
        {% if ticker_items %}
        <div class="min-w-0 flex-1 border-l border-slate-100 pl-2">
            {% set inline = true %}
            {% include "lms/partials/_assignment_ticker.jinja" %}
        </div>
        {% endif %}
    </div>
    {% endif %}

    {% if not is_staff_lms and not is_office_lms %}
    {% include "lms/partials/_pwa_install_banner.jinja" %}
    {% endif %}

    {# 4 columns: Topics | Recent submissions | Recent Assignment | Top score #}
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4 lg:items-start">

        {# 1 — Topics #}
        <aside class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 px-3 py-2">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Topics</h2>
                {% if is_admin_lms or is_office_lms %}
                <a href="{{ url('lms:topic_create') }}" class="rounded bg-indigo-600 px-2 py-0.5 text-[9px] font-black uppercase text-white hover:bg-indigo-500">+ New</a>
                {% endif %}
            </div>
            {% if topics %}
            <nav class="p-1.5">
                <ul class="space-y-0.5">
                    {% for item in topics %}
                    <li>
                        <div class="flex items-start rounded-lg hover:bg-indigo-50">
                            <a href="{{ url('lms:topic_detail', pk=item.topic.pk) }}" class="flex min-w-0 flex-1 items-start gap-2 px-2 py-2">
                                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-indigo-100 text-[10px] font-black text-indigo-700">
                                    {{ item.title[0]|upper }}
                                </span>
                                <span class="min-w-0">
                                    <span class="block text-xs font-bold leading-snug text-slate-900 break-words">{{ item.title }}</span>
                                    <span class="mt-0.5 block text-[10px] text-slate-500">{{ item.assignments|length }} asgn</span>
                                </span>
                            </a>
                            {% if (is_admin_lms or is_office_lms) and item.topic %}
                            <a href="{{ url('lms:topic_edit', pk=item.topic.pk) }}" class="mr-1.5 mt-2 shrink-0 px-1.5 py-0.5 text-[8px] font-black uppercase text-slate-400 hover:text-indigo-600">Edit</a>
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </nav>
            {% else %}
            <p class="px-3 py-6 text-center text-xs text-slate-500">No topics yet.</p>
            {% endif %}
        </aside>

        {# 2 — Recent submissions #}
        <section class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-100 px-3 py-2.5">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Recent submissions</h2>
            </div>
            {% if recent_submissions %}
            <ul class="divide-y divide-slate-100">
                {% for s in recent_submissions %}
                <li class="flex items-start gap-2.5 px-3 py-2.5">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-[11px] font-black text-white">
                        {{ s.student.get_username()[0]|upper }}
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5">
                            <p class="truncate text-xs font-black text-slate-900">{{ s.student.get_username() }}</p>
                            {% if s.is_pinned %}
                            <span class="rounded bg-amber-100 px-1 py-0.5 text-[8px] font-black uppercase text-amber-800">Pinned</span>
                            {% endif %}
                            <span class="text-[10px] font-semibold text-slate-400">{{ s.updated_at.strftime('%d %b') }}</span>
                        </div>
                        <p class="mt-0.5 truncate text-[11px] text-slate-600">
                            <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="font-bold text-indigo-600 hover:underline">{{ s.assignment.title }}</a>
                        </p>
                        {% if s.caption %}
                        <p class="mt-0.5 line-clamp-1 text-[10px] text-slate-500">{{ s.caption }}</p>
                        {% endif %}
                    </div>
                    <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}"
                       class="mt-0.5 inline-flex shrink-0 rounded-md border border-slate-200 px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">
                        View
                    </a>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="px-3 py-10 text-center text-xs text-slate-500">No submissions yet.</p>
            {% endif %}
        </section>

        {# 3 — Recent Assignment #}
        <section class="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-emerald-100 bg-emerald-50 px-3 py-2.5">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-emerald-800">Recent Assignment</h2>
            </div>
            {% if recent_assignments %}
            <ul class="divide-y divide-slate-100">
                {% for a in recent_assignments %}
                <li>
                    <a href="{{ url('lms:assignment_detail', pk=a.pk) }}" class="flex items-start gap-2.5 px-3 py-2.5 hover:bg-emerald-50">
                        <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-[10px] font-black text-emerald-700">
                            {{ a.title[0]|upper }}
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block text-xs font-bold leading-snug text-slate-900 line-clamp-2">{{ a.title }}</span>
                            <span class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-[10px] text-slate-500">
                                {% if a.topic %}
                                <span class="truncate font-semibold text-emerald-700">{{ a.topic.title }}</span>
                                {% endif %}
                                <span>{{ a.created_at.strftime('%d %b') }}</span>
                                {% if a.due_at %}
                                <span class="text-amber-700">Due {{ a.due_at.strftime('%d %b') }}</span>
                                {% endif %}
                            </span>
                        </span>
                    </a>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="px-3 py-10 text-center text-xs text-slate-500">No assignments yet.</p>
            {% endif %}
        </section>

        {# 4 — Top score, then Best likes, then Latest comments #}
        <aside class="flex min-w-0 flex-col gap-3">
            <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-amber-100 bg-amber-50 px-3 py-2.5">
                    <h2 class="text-[10px] font-black uppercase tracking-widest text-amber-800">Top score</h2>
                </div>
                {% if top_scores %}
                <ul class="divide-y divide-slate-50">
                    {% for s in top_scores %}
                    <li>
                        <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="flex items-center gap-2 px-2.5 py-2.5 hover:bg-amber-50">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-[10px] font-black text-amber-800">
                                {{ s.student.get_username()[0]|upper }}
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-xs font-bold text-slate-900">{{ s.student.get_username() }}</span>
                                <span class="block truncate text-[10px] text-slate-500">{{ s.assignment.title }}</span>
                            </span>
                            <span class="shrink-0 text-sm font-black text-amber-700">{{ s.marks }}</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="px-3 py-10 text-center text-xs text-slate-400">No marks yet.</p>
                {% endif %}
            </section>

            <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-rose-100 bg-rose-50 px-3 py-2">
                    <h2 class="text-[10px] font-black uppercase tracking-widest text-rose-800">Best likes</h2>
                </div>
                {% if best_likes %}
                <ul class="divide-y divide-slate-50">
                    {% for s in best_likes %}
                    <li>
                        <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="flex items-center gap-2 px-2.5 py-2 hover:bg-rose-50">
                            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-rose-100 text-[10px] font-black text-rose-700">
                                {{ s.student.get_username()[0]|upper }}
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-xs font-bold text-slate-900">{{ s.student.get_username() }}</span>
                                <span class="block truncate text-[10px] text-slate-500">{{ s.assignment.title }}</span>
                            </span>
                            <span class="shrink-0 text-xs font-black text-rose-600">❤️ {{ s.like_count }}</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="px-3 py-5 text-center text-[11px] text-slate-400">No likes yet.</p>
                {% endif %}
            </section>

            <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-indigo-100 bg-indigo-50 px-3 py-2">
                    <h2 class="text-[10px] font-black uppercase tracking-widest text-indigo-800">Latest comments</h2>
                </div>
                {% if latest_comments %}
                <ul class="divide-y divide-slate-50">
                    {% for c in latest_comments %}
                    <li>
                        <a href="{{ url('lms:assignment_detail', pk=c.submission.assignment_id) }}" class="block px-2.5 py-2 hover:bg-indigo-50">
                            <div class="flex items-center gap-1.5">
                                <span class="text-xs font-black text-slate-900">{{ c.user.get_username() }}</span>
                                <span class="text-[10px] text-slate-400">{{ c.created_at.strftime('%d %b') }}</span>
                            </div>
                            <p class="mt-0.5 line-clamp-2 text-[11px] leading-snug text-slate-600">{{ c.body }}</p>
                            <p class="mt-0.5 truncate text-[10px] font-semibold text-indigo-600">{{ c.submission.assignment.title }}</p>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="px-3 py-5 text-center text-[11px] text-slate-400">No comments yet.</p>
                {% endif %}
            </section>
        </aside>
    </div>
</div>
{% endblock %}
