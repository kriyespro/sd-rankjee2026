{% extends "base.jinja" %}
{% block title %}LMS · RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
        <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600">Classroom</p>
            <h1 class="text-2xl font-black tracking-tight text-slate-900">LMS Portfolio Feed</h1>
            <p class="mt-1 text-sm text-slate-600">Pick a topic on the left · see latest work on the right.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if is_staff_lms %}
            <a href="{{ url('lms:assignment_create') }}" class="inline-flex rounded-xl bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">New assignment</a>
            <a href="{{ url('lms:batches') }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Batches</a>
            {% endif %}
            <a href="{{ url('dashboard:index') }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">Dashboard</a>
        </div>
    </div>

    <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
        {# Left sidebar — topics #}
        <aside class="w-full shrink-0 lg:w-64 xl:w-72">
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm lg:sticky lg:top-4">
                <div class="flex items-center justify-between gap-2 border-b border-slate-100 px-4 py-3">
                    <h2 class="text-xs font-black uppercase tracking-widest text-slate-500">Topics</h2>
                    {% if is_staff_lms %}
                    <a href="{{ url('lms:topic_create') }}" class="rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-[9px] font-black uppercase tracking-wider text-slate-600 hover:bg-white">+ New</a>
                    {% endif %}
                </div>
                {% if topics %}
                <nav class="max-h-[70vh] overflow-y-auto p-2">
                    <ul class="space-y-1">
                        {% for item in topics %}
                        <li>
                            <div class="group flex items-center gap-2 rounded-xl px-2 py-2 hover:bg-indigo-50/60">
                                <a href="{{ url('lms:topic_detail', pk=item.topic.pk) }}" class="flex min-w-0 flex-1 items-center gap-2.5">
                                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-[11px] font-black text-indigo-700">
                                        {{ item.title[0]|upper }}
                                    </span>
                                    <span class="min-w-0">
                                        <span class="block truncate text-sm font-bold text-slate-900 group-hover:text-indigo-700">{{ item.title }}</span>
                                        <span class="block truncate text-[10px] font-semibold text-slate-500">{{ item.assignments|length }} assignment{% if item.assignments|length != 1 %}s{% endif %}</span>
                                    </span>
                                </a>
                                {% if is_staff_lms and item.topic %}
                                <a href="{{ url('lms:topic_edit', pk=item.topic.pk) }}"
                                   class="shrink-0 rounded px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-slate-400 opacity-0 transition group-hover:opacity-100 hover:bg-white hover:text-slate-600"
                                   title="Edit topic">Edit</a>
                                {% endif %}
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                </nav>
                {% else %}
                <p class="px-4 py-8 text-center text-sm text-slate-500">
                    No topics yet.{% if is_staff_lms %} Create one to get started.{% endif %}
                </p>
                {% endif %}
            </div>
        </aside>

        {# Right — recent submissions feed #}
        <main class="min-w-0 flex-1">
            <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 px-5 py-4">
                    <h2 class="text-xs font-black uppercase tracking-widest text-slate-500">Recent submissions</h2>
                    <p class="mt-1 text-sm text-slate-600">Latest student work across all topics.</p>
                </div>
                {% if recent_submissions %}
                <ul class="divide-y divide-slate-100">
                    {% for s in recent_submissions %}
                    <li class="flex items-start gap-3 px-5 py-4 transition hover:bg-slate-50/80">
                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-black text-white">
                            {{ s.student.get_username()[0]|upper }}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <p class="text-sm font-black text-slate-900">{{ s.student.get_username() }}</p>
                                {% if s.is_pinned %}
                                <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[9px] font-black uppercase text-amber-800">Pinned</span>
                                {% endif %}
                                <span class="text-[11px] font-semibold text-slate-400">{{ s.updated_at.strftime('%d %b · %H:%M') }}</span>
                            </div>
                            <p class="mt-0.5 text-sm text-slate-600">
                                submitted on
                                <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}" class="font-bold text-indigo-600 hover:underline">{{ s.assignment.title }}</a>
                            </p>
                            {% if s.caption %}
                            <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-slate-500">{{ s.caption }}</p>
                            {% endif %}
                        </div>
                        <a href="{{ url('lms:assignment_detail', pk=s.assignment_id) }}"
                           class="hidden shrink-0 self-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50 sm:inline-flex">
                            View
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="px-5 py-12 text-center text-sm text-slate-500">No submissions yet — open a topic and post on an assignment.</p>
                {% endif %}
            </section>
        </main>
    </div>
</div>
{% endblock %}
