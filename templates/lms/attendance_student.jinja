{% extends "base.jinja" %}
{% block title %}Attendance — {{ course.name }} — {{ student.username }} — RankJee{% endblock %}

{% block content %}
<div class="mx-auto max-w-3xl px-4 py-6 sm:px-6">

    {# Breadcrumbs #}
    {% if breadcrumbs %}
    <nav class="mb-4 flex flex-wrap items-center gap-1 text-[10px] font-black uppercase tracking-wider text-slate-400">
        <a href="{{ url('lms:home') }}" class="hover:text-indigo-600 transition-colors">LMS</a>
        {% for crumb in breadcrumbs %}
        <span class="opacity-40">›</span>
        {% if crumb.url %}<a href="{{ crumb.url }}" class="hover:text-indigo-600 transition-colors">{{ crumb.label }}</a>
        {% else %}<span class="text-slate-700">{{ crumb.label }}</span>{% endif %}
        {% endfor %}
    </nav>
    {% endif %}

    {# Header #}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-sky-700">{{ course.name }}</p>
            <h1 class="text-lg font-black text-slate-900 leading-tight">
                Attendance · {{ student.username }}
            </h1>
            <p class="text-[11px] text-slate-400 mt-0.5">Faculty-marked + student class log · monthly view</p>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if is_faculty_or_admin %}
            <a href="{{ url('lms:attendance_mark', pk=course.pk) }}"
               class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-black text-emerald-700 hover:bg-emerald-100 shadow-sm">
                📋 Mark session
            </a>
            <a href="{{ url('lms:attendance_course_summary', pk=course.pk) }}?year={{ year }}&month={{ month }}"
               class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-600 hover:bg-slate-50 shadow-sm">
                👥 All students
            </a>
            {% endif %}
        </div>
    </div>

    {# Summary strip — 4 stats + overall rate bar #}
    <div class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="mb-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
            <div class="rounded-xl bg-slate-50 p-3 text-center">
                <p class="text-[10px] font-black uppercase text-slate-400">Total sessions</p>
                <p class="text-2xl font-black text-slate-900">{{ summary.total }}</p>
            </div>
            <div class="rounded-xl bg-emerald-50 p-3 text-center">
                <p class="text-[10px] font-black uppercase text-emerald-600">Present</p>
                <p class="text-2xl font-black text-emerald-700">{{ summary.present }}</p>
            </div>
            <div class="rounded-xl bg-amber-50 p-3 text-center">
                <p class="text-[10px] font-black uppercase text-amber-600">Late</p>
                <p class="text-2xl font-black text-amber-700">{{ summary.late }}</p>
            </div>
            <div class="rounded-xl bg-rose-50 p-3 text-center">
                <p class="text-[10px] font-black uppercase text-rose-600">Absent</p>
                <p class="text-2xl font-black text-rose-700">{{ summary.absent }}</p>
            </div>
        </div>
        {% if summary.rate is not none %}
        <div class="flex items-center gap-3">
            <div class="h-2.5 flex-1 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-2.5 rounded-full transition-all
                    {{ 'bg-emerald-500' if summary.rate >= 75 else 'bg-amber-500' if summary.rate >= 50 else 'bg-rose-500' }}"
                     style="width: {{ summary.rate }}%"></div>
            </div>
            <p class="text-sm font-black flex-shrink-0
                {{ 'text-emerald-700' if summary.rate >= 75 else 'text-amber-700' if summary.rate >= 50 else 'text-rose-600' }}">
                {{ summary.rate }}% overall
            </p>
        </div>
        {% endif %}
    </div>

    {# Month navigation #}
    <div class="mb-3 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2 shadow-sm">
        <a href="?year={{ prev_year }}&month={{ prev_month }}{% if request.GET.student_id %}&student_id={{ request.GET.student_id }}{% endif %}"
           class="text-sm font-black text-slate-500 hover:text-indigo-600 px-2 py-1 rounded-lg hover:bg-slate-50">← Prev</a>
        <p class="text-sm font-black text-slate-900">{{ month_name }}</p>
        <a href="?year={{ next_year }}&month={{ next_month }}{% if request.GET.student_id %}&student_id={{ request.GET.student_id }}{% endif %}"
           class="text-sm font-black text-slate-500 hover:text-indigo-600 px-2 py-1 rounded-lg hover:bg-slate-50">Next →</a>
    </div>

    {# Legend #}
    <div class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-[10px] font-black uppercase tracking-wide">
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-emerald-400"></span>Present (faculty)</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-amber-400"></span>Late (faculty)</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-rose-300"></span>Absent (faculty)</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-indigo-500 border-2 border-indigo-300"></span>Class log (student)</span>
    </div>

    {# ── Combined Monthly Calendar ── #}
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">

        {# Weekday header row #}
        <div class="grid grid-cols-7 border-b border-slate-100 bg-slate-50">
            {% for wd in ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'] %}
            <div class="py-2 text-center text-[10px] font-black uppercase tracking-wider text-slate-400">{{ wd }}</div>
            {% endfor %}
        </div>

        {# Calendar days grid #}
        <div class="grid grid-cols-7 divide-x divide-slate-100">
            {# Empty cells for days before month start #}
            {% for _ in range(weekday_start) %}
            <div class="border-b border-slate-100 min-h-[5rem] bg-slate-50/30 p-1"></div>
            {% endfor %}

            {% for day in days %}
            {% set att_status = day.status %}
            {% set log = day.class_log %}
            {% set is_today = day.date == today_date if today_date is defined else false %}

            <div class="border-b border-slate-100 min-h-[5rem] p-1.5 relative
                {{ 'bg-emerald-50/60' if att_status == 'PRESENT'
                   else 'bg-amber-50/50' if att_status == 'LATE'
                   else 'bg-rose-50/30' if att_status == 'ABSENT'
                   else 'bg-white' }}">

                {# Day number #}
                <p class="text-xs font-black leading-tight mb-1
                    {{ 'text-emerald-700' if att_status == 'PRESENT'
                       else 'text-amber-700' if att_status == 'LATE'
                       else 'text-rose-600' if att_status == 'ABSENT'
                       else 'text-slate-400' }}">
                    {{ day.day }}
                </p>

                {# Faculty attendance badge #}
                {% if att_status %}
                <div class="mb-1">
                    <span class="inline-block rounded px-1 py-0.5 text-[8px] font-black uppercase leading-none
                        {{ 'bg-emerald-400 text-white' if att_status == 'PRESENT'
                           else 'bg-amber-400 text-white' if att_status == 'LATE'
                           else 'bg-rose-400 text-white' }}">
                        {{ '✓ P' if att_status == 'PRESENT' else '~ L' if att_status == 'LATE' else '✗ A' }}
                    </span>
                </div>
                {% endif %}

                {# Student class log dot + topic snippet #}
                {% if log %}
                <div class="mt-0.5">
                    <div class="flex items-center gap-1 mb-0.5">
                        <span class="h-2 w-2 flex-shrink-0 rounded-full
                            {{ 'bg-indigo-500' if log.attendance == 'PRESENT' else 'bg-slate-400' }}"></span>
                        <span class="text-[8px] font-black uppercase text-indigo-700 leading-none">
                            {{ 'Log ✓' if log.attendance == 'PRESENT' else 'Log ✗' }}
                        </span>
                    </div>
                    {% if log.topic %}
                    <p class="text-[8px] text-slate-500 leading-tight truncate" title="{{ log.topic }}">
                        {{ log.topic[:20] }}{% if log.topic|length > 20 %}…{% endif %}
                    </p>
                    {% endif %}
                </div>
                {% endif %}

            </div>
            {% endfor %}
        </div>
    </div>

    {# ── Day-by-day detail list (only days with data) ── #}
    {% set data_days = days | selectattr('status') | list + days | selectattr('class_log') | list %}
    {% if days | selectattr('status') | list or days | selectattr('class_log') | list %}
    <div class="mt-5">
        <h2 class="mb-2 text-[10px] font-black uppercase tracking-wider text-slate-500">Session details — {{ month_name }}</h2>
        <div class="divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            {% for day in days %}
            {% if day.status or day.class_log %}
            <div class="flex items-start gap-3 px-4 py-2.5
                {{ 'border-l-4 border-emerald-400' if day.status == 'PRESENT'
                   else 'border-l-4 border-amber-400' if day.status == 'LATE'
                   else 'border-l-4 border-rose-400' if day.status == 'ABSENT'
                   else 'border-l-4 border-slate-200' }}">
                {# Date #}
                <div class="w-12 flex-shrink-0 text-center">
                    <p class="text-base font-black text-slate-700 leading-none">{{ day.day }}</p>
                    <p class="text-[9px] font-bold uppercase text-slate-400">{{ day.weekday }}</p>
                </div>
                {# Faculty attendance #}
                <div class="flex-1 min-w-0">
                    {% if day.status %}
                    <span class="inline-block rounded-full px-2 py-0.5 text-[10px] font-black uppercase mb-1
                        {{ 'bg-emerald-100 text-emerald-700' if day.status == 'PRESENT'
                           else 'bg-amber-100 text-amber-700' if day.status == 'LATE'
                           else 'bg-rose-100 text-rose-700' }}">
                        {{ day.status }}
                    </span>
                    {% endif %}
                    {% if day.class_log %}
                    <div class="flex items-start gap-2 mt-0.5">
                        <span class="h-2 w-2 mt-1 flex-shrink-0 rounded-full
                            {{ 'bg-indigo-500' if day.class_log.attendance == 'PRESENT' else 'bg-slate-400' }}"></span>
                        <div class="min-w-0">
                            <p class="text-xs font-black text-slate-800 leading-tight truncate">
                                {{ day.class_log.topic }}
                            </p>
                            {% if day.class_log.details %}
                            <p class="text-[10px] text-slate-500 leading-snug mt-0.5 truncate">
                                {{ day.class_log.details[:80] }}{% if day.class_log.details|length > 80 %}…{% endif %}
                            </p>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                </div>
                {# Source label #}
                <div class="flex-shrink-0 text-right text-[9px] text-slate-300 font-bold uppercase">
                    {% if day.status and day.class_log %}both
                    {% elif day.status %}faculty
                    {% else %}student log{% endif %}
                </div>
            </div>
            {% endif %}
            {% endfor %}
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}
