{% extends "base.jinja" %}
{% block title %}Attendance — {{ course.name }} — RankJee{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl px-4 py-6 sm:px-6">

    {# Breadcrumbs #}
    {% if breadcrumbs %}
    <nav class="mb-4 flex flex-wrap items-center gap-1 text-[10px] font-black uppercase tracking-wider text-slate-400">
        <a href="{{ url('lms:home') }}" class="hover:text-indigo-600 transition-colors">LMS</a>
        {% for crumb in breadcrumbs %}
        <span class="opacity-40">›</span>
        {% if crumb.url %}<a href="{{ crumb.url }}" class="hover:text-indigo-600 transition-colors">{{ crumb.label }}</a>
        {% else %}<span class="text-slate-700">{{ crumb.label }}</span>{% endif %}
        {% endfor %}
    </nav>
    {% endif %}

    <div class="mb-4">
        <p class="text-[10px] font-black uppercase tracking-widest text-sky-700">{{ course.name }}</p>
        <h1 class="text-xl font-black text-slate-900">Attendance — {{ student.username }}</h1>
    </div>

    {# Summary strip #}
    <div class="mb-5 grid grid-cols-4 gap-2">
        <div class="rounded-xl border border-slate-200 bg-white p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-slate-400">Total</p>
            <p class="text-xl font-black text-slate-900">{{ summary.total }}</p>
        </div>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-emerald-600">Present</p>
            <p class="text-xl font-black text-emerald-700">{{ summary.present }}</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-amber-600">Late</p>
            <p class="text-xl font-black text-amber-700">{{ summary.late }}</p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-rose-600">Absent</p>
            <p class="text-xl font-black text-rose-700">{{ summary.absent }}</p>
        </div>
    </div>
    {% if summary.rate is not none %}
    <div class="mb-5 rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-2.5 flex items-center gap-3">
        <div class="h-2 flex-1 rounded-full bg-indigo-100 overflow-hidden">
            <div class="h-2 rounded-full {{ 'bg-emerald-500' if summary.rate >= 75 else 'bg-amber-500' if summary.rate >= 50 else 'bg-rose-500' }}"
                 style="width: {{ summary.rate }}%"></div>
        </div>
        <p class="text-sm font-black {{ 'text-emerald-700' if summary.rate >= 75 else 'text-amber-700' if summary.rate >= 50 else 'text-rose-700' }}">
            {{ summary.rate }}% attendance
        </p>
    </div>
    {% endif %}

    {# Month navigation #}
    <div class="mb-4 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2.5 shadow-sm">
        <a href="?year={{ prev_year }}&month={{ prev_month }}" class="text-sm font-black text-slate-500 hover:text-indigo-600">← Prev</a>
        <p class="text-sm font-black text-slate-900">{{ month_name }}</p>
        <a href="?year={{ next_year }}&month={{ next_month }}" class="text-sm font-black text-slate-500 hover:text-indigo-600">Next →</a>
    </div>

    {# Calendar grid #}
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        {# Weekday headers #}
        <div class="grid grid-cols-7 border-b border-slate-100 bg-slate-50">
            {% for wd in ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'] %}
            <div class="py-2 text-center text-[10px] font-black uppercase tracking-wider text-slate-400">{{ wd }}</div>
            {% endfor %}
        </div>

        {# Days grid — pad start with empty cells #}
        <div class="grid grid-cols-7">
            {% for _ in range(weekday_start) %}
            <div class="border-b border-r border-slate-50 p-2"></div>
            {% endfor %}

            {% for day in days %}
            {% set s = day.status %}
            <div class="border-b border-r border-slate-100 p-2 min-h-[3.5rem]
                {{ 'bg-emerald-50' if s == 'PRESENT' else 'bg-amber-50' if s == 'LATE' else 'bg-rose-50/40' if s == 'ABSENT' else '' }}">
                <p class="text-xs font-black leading-tight
                    {{ 'text-emerald-700' if s == 'PRESENT' else 'text-amber-700' if s == 'LATE' else 'text-rose-600' if s == 'ABSENT' else 'text-slate-400' }}">
                    {{ day.day }}
                </p>
                {% if s %}
                <p class="mt-0.5 text-[9px] font-black uppercase leading-none
                    {{ 'text-emerald-600' if s == 'PRESENT' else 'text-amber-600' if s == 'LATE' else 'text-rose-500' }}">
                    {{ '✓' if s == 'PRESENT' else '~' if s == 'LATE' else '✗' }}
                    {{ s }}
                </p>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>

    {# Legend #}
    <div class="mt-3 flex flex-wrap gap-3 text-[10px] font-black uppercase tracking-wider">
        <span class="flex items-center gap-1 text-emerald-700"><span class="h-3 w-3 rounded bg-emerald-400"></span>Present</span>
        <span class="flex items-center gap-1 text-amber-700"><span class="h-3 w-3 rounded bg-amber-400"></span>Late</span>
        <span class="flex items-center gap-1 text-rose-600"><span class="h-3 w-3 rounded bg-rose-300"></span>Absent</span>
        <span class="flex items-center gap-1 text-slate-400"><span class="h-3 w-3 rounded bg-slate-100 border"></span>No record</span>
    </div>

</div>
{% endblock %}
