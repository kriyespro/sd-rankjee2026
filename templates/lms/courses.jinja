{% extends "base.jinja" %}
{% block title %}LMS Courses · RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
    {% include "partials/_breadcrumb.jinja" %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600">{% if is_office_lms %}Office · course & student setup{% else %}Staff{% endif %}</p>
            <h1 class="text-2xl font-black tracking-tight text-slate-900">{% if is_admin_lms or is_office_lms %}All courses{% else %}My courses{% endif %}</h1>
            {% if is_office_lms %}
            <p class="mt-1 text-xs text-slate-500">Create a course and assign a faculty/tutor to teach it, then assign or remove students below. You can't create assignments or edit anything else here.</p>
            {% elif not is_admin_lms %}
            <p class="mt-1 text-xs text-slate-500">Only you can see and manage the students and assignments in your own courses.</p>
            {% endif %}
        </div>
        {% if is_admin_lms %}
        <a href="{{ url('lms:course_builder') }}" class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100 whitespace-nowrap">🧱 Course builder →</a>
        {% endif %}
        {% if is_admin_lms or is_office_lms %}
        <a href="{{ url('lms:student_assign') }}" class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2 text-xs font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100 whitespace-nowrap">🎯 Assign students →</a>
        {% endif %}
    </div>

    {% if can_manage_enrollment and student_options %}
    <datalist id="lms-student-options">
        {% for s in student_options %}
        <option value="{{ s.username }}{% if s.email %} · {{ s.email }}{% endif %}">
        {% endfor %}
    </datalist>
    {% endif %}

    {% if (is_admin_lms or is_office_lms) and unassigned_purchases %}
    <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-900">
        <p class="mb-2 font-black uppercase tracking-wider text-amber-700">⚠ {{ unassigned_purchases|length }} course purchase(s) have no delivery batch yet</p>
        <ul class="space-y-1">
            {% for p in unassigned_purchases %}
            <li>{{ p.user.get_username() }} bought <strong>{{ p.course.title }}</strong> — assign a tutor below (create a course with that paid course selected).</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {% if can_create_course %}
    <form method="post" class="mb-8 flex flex-wrap items-end gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="create_course">
        <div class="min-w-[12rem] flex-1">
            <label class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">New course name</label>
            {{ course_form.name }}
        </div>
        {% if course_form.owner %}
        <div class="min-w-[12rem] flex-1">
            <label class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">Owner (faculty/tutor)</label>
            {{ course_form.owner }}
        </div>
        {% endif %}
        <div class="min-w-[12rem] flex-1">
            <label class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">Class / level</label>
            {{ course_form.level }}
        </div>
        {% if is_admin_lms and course_form.catalog_course %}
        <div class="min-w-[12rem] flex-1">
            <label class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">Paid course (/courses/)</label>
            {{ course_form.catalog_course }}
        </div>
        <label class="flex items-center gap-2 text-xs font-bold text-slate-700 pb-2">
            {{ course_form.is_default_for_catalog }} Auto-enroll buyers
        </label>
        {% endif %}
        <label class="flex items-center gap-2 text-xs font-bold text-slate-700 pb-2">
            {{ course_form.is_active }} Active
        </label>
        <button type="submit" class="rounded-xl bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">Add course</button>
    </form>
    {% endif %}

    <div class="space-y-4">
        {% for c in courses %}
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                <h2 class="text-sm font-black text-slate-900">{{ c.name }}
                    {% if not c.is_active %}<span class="ml-2 text-[10px] font-black uppercase text-rose-600">Inactive</span>{% endif %}
                    {% if not (is_admin_lms or is_office_lms) %}
                    <span class="ml-2 text-[10px] font-bold uppercase text-slate-400">
                        {% if c.owner %}Owner: {{ c.owner.get_username() }}{% else %}Platform-wide{% endif %}
                    </span>
                    {% endif %}
                    {% if c.catalog_course %}
                    <span class="ml-2 inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-black uppercase text-indigo-700">
                        Delivers: {{ c.catalog_course.title }}{% if c.is_default_for_catalog %} · default{% endif %}
                    </span>
                    {% endif %}
                </h2>
                <span class="flex items-center gap-2 text-[11px] font-bold text-slate-500">
                    <span>{{ c.enrollments.all()|length }} students</span>
                    <span class="text-slate-300">·</span>
                    <span class="{% if not c.topic_count %}text-amber-600{% endif %}">{{ c.topic_count }} topic{{ 's' if c.topic_count != 1 else '' }}</span>
                    <span class="text-slate-300">·</span>
                    <span class="{% if not c.assignment_count %}text-amber-600{% endif %}">{{ c.assignment_count }} assignment{{ 's' if c.assignment_count != 1 else '' }}</span>
                </span>
            </div>
            {% if is_admin_lms or is_office_lms %}
            <form method="post" class="mb-3 flex flex-wrap items-center gap-1.5">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="reassign_owner">
                <input type="hidden" name="course_id" value="{{ c.pk }}">
                <label class="text-[10px] font-black uppercase tracking-wider text-slate-400">Faculty:</label>
                <select name="owner_id" class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[11px] font-bold text-slate-700">
                    <option value="">Platform-wide (no owner)</option>
                    {% for o in owner_options %}
                    <option value="{{ o.pk }}" {% if c.owner_id == o.pk %}selected{% endif %}>{{ o.get_username() }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[10px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Save</button>
            </form>
            {% endif %}
            <ul class="mb-3 space-y-1">
                {% for m in c.enrollments.all() %}
                <li class="flex items-center justify-between gap-2 rounded-lg bg-slate-50 px-3 py-1.5 text-xs">
                    <span class="font-bold text-slate-800">{{ m.user.get_username() }}</span>
                    {% if can_manage_enrollment %}
                    <form method="post" class="inline">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <input type="hidden" name="action" value="remove_member">
                        <input type="hidden" name="course_id" value="{{ c.pk }}">
                        <input type="hidden" name="membership_id" value="{{ m.pk }}">
                        <button type="submit" class="font-black uppercase tracking-wider text-rose-600 hover:underline">Remove</button>
                    </form>
                    {% endif %}
                </li>
                {% else %}
                <li class="text-xs text-slate-400">No students enrolled yet.</li>
                {% endfor %}
            </ul>
            {% if can_manage_enrollment %}
            <div x-data="{ showBrowse: false }">
                {# Quick typeahead add #}
                <form method="post" class="flex flex-wrap items-start gap-2 mb-2">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="add_member">
                    <input type="hidden" name="course_id" value="{{ c.pk }}">
                    <div class="flex-1 min-w-[12rem]">
                        {{ member_form.username }}
                        {% if member_form.username.errors and request.POST.get('course_id') == c.pk|string %}
                        <p class="mt-1 text-[11px] font-bold text-rose-600">{{ member_form.username.errors|join(' ') }}</p>
                        {% endif %}
                    </div>
                    <button type="submit" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Add →</button>
                    {% if is_admin_lms %}
                    <button type="button"
                            @click="showBrowse = !showBrowse"
                            hx-get="{{ url('lms:students_for_course', pk=c.pk) }}"
                            hx-target="#browse-{{ c.pk }}"
                            hx-swap="innerHTML"
                            hx-trigger="click once"
                            class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-[11px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-100">
                        Browse all students
                    </button>
                    {% endif %}
                </form>
                <p class="mb-2 text-[10px] text-slate-400">
                    {% if is_admin_lms or is_office_lms %}Type username or email to search.{% else %}Type a student's username to add them.{% endif %}
                    {{ student_options|length }} students on platform.
                </p>
                {# HTMX browse panel (admin only) — uses bulk_enroll endpoint #}
                {% if is_admin_lms %}
                <div x-show="showBrowse" class="mt-2">
                    <form method="post" action="{{ url('lms:bulk_enroll') }}">
                        {{ csrf_input }}
                        <input type="hidden" name="course_id" value="{{ c.pk }}">
                        <input type="hidden" name="next" value="{{ request.path }}">
                        <div id="browse-{{ c.pk }}">
                            <p class="text-[11px] text-slate-400 italic">Click "Browse all students" to load the list…</p>
                        </div>
                    </form>
                </div>
                {% endif %}
            </div>
            {# ── Attendance quick links ── #}
            {% if can_manage_enrollment %}
            <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-3">
                <a href="{{ url('lms:attendance_mark', pk=c.pk) }}"
                   class="inline-flex items-center gap-1 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-emerald-700 hover:bg-emerald-100">
                    📋 Mark attendance
                </a>
                <a href="{{ url('lms:attendance_course_summary', pk=c.pk) }}"
                   class="inline-flex items-center gap-1 rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-sky-700 hover:bg-sky-100">
                    📊 Attendance summary
                </a>
            </div>
            {% elif request.user.role == 'STUDENT' %}
            <div class="mt-3 border-t border-slate-100 pt-3">
                <a href="{{ url('lms:attendance_student', pk=c.pk) }}"
                   class="inline-flex items-center gap-1 rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-[11px] font-black uppercase tracking-wider text-sky-700 hover:bg-sky-100">
                    📅 My attendance
                </a>
            </div>
            {% endif %}
            {% endif %}
        </section>
        {% else %}
        <p class="text-sm text-slate-500">No courses yet — create one above, then add your students and assignments to it.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
