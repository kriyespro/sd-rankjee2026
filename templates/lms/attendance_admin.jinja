{% extends "base.jinja" %}
{% block title %}All Attendance — Admin — RankJee{% endblock %}

{% block content %}
<div class="mx-auto max-w-5xl px-4 py-6 sm:px-6">

    {# Breadcrumbs #}
    {% if breadcrumbs %}
    <nav class="mb-4 flex flex-wrap items-center gap-1 text-[10px] font-black uppercase tracking-wider text-slate-400">
        <a href="{{ url('dashboard:index') }}" class="hover:text-indigo-600 transition-colors">Admin</a>
        {% for crumb in breadcrumbs %}
        <span class="opacity-40">›</span>
        {% if crumb.url %}<a href="{{ crumb.url }}" class="hover:text-indigo-600 transition-colors">{{ crumb.label }}</a>
        {% else %}<span class="text-slate-700">{{ crumb.label }}</span>{% endif %}
        {% endfor %}
    </nav>
    {% endif %}

    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-indigo-600">Superadmin</p>
            <h1 class="text-xl font-black text-slate-900">All Attendance</h1>
            <p class="text-xs text-slate-400 mt-0.5">All courses · all faculty · all students</p>
        </div>
        <a href="{{ url('lms:courses') }}"
           class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-black text-slate-500 hover:bg-slate-50 shadow-sm">
            ← LMS Courses
        </a>
    </div>

    {# Stats strip #}
    <div class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-slate-400">Total records</p>
            <p class="text-2xl font-black text-slate-900">{{ total }}</p>
        </div>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-emerald-600">Present</p>
            <p class="text-2xl font-black text-emerald-700">{{ present }}</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-amber-600">Late</p>
            <p class="text-2xl font-black text-amber-700">{{ late }}</p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-center shadow-sm">
            <p class="text-[10px] font-black uppercase text-rose-600">Absent</p>
            <p class="text-2xl font-black text-rose-700">{{ absent }}</p>
        </div>
    </div>

    {# Month navigation #}
    <div class="mb-4 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2.5 shadow-sm">
        <a href="?year={{ prev_year }}&month={{ prev_month }}" class="text-sm font-black text-slate-500 hover:text-indigo-600">← Prev</a>
        <p class="text-sm font-black text-slate-900">{{ month_name }}</p>
        <a href="?year={{ next_year }}&month={{ next_month }}" class="text-sm font-black text-slate-500 hover:text-indigo-600">Next →</a>
    </div>

    {% if not records %}
    <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
        <p class="text-2xl mb-2">📋</p>
        <p class="text-sm font-bold text-slate-500">No attendance records for {{ month_name }}.</p>
    </div>
    {% else %}
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-xs">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50">
                        <th class="px-4 py-2.5 text-left font-black uppercase tracking-wider text-slate-500">Date</th>
                        <th class="px-3 py-2.5 text-left font-black uppercase tracking-wider text-slate-500">Course</th>
                        <th class="px-3 py-2.5 text-left font-black uppercase tracking-wider text-slate-500">Student</th>
                        <th class="px-3 py-2.5 text-center font-black uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-3 py-2.5 text-left font-black uppercase tracking-wider text-slate-400">Marked by</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for rec in records %}
                    <tr class="hover:bg-slate-50 transition-colors
                        {{ 'bg-emerald-50/30' if rec.status == 'PRESENT' else 'bg-amber-50/30' if rec.status == 'LATE' else 'bg-rose-50/20' }}">
                        <td class="px-4 py-2 font-bold text-slate-700 whitespace-nowrap">{{ rec.date }}</td>
                        <td class="px-3 py-2 font-bold text-indigo-700 truncate max-w-[10rem]">{{ rec.course.name }}</td>
                        <td class="px-3 py-2 font-bold text-slate-800">{{ rec.student.username }}</td>
                        <td class="px-3 py-2 text-center">
                            <span class="rounded-full px-2 py-0.5 text-[10px] font-black uppercase
                                {{ 'bg-emerald-100 text-emerald-700' if rec.status == 'PRESENT' else 'bg-amber-100 text-amber-700' if rec.status == 'LATE' else 'bg-rose-100 text-rose-700' }}">
                                {{ rec.status }}
                            </span>
                        </td>
                        <td class="px-3 py-2 text-slate-400">{{ rec.marked_by.username if rec.marked_by else '—' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}
