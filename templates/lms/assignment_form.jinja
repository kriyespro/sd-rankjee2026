{% extends "base.jinja" %}
{% block title %}{% if is_edit %}Edit assignment{% else %}New assignment{% endif %} · LMS{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-xl px-4 py-6 sm:px-6">
    {% include "partials/_breadcrumb.jinja" %}
    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600">Staff</p>
    <h1 class="text-2xl font-black tracking-tight text-slate-900">{% if is_edit %}Edit assignment{% else %}Create assignment{% endif %}</h1>
    <p class="mt-1 text-sm text-slate-600 mb-6">
        {% if is_edit %}
        Update topic, title, instructions, course, or deadline for “{{ assignment.title }}”.
        {% elif form.topic_mode %}
        Select an existing topic or create a new one, then add the assignment inside it.
        {% else %}
        Pick one of the existing topics, then add the assignment inside it.
        {% endif %}
    </p>

    <form method="post" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
          x-data="{ topicMode: '{{ form.topic_mode.value() if form.topic_mode else 'existing' }}' }">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">

        <div class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4 space-y-3">
            <p class="text-xs font-black uppercase tracking-wider text-indigo-800">Topic</p>
            {% if form.topic_mode %}
            <div class="flex flex-wrap gap-4 text-sm font-semibold text-slate-700">
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="topic_mode" value="existing" x-model="topicMode"
                           class="text-indigo-600 focus:ring-indigo-500">
                    Select existing
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="topic_mode" value="new" x-model="topicMode"
                           class="text-indigo-600 focus:ring-indigo-500">
                    Create new
                </label>
            </div>
            {% if form.topic_mode.errors %}
            <p class="text-sm text-rose-600">{% for e in form.topic_mode.errors %}{{ e }}{% endfor %}</p>
            {% endif %}

            <div x-show="topicMode === 'existing'" x-cloak>
                <label for="{{ form.topic.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">Existing topic</label>
                {{ form.topic }}
                {% if form.topic.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.topic.errors %}{{ e }}{% endfor %}</p>{% endif %}
            </div>

            <div x-show="topicMode === 'new'" x-cloak class="space-y-3">
                <div>
                    <label for="{{ form.new_topic_title.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">New topic title</label>
                    {{ form.new_topic_title }}
                    {% if form.new_topic_title.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.new_topic_title.errors %}{{ e }}{% endfor %}</p>{% endif %}
                </div>
                <div>
                    <label for="{{ form.new_topic_description.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">Description <span class="font-semibold normal-case text-slate-400">(optional)</span></label>
                    {{ form.new_topic_description }}
                    {% if form.new_topic_description.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.new_topic_description.errors %}{{ e }}{% endfor %}</p>{% endif %}
                </div>
            </div>
            {% else %}
            {# Faculty pick from the existing list only — topics are admin/office-managed curriculum. #}
            <label for="{{ form.topic.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">Topic</label>
            {{ form.topic }}
            <p class="mt-1 text-[11px] text-slate-500">Don't see the right topic? Ask an admin/office teammate to add it.</p>
            {% if form.topic.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.topic.errors %}{{ e }}{% endfor %}</p>{% endif %}
            {% endif %}
        </div>

        <div>
            <label for="{{ form.title.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">{{ form.title.label }}</label>
            {{ form.title }}
            {% if form.title.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.title.errors %}{{ e }}{% endfor %}</p>{% endif %}
        </div>
        <div>
            <label for="{{ form.instructions.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">{{ form.instructions.label }}</label>
            {{ form.instructions }}
            {% if form.instructions.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.instructions.errors %}{{ e }}{% endfor %}</p>{% endif %}
        </div>
        <div>
            <label for="{{ form.concept_video.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">
                Lecture recording <span class="font-semibold normal-case text-slate-400">(optional)</span>
            </label>
            {{ form.concept_video }}
            <p class="mt-1 text-[11px] text-slate-500">Students get a “Watch lecture” button that opens this video on <span class="font-semibold">/learning/</span>. Manage videos under CMS → Videos.</p>
            {% if form.concept_video.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.concept_video.errors %}{{ e }}{% endfor %}</p>{% endif %}
        </div>
        <div>
            <label for="{{ form.study_topic.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">
                Study topic <span class="font-semibold normal-case text-slate-400">(optional)</span>
            </label>
            {{ form.study_topic }}
            <p class="mt-1 text-[11px] text-slate-500">Students get an “Open study topic” button that opens this chapter on <span class="font-semibold">/admin/study/</span>. Manage topics under Study → Topics.</p>
            {% if form.study_topic.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.study_topic.errors %}{{ e }}{% endfor %}</p>{% endif %}
        </div>
        <div>
            <label for="{{ form.skill.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">
                {{ form.skill.label }} <span class="font-semibold normal-case text-slate-400">(optional)</span>
            </label>
            {{ form.skill }}
            <p class="mt-1 text-[11px] text-slate-500">Students get a “Take the test” button that opens this test on <span class="font-semibold">/assessment/</span>; their result shows on this assignment page.</p>
            {% if form.skill.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.skill.errors %}{{ e }}{% endfor %}</p>{% endif %}
        </div>
        <div>
            <label for="{{ form.course.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">{{ form.course.label }}</label>
            {{ form.course }}
            <p class="mt-1 text-[11px] text-slate-500">Only students enrolled in this course will see the assignment.</p>
            {% if form.course.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.course.errors %}{{ e }}{% endfor %}</p>{% endif %}
        </div>
        <div>
            <label for="{{ form.due_at.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">{{ form.due_at.label }}</label>
            {{ form.due_at }}
            {% if form.due_at.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in form.due_at.errors %}{{ e }}{% endfor %}</p>{% endif %}
        </div>
        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            {{ form.is_published }}
            {{ form.is_published.label }}
        </label>
        {% if form.is_published.errors %}<p class="text-sm text-rose-600">{% for e in form.is_published.errors %}{{ e }}{% endfor %}</p>{% endif %}

        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            {{ form.is_free_preview }}
            {{ form.is_free_preview.label }}
        </label>
        <p class="text-xs text-slate-500">Shown to any student who requests a free preview on this course's catalog page. Requires a lecture recording above.</p>
        {% if form.is_free_preview.errors %}<p class="text-sm text-rose-600">{% for e in form.is_free_preview.errors %}{{ e }}{% endfor %}</p>{% endif %}

        {% if form.non_field_errors() %}
        <p class="text-sm text-rose-600">{% for e in form.non_field_errors() %}{{ e }}{% endfor %}</p>
        {% endif %}
        <div class="flex flex-wrap gap-2 pt-2">
            <button type="submit" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">
                {% if is_edit %}Save changes{% else %}Publish{% endif %}
            </button>
            {% if is_edit and assignment %}
            <a href="{{ url('lms:assignment_detail', pk=assignment.pk) }}" class="rounded-xl border border-slate-200 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">Back to assignment</a>
            {% else %}
            <a href="{{ url('lms:home') }}" class="rounded-xl border border-slate-200 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50">Cancel</a>
            {% endif %}
        </div>
    </form>
</div>
{% endblock %}
