{% extends "base.jinja" %}
{% block title %}LMS Batches · RankJee{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-600">Staff</p>
            <h1 class="text-2xl font-black tracking-tight text-slate-900">LMS Batches</h1>
        </div>
        <a href="{{ url('lms:home') }}" class="text-xs font-black uppercase tracking-wider text-indigo-600 hover:underline">← LMS home</a>
    </div>

    <form method="post" class="mb-8 flex flex-wrap items-end gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="create_batch">
        <div class="min-w-[12rem] flex-1">
            <label class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">New batch name</label>
            {{ batch_form.name }}
        </div>
        <label class="flex items-center gap-2 text-xs font-bold text-slate-700 pb-2">
            {{ batch_form.is_active }} Active
        </label>
        <button type="submit" class="rounded-xl bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">Add batch</button>
    </form>

    <div class="space-y-4">
        {% for b in batches %}
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="text-sm font-black text-slate-900">{{ b.name }}
                    {% if not b.is_active %}<span class="ml-2 text-[10px] font-black uppercase text-rose-600">Inactive</span>{% endif %}
                </h2>
                <span class="text-[11px] font-bold text-slate-500">{{ b.memberships.all()|length }} students</span>
            </div>
            <ul class="mb-3 space-y-1">
                {% for m in b.memberships.all() %}
                <li class="flex items-center justify-between gap-2 rounded-lg bg-slate-50 px-3 py-1.5 text-xs">
                    <span class="font-bold text-slate-800">{{ m.user.get_username() }}</span>
                    <form method="post" class="inline">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <input type="hidden" name="action" value="remove_member">
                        <input type="hidden" name="batch_id" value="{{ b.pk }}">
                        <input type="hidden" name="membership_id" value="{{ m.pk }}">
                        <button type="submit" class="font-black uppercase tracking-wider text-rose-600 hover:underline">Remove</button>
                    </form>
                </li>
                {% else %}
                <li class="text-xs text-slate-400">No members yet.</li>
                {% endfor %}
            </ul>
            <form method="post" class="flex flex-wrap gap-2">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="add_member">
                <input type="hidden" name="batch_id" value="{{ b.pk }}">
                {{ member_form.username }}
                <button type="submit" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-[11px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Add student</button>
            </form>
        </section>
        {% else %}
        <p class="text-sm text-slate-500">No batches yet — create one above (optional; assignments can target all students).</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
