{% extends "base.jinja" %}
{% block title %}{{ topic.title }} · LMS{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6">
    {% include "partials/_breadcrumb.jinja" %}

    <header class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900">{{ topic.title }}</h1>
                {% if topic.course %}
                <span class="mt-1 inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-black uppercase tracking-wide text-indigo-700">{{ topic.course.name }}</span>
                {% endif %}
                {% if topic.description %}
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{{ topic.description }}</p>
                {% endif %}
            </div>
            {% if is_staff_lms or can_manage_topics %}
            <div class="flex gap-2">
                {% if can_manage_topics %}
                <a href="{{ url('lms:topic_edit', pk=topic.pk) }}" class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">Edit topic</a>
                {% endif %}
                {% if is_staff_lms %}
                <a href="{{ url('lms:assignment_create') }}?topic={{ topic.pk }}" class="rounded-xl bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">New assignment</a>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </header>

    <section>
        <h2 class="mb-3 text-xs font-black uppercase tracking-widest text-slate-500">Assignments</h2>
        {% if assignments %}
        <div class="grid gap-3 sm:grid-cols-2">
            {% for a in assignments %}
            <div class="relative rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                {% if is_staff_lms %}
                <a href="{{ url('lms:assignment_edit', pk=a.pk) }}" class="absolute right-3 top-3 rounded-md border border-slate-200 bg-white px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-slate-500 hover:bg-slate-50">Edit</a>
                {% endif %}
                <a href="{{ url('lms:assignment_detail', pk=a.pk) }}" class="block">
                    <p class="pr-12 text-sm font-black text-slate-900">{{ a.title }}</p>
                    <p class="mt-1 line-clamp-2 text-xs text-slate-500">{{ a.instructions or 'No instructions' }}</p>
                    <div class="mt-3 flex flex-wrap gap-2 text-[10px] font-black uppercase tracking-wider">
                        {% if a.course %}
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">{{ a.course.name }}</span>
                        {% else %}
                        <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-indigo-700">All students</span>
                        {% endif %}
                        {% if a.due_at %}
                        <span class="rounded-full bg-amber-50 px-2 py-0.5 text-amber-800">Due {{ a.due_at.strftime('%d %b %H:%M') }}</span>
                        {% endif %}
                        {% if not a.is_published %}
                        <span class="rounded-full bg-rose-50 px-2 py-0.5 text-rose-700">Draft</span>
                        {% endif %}
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500">
            No assignments in this topic yet.
        </p>
        {% endif %}
    </section>
</div>
{% endblock %}
