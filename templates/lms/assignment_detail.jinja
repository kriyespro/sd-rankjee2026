{% extends "base.jinja" %}
{% block title %}{{ assignment.title }} · LMS{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-2xl px-4 py-6 sm:px-6">
    <nav class="mb-4 text-xs font-bold text-slate-500">
        <a href="{{ url('lms:home') }}" class="text-indigo-600 hover:underline">LMS</a>
        {% if assignment.topic %}
        <span class="mx-1.5">/</span>
        <a href="{{ url('lms:topic_detail', pk=assignment.topic.pk) }}" class="text-indigo-600 hover:underline">{{ assignment.topic.title }}</a>
        {% endif %}
        <span class="mx-1.5">/</span>
        <span class="text-slate-800">{{ assignment.title }}</span>
    </nav>

    <header class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <h1 class="text-xl font-black tracking-tight text-slate-900">{{ assignment.title }}</h1>
            {% if is_staff_lms %}
            <a href="{{ url('lms:assignment_edit', pk=assignment.pk) }}"
               class="shrink-0 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50">
                Edit assignment
            </a>
            {% endif %}
        </div>
        {% if assignment.instructions %}
        <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-700">{{ assignment.instructions }}</p>
        {% endif %}
        <div class="mt-3 flex flex-wrap gap-2 text-[10px] font-black uppercase tracking-wider">
            {% if assignment.topic %}
            <span class="rounded-full bg-violet-50 px-2 py-0.5 text-violet-700">{{ assignment.topic.title }}</span>
            {% endif %}
            {% if assignment.batch %}
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">{{ assignment.batch.name }}</span>
            {% else %}
            <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-indigo-700">All students</span>
            {% endif %}
            {% if assignment.due_at %}
            <span class="rounded-full {% if past_due %}bg-rose-50 text-rose-700{% else %}bg-amber-50 text-amber-800{% endif %} px-2 py-0.5">
                Due {{ assignment.due_at.strftime('%d %b %Y %H:%M') }}{% if past_due %} · closed{% endif %}
            </span>
            {% endif %}
            {% if not assignment.is_published %}
            <span class="rounded-full bg-rose-50 px-2 py-0.5 text-rose-700">Draft</span>
            {% endif %}
        </div>
    </header>

    {% if show_submit_form and submit_form %}
    <section class="mb-6 rounded-2xl border border-indigo-100 bg-indigo-50/40 p-5">
        <h2 class="text-xs font-black uppercase tracking-widest text-indigo-800 mb-3">
            {% if my_sub %}Update your submission{% else %}Submit your work{% endif %}
        </h2>
        <form method="post" class="space-y-3"
              x-data="{
                  rows: {{ url_rows_json }},
                  addRow() { this.rows.push({ url: '', kind: 'DRIVE' }); },
                  removeRow(i) { if (this.rows.length > 1) this.rows.splice(i, 1); }
              }">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="submit">
            <div>
                <label for="{{ submit_form.caption.id_for_label }}" class="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">Caption <span class="font-semibold normal-case text-slate-400">(optional)</span></label>
                {{ submit_form.caption }}
                {% if submit_form.caption.errors %}<p class="mt-1 text-sm text-rose-600">{% for e in submit_form.caption.errors %}{{ e }}{% endfor %}</p>{% endif %}
            </div>
            <div>
                <div class="mb-2 flex items-center justify-between gap-2">
                    <p class="text-xs font-black uppercase tracking-wider text-slate-500">Links</p>
                    <button type="button" @click="addRow()"
                            class="rounded-lg border border-indigo-200 bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-indigo-700 hover:bg-indigo-50">
                        + Add link
                    </button>
                </div>
                <div class="space-y-2">
                    <template x-for="(row, index) in rows" :key="index">
                        <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-white p-3 sm:flex-row sm:items-center">
                            <select :name="'url_kind_' + index" x-model="row.kind"
                                    class="w-full sm:w-36 rounded-lg border border-slate-200 px-2 py-2 text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500">
                                <option value="DRIVE">Google Drive</option>
                                <option value="WEBSITE">Website</option>
                            </select>
                            <input type="url" :name="'url_' + index" x-model="row.url" required
                                   placeholder="https://drive.google.com/… or https://yoursite.com"
                                   class="flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <button type="button" @click="removeRow(index)" x-show="rows.length > 1"
                                    class="self-end rounded-lg px-2 py-1 text-[10px] font-black uppercase tracking-wider text-rose-600 hover:bg-rose-50 sm:self-center">
                                Remove
                            </button>
                        </div>
                    </template>
                </div>
                <p class="mt-2 text-[11px] leading-relaxed text-slate-500">Add one or more Google Drive file links and/or website URLs.</p>
            </div>
            {% if submit_form.non_field_errors() %}
            <p class="text-sm text-rose-600">{% for e in submit_form.non_field_errors() %}{{ e }}{% endfor %}</p>
            {% endif %}
            <button type="submit" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">
                {% if my_sub %}Save changes{% else %}Post to feed{% endif %}
            </button>
        </form>
    </section>
    {% elif past_due and not my_sub %}
    <p class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-bold text-amber-900">Deadline passed — submissions closed.</p>
    {% endif %}

    <h2 class="mb-3 text-xs font-black uppercase tracking-widest text-slate-500">Class feed</h2>
    <div class="space-y-4" id="lms-feed">
        {% for s in feed %}
        {% include "lms/partials/_submission_card.jinja" %}
        {% else %}
        <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-10 text-center text-sm text-slate-500">
            No submissions yet. Be the first to post.
        </p>
        {% endfor %}
    </div>
</div>
{% endblock %}
