{% extends "base.jinja" %}
{% block title %}Assign students - LMS Admin{% endblock %}

{% block content %}
<div class="mx-auto max-w-4xl px-4 pb-12 pt-8 sm:px-6">
    {% set crumbs = [{'label': 'Dashboard', 'url': url('dashboard:index')}, {'label': 'LMS', 'url': url('lms:courses')}, {'label': 'Assign students'}] %}
    {% include "partials/_breadcrumb.jinja" %}
    <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900">Assign students</h1>
    <p class="mt-1 mb-6 text-sm text-slate-600">Pick any student, see every course (and faculty) they're in, and add or remove them from any course — one screen.</p>

    <form method="get" class="mb-6 flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row sm:items-end">
        <div class="min-w-[220px] flex-1">
            <label class="mb-1 block text-[11px] font-black uppercase tracking-widest text-slate-400">Search student</label>
            <input type="text" name="q" value="{{ q }}" placeholder="Username or email…"
                   class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
        </div>
        <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500">Search</button>
    </form>

    {% if q %}
    <div class="mb-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-4 py-2.5">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">{{ matches|length }} match{{ 'es' if matches|length != 1 else '' }}</p>
        </div>
        <div class="divide-y divide-slate-100">
            {% for m in matches %}
            <a href="?q={{ q|urlencode }}&student_id={{ m.id }}"
               class="flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-slate-50 {{ 'bg-indigo-50' if selected_student and selected_student.id == m.id }}">
                <div class="min-w-0">
                    <p class="text-sm font-black text-slate-900 truncate">@{{ m.username }}</p>
                    <p class="text-[11px] text-slate-500 truncate">{{ m.email }}{% if m.level %} · {{ m.level.name }}{% elif m.class_level %} · Class {{ m.class_level }}{% endif %}</p>
                </div>
                <span class="shrink-0 text-[10px] font-black uppercase tracking-wider text-indigo-600">Manage →</span>
            </a>
            {% else %}
            <p class="px-4 py-8 text-center text-xs font-bold text-slate-400">No students match "{{ q }}".</p>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if selected_student %}
    <div class="overflow-hidden rounded-xl border border-indigo-200 bg-white shadow-sm">
        <div class="border-b border-indigo-100 bg-indigo-50/50 px-4 py-3">
            <p class="text-[10px] font-black uppercase tracking-widest text-indigo-700">Managing</p>
            <p class="text-base font-black text-slate-900">@{{ selected_student.username }} <span class="font-semibold text-slate-500">— {{ selected_student.email }}</span></p>
        </div>

        <div class="border-b border-slate-100 px-4 py-4">
            <p class="mb-2 text-[10px] font-black uppercase tracking-widest text-slate-500">Currently enrolled in</p>
            {% if enrollments %}
            <div class="space-y-2">
                {% for e in enrollments %}
                <div class="flex items-center justify-between gap-3 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2">
                    <div class="min-w-0">
                        <p class="text-xs font-black text-slate-900 truncate">{{ e.course.name }}</p>
                        <p class="text-[10px] text-slate-500 truncate">
                            {% if e.course.owner %}Faculty: {{ e.course.owner.get_full_name() or e.course.owner.username }}{% else %}No faculty assigned{% endif %}
                            {% if e.course.level %} · {{ e.course.level.name }}{% endif %}
                        </p>
                    </div>
                    <form method="post" class="shrink-0">
                        {{ csrf_input }}
                        <input type="hidden" name="action" value="unenroll">
                        <input type="hidden" name="student_id" value="{{ selected_student.id }}">
                        <input type="hidden" name="enrollment_id" value="{{ e.id }}">
                        <button type="submit" class="rounded-md border border-rose-200 bg-rose-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-rose-700 hover:bg-rose-100">Remove</button>
                    </form>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-xs font-bold text-slate-400">Not enrolled in any course yet.</p>
            {% endif %}
        </div>

        <div class="px-4 py-4">
            <p class="mb-2 text-[10px] font-black uppercase tracking-widest text-slate-500">Add to a course</p>
            <form method="post" class="flex flex-col gap-2 sm:flex-row sm:items-end">
                {{ csrf_input }}
                <input type="hidden" name="action" value="enroll">
                <input type="hidden" name="student_id" value="{{ selected_student.id }}">
                <div class="min-w-[240px] flex-1">
                    <select name="course_id" required class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
                        <option value="">Pick any course…</option>
                        {% for c in all_courses %}
                        <option value="{{ c.id }}" {% if c.id in enrolled_course_ids %}disabled{% endif %}>
                            {{ c.name }}{% if c.owner %} · {{ c.owner.get_full_name() or c.owner.username }}{% else %} · No faculty{% endif %}{% if c.level %} · {{ c.level.name }}{% endif %}{% if c.id in enrolled_course_ids %} (already enrolled){% endif %}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-indigo-500 whitespace-nowrap">Add →</button>
            </form>
        </div>
    </div>
    {% elif not q %}
    <p class="rounded-xl border border-dashed border-slate-200 px-4 py-8 text-center text-xs font-bold text-slate-400">Search for a student above to manage their course assignments.</p>
    {% endif %}
</div>
{% endblock %}
