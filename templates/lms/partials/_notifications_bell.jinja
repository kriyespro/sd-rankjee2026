{# Expects: lms_notify, student_name (optional — falls back to username) #}
{% set greet_name = (student_name or request.user.first_name or request.user.username)|title %}

<div class="flex min-w-0 max-w-full items-start gap-2.5 sm:gap-3" x-data="{ open: false }">
    <div class="relative shrink-0">
        <button type="button"
                @click="open = !open"
                class="relative inline-flex h-9 w-9 items-center justify-center rounded-full border transition
                       {% if lms_notify.unread_count %}border-indigo-200 bg-indigo-50 text-indigo-600 shadow-sm{% else %}border-slate-200 bg-white text-slate-500 hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-600{% endif %}"
                :aria-expanded="open"
                aria-label="LMS notifications">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
            {% if lms_notify.unread_count %}
            <span class="absolute -right-1 -top-1 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-rose-500 px-1 text-[9px] font-black leading-none text-white ring-2 ring-white">
                {% if lms_notify.unread_count > 99 %}99+{% elif lms_notify.unread_count > 9 %}9+{% else %}{{ lms_notify.unread_count }}{% endif %}
            </span>
            {% endif %}
        </button>

        <div x-show="open"
             x-cloak
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 translate-y-1 scale-[0.98]"
             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
             @click.outside="open = false"
             @keydown.escape.window="open = false"
             class="absolute left-0 top-full z-[60] mt-2 w-[min(100vw-2rem,24rem)] overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-2xl ring-1 ring-black/5 sm:left-0">
            <div class="bg-gradient-to-r from-indigo-600 to-violet-600 px-4 py-3 text-white">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                        <p class="text-sm font-black tracking-tight">Hi {{ greet_name }} 👋</p>
                        <p class="mt-0.5 text-[11px] font-medium leading-snug text-indigo-100">Your latest classroom updates</p>
                    </div>
                    {% if lms_notify.unread_count %}
                    <span class="shrink-0 rounded-full bg-white/20 px-2.5 py-1 text-[10px] font-black text-white backdrop-blur-sm">
                        {{ lms_notify.unread_count }} new
                    </span>
                    {% endif %}
                </div>
            </div>

            {% if lms_notify.notifications %}
            <div class="max-h-[min(70vh,22rem)] overflow-y-auto overscroll-contain bg-slate-50/40 p-2">
                {% if lms_notify.own_work %}
                <div class="mb-2">
                    <p class="px-2 py-1.5 text-[9px] font-black uppercase tracking-[0.18em] text-slate-400">On your work</p>
                    <ul class="space-y-1">
                        {% for note in lms_notify.own_work %}
                        <li>
                            <a href="{% if note.notification_id %}{{ url('lms:notification_read', note_id=note.notification_id) }}{% else %}{{ note.link }}{% endif %}"
                               @click="open = false"
                               class="flex gap-3 rounded-xl border px-3 py-2.5 transition
                                      {% if not note.is_read %}border-indigo-200 bg-white shadow-sm{% else %}border-transparent bg-white/80 hover:border-slate-200 hover:bg-white{% endif %}">
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-50 text-base ring-1 ring-slate-100">{{ note.icon }}</span>
                                <span class="min-w-0 flex-1">
                                    <span class="flex items-center gap-1.5">
                                        <span class="truncate text-xs font-black text-slate-900">{{ note.title }}</span>
                                        {% if not note.is_read %}<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-500"></span>{% endif %}
                                    </span>
                                    <span class="mt-0.5 line-clamp-2 text-[11px] leading-snug text-slate-600">{{ note.body }}</span>
                                    <span class="mt-1 block text-[10px] font-semibold text-slate-400">{{ note.created_at.strftime('%d %b · %I:%M %p') }}</span>
                                </span>
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% if lms_notify.classroom %}
                <div>
                    <p class="px-2 py-1.5 text-[9px] font-black uppercase tracking-[0.18em] text-slate-400">New assignments</p>
                    <ul class="space-y-1">
                        {% for note in lms_notify.classroom %}
                        <li>
                            <a href="{% if note.notification_id %}{{ url('lms:notification_read', note_id=note.notification_id) }}{% else %}{{ note.link }}{% endif %}"
                               @click="open = false"
                               class="flex gap-3 rounded-xl border px-3 py-2.5 transition
                                      {% if not note.is_read %}border-violet-200 bg-white shadow-sm{% else %}border-transparent bg-white/80 hover:border-slate-200 hover:bg-white{% endif %}">
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-50 text-base ring-1 ring-slate-100">{{ note.icon }}</span>
                                <span class="min-w-0 flex-1">
                                    <span class="flex items-center gap-1.5">
                                        <span class="truncate text-xs font-black text-slate-900">{{ note.title }}</span>
                                        {% if not note.is_read %}<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500"></span>{% endif %}
                                    </span>
                                    <span class="mt-0.5 line-clamp-2 text-[11px] leading-snug text-slate-600">{{ note.body }}</span>
                                    <span class="mt-1 block text-[10px] font-semibold text-slate-400">{{ note.created_at.strftime('%d %b · %I:%M %p') }}</span>
                                </span>
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
            {% else %}
            <div class="bg-white px-4 py-8 text-center">
                <p class="text-3xl">🔔</p>
                <p class="mt-2 text-sm font-bold text-slate-800">You're all caught up</p>
                <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Marks, remarks, reviews, comments, likes &amp; new assignments will show up here.</p>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="min-w-0 flex-1 pt-0.5">
        <p class="text-sm font-black leading-tight text-slate-900">
            How are you, <span class="text-indigo-600">{{ greet_name }}</span>?
        </p>
        <button type="button"
                @click="open = !open"
                class="mt-0.5 text-left text-[11px] font-semibold leading-snug text-slate-500 transition hover:text-indigo-600">
            Check notifications for the latest updates
            {% if lms_notify.unread_count %}
            <span class="text-rose-600">· {{ lms_notify.unread_count }} new</span>
            {% endif %}
        </button>
    </div>
</div>
