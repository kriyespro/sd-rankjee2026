{# Expects: lms_notify, student_name (optional — falls back to username) #}
{% set greet_name = (student_name or request.user.first_name or request.user.username)|title %}

<div class="flex min-w-0 max-w-full items-start gap-2.5 sm:gap-3"
     x-data="{
         open: false,
         checked: {},
         markAndGo(event, id, href) {
             if (id) {
                 const nid = parseInt(id, 10);
                 this.checked[nid] = true;
                 fetch('/admin/lms/notifications/' + nid + '/read/?ajax=1', {
                     headers: { 'X-Requested-With': 'XMLHttpRequest' }
                 }).catch(() => {});
             }
             if (href) {
                 setTimeout(() => { window.location.href = href; }, 120);
             }
             event.preventDefault();
         }
     }">
    {# Mobile backdrop #}
    <div x-show="open"
         x-cloak
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         @click="open = false"
         class="fixed inset-0 z-[65] bg-slate-900/30 sm:hidden"
         aria-hidden="true"></div>

    <div class="relative shrink-0">
        <button type="button"
                @click="open = !open"
                class="relative inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full border transition
                       {% if lms_notify.unread_count %}border-indigo-200 bg-indigo-50 text-indigo-600 shadow-sm{% else %}border-slate-200 bg-white text-slate-500 hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-600{% endif %}"
                :aria-expanded="open"
                aria-label="LMS notifications">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
            {% if lms_notify.unread_count %}
            <span class="absolute right-0 top-0 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-rose-500 px-0.5 text-[8px] font-black leading-none text-white ring-2 ring-white">
                {% if lms_notify.unread_count > 99 %}99+{% elif lms_notify.unread_count > 9 %}9+{% else %}{{ lms_notify.unread_count }}{% endif %}
            </span>
            {% endif %}
        </button>

        <div x-show="open"
             x-cloak
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 translate-y-1 scale-[0.98]"
             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
             @click.outside="open = false"
             @keydown.escape.window="open = false"
             class="fixed inset-x-3 top-[4.25rem] z-[70] mx-auto max-h-[min(70vh,18rem)] w-auto overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-2xl ring-1 ring-black/5
                    sm:absolute sm:inset-x-auto sm:left-0 sm:right-auto sm:top-full sm:mt-1.5 sm:max-h-none sm:w-[28rem]">
            <div class="bg-gradient-to-r from-indigo-600 to-violet-600 px-3 py-2 text-white">
                <div class="flex items-center justify-between gap-2">
                    <div class="min-w-0">
                        <p class="text-xs font-black tracking-tight">Hi {{ greet_name }} 👋</p>
                        <p class="text-[10px] leading-tight text-indigo-100">Latest updates</p>
                    </div>
                    {% if lms_notify.unread_count %}
                    <span class="shrink-0 rounded-full bg-white/20 px-2 py-0.5 text-[9px] font-black text-white">
                        {{ lms_notify.unread_count }} new
                    </span>
                    {% endif %}
                </div>
            </div>

            {% if lms_notify.notifications %}
            <div class="max-h-[min(50vh,14rem)] overflow-y-auto overscroll-contain bg-slate-50/50 p-1.5 sm:max-h-[14rem]">
                {% if lms_notify.own_work %}
                <div class="mb-1.5">
                    <p class="px-1.5 py-1 text-[8px] font-black uppercase tracking-[0.16em] text-slate-400">On your work</p>
                    <ul class="space-y-1">
                        {% for note in lms_notify.own_work %}
                        {% set note_href = note.notification_id and url('lms:notification_read', note_id=note.notification_id) or note.link %}
                        <li>
                            <a href="{{ note_href }}"
                               {% if note.notification_id %}
                               data-note-id="{{ note.notification_id }}"
                               data-note-link="{{ note.link or note_href }}"
                               @click="markAndGo($event, $el.dataset.noteId, $el.dataset.noteLink)"
                               {% else %}
                               @click="open = false"
                               {% endif %}
                               class="flex min-h-[44px] gap-2 rounded-lg border px-2 py-2 transition
                                      {% if not note.is_read %}border-indigo-200 bg-white{% else %}border-transparent bg-white/90 hover:border-slate-200{% endif %}"
                               {% if note.notification_id %}:class="checked[{{ note.notification_id }}] ? 'border-transparent bg-white/90' : ''"{% endif %}>
                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-50 text-xs ring-1 ring-slate-100">{{ note.icon }}</span>
                                <span class="min-w-0 flex-1">
                                    <span class="flex items-center gap-1">
                                        <span class="truncate text-[10px] font-black text-slate-900">{{ note.title }}</span>
                                        {% if not note.is_read %}
                                        <span class="h-1 w-1 shrink-0 rounded-full bg-indigo-500"
                                              {% if note.notification_id %}x-show="!checked[{{ note.notification_id }}]"{% endif %}></span>
                                        {% endif %}
                                        <span class="ml-auto shrink-0 text-[9px] text-slate-400">{{ note.created_at.strftime('%d %b · %I:%M %p') }}</span>
                                    </span>
                                    {% if not note.is_read %}
                                    <span class="mt-0.5 line-clamp-1 text-[9px] leading-snug text-slate-600"
                                          {% if note.notification_id %}x-show="!checked[{{ note.notification_id }}]"{% endif %}>
                                        {{ note.body }}
                                    </span>
                                    {% endif %}
                                    <span class="mt-0.5 hidden text-[8px] font-bold uppercase text-emerald-600"
                                          {% if note.notification_id %}x-show="checked[{{ note.notification_id }}]"{% endif %}>
                                        ✓ Opening…
                                    </span>
                                </span>
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% if lms_notify.classroom %}
                <div>
                    <p class="px-1.5 py-1 text-[8px] font-black uppercase tracking-[0.16em] text-slate-400">New assignments</p>
                    <ul class="space-y-1">
                        {% for note in lms_notify.classroom %}
                        {% set note_href = note.notification_id and url('lms:notification_read', note_id=note.notification_id) or note.link %}
                        <li>
                            <a href="{{ note_href }}"
                               {% if note.notification_id %}
                               data-note-id="{{ note.notification_id }}"
                               data-note-link="{{ note.link or note_href }}"
                               @click="markAndGo($event, $el.dataset.noteId, $el.dataset.noteLink)"
                               {% else %}
                               @click="open = false"
                               {% endif %}
                               class="flex min-h-[44px] gap-2 rounded-lg border px-2 py-2 transition
                                      {% if not note.is_read %}border-violet-200 bg-white{% else %}border-transparent bg-white/90 hover:border-slate-200{% endif %}"
                               {% if note.notification_id %}:class="checked[{{ note.notification_id }}] ? 'border-transparent bg-white/90' : ''"{% endif %}>
                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-50 text-xs ring-1 ring-slate-100">{{ note.icon }}</span>
                                <span class="min-w-0 flex-1">
                                    <span class="flex items-center gap-1">
                                        <span class="truncate text-[10px] font-black text-slate-900">{{ note.title }}</span>
                                        {% if not note.is_read %}
                                        <span class="h-1 w-1 shrink-0 rounded-full bg-violet-500"
                                              {% if note.notification_id %}x-show="!checked[{{ note.notification_id }}]"{% endif %}></span>
                                        {% endif %}
                                        <span class="ml-auto shrink-0 text-[9px] text-slate-400">{{ note.created_at.strftime('%d %b · %I:%M %p') }}</span>
                                    </span>
                                    {% if not note.is_read %}
                                    <span class="mt-0.5 line-clamp-1 text-[9px] leading-snug text-slate-600"
                                          {% if note.notification_id %}x-show="!checked[{{ note.notification_id }}]"{% endif %}>
                                        {{ note.body }}
                                    </span>
                                    {% endif %}
                                    <span class="mt-0.5 hidden text-[8px] font-bold uppercase text-emerald-600"
                                          {% if note.notification_id %}x-show="checked[{{ note.notification_id }}]"{% endif %}>
                                        ✓ Opening…
                                    </span>
                                </span>
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
            {% else %}
            <div class="bg-white px-3 py-5 text-center">
                <p class="text-xl">🔔</p>
                <p class="mt-1 text-[11px] font-bold text-slate-800">All caught up</p>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="min-w-0 flex-1 pt-1 sm:pt-0.5">
        <p class="text-xs font-black leading-tight text-slate-900">
            How are you, <span class="text-indigo-600">{{ greet_name }}</span>?
        </p>
        <button type="button"
                @click="open = !open"
                class="mt-1 min-h-[44px] text-left text-[10px] font-semibold leading-snug text-slate-500 transition hover:text-indigo-600 sm:mt-0.5 sm:min-h-0">
            Check notifications for updates
            {% if lms_notify.unread_count %}
            <span class="text-rose-600">· {{ lms_notify.unread_count }} new</span>
            {% endif %}
        </button>
    </div>
</div>
