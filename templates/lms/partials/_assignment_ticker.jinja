{# Expects: ticker_items — list of {kind, badge, label, url}; optional inline=true #}
{% if ticker_items %}
{% set _inline = inline|default(false) %}
<style>
@keyframes lms-ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
.lms-ticker-track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: max-content;
    gap: 0.5rem;
    animation: lms-ticker-scroll 32s linear infinite;
}
.lms-ticker-track:hover { animation-play-state: paused; }
@media (prefers-reduced-motion: reduce) {
    .lms-ticker-track { animation: none; }
    .lms-ticker-track .lms-ticker-clone { display: none; }
}
</style>
{% if _inline %}
<div class="relative min-w-0 flex-1 overflow-hidden py-0.5" role="region" aria-label="Assignment updates">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-4 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-4 bg-gradient-to-l from-white to-transparent"></div>
    <div class="lms-ticker-track">
        {% for item in ticker_items %}
        <a href="{{ item.url }}"
           class="inline-flex shrink-0 items-center gap-1 rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-slate-800 transition hover:border-indigo-200 hover:bg-indigo-50">
            <span class="inline-flex shrink-0 rounded-full px-1.5 py-px text-[8px] font-black uppercase
                {% if item.kind == 'pending' %}bg-amber-100 text-amber-800
                {% elif item.kind == 'review' %}bg-rose-100 text-rose-700
                {% else %}bg-emerald-100 text-emerald-800{% endif %}">{{ item.badge }}</span>
            <span class="max-w-[9rem] truncate text-[10px] font-semibold">{{ item.label }}</span>
        </a>
        {% endfor %}
        {% for item in ticker_items %}
        <a href="{{ item.url }}" tabindex="-1" aria-hidden="true"
           class="lms-ticker-clone inline-flex shrink-0 items-center gap-1 rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-slate-800">
            <span class="inline-flex shrink-0 rounded-full px-1.5 py-px text-[8px] font-black uppercase
                {% if item.kind == 'pending' %}bg-amber-100 text-amber-800
                {% elif item.kind == 'review' %}bg-rose-100 text-rose-700
                {% else %}bg-emerald-100 text-emerald-800{% endif %}">{{ item.badge }}</span>
            <span class="max-w-[9rem] truncate text-[10px] font-semibold">{{ item.label }}</span>
        </a>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="flex min-w-0 items-center overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
     role="region"
     aria-label="Assignment updates">
    <div class="flex shrink-0 items-center gap-2 self-stretch border-r border-slate-100 bg-slate-50 px-3 py-2.5">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-white" aria-hidden="true">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
        </span>
        <div class="hidden sm:block leading-tight">
            <p class="text-[10px] font-black uppercase tracking-wider text-slate-500">Updates</p>
            <p class="text-[11px] font-bold text-slate-800">Your assignments</p>
        </div>
    </div>
    <div class="relative min-w-0 flex-1 overflow-hidden py-2.5">
        <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-6 bg-gradient-to-r from-white to-transparent"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-6 bg-gradient-to-l from-white to-transparent"></div>
        <div class="lms-ticker-track px-4">
            {% for item in ticker_items %}
            <a href="{{ item.url }}"
               class="inline-flex shrink-0 items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-800 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-800">
                <span class="inline-flex shrink-0 rounded-full px-2 py-0.5 text-[9px] font-black uppercase tracking-wide
                    {% if item.kind == 'pending' %}bg-amber-100 text-amber-800
                    {% elif item.kind == 'review' %}bg-rose-100 text-rose-700
                    {% else %}bg-emerald-100 text-emerald-800{% endif %}">{{ item.badge }}</span>
                <span class="max-w-[14rem] truncate text-xs font-semibold">{{ item.label }}</span>
            </a>
            {% endfor %}
            {% for item in ticker_items %}
            <a href="{{ item.url }}" tabindex="-1" aria-hidden="true"
               class="lms-ticker-clone inline-flex shrink-0 items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-800 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-800">
                <span class="inline-flex shrink-0 rounded-full px-2 py-0.5 text-[9px] font-black uppercase tracking-wide
                    {% if item.kind == 'pending' %}bg-amber-100 text-amber-800
                    {% elif item.kind == 'review' %}bg-rose-100 text-rose-700
                    {% else %}bg-emerald-100 text-emerald-800{% endif %}">{{ item.badge }}</span>
                <span class="max-w-[14rem] truncate text-xs font-semibold">{{ item.label }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}
{% endif %}
