{% extends "base.jinja" %}
{% block title %}Daily Scholarship Jackpot - RankJee{% endblock %}

{% block extra_head %}
<style>
    .jackpot-gradient {
        background: radial-gradient(circle at top right, #4f46e5, #7c3aed, #020617);
    }
    .timer-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>
{% endblock %}

{% block content %}
<div class="jackpot-gradient min-h-screen text-white py-12 px-4 pb-32">
    <div class="max-w-4xl mx-auto">
        
        {% if no_jackpot %}
        <div class="text-center py-20">
            <div class="text-6xl mb-6">🏜️</div>
            <h2 class="text-3xl font-black mb-4">No Active Jackpot</h2>
            <p class="text-slate-400 max-w-md mx-auto">We're refilling the prize pool! Check back shortly for the next scheduled scholarship event.</p>
            <a href="{{ url('assessment:index') }}" class="inline-block mt-8 bg-white text-slate-900 px-8 py-3 rounded-xl font-black uppercase text-xs tracking-widest hover:bg-indigo-50 transition-all">Back to Catalog</a>
        </div>
        {% else %}

        <!-- Jackpot Header -->
        <div class="text-center mb-12">
            <div class="inline-flex items-center gap-2 bg-indigo-500/20 border border-indigo-400/30 rounded-full px-4 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-indigo-300 mb-6">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Daily Elite Event
            </div>
            <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-4 leading-tight">
                ₹{{ jackpot.prize_pool|int }} Scholarship <br>
                <span class="text-indigo-400">Daily Jackpot.</span>
            </h1>
            <p class="text-slate-400 font-medium max-w-xl mx-auto">Rank in the Top 10 for the <strong>{{ jackpot.skill.name }}</strong> test to win 100% real cash prizes.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <!-- Left: Countdown/Action -->
            <div class="timer-card rounded-[2.5rem] p-8 md:p-12 text-center relative overflow-hidden">
                <div x-data="{ 
                    timeLeft: {{ time_to_go }},
                    isLive: {{ 'true' if is_live else 'false' }},
                    formatTime(s) {
                        const h = Math.floor(s / 3600);
                        const m = Math.floor((s % 3600) / 60);
                        const sec = s % 60;
                        return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
                    }
                }" x-init="if(!isLive) setInterval(() => { if(timeLeft > 0) timeLeft--; else isLive = true; }, 1000)">
                    
                    <template x-if="!isLive">
                        <div>
                            <p class="text-xs font-black text-indigo-400 uppercase tracking-[0.3em] mb-6">Next Event Starts In</p>
                            <div class="text-6xl md:text-7xl font-black tracking-tighter mb-10 tabular-nums" x-text="formatTime(timeLeft)"></div>
                            <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-xs font-bold text-slate-400">
                                Event live today at {{ jackpot.scheduled_time.strftime('%I:%M %p') }}
                            </div>
                        </div>
                    </template>

                    <template x-if="isLive">
                        <div>
                            <div class="w-24 h-24 bg-emerald-500/20 rounded-full flex items-center justify-center text-5xl mx-auto mb-6 border-2 border-emerald-500/30 shadow-2xl shadow-emerald-500/20 animate-bounce">🔥</div>
                            <h3 class="text-2xl font-black mb-2">The Quiz is LIVE!</h3>
                            <p class="text-slate-400 text-sm mb-10">You have 60 minutes to submit your best score.</p>
                            
                            {% if already_played %}
                                <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 p-6 rounded-2xl text-sm font-bold">
                                    ✅ Participation recorded! Wait for the leaderboard to settle at {{ (jackpot.scheduled_time + timedelta(hours=1)).strftime('%I:%M %p') }}
                                </div>
                            {% else %}
                                <a href="{{ url('assessment:take_test', jackpot.skill.id) }}" 
                                   class="block w-full bg-white text-slate-900 py-5 rounded-2xl font-black uppercase text-sm tracking-[0.2em] hover:bg-indigo-50 transition-all shadow-2xl shadow-white/10 active:scale-95">
                                    Enter Arena Now
                                </a>
                            {% endif %}
                        </div>
                    </template>
                </div>
                
                <!-- Decorative background text -->
                <div class="absolute -bottom-10 -left-10 text-9xl font-black text-white/5 pointer-events-none select-none">READY</div>
            </div>

            <!-- Right: Rules & Recent Winners -->
            <div class="space-y-6">
                <div class="bg-white/5 border border-white/10 rounded-3xl p-6">
                    <h4 class="text-xs font-black uppercase tracking-widest text-indigo-400 mb-4">Payout Structure</h4>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center py-2 border-b border-white/5">
                            <div class="flex items-center gap-3">
                                <span class="w-6 h-6 rounded-lg bg-amber-400/20 text-amber-400 flex items-center justify-center text-xs font-black">1st</span>
                                <span class="text-sm font-bold">Grand Winner</span>
                            </div>
                            <span class="text-emerald-400 font-black">₹150</span>
                        </div>
                        <div class="flex justify-between items-center py-2 border-b border-white/5">
                            <div class="flex items-center gap-3">
                                <span class="w-6 h-6 rounded-lg bg-slate-400/20 text-slate-300 flex items-center justify-center text-xs font-black">2nd</span>
                                <span class="text-sm font-bold">Elite Performer</span>
                            </div>
                            <span class="text-emerald-400 font-black">₹100</span>
                        </div>
                        <div class="flex justify-between items-center py-2 border-b border-white/5">
                            <div class="flex items-center gap-3">
                                <span class="w-6 h-6 rounded-lg bg-orange-400/20 text-orange-400 flex items-center justify-center text-xs font-black">3rd</span>
                                <span class="text-sm font-bold">Pro Contestant</span>
                            </div>
                            <span class="text-emerald-400 font-black">₹75</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="text-xs text-slate-500 font-medium">Rank 4-10</span>
                            <span class="text-emerald-400/70 font-black">₹20-₹50</span>
                        </div>
                    </div>
                </div>

                {% if recent_winners %}
                <div class="bg-white/5 border border-white/10 rounded-3xl p-6">
                    <h4 class="text-xs font-black uppercase tracking-widest text-indigo-400 mb-4">Last Event Hall of Fame</h4>
                    <div class="space-y-4">
                        {% for winner in recent_winners %}
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed={{ winner.user.username }}" loading="lazy" decoding="async" width="24" height="24" class="w-6 h-6 rounded-full bg-white/10">
                                <span class="text-xs font-bold">{{ winner.user.username|truncate(12) }}</span>
                            </div>
                            <div class="text-right">
                                <p class="text-xs font-black text-emerald-400">+₹{{ winner.award_amount|int }}</p>
                                <p class="text-xs font-bold text-slate-600">{{ winner.score }}% Score</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {% endif %}
    </div>
</div>
{% endblock %}
