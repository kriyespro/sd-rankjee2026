{% extends "base.jinja" %}
{% block title %}Skill Tests - SkillLoop{% endblock %}
{% block content %}
<div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold mb-6">Diagnostic Tests</h2>
    {% if paths %}
        {% for path in paths %}
            <div class="mt-8 mb-4 border-b pb-2">
                <h3 class="text-2xl font-bold flex items-center gap-2">
                    <span class="bg-indigo-100 text-indigo-800 text-sm py-1 px-3 rounded-full">Level {{ path.level_order }}</span>
                    {{ path.name }}
                </h3>
                {% if path.description %}
                    <p class="text-gray-500 mt-2">{{ path.description }}</p>
                {% endif %}
            </div>
            
            <div class="space-y-4">
            {% for skill in path.skills.filter(is_active=True) %}
                <div class="bg-white rounded-lg shadow p-6 flex items-center justify-between border-l-4 border-indigo-500">
                    <div>
                        <h4 class="text-xl font-semibold">{{ skill.name }}</h4>
                        <p class="text-gray-500 text-sm mt-1">{{ skill.description }}</p>
                        {% if skill.id in attempted_ids %}
                            <span class="mt-2 inline-block text-xs font-semibold bg-green-100 text-green-700 px-2 py-1 rounded">Already Attempted</span>
                        {% endif %}
                    </div>
                    <a href="{{ url('assessment:take_test', skill.id) }}"
                       class="bg-indigo-600 text-white px-5 py-2 rounded-lg font-medium hover:bg-indigo-700 transition">
                       {% if skill.id in attempted_ids %}Retest{% else %}Take Test{% endif %}
                    </a>
                </div>
            {% else %}
                <p class="text-gray-400 italic">No skills in this path yet.</p>
            {% endfor %}
            </div>
        {% endfor %}
    {% endif %}

    {% if unassigned_skills %}
        <div class="mt-10 mb-4 border-b pb-2">
            <h3 class="text-xl font-bold text-gray-700">Other Skills</h3>
        </div>
        <div class="space-y-4">
        {% for skill in unassigned_skills %}
            <div class="bg-white rounded-lg shadow p-6 flex items-center justify-between">
                <div>
                    <h4 class="text-xl font-semibold">{{ skill.name }}</h4>
                    <p class="text-gray-500 text-sm mt-1">{{ skill.description }}</p>
                    {% if skill.id in attempted_ids %}
                        <span class="mt-2 inline-block text-xs font-semibold bg-green-100 text-green-700 px-2 py-1 rounded">Already Attempted</span>
                    {% endif %}
                </div>
                <a href="{{ url('assessment:take_test', skill.id) }}"
                   class="bg-indigo-600 text-white px-5 py-2 rounded-lg font-medium hover:bg-indigo-700 transition shadow">
                   {% if skill.id in attempted_ids %}Retest{% else %}Take Test{% endif %}
                </a>
            </div>
        {% endfor %}
        </div>
    {% endif %}

    {% if not paths and not unassigned_skills %}
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500 mt-6">
            <p>No tests available yet. Check back soon!</p>
        </div>
    {% endif %}
</div>
{% endblock %}
