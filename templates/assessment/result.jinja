{% extends "base.jinja" %}
{% block title %}Test Result - RankJee{% endblock %}
{% block content %}
<div class="max-w-2xl mx-auto text-center">
    <div class="bg-white rounded-2xl shadow-lg p-10 mt-6">
        {% if passed %}
            <div class="text-6xl mb-4">🏆</div>
            <h2 class="text-3xl font-extrabold text-green-600">You Passed!</h2>
            <p class="text-gray-500 mt-2">You scored <span class="font-bold text-green-600">{{ score }}%</span> on <strong>{{ current_set.name if current_set else skill.name }}</strong>.</p>
            {% if next_set %}
                <p class="mt-4 text-gray-600">Level up! You are ready for the next set.</p>
            {% else %}
                <p class="mt-4 text-gray-600">Mastery Complete! You have finished all sets for this topic.</p>
            {% endif %}
            
            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
                {% if next_set %}
                    <a href="{{ url('assessment:take_test', skill.id) }}" class="bg-indigo-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition transform hover:-translate-y-0.5">🚀 Start Next: {{ next_set.name }}</a>
                {% elif next_skill %}
                    <a href="{{ url('learning:index') }}?skill={{ next_skill.id }}" class="bg-indigo-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition transform hover:-translate-y-0.5">🚀 Start Next Topic: {{ next_skill.name }}</a>
                {% endif %}
                <a href="{{ url('dashboard:index') }}" class="bg-white border-2 border-slate-200 text-slate-700 px-8 py-3 rounded-lg font-bold hover:bg-slate-50 transition">Go to Dashboard</a>
            </div>
        {% else %}
            <div class="text-6xl mb-4">📚</div>
            <h2 class="text-3xl font-extrabold text-indigo-700">Keep Learning!</h2>
            <p class="text-gray-500 mt-2">You scored <span class="font-bold text-red-500">{{ score }}%</span> — you need <strong>80%</strong> to pass.</p>
            {% if weak_concepts %}
            <div class="mt-8 text-left space-y-6">
                <h3 class="font-black text-xl text-slate-800 border-b pb-2">Questions to Review</h3>
                
                {% for item in submitted_answers %}
                    {% if not item.is_correct %}
                    <div class="bg-red-50 border-l-4 border-red-500 rounded-r-xl p-5 shadow-sm">
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-xs font-bold text-red-600 uppercase tracking-widest bg-red-100 px-2 py-0.5 rounded">{{ item.question.concept_tag }}</span>
                            <a href="{{ url('learning:index') }}?skill={{ skill.id }}&concept={{ item.question.concept_tag|urlencode }}" class="text-xs font-bold text-indigo-600 hover:underline flex items-center gap-1">
                                📺 Watch Lesson
                            </a>
                        </div>
                        <p class="font-semibold text-slate-800 mb-4">{{ item.question.text }}</p>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm mb-4">
                            <div class="bg-white border border-red-200 p-3 rounded-lg">
                                <span class="text-xs font-bold text-slate-400 block mb-1">Your Answer</span>
                                <span class="text-red-600 font-medium">
                                    {% if item.user_answer == 'A' %}{{ item.question.option_a }}
                                    {% elif item.user_answer == 'B' %}{{ item.question.option_b }}
                                    {% elif item.user_answer == 'C' %}{{ item.question.option_c }}
                                    {% elif item.user_answer == 'D' %}{{ item.question.option_d }}
                                    {% else %}(Skipped){% endif %}
                                </span>
                            </div>
                            <div class="bg-white border border-emerald-200 p-3 rounded-lg">
                                <span class="text-xs font-bold text-slate-400 block mb-1">Correct Answer</span>
                                <span class="text-emerald-600 font-medium">
                                    {% if item.question.correct_option == 'A' %}{{ item.question.option_a }}
                                    {% elif item.question.correct_option == 'B' %}{{ item.question.option_b }}
                                    {% elif item.question.correct_option == 'C' %}{{ item.question.option_c }}
                                    {% elif item.question.correct_option == 'D' %}{{ item.question.option_d }}
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        
                        {% if item.question.explanation %}
                        <div class="bg-white/60 p-4 rounded-lg text-slate-700 text-sm border border-slate-200">
                            <strong>💡 Explanation:</strong> {{ item.question.explanation }}
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% endif %}
            <div class="mt-6 flex flex-col sm:flex-row gap-4 justify-center">
                <a href="{{ url('learning:index') }}" class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition">Study Weak Areas</a>
                <a href="{{ url('assessment:take_test', skill.id) }}" class="bg-white border border-gray-300 text-gray-700 px-6 py-2 rounded-lg font-semibold hover:bg-gray-50 transition">Retry Test</a>
            </div>
        {% endif %}
        <p class="mt-6 text-sm text-gray-400">{{ correct }}/{{ total }} correct</p>
        {% if total > 0 and time_taken_seconds > 0 %}
        <p class="mt-2 text-sm text-slate-500">Avg <span class="font-semibold text-slate-700">{{ '%.1f'|format(time_taken_seconds / total) }}</span> sec per question</p>
        {% endif %}
    </div>
</div>
{% endblock %}
