{% extends "base.jinja" %}

{% block title %}Pricing Plans - RankJee{% endblock %}

{% block content %}
<div class="py-12 bg-gray-50 min-h-screen" x-data="{ billing: 'monthly' }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {% if payment_dummy %}
        <div class="mb-8 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-900">
            <strong>Dummy checkout</strong> — no real Razorpay keys needed in DEBUG. Click Get Started and confirm to activate Pro locally.
        </div>
        {% endif %}
        {% if signup_trial_enabled and signup_trial_days > 0 %}
        <div class="mb-8 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-center text-sm font-semibold text-indigo-900">
            New accounts get <strong>{{ signup_trial_days }} days</strong> of exam Pro access free (no card). Subscribe anytime on this page to extend.
        </div>
        {% endif %}
        {% if referral_premium_enabled %}
        <div class="mb-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-center text-sm font-semibold text-emerald-900">
            Test mode: sign up using any valid referral code and get {{ referral_premium_days }} days Pro access without payment.
        </div>
        {% endif %}
        <div class="text-center">
            <h2 class="text-base font-semibold text-indigo-600 tracking-wide uppercase">Exam add-on pricing</h2>
            <p class="mt-1 text-4xl font-extrabold text-gray-900 sm:text-5xl sm:tracking-tight lg:text-6xl">
                Boost learning beyond tutor sessions
            </p>
            <p class="max-w-xl mt-5 mx-auto text-xl text-gray-500">
                These plans are an optional add-on for online diagnostics, skill paths, and practice tests.
            </p>
            <p class="max-w-3xl mt-3 mx-auto text-sm text-slate-500">
                Exam subscriptions are billed in the `payments` module only. Home tutor marketplace fees are separate and billed under `hometutor_payments`.
            </p>
        </div>

        <div class="mt-12 flex justify-center">
            <div class="relative bg-white rounded-lg p-0.5 flex sm:mt-8">
                <button type="button" @click="billing = 'monthly'" :class="{ 'bg-white shadow-sm text-gray-900': billing === 'monthly', 'text-gray-500': billing !== 'monthly' }" class="relative py-2 px-6 border-transparent rounded-md text-sm font-medium whitespace-nowrap focus:outline-none focus:z-10 sm:w-auto sm:px-8">
                    Monthly
                </button>
                <button type="button" @click="billing = 'annual'" :class="{ 'bg-white shadow-sm text-gray-900': billing === 'annual', 'text-gray-500': billing !== 'annual' }" class="ml-0.5 relative py-2 px-6 border-transparent rounded-md text-sm font-medium whitespace-nowrap focus:outline-none focus:z-10 sm:w-auto sm:px-8">
                    Annual <span class="ml-1 text-xs text-green-500 font-bold">(-33%)</span>
                </button>
            </div>
        </div>

        <div class="mt-12 space-y-12 lg:space-y-0 lg:grid lg:grid-cols-3 lg:gap-x-8">
            {% for plan in plans %}
            <div class="relative p-8 bg-white border border-gray-200 rounded-2xl shadow-sm flex flex-col transition-all duration-300 hover:shadow-xl hover:-translate-y-1" x-show="billing === '{% if plan.duration_days > 30 %}annual{% else %}monthly{% endif %}'">
                <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900">{{ plan.name }}</h3>
                    {% if plan.duration_days > 30 %}
                    <p class="absolute top-0 py-1.5 px-4 bg-indigo-500 text-white text-xs font-semibold uppercase tracking-wide rounded-full transform -translate-y-1/2">
                        Best Value
                    </p>
                    {% endif %}
                    <p class="mt-4 flex items-baseline text-gray-900">
                        <span class="text-5xl font-extrabold tracking-tight">₹{{ plan.price|int }}</span>
                        <span class="ml-1 text-xl font-semibold">/{% if plan.duration_days > 30 %}year{% else %}month{% endif %}</span>
                    </p>
                    <p class="mt-6 text-gray-500">{{ plan.description }}</p>

                    <ul role="list" class="mt-6 space-y-4">
                        {% for feature in plan.features %}
                        <li class="flex">
                            <svg class="flex-shrink-0 w-6 h-6 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="ml-3 text-gray-600">{{ feature }}</span>
                        </li>
                        {% endfor %}
                    </ul>
                </div>

                {% if request.user.is_authenticated %}
                <button 
                    type="button"
                    @click="initiatePayment({{ plan.id }})"
                    class="mt-8 block w-full py-3 px-6 border border-transparent rounded-md text-center font-medium bg-indigo-600 text-white hover:bg-indigo-700 transition-colors shadow-lg shadow-indigo-100"
                >
                    Get Started
                </button>
                {% else %}
                <a href="{{ url('users:login') }}?next=/payments/plans/" class="mt-8 block w-full py-3 px-6 border border-transparent rounded-md text-center font-medium bg-slate-800 text-white hover:bg-slate-900 transition-colors shadow-lg">
                    Log in to subscribe
                </a>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Razorpay Checkout (skipped in dummy mode) -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
function getCookie(name) {
    let v = null;
    if (document.cookie && document.cookie !== '') {
        document.cookie.split(';').forEach(function (c) {
            c = c.trim();
            if (c.startsWith(name + '=')) v = decodeURIComponent(c.slice(name.length + 1));
        });
    }
    return v;
}
async function verifyOnServer(payload) {
    const csrftoken = getCookie('csrftoken');
    const body = new URLSearchParams(payload);
    const verifyResp = await fetch('/payments/verify/', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRFToken': csrftoken || '',
        },
        credentials: 'same-origin',
        body: body,
    });
    const verifyData = await verifyResp.json();
    if (verifyData.status === 'success') {
        window.location.href = '/admin/?paid=1';
    } else {
        alert(verifyData.error || 'Payment verification failed');
    }
}
async function initiatePayment(planId) {
    const csrftoken = getCookie('csrftoken');
    const response = await fetch('/payments/order/' + planId + '/', {
        method: 'POST',
        headers: { 'X-CSRFToken': csrftoken || '' },
        credentials: 'same-origin',
    });
    const data = await response.json();
    if (data.error) {
        alert('Payment error: ' + data.error);
        return;
    }
    if (data.checkout_mode === 'dummy') {
        if (!confirm('Simulate successful payment and activate this plan? (local dummy mode)')) return;
        await verifyOnServer({
            razorpay_order_id: data.order_id,
            razorpay_payment_id: 'pay_dummy_' + Date.now(),
            razorpay_signature: 'dummy',
        });
        return;
    }
    const options = {
        key: data.key,
        amount: data.amount,
        currency: 'INR',
        name: 'RankJee Pro',
        description: data.description,
        order_id: data.order_id,
        handler: async function (response) {
            await verifyOnServer({
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_signature: response.razorpay_signature,
            });
        },
        prefill: { name: data.user_name, email: data.user_email },
        theme: { color: '#4F46E5' },
    };
    const rzp1 = new Razorpay(options);
    rzp1.open();
}
</script>
{% endblock %}
