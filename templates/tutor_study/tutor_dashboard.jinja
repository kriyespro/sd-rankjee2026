{% extends "base.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block content %}
<div class="max-w-4xl mx-auto px-4 py-10">
    <div class="flex flex-wrap justify-between items-start gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-900">Study room</h1>
            <p class="text-slate-600 mt-1">Share notes and assignments with active students.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ url('study:tutor_material_create') }}" class="bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider hover:bg-indigo-700">New notes</a>
            <a href="{{ url('study:tutor_assignment_create') }}" class="border border-indigo-600 text-indigo-700 px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider hover:bg-indigo-50">New assignment</a>
        </div>
    </div>

    <section class="mt-10">
        <h2 class="text-xl font-black text-slate-900 mb-4">Notes</h2>
        {% if materials %}
        <ul class="space-y-2">
            {% for m in materials %}
            <li class="flex flex-wrap justify-between gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3">
                <span class="font-semibold text-slate-800">{{ m.title }} {% if not m.is_published %}<span class="text-xs text-amber-600">(draft)</span>{% endif %}</span>
                <a href="{{ url('study:tutor_material_edit', pk=m.pk) }}" class="text-xs font-black uppercase text-indigo-600">Edit</a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="text-slate-600 text-sm">No notes yet.</p>
        {% endif %}
    </section>

    <section class="mt-10">
        <h2 class="text-xl font-black text-slate-900 mb-4">Assignments</h2>
        {% if assignments %}
        <ul class="space-y-2">
            {% for a in assignments %}
            <li class="flex flex-wrap justify-between gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 items-center">
                <div>
                    <span class="font-semibold text-slate-800">{{ a.title }}</span>
                    <span class="text-xs text-slate-500 ml-2">{{ a.sub_count }} submission(s)</span>
                </div>
                <div class="flex gap-3">
                    <a href="{{ url('study:tutor_assignment_submissions', pk=a.pk) }}" class="text-xs font-black uppercase text-slate-600">Submissions</a>
                    <a href="{{ url('study:tutor_assignment_edit', pk=a.pk) }}" class="text-xs font-black uppercase text-indigo-600">Edit</a>
                </div>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="text-slate-600 text-sm">No assignments yet.</p>
        {% endif %}
    </section>
</div>
{% endblock %}
