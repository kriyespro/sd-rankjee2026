{% extends "tutor_study/layout_lms.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block study_content %}
<header class="bg-white border-b border-[#dadce0]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 flex flex-wrap items-start justify-between gap-4">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#5f6368]">Teaching</p>
            <h1 class="text-xl sm:text-2xl mt-1 text-[#202124]">Classroom</h1>
            <p class="mt-2 text-sm text-[#5f6368] max-w-xl">Share readings and assignments with students who are linked to you.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ url('study:tutor_material_create') }}" class="inline-flex items-center justify-center rounded-full bg-[#1a73e8] px-5 py-2 text-sm font-medium text-white shadow-sm hover:bg-[#1557b0]">
                Create material
            </a>
            <a href="{{ url('study:tutor_assignment_create') }}" class="inline-flex items-center justify-center rounded-full border border-[#dadce0] bg-white px-5 py-2 text-sm font-medium text-[#1a73e8] hover:bg-[#f8f9fa]">
                Create assignment
            </a>
        </div>
    </div>
</header>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 lg:py-8 grid gap-6 lg:grid-cols-12">
    <div class="lg:col-span-7 space-y-6">
        <section class="study-lms-card overflow-hidden">
            <div class="border-b border-[#e8eaed] bg-[#fafbfc] px-4 py-3 sm:px-5 flex items-center justify-between">
                <h2 class="text-base font-semibold text-[#202124]">Materials</h2>
                <span class="text-xs text-[#5f6368]">{{ materials|length }} total</span>
            </div>
            {% if materials %}
            <div>
                {% for m in materials %}
                <div class="study-lms-row">
                    <span class="mt-0.5 shrink-0 text-[#5f6368]" aria-hidden="true">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-[#202124]">{{ m.title }}</span>
                        {% if not m.is_published %}
                        <span class="ml-2 inline-flex rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-950">Draft</span>
                        {% endif %}
                        <p class="text-xs text-[#80868b] mt-0.5">Updated {{ m.updated_at.strftime('%d %b %Y') }}</p>
                    </div>
                    <a href="{{ url('study:tutor_material_edit', pk=m.pk) }}" class="shrink-0 text-sm font-medium text-[#1a73e8] hover:underline">Edit</a>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="px-5 py-10 text-center">
                <p class="text-sm text-[#5f6368]">No materials yet. Create one for students to open from Study.</p>
            </div>
            {% endif %}
        </section>
    </div>

    <div class="lg:col-span-5 space-y-6">
        <section class="study-lms-card overflow-hidden">
            <div class="border-b border-[#e8eaed] bg-[#fafbfc] px-4 py-3 sm:px-5">
                <h2 class="text-base font-semibold text-[#202124]">Assignments</h2>
            </div>
            {% if assignments %}
            <div>
                {% for a in assignments %}
                <div class="study-lms-row items-center">
                    <span class="mt-0.5 shrink-0 text-[#5f6368]" aria-hidden="true">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-[#202124]">{{ a.title }}</span>
                        <p class="text-xs text-[#5f6368] mt-0.5">{{ a.sub_count }} submission{% if a.sub_count != 1 %}s{% endif %}</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                        <a href="{{ url('study:tutor_assignment_submissions', pk=a.pk) }}" class="text-sm font-medium text-[#5f6368] hover:text-[#202124]">Work</a>
                        <a href="{{ url('study:tutor_assignment_edit', pk=a.pk) }}" class="text-sm font-medium text-[#1a73e8] hover:underline">Edit</a>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="px-5 py-10 text-center">
                <p class="text-sm text-[#5f6368]">No assignments yet.</p>
            </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
