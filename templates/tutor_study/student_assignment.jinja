{% extends "tutor_study/layout_lms.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block study_content %}
<header class="bg-white border-b border-[#dadce0]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-4">
        <a href="{{ url(study_route_hub) }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#1a73e8] hover:text-[#1557b0]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Back to Study
        </a>
        <div class="mt-4 flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
                <h1 class="text-xl sm:text-2xl text-[#202124] leading-snug">{{ assignment.title }}</h1>
                {% if assignment.due_at %}
                <p class="mt-2 inline-flex items-center rounded-full border border-[#dadce0] bg-[#f8f9fa] px-3 py-1 text-xs font-medium text-[#202124]">
                    Due {{ assignment.due_at.strftime('%d %B %Y · %H:%M') }}
                </p>
                {% endif %}
            </div>
        </div>
    </div>
</header>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    <div class="study-lms-card px-5 py-6 sm:px-8 sm:py-7 space-y-6">
        {% if assignment.material %}
        <div class="rounded-lg border border-[#e8eaed] bg-[#fafbfc] px-4 py-3">
            <p class="text-[11px] font-semibold uppercase tracking-wide text-[#5f6368]">Reading</p>
            <a href="{{ url(study_route_material, pk=assignment.material.pk) }}" class="mt-1 inline-flex items-center gap-2 text-sm font-medium text-[#1a73e8] hover:underline">
                {{ assignment.material.title }}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>
        {% endif %}

        {% if assignment.instructions %}
        <div>
            <h2 class="text-sm font-semibold text-[#202124]">Instructions</h2>
            <div class="mt-2 text-sm text-[#3c4043] whitespace-pre-wrap leading-relaxed">{{ assignment.instructions }}</div>
        </div>
        {% endif %}

        {% if assignment.skill %}
        <div class="rounded-lg border border-[#c7d7f7] bg-[#e8f0fe] px-4 py-4 flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-wide text-[#1967d2]">Practice</p>
                <p class="mt-1 text-sm font-medium text-[#202124]">{{ assignment.skill.name }}</p>
            </div>
            <a href="{{ url('assessment:take_test', skill_id=assignment.skill.id) }}" class="inline-flex shrink-0 rounded-full bg-[#1a73e8] px-5 py-2 text-sm font-medium text-white shadow-sm hover:bg-[#1557b0]">
                Take quiz
            </a>
        </div>
        {% endif %}
    </div>

    <section class="study-lms-card px-5 py-6 sm:px-8 sm:py-7">
        <h2 class="text-base font-semibold text-[#202124]">Your work</h2>
        <p class="mt-1 text-sm text-[#5f6368] leading-relaxed">Submit a <strong>share link</strong> to Google Drive or Google Docs so your tutor can open your file. RankJee only stores the link, not the file.</p>
        {% if google_drive_picker_enabled %}
        <p class="mt-2 text-xs text-[#5f6368]">Use <strong>Pick from Drive</strong> to choose a file (Google may ask you to allow Drive access).</p>
        {% endif %}
        {% if submission %}
        <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-3 py-1 text-xs font-medium text-green-900">
            Last submitted {{ submission.submitted_at.strftime('%d %b %Y, %H:%M') }}
        </p>
        {% endif %}
        <form method="post" class="mt-6 space-y-4" id="assignment-submit-form">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                    <label for="{{ form.drive_url.id_for_label }}" class="block text-xs font-semibold uppercase tracking-wide text-[#5f6368]">Drive link</label>
                    {% if google_drive_picker_enabled %}
                    <button type="button" id="study-drive-picker-btn" class="inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-wide text-indigo-800 hover:bg-indigo-100 transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3L4 9v12h16V9l-8-6zm0 2.18l6 4.5V19H6v-9.32l6-4.5z"/></svg>
                        Pick from Drive
                    </button>
                    {% endif %}
                </div>
                {{ form.drive_url }}
                {% if form.drive_url.errors %}
                <p class="text-red-700 text-sm mt-2">{{ form.drive_url.errors[0] }}</p>
                {% endif %}
            </div>
            <button type="submit" class="inline-flex rounded-full bg-[#1a73e8] px-6 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-[#1557b0]">
                Turn in
            </button>
        </form>
    </section>
</div>

{% if google_drive_picker_enabled %}
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script src="https://apis.google.com/js/api.js" async defer></script>
<script>
(function () {
    var clientId = {{ google_picker_client_id_json|safe }};
    var apiKey = {{ google_picker_api_key_json|safe }};
    var btn = document.getElementById('study-drive-picker-btn');
    var input = document.querySelector('#assignment-submit-form [name="drive_url"]');
    if (!btn || !input || !clientId || !apiKey) return;

    function loadPickerThen(cb) {
        if (typeof gapi !== 'undefined' && gapi.load) {
            gapi.load('picker', cb);
            return;
        }
        setTimeout(function () { loadPickerThen(cb); }, 100);
    }

    btn.addEventListener('click', function () {
        if (typeof google === 'undefined' || !google.accounts || !google.accounts.oauth2) {
            alert('Google sign-in script is still loading. Try again in a moment.');
            return;
        }
        var tokenClient = google.accounts.oauth2.initTokenClient({
            client_id: clientId,
            scope: 'https://www.googleapis.com/auth/drive.readonly',
            callback: function (res) {
                if (res.error) return;
                if (!res.access_token) return;
                loadPickerThen(function () {
                    var picker = new google.picker.PickerBuilder()
                        .addView(new google.picker.DocsView().setIncludeFolders(true))
                        .setOAuthToken(res.access_token)
                        .setDeveloperKey(apiKey)
                        .setTitle('Select your file')
                        .setCallback(function (data) {
                            if (data[google.picker.Response.ACTION] !== google.picker.Action.PICKED) return;
                            var docs = data[google.picker.Response.DOCUMENTS];
                            if (!docs || !docs.length) return;
                            var url = docs[0].url || docs[0].alternateLink || '';
                            if (url) {
                                input.value = url;
                                input.dispatchEvent(new Event('input', { bubbles: true }));
                            }
                        })
                        .build();
                    picker.setVisible(true);
                });
            },
        });
        tokenClient.requestAccessToken({ prompt: '' });
    });
})();
</script>
{% endif %}
{% endblock %}
