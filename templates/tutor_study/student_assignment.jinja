{% extends "base.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block content %}
<div class="max-w-3xl mx-auto px-4 py-10">
    <a href="{{ url('study:student_hub') }}" class="text-xs font-black uppercase tracking-wider text-indigo-600 hover:underline">← Study room</a>

    <article class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
        <h1 class="text-2xl md:text-3xl font-black text-slate-900">{{ assignment.title }}</h1>
        {% if assignment.due_at %}
        <p class="text-sm text-slate-500 mt-2">Due {{ assignment.due_at.strftime('%d %B %Y, %H:%M') }}</p>
        {% endif %}

        {% if assignment.material %}
        <div class="mt-6">
            <p class="text-xs font-black uppercase tracking-wider text-slate-500">Reading</p>
            <a href="{{ url('study:student_material', pk=assignment.material.pk) }}" class="font-bold text-indigo-700 hover:underline">{{ assignment.material.title }}</a>
        </div>
        {% endif %}

        {% if assignment.instructions %}
        <div class="mt-6 text-slate-700 whitespace-pre-wrap">{{ assignment.instructions }}</div>
        {% endif %}

        {% if assignment.skill %}
        <div class="mt-8 p-4 rounded-xl bg-indigo-50 border border-indigo-100 flex flex-wrap justify-between items-center gap-4">
            <div>
                <p class="text-xs font-black uppercase tracking-wider text-indigo-800">Practice quiz</p>
                <p class="text-sm text-indigo-900">{{ assignment.skill.name }}</p>
            </div>
            <a href="{{ url('assessment:take_test', skill_id=assignment.skill.id) }}" class="bg-indigo-600 text-white px-5 py-2 rounded-xl font-black text-sm uppercase tracking-wider hover:bg-indigo-700">Take assessment →</a>
        </div>
        {% endif %}

        <section class="mt-10 border-t border-slate-100 pt-8">
            <h2 class="text-lg font-black text-slate-900 mb-2">Submit work</h2>
            <p class="text-sm text-slate-600 mb-4">Paste a share link to your completed work on Google Drive or Google Docs.</p>
            {% if submission %}
            <p class="text-sm text-emerald-700 font-semibold mb-4">Last submitted {{ submission.submitted_at.strftime('%d %b %Y, %H:%M') }}</p>
            {% endif %}
            <form method="post" class="space-y-4">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <div>
                    {{ form.drive_url }}
                    {% if form.drive_url.errors %}
                    <p class="text-red-600 text-sm mt-1">{{ form.drive_url.errors[0] }}</p>
                    {% endif %}
                </div>
                <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-xl font-black uppercase tracking-wider text-sm hover:bg-indigo-700">Submit link</button>
            </form>
        </section>
    </article>
</div>
{% endblock %}
