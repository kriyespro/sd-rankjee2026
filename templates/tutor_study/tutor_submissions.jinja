{% extends "tutor_study/layout_lms.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block study_content %}
<header class="bg-white border-b border-[#dadce0]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-4">
        <a href="{{ url('study:tutor_dashboard') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#1a73e8] hover:text-[#1557b0]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Back to Classroom
        </a>
        <h1 class="text-xl sm:text-2xl mt-4 text-[#202124] leading-snug">{{ assignment.title }}</h1>
        <p class="mt-1 text-sm text-[#5f6368]">Student submissions — open each Drive link in a new tab.</p>
    </div>
</header>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    {% if submissions %}
    <div class="study-lms-card divide-y divide-[#e8eaed] overflow-hidden">
        {% for s in submissions %}
        <div class="px-5 py-4 sm:px-6 hover:bg-[#f8f9fa] transition-colors">
            <p class="font-medium text-[#202124]">{{ s.student.get_full_name() or s.student.username or s.student.email }}</p>
            <p class="text-xs text-[#80868b] mt-1">{{ s.submitted_at.strftime('%d %b %Y · %H:%M') }}</p>
            <a href="{{ s.drive_url }}" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-[#1a73e8] hover:underline break-all">
                Open submission
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="study-lms-card px-6 py-12 text-center">
        <p class="text-sm font-medium text-[#202124]">No submissions yet</p>
        <p class="text-xs text-[#5f6368] mt-2">Students turn in from the assignment page on Study.</p>
    </div>
    {% endif %}
</div>
{% endblock %}
