{% extends "base.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block content %}
<div class="max-w-3xl mx-auto px-4 py-10">
    <a href="{{ url('study:tutor_dashboard') }}" class="text-xs font-black uppercase tracking-wider text-indigo-600 hover:underline">← Tutor study</a>
    <h1 class="text-2xl font-black text-slate-900 mt-6">{{ assignment.title }}</h1>
    <p class="text-sm text-slate-600 mt-1">Student Drive links</p>

    {% if submissions %}
    <ul class="mt-8 space-y-4">
        {% for s in submissions %}
        <li class="rounded-xl border border-slate-200 bg-white p-4">
            <p class="font-bold text-slate-900">{{ s.student.get_full_name() or s.student.username or s.student.email }}</p>
            <p class="text-xs text-slate-500 mt-1">{{ s.submitted_at.strftime('%d %b %Y, %H:%M') }}</p>
            <a href="{{ s.drive_url }}" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-indigo-600 break-all hover:underline mt-2 inline-block">Open link →</a>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="mt-8 text-slate-600">No submissions yet.</p>
    {% endif %}
</div>
{% endblock %}
