{% extends "tutor_study/layout_lms.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block study_content %}
<header class="bg-white border-b border-[#dadce0]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-4">
        <a href="{{ url('study:tutor_dashboard') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#1a73e8] hover:text-[#1557b0]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Back to Classroom
        </a>
        <h1 class="text-xl sm:text-2xl mt-4 text-[#202124]">{% if material %}Edit material{% else %}Create material{% endif %}</h1>
        <p class="mt-1 text-sm text-[#5f6368]">Students see published materials on Study when they are linked to you.</p>
    </div>
</header>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <div class="study-lms-card px-5 py-6 sm:px-8 sm:py-8">
        <form method="post" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            {% for field in form %}
            <div>
                <label class="block text-[11px] font-semibold uppercase tracking-wide text-[#5f6368] mb-2" for="{{ field.id_for_label }}">{{ field.label }}</label>
                {{ field }}
                {% if field.errors %}
                <p class="text-red-700 text-sm mt-2">{{ field.errors[0] }}</p>
                {% endif %}
            </div>
            {% endfor %}
            <button type="submit" class="inline-flex rounded-full bg-[#1a73e8] px-6 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-[#1557b0]">Save</button>
        </form>
    </div>
</div>
{% endblock %}
