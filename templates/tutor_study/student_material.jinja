{% extends "tutor_study/layout_lms.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block study_content %}
<header class="bg-white border-b border-[#dadce0]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-4">
        <a href="{{ url(study_route_hub) }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#1a73e8] hover:text-[#1557b0]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Back to Study
        </a>
        <h1 class="text-xl sm:text-2xl mt-4 text-[#202124] leading-snug">{{ material.title }}</h1>
        {% if material.attachment %}
        <a href="{{ material.attachment.url }}" class="inline-flex mt-4 items-center gap-2 rounded-full border border-[#dadce0] bg-white px-4 py-2 text-sm font-medium text-[#1a73e8] hover:bg-[#f8f9fa]" download>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            Download attachment
        </a>
        {% endif %}
    </div>
</header>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <article class="study-lms-card px-5 py-6 sm:px-8 sm:py-8">
        <div class="study-prose max-w-none">{{ body_html }}</div>
    </article>
</div>
{% endblock %}
