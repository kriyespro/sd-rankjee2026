{% extends "tutor_study/layout_lms.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block study_extra_head %}
<style>
    .study-read-root {
        background: linear-gradient(180deg, #e7e2da 0%, #efeae4 35%, #dcd6cc 100%);
        min-height: 100%;
    }
    .study-reading-prose { font-family: Georgia, 'Times New Roman', serif; }
    .study-reading-prose p,
    .study-reading-prose .study-prose p {
        font-size: 1.0625rem;
        line-height: 1.78;
        color: #1e293b;
        margin-bottom: 1rem;
    }
    .study-reading-prose p:last-child,
    .study-reading-prose .study-prose p:last-child { margin-bottom: 0; }
</style>
{% endblock %}
{% block study_content %}
<div class="study-read-root">
    <header class="border-b border-stone-400/25 bg-[#fffefb]/90 backdrop-blur-sm">
        <div class="max-w-prose mx-auto px-4 sm:px-6 py-3 sm:py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <div class="min-w-0 flex-1">
                    <a href="{{ url(study_route_hub) }}" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-700 hover:text-indigo-900 hover:underline">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        Back to Study
                    </a>
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug mt-2 font-sans tracking-tight">{{ material.title }}</h1>
                    {% if material.attachment %}
                    <a href="{{ material.attachment.url }}" class="inline-flex mt-3 items-center gap-2 rounded-full border border-stone-300 bg-white px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-stone-50 shadow-sm" download>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        Download attachment
                    </a>
                    {% endif %}
                </div>
                <button type="button" id="study-copy-btn" class="shrink-0 self-end sm:self-start inline-flex items-center gap-2 rounded-xl border border-indigo-200 bg-white px-3 py-2 text-xs font-bold uppercase tracking-wide text-indigo-800 shadow-sm hover:bg-indigo-50 hover:border-indigo-300 transition-colors">
                    <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    Copy content
                </button>
            </div>
        </div>
    </header>

    <div class="px-4 sm:px-6 py-5 sm:py-8">
        <article class="max-w-prose mx-auto rounded-2xl border border-stone-300/70 bg-[#fffefb] shadow-xl shadow-stone-900/10 px-5 py-6 sm:px-9 sm:py-9">
            <div class="study-reading-prose max-w-none">{{ body_html }}</div>
        </article>
    </div>
</div>

<script type="application/json" id="study-plain-data">{{ material_plain_json|safe }}</script>
<script>
(function () {
    var el = document.getElementById('study-plain-data');
    var btn = document.getElementById('study-copy-btn');
    if (!el || !btn) return;
    function plainText() {
        try { return JSON.parse(el.textContent || '""'); }
        catch (e) { return ''; }
    }
        btn.addEventListener('click', function () {
        var t = plainText();
        if (!t) return;
        var labelHtml = btn.innerHTML;
        navigator.clipboard.writeText(t).then(function () {
            btn.textContent = 'Copied!';
            setTimeout(function () { btn.innerHTML = labelHtml; }, 2200);
        });
    });
})();
</script>
{% endblock %}
