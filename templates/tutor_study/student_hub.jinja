{% extends "tutor_study/layout_lms.jinja" %}
{% block title %}{{ seo_title }}{% endblock %}
{% block study_content %}
<header class="border-b border-slate-200/90 bg-gradient-to-r from-slate-50 via-indigo-50/40 to-violet-50/50">
    <div class="px-4 sm:px-6 py-3 lg:py-4">
        <div class="flex flex-wrap items-center justify-between gap-2 gap-y-1">
            <h1 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">Study workspace</h1>
            {% if dashboard_study_embedded %}
            <span class="text-[10px] font-semibold uppercase tracking-wider text-indigo-600/90 bg-white/70 rounded-full px-2 py-0.5 border border-indigo-100">Dashboard</span>
            {% endif %}
        </div>
        {% if dashboard_study_embedded %}
        <p class="text-xs text-slate-600 mt-1 leading-snug max-w-3xl">Notes, assignments & practice quizzes — by topic.</p>
        {% endif %}

        {% if not show_study_empty %}
        <dl class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
            <div class="rounded-xl border border-teal-200/80 bg-gradient-to-br from-teal-400/20 via-teal-50 to-white px-2.5 py-2 shadow-sm">
                <dt class="text-[9px] font-bold uppercase tracking-wide text-teal-900/75">Materials</dt>
                <dd class="text-lg font-bold tabular-nums leading-none text-teal-950 mt-0.5">{{ study_summary_materials }}</dd>
            </div>
            <div class="rounded-xl border border-indigo-200/80 bg-gradient-to-br from-indigo-400/18 via-indigo-50 to-white px-2.5 py-2 shadow-sm">
                <dt class="text-[9px] font-bold uppercase tracking-wide text-indigo-900/75">Assignments</dt>
                <dd class="text-lg font-bold tabular-nums leading-none text-indigo-950 mt-0.5">{{ study_summary_assignments }}</dd>
            </div>
            <div class="rounded-xl border border-violet-200/80 bg-gradient-to-br from-violet-400/18 via-violet-50 to-white px-2.5 py-2 shadow-sm">
                <dt class="text-[9px] font-bold uppercase tracking-wide text-violet-900/75">Quizzes</dt>
                <dd class="text-lg font-bold tabular-nums leading-none text-violet-950 mt-0.5">{{ study_summary_exams }}</dd>
            </div>
            <div class="rounded-xl border border-amber-200/80 bg-gradient-to-br from-amber-400/22 via-amber-50 to-white px-2.5 py-2 shadow-sm">
                <dt class="text-[9px] font-bold uppercase tracking-wide text-amber-900/75">Tutor links</dt>
                <dd class="text-lg font-bold tabular-nums leading-none text-amber-950 mt-0.5">{{ engaged_tutor_count }}</dd>
            </div>
        </dl>
        {% endif %}
    </div>
</header>

<div class="px-4 sm:px-6 py-4 lg:py-5 space-y-6">
    {% if show_study_empty %}
    <div class="study-lms-card max-w-lg mx-auto text-center px-5 py-10">
        <h2 class="text-base font-semibold text-[#202124]">Nothing here yet</h2>
        <p class="mt-1.5 text-sm text-[#5f6368] leading-relaxed">When staff publishes notes or you connect with a tutor, topics will appear in the sidebar.</p>
        <div class="mt-6 flex flex-col sm:flex-row items-stretch justify-center gap-2">
            <a href="{{ url('hometutor:tutor_list') }}" class="inline-flex justify-center rounded-full bg-[#1a73e8] px-5 py-2 text-sm font-semibold text-white hover:bg-[#1557b0]">Find tutors</a>
            <a href="{{ url('assessment:index') }}" class="inline-flex justify-center rounded-full border border-[#dadce0] bg-white px-5 py-2 text-sm font-semibold text-[#1a73e8] hover:bg-[#f8f9fa]">Assessments</a>
        </div>
    </div>
    {% else %}
    <section aria-labelledby="study-topics-heading">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <h2 id="study-topics-heading" class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Topics</h2>
            <p class="text-[10px] text-slate-500">Tap to open</p>
        </div>
        <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-2.5">
            {% for item in study_nav_items %}
            {% if item.kind == 'topic' %}
            {% set skin = loop.cycle(
                'border-emerald-200/90 bg-gradient-to-br from-emerald-400/12 via-white to-teal-50/90 hover:from-emerald-400/18',
                'border-sky-200/90 bg-gradient-to-br from-sky-400/12 via-white to-blue-50/90 hover:from-sky-400/18',
                'border-violet-200/90 bg-gradient-to-br from-violet-400/12 via-white to-violet-50/90 hover:from-violet-400/18',
                'border-amber-200/90 bg-gradient-to-br from-amber-400/14 via-white to-amber-50/90 hover:from-amber-400/20'
            ) %}
            <a href="{{ item.href }}" class="group relative overflow-hidden rounded-xl border {{ skin }} px-3 py-2.5 shadow-sm hover:shadow-md hover:border-indigo-300/60 transition-all text-left">
                <span class="absolute inset-y-0 left-0 w-1 rounded-l-xl bg-gradient-to-b from-indigo-500 to-violet-500 opacity-70 group-hover:opacity-100"></span>
                <div class="pl-2 flex items-start justify-between gap-2">
                    <h3 class="text-[13px] font-bold text-slate-900 leading-tight group-hover:text-indigo-700 transition-colors" {% if item.depth %}style="margin-left: {{ item.depth * 6 }}px"{% endif %}>{{ item.label }}</h3>
                    <span class="shrink-0 text-indigo-500 opacity-0 group-hover:opacity-100 text-sm" aria-hidden="true">→</span>
                </div>
                <div class="pl-2 mt-2 flex flex-wrap gap-1">
                    <span class="inline-flex rounded-md bg-teal-500/15 px-1.5 py-px text-[9px] font-bold uppercase tracking-wide text-teal-900">{{ item.count_materials }} notes</span>
                    <span class="inline-flex rounded-md bg-indigo-500/15 px-1.5 py-px text-[9px] font-bold uppercase tracking-wide text-indigo-900">{{ item.count_assignments }} tasks</span>
                    {% if item.count_exams %}
                    <span class="inline-flex rounded-md bg-violet-500/15 px-1.5 py-px text-[9px] font-bold uppercase tracking-wide text-violet-900">{{ item.count_exams }} quiz</span>
                    {% endif %}
                </div>
            </a>
            {% endif %}
            {% endfor %}
        </div>
    </section>

    <div class="flex flex-wrap justify-center gap-x-6 gap-y-1.5 pt-3 border-t border-slate-200/80 text-xs font-semibold text-indigo-600">
        <a href="{{ url('hometutor:tutor_list') }}" class="hover:text-indigo-800 hover:underline">Find tutors</a>
        <a href="{{ url('learning:index') }}" class="hover:text-indigo-800 hover:underline">Learning</a>
        <a href="{{ url('assessment:index') }}" class="hover:text-indigo-800 hover:underline">Assessments</a>
    </div>
    {% endif %}
</div>
{% endblock %}
