{# Requires: study_nav_items, lms_active_nav, lms_active_topic_pk, lms_highlight_topic_pk, dashboard_study_embedded #}
<div class="study-lms-sidebar-shell flex flex-col h-full min-h-0">
    <div class="shrink-0 px-4 pt-5 pb-4 border-b border-slate-200/90 bg-white/90 backdrop-blur-sm">
        <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-md shadow-indigo-500/25" aria-hidden="true">
                <svg class="w-5 h-5 opacity-95" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <div class="min-w-0 pt-0.5">
                <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Study workspace</p>
                <p class="text-[15px] font-semibold text-slate-900 tracking-tight leading-snug mt-0.5">Your classroom</p>
                {% if dashboard_study_embedded %}
                <a href="{{ url('dashboard:index') }}" class="group mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-indigo-600 hover:text-indigo-700">
                    <svg class="w-3.5 h-3.5 text-indigo-400 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    Dashboard home
                </a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="shrink-0 px-4 pt-4 pb-1">
        <p id="study-sidebar-nav-label" class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Menu</p>
    </div>

    <nav class="study-lms-sidebar-nav flex-1 overflow-y-auto px-2 pb-4 space-y-1 min-h-0" aria-labelledby="study-sidebar-nav-label">
        {% for item in study_nav_items %}
            {% if item.kind == 'overview' %}
            <a href="{{ item.href }}" class="study-lms-sidebar-link group mx-1 flex items-center gap-3 rounded-xl px-3 py-2.5 text-[13px] font-semibold transition-all duration-150 {% if lms_active_nav == 'hub' %}study-lms-sidebar-link-active text-indigo-800{% else %}text-slate-700 hover:bg-white/90 hover:text-slate-900 hover:shadow-sm{% endif %}">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg {% if lms_active_nav == 'hub' %}bg-indigo-500 text-white shadow-sm{% else %}bg-slate-200/80 text-slate-600 group-hover:bg-white group-hover:text-indigo-600{% endif %} transition-colors duration-150" aria-hidden="true">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                </span>
                <span class="min-w-0 break-words">{{ item.label }}</span>
            </a>
            {% else %}
            {% set rail_left = 14 + item.depth * 12 %}
            {% set is_active = lms_active_nav == 'topic' and (
                (item.topic_pk is none and lms_active_topic_pk is none) or
                (item.topic_pk == lms_active_topic_pk)
            ) %}
            {% set is_related = lms_active_nav in ('material', 'assignment') and (
                (item.topic_pk is none and lms_highlight_topic_pk is none) or
                (item.topic_pk == lms_highlight_topic_pk)
            ) %}
            <a href="{{ item.href }}" class="study-lms-sidebar-link group relative mx-1 flex rounded-xl py-2 pr-2.5 text-[13px] transition-all duration-150 {% if is_active %}study-lms-sidebar-link-active{% elif is_related %}bg-amber-50/95 ring-1 ring-amber-200/90 shadow-sm text-slate-900{% else %}text-slate-700 hover:bg-white/85 hover:text-slate-900 hover:shadow-sm{% endif %}" style="padding-left: {{ rail_left }}px;">
                {% if item.depth > 0 %}
                <span class="pointer-events-none absolute bottom-2 left-3 top-2 w-px rounded-full bg-slate-300/90 group-hover:bg-slate-400/80" style="left: {{ 10 + (item.depth - 1) * 12 }}px;" aria-hidden="true"></span>
                <span class="pointer-events-none absolute left-0 top-1/2 h-px w-2 -translate-y-1/2 bg-slate-300/90 group-hover:bg-slate-400/80" style="left: {{ 10 + (item.depth - 1) * 12 }}px;" aria-hidden="true"></span>
                {% endif %}
                <span class="relative flex min-w-0 flex-1 flex-col gap-1">
                    <span class="font-semibold leading-snug break-words {% if is_active %}text-indigo-900{% elif is_related %}text-amber-950{% endif %}">{{ item.label }}</span>
                    {% if item.count_materials or item.count_assignments or item.count_exams %}
                    <span class="flex flex-wrap gap-1">
                        {% if item.count_materials %}
                        <span class="inline-flex rounded-md bg-teal-500/[0.12] px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-teal-800">{{ item.count_materials }} notes</span>
                        {% endif %}
                        {% if item.count_assignments %}
                        <span class="inline-flex rounded-md bg-indigo-500/[0.12] px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-indigo-800">{{ item.count_assignments }} tasks</span>
                        {% endif %}
                        {% if item.count_exams %}
                        <span class="inline-flex rounded-md bg-violet-500/[0.14] px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-violet-900">{{ item.count_exams }} quiz</span>
                        {% endif %}
                    </span>
                    {% endif %}
                </span>
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-300 opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100 {% if is_active %}text-indigo-400 opacity-100{% endif %}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
            {% endif %}
        {% endfor %}
    </nav>
</div>
