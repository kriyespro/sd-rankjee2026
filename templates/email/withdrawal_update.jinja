<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f8fafc;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
    <div style="max-width:560px;margin:0 auto;padding:24px;">
      <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:16px;padding:24px;">
        <div style="font-weight:900;font-size:18px;letter-spacing:-0.01em;margin-bottom:8px;">Withdrawal status update</div>
        <div style="font-size:14px;color:#475569;line-height:1.6;">
          Hi <strong>{{ user.username }}</strong>,<br>
          Your withdrawal request of <strong>₹{{ amount }}</strong> to <strong>{{ upi_id }}</strong> is now <strong>{{ status }}</strong>.
          {% if admin_note %}<br><br><strong>Note:</strong> {{ admin_note }}{% endif %}
        </div>
        <div style="margin-top:18px;">
          <a href="{{ earnings_url }}" style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;font-weight:800;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;padding:12px 16px;border-radius:12px;">View Wallet</a>
        </div>
      </div>
      <div style="text-align:center;margin-top:12px;font-size:11px;color:#94a3b8;">© 2026 RankJee</div>
    </div>
  </body>
</html>
