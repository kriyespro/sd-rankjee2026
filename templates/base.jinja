<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set _seo_title = seo_title if seo_title is defined and seo_title else "RankJee — Home tutor jobs & best tutors in your city" %}
    {% set _seo_description = seo_description if seo_description is defined and seo_description else "Get home tutors jobs in your city and find the best home tutor near you — RankJee connects families with verified tutors, courses, and exam practice." %}
    {% set _seo_keywords = seo_keywords if seo_keywords is defined and seo_keywords else "home tutor jobs, best home tutor, private tutor, tuition at home, RankJee" %}
    {% set _canonical_url = canonical_url if canonical_url is defined and canonical_url else request.build_absolute_uri(request.path) %}
    <title>{% block title %}{{ _seo_title }}{% endblock %}</title>
    <meta name="description" content="{{ _seo_description }}">
    <meta name="keywords" content="{{ _seo_keywords }}">
    <link rel="canonical" href="{{ _canonical_url }}">
    {% if seo_noindex is defined and seo_noindex %}
    <meta name="robots" content="noindex, nofollow">
    {% else %}
    <meta name="robots" content="index, follow">
    {% endif %}
    <meta property="og:title" content="{{ _seo_title }}">
    <meta property="og:description" content="{{ _seo_description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ _canonical_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ _seo_title }}">
    <meta name="twitter:description" content="{{ _seo_description }}">
    <link rel="manifest" href="{{ static('manifest.json') }}">
    <meta name="theme-color" content="#3b4cb8">
    <link rel="apple-touch-icon" href="{{ static('img/icons/apple-touch-icon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Async font CSS: avoids render-blocking chain on fonts.googleapis.com → gstatic woff2 #}
    {% set _gf = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;600;700;800;900&display=swap" %}
    <link rel="preload" as="style" href="{{ _gf }}" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ _gf }}"></noscript>
    <link rel="stylesheet" href="{{ static('css/app.css') }}">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
    <script defer src="{{ static('js/htmx.min.js') }}"></script>
    <style>
        [x-cloak] { display: none !important; }
        /* RankJEE brand palette — see colorp.md */
        :root {
            --rj-navy: #0D2B5E;
            --rj-saffron: #F4711C;
            --rj-gold: #F5B731;
            --rj-emerald: #1CA97B;
            --rj-surface: #f4f6fb;
            --rj-surface-warm: #faf8f5;
        }

        /* Tutor listing cards — RankJEE palette (shared home + directory) */
        .rankjee-tutor-card {
            position: relative;
            overflow: hidden;
            border: 1px solid color-mix(in srgb, var(--rj-navy) 12%, #e2e8f0);
            border-radius: 1.25rem;
            box-shadow: 0 4px 22px -14px color-mix(in srgb, var(--rj-navy) 26%, transparent);
            transition: box-shadow 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
        }
        .rankjee-tutor-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--rj-navy), var(--rj-saffron));
            opacity: 0.92;
        }
        .rankjee-tutor-card:hover {
            border-color: color-mix(in srgb, var(--rj-saffron) 38%, #e2e8f0);
            box-shadow: 0 20px 44px -22px color-mix(in srgb, var(--rj-navy) 26%, transparent);
            transform: translateY(-3px);
        }
        .rankjee-tutor-avatar-ph {
            background: linear-gradient(145deg, var(--rj-navy) 0%, color-mix(in srgb, var(--rj-navy) 55%, var(--rj-saffron)) 100%);
            color: #fff;
        }
        .rankjee-tutor-badge-verified {
            background: color-mix(in srgb, var(--rj-emerald) 12%, #ecfdf5);
            color: color-mix(in srgb, var(--rj-emerald) 35%, #064e3b);
            border: 1px solid color-mix(in srgb, var(--rj-emerald) 28%, #bbf7d0);
        }
        .rankjee-tutor-badge-rating {
            background: color-mix(in srgb, var(--rj-gold) 24%, #fffbeb);
            color: var(--rj-navy);
            border: 1px solid color-mix(in srgb, var(--rj-gold) 40%, #fde68a);
        }
        .rankjee-tutor-name-link:hover .rankjee-tutor-name {
            color: var(--rj-saffron);
        }
        .rankjee-tutor-subjects {
            color: color-mix(in srgb, var(--rj-navy) 88%, #1e293b);
        }
        .rankjee-chip {
            display: inline-flex;
            align-items: center;
            border-radius: 0.5rem;
            padding: 0.25rem 0.625rem;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .rankjee-chip-muted {
            background: color-mix(in srgb, var(--rj-navy) 7%, #f1f5f9);
            color: color-mix(in srgb, var(--rj-navy) 72%, #334155);
        }
        .rankjee-chip-accent {
            background: color-mix(in srgb, var(--rj-saffron) 12%, #fff);
            color: var(--rj-navy);
            border: 1px solid color-mix(in srgb, var(--rj-saffron) 35%, #fed7aa);
        }
        .rankjee-tutor-btn-primary {
            display: block;
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 0.75rem;
            text-align: center;
            font-size: 0.875rem;
            font-weight: 700;
            background: var(--rj-saffron);
            color: #fff;
            transition: filter 0.15s ease;
        }
        .rankjee-tutor-btn-primary:hover {
            filter: brightness(1.07);
        }
        .rankjee-tutor-btn-secondary {
            display: block;
            width: 100%;
            padding: 0.625rem 1rem;
            border-radius: 0.75rem;
            text-align: center;
            font-size: 0.75rem;
            font-weight: 900;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            border: 2px solid var(--rj-navy);
            color: var(--rj-navy);
            background: #fff;
            transition: background-color 0.15s ease;
        }
        .rankjee-tutor-btn-secondary:hover {
            background: color-mix(in srgb, var(--rj-gold) 14%, #fff);
        }
        .rankjee-tutor-btn-ghost {
            display: block;
            width: 100%;
            padding: 0.625rem 1rem;
            border-radius: 0.75rem;
            text-align: center;
            font-size: 0.75rem;
            font-weight: 900;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            border: 1px solid #e2e8f0;
            color: #475569;
            background: #fff;
            transition: background-color 0.15s ease;
        }
        .rankjee-tutor-btn-ghost:hover {
            background: #f8fafc;
        }
        /* Shared CTA utilities */
        .rj-cta-primary {
            background: var(--rj-saffron);
            border: 2px solid color-mix(in srgb, var(--rj-saffron) 72%, #c2410c);
            border-radius: 0.875rem;
            font-size: 0.8125rem;
            letter-spacing: 0.07em;
            box-shadow: 0 10px 28px -10px color-mix(in srgb, var(--rj-saffron) 58%, transparent);
            transition: filter 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
        }
        .rj-cta-primary:hover {
            filter: brightness(1.06);
        }
        .rj-cta-primary:active {
            transform: scale(0.98);
        }
        .rj-link-accent:hover {
            color: var(--rj-saffron);
        }

        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
        
        /* Smooth, modern scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        .nav-glass {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        /* Logo “R” tile — never rely on Tailwind arbitrary classes alone (missing purge → white on white) */
        .rankjee-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 2rem;
            height: 2rem;
            min-width: 2rem;
            min-height: 2rem;
            border-radius: 0.5rem;
            background-color: #3b4cb8;
            color: #ffffff;
            font-weight: 900;
            font-size: 1.125rem;
            line-height: 1;
            font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
            box-shadow: 0 4px 6px -1px rgba(59, 76, 184, 0.28);
            transition: transform 0.15s ease;
        }
        .rankjee-logo:hover .rankjee-mark {
            transform: scale(1.02);
        }
        @media (min-width: 768px) {
            .rankjee-mark {
                width: 2.5rem;
                height: 2.5rem;
                min-width: 2.5rem;
                min-height: 2.5rem;
                font-size: 1.375rem;
            }
        }
        .brand-jee {
            color: #3b4cb8;
        }
        .nav-link {
            transition: all 0.3s ease;
            position: relative;
            color: #475569;
        }
        .nav-link:hover {
            color: #4f46e5;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            width: 0;
            height: 1.5px;
            background: #4f46e5;
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }
        .nav-link:hover::after {
            width: 100%;
        }
        /* Mobile Bottom Bar Shadow */
        .mobile-nav-shadow {
            box-shadow: 0 -4px 20px -5px rgba(0, 0, 0, 0.08);
        }
        /* Main nav — compact account cluster (replaces removed top utility bar) */
        .nav-main-util {
            display: inline-flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.25rem 0.35rem;
        }
        @media (min-width: 768px) {
            .nav-main-util { gap: 0.35rem 0.5rem; }
        }
        .nav-main-util a.nav-util-link {
            display: inline-flex;
            align-items: center;
            padding: 0.35rem 0.5rem;
            border-radius: 0.5rem;
            font-size: 0.625rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #64748b;
            text-decoration: none;
            transition: background 0.15s ease, color 0.15s ease;
        }
        @media (min-width: 768px) {
            .nav-main-util a.nav-util-link { font-size: 0.6875rem; padding: 0.4rem 0.65rem; letter-spacing: 0.12em; }
        }
        .nav-main-util a.nav-util-link:hover {
            color: #4f46e5;
            background: rgba(238, 242, 255, 0.95);
        }
        .nav-util-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.625rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            border-radius: 0.5rem;
            padding: 0.35rem 0.55rem;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }
        @media (min-width: 768px) {
            .nav-util-btn { font-size: 0.6875rem; padding: 0.4rem 0.65rem; letter-spacing: 0.12em; }
        }
        .nav-util-btn--logout {
            color: #64748b;
            background: transparent;
            border: 1px solid rgba(148, 163, 184, 0.45);
        }
        .nav-util-btn--logout:hover {
            color: #b91c1c;
            border-color: rgba(248, 113, 113, 0.55);
            background: rgba(254, 242, 242, 0.9);
        }
        .nav-util-btn--login {
            color: #4f46e5;
            background: rgba(238, 242, 255, 0.9);
            border: 1px solid rgba(199, 210, 254, 0.8);
            text-decoration: none;
        }
        .nav-util-btn--login:hover {
            background: rgba(224, 231, 255, 1);
        }
        .nav-util-btn--join {
            color: #fff;
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            border: 1px solid rgba(129, 140, 248, 0.5);
            text-decoration: none;
            box-shadow: 0 1px 2px rgba(79, 70, 229, 0.25);
        }
        .nav-util-btn--join:hover {
            filter: brightness(1.05);
        }
        /* Footer — 4-column keyword grid */
        .site-footer {
            background: linear-gradient(185deg, #eef2ff 0%, #f8fafc 35%, #f1f5f9 100%);
        }
        .footer-col-card {
            border-radius: 1rem;
            border: 1px solid rgba(226, 232, 240, 0.98);
            background: rgba(255, 255, 255, 0.94);
            box-shadow: 0 6px 28px -18px rgba(30, 27, 75, 0.35), 0 1px 0 rgba(255, 255, 255, 0.8) inset;
            height: 100%;
        }
        .footer-col-head {
            border-bottom: 1px solid rgba(199, 210, 254, 0.55);
            padding-bottom: 0.75rem;
            margin-bottom: 0.625rem;
        }
        .footer-kw li + li { margin-top: 0.0625rem; }
        .footer-kw a {
            display: block;
            padding: 0.4rem 0.55rem;
            margin-left: -0.55rem;
            margin-right: -0.55rem;
            border-radius: 0.5rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #475569;
            text-decoration: none;
            line-height: 1.4;
            transition: background 0.14s ease, color 0.14s ease;
        }
        .footer-kw a:hover {
            background: rgba(238, 242, 255, 0.98);
            color: #4338ca;
        }
        .footer-study-box {
            margin-top: 1rem;
            padding: 0.875rem;
            border-radius: 0.75rem;
            background: linear-gradient(145deg, rgba(238, 242, 255, 0.65) 0%, rgba(241, 245, 249, 0.9) 100%);
            border: 1px solid rgba(199, 210, 254, 0.45);
        }
    </style>
    {% block schema %}{% endblock %}
    {% block extra_head %}{% endblock %}
</head>
<body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen antialiased selection:bg-indigo-100 selection:text-indigo-900 font-sans pb-20 md:pb-0">
    {% set current_role = request.user.role if request.user.is_authenticated and request.user.role is defined else 'STUDENT' %}

    <header class="sticky top-0 z-50">
    <nav class="nav-glass border-t-0">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 md:px-8 h-[3.2rem] md:h-16 flex items-center gap-2 md:gap-4">
            {# Logo — ~20% shorter bar: smaller mark + type #}
            {# Brand mark: blue #3b4cb8 square + white R; wordmark Rank (black) + Jee (brand blue) #}
            <a href="{{ url('core:home') }}" class="rankjee-logo flex shrink-0 items-center gap-1.5 md:gap-2.5 pr-2 md:pr-5 mr-0.5 md:mr-1 border-r border-slate-200/90" aria-label="RankJee home">
                <span class="rankjee-mark" aria-hidden="true">R</span>
                <span class="text-lg md:text-xl font-black tracking-tight text-slate-900">Rank<span class="brand-jee">Jee</span></span>
            </a>
            
            <!-- Desktop Nav — centered in remaining space -->
            <div class="hidden md:flex flex-1 min-w-0 justify-center items-center">
            <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 lg:gap-x-6 xl:gap-x-7 text-xs font-black text-slate-600 uppercase tracking-[0.14em] lg:tracking-[0.16em] text-center">
                {% if not request.user.is_authenticated %}
                    <a href="{{ url('hometutor:tutor_list') }}" class="nav-link">Tutors</a>
                    <a href="{{ url('assessment:index') }}" class="nav-link">Exams</a>
                    <a href="{{ url('learning:index') }}" class="nav-link">Learn</a>
                    <a href="{{ url('core:courses') }}" class="nav-link">Courses</a>
                    <a href="{{ url('core:earnings') }}" class="nav-link">Earn</a>
                {% elif current_role == 'TUTOR' %}
                    <a href="{{ url('hometutor:tutor_demos') }}" class="nav-link">Demo Inbox</a>
                    <a href="{{ url('hometutor:my_profile') }}" class="nav-link">My Listing</a>
                    <a href="{{ url('hometutor:tutor_list') }}" class="nav-link">Marketplace</a>
                {% elif current_role == 'PARENT' %}
                    <a href="{{ url('hometutor:tutor_list') }}" class="nav-link">Tutors</a>
                    <a href="{{ url('hometutor:my_demo_requests') }}" class="nav-link">My Demos</a>
                    <a href="{{ url('dashboard:study') }}" class="nav-link">Study</a>
                    <a href="{{ url('learning:index') }}" class="nav-link">{{ uil.academy }}</a>
                {% elif current_role == 'VIP_USER' %}
                    <a href="{{ url('hometutor:tutor_list') }}" class="nav-link">Tutors</a>
                    <a href="{{ url('dashboard:study') }}" class="nav-link">Study</a>
                    <a href="{{ url('assessment:index') }}" class="nav-link">Exams</a>
                    <a href="{{ url('learning:index') }}" class="nav-link">Learn</a>
                    <a href="{{ url('core:courses') }}" class="nav-link">Courses</a>
                    <a href="{{ url('core:earnings') }}" class="nav-link">Earn</a>
                {% elif current_role == 'CITY_ADMIN' or current_role == 'GLOBAL_ADMIN' or request.user.is_staff or request.user.is_superuser %}
                    <a href="/sd/" class="nav-link">Admin</a>
                    <a href="{{ url('lms:home') }}" class="nav-link">LMS</a>
                    <a href="{{ url('hometutor:tutor_list') }}" class="nav-link">Marketplace</a>
                    <a href="{{ url('assessment:index') }}" class="nav-link">Exams</a>
                    <a href="{{ url('learning:index') }}" class="nav-link">Learn</a>
                    <a href="{{ url('core:courses') }}" class="nav-link">Courses</a>
                    <a href="{{ url('core:earnings') }}" class="nav-link">Earn</a>
                {% else %}
                    <a href="{{ url('hometutor:tutor_list') }}" class="nav-link">Tutors</a>
                    {% if request.user.is_authenticated %}
                    <a href="{{ url('dashboard:study') }}" class="nav-link">Study</a>
                    <a href="{{ url('lms:home') }}" class="nav-link">LMS</a>
                    {% endif %}
                    <a href="{{ url('assessment:index') }}" class="nav-link">Exams</a>
                    <a href="{{ url('learning:index') }}" class="nav-link">Learn</a>
                    <a href="{{ url('core:courses') }}" class="nav-link">Courses</a>
                    <a href="{{ url('core:earnings') }}" class="nav-link">Earn</a>
                {% endif %}
            </div>
            </div>

            <!-- Dashboard · Blog · Login/Logout/Join — compact (replaces top utility strip) -->
            <div class="flex shrink-0 items-center justify-end gap-1.5 md:gap-2">
                <nav class="nav-main-util" aria-label="Account shortcuts">
                    {% if request.user.is_authenticated %}
                    <a href="{{ url('dashboard:index') }}" class="nav-util-link">{{ uil.dashboard }}</a>
                    {% endif %}
                    <a href="{{ url('blog:index') }}" class="nav-util-link">Blog</a>
                    {% if request.user.is_authenticated %}
                    <a href="{{ url('core:course_cart') }}" class="nav-util-link">Cart{% if course_cart_count %} {{ course_cart_count }}{% endif %}</a>
                    <form action="{{ url('users:logout') }}" method="post" class="inline m-0">
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <button type="submit" class="nav-util-btn nav-util-btn--logout">{{ uil.logout }}</button>
                    </form>
                    {% else %}
                    <a href="{{ url('users:login') }}" class="nav-util-btn nav-util-btn--login">{{ uil.login }}</a>
                    <a href="{{ url('users:signup') }}" class="nav-util-btn nav-util-btn--join">{{ uil.join }}</a>
                    {% endif %}
                </nav>
                {% if exam_paywall_enabled and request.user.is_authenticated and not request.user.is_premium %}
                <a href="{{ url('payments:plans') }}" class="hidden sm:inline-flex items-center bg-gradient-to-r from-amber-400 to-orange-500 text-white text-[10px] font-black px-2.5 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl shadow-md shadow-orange-200/80 hover:scale-[1.02] transition-all uppercase tracking-widest">
                    <span>{{ uil.pro }}</span>
                </a>
                {% endif %}
            </div>
        </div>
        {% if nav_progress_percent is defined %}
        <div class="h-1 bg-slate-100">
            <div class="h-1 bg-indigo-600 transition-all" style="width: {{ nav_progress_percent }}%"></div>
        </div>
        {% endif %}
    </nav>
    </header>

    <!-- Mobile Bottom Tab Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-t border-slate-100 md:hidden mobile-nav-shadow px-4 py-2">
        <div class="flex items-center justify-between gap-1 w-full max-w-lg mx-auto">
            <a href="{{ url('core:home') }}" class="flex flex-shrink-0 flex-col items-center gap-1 p-1.5 group">
                <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if request.path == '/' %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">🏠</div>
                <span class="text-[10px] font-black uppercase tracking-wider {% if request.path == '/' %}text-indigo-600{% else %}text-slate-500{% endif %}">{{ uil.home }}</span>
            </a>
            {% if not request.user.is_authenticated or current_role in ('STUDENT', 'VIP_USER') %}
                <div class="flex flex-1 justify-evenly items-center min-w-0 gap-0.5">
                <a href="{{ url('assessment:index') }}" class="flex flex-col items-center gap-0.5 p-1 group min-w-0 flex-1 max-w-[4.5rem]">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if 'assessment' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">📝</div>
                    <span class="text-[10px] font-black uppercase tracking-wider text-center leading-tight {% if 'assessment' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">{{ uil.test }}</span>
                </a>
