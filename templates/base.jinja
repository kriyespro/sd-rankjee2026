<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set _seo_title = seo_title if seo_title is defined and seo_title else "RankJee - Earn While You Learn" %}
    {% set _seo_description = seo_description if seo_description is defined and seo_description else "RankJee helps students learn, practice, and grow with tests, courses, and tutor support." %}
    {% set _canonical_url = canonical_url if canonical_url is defined and canonical_url else request.build_absolute_uri(request.path) %}
    <title>{% block title %}{{ _seo_title }}{% endblock %}</title>
    <meta name="description" content="{{ _seo_description }}">
    <link rel="canonical" href="{{ _canonical_url }}">
    {% if seo_noindex is defined and seo_noindex %}
    <meta name="robots" content="noindex, nofollow">
    {% else %}
    <meta name="robots" content="index, follow">
    {% endif %}
    <meta property="og:title" content="{{ _seo_title }}">
    <meta property="og:description" content="{{ _seo_description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ _canonical_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ _seo_title }}">
    <meta name="twitter:description" content="{{ _seo_description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# Async font CSS: avoids render-blocking chain on fonts.googleapis.com → gstatic woff2 #}
    {% set _gf = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;600;700;800;900&display=swap" %}
    <link rel="preload" as="style" href="{{ _gf }}" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ _gf }}"></noscript>
    <link rel="stylesheet" href="{{ static('css/app.css') }}">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
    <script defer src="{{ static('js/htmx.min.js') }}"></script>
    <style>
        [x-cloak] { display: none !important; }
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
        
        /* Smooth, modern scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        .nav-glass {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        .nav-link {
            transition: all 0.3s ease;
            position: relative;
            color: #475569;
        }
        .nav-link:hover {
            color: #4f46e5;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            width: 0;
            height: 1.5px;
            background: #4f46e5;
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }
        .nav-link:hover::after {
            width: 100%;
        }
        /* Mobile Bottom Bar Shadow */
        .mobile-nav-shadow {
            box-shadow: 0 -4px 20px -5px rgba(0, 0, 0, 0.08);
        }
        /* Top utility strip — explicit flex/gap (does not rely on Tailwind purge for spacing) */
        .nav-top-bar {
            background: linear-gradient(90deg, #0f172a 0%, #1e293b 45%, #1e1b4b 55%, #0f172a 100%);
            border-bottom: 1px solid rgba(99, 102, 241, 0.3);
        }
        .nav-top-bar-inner {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            column-gap: 0.75rem;
            row-gap: 0.25rem;
            max-width: 80rem;
            margin-left: auto;
            margin-right: auto;
            padding: 0.28rem 0.75rem;
        }
        @media (min-width: 768px) {
            .nav-top-bar-inner { padding: 0.32rem 1.25rem; }
        }
        .nav-top-bar-links {
            display: inline-flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0 0.85rem;
        }
        .nav-top-bar-links > a {
            color: #e2e8f0;
            font-size: 0.625rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            white-space: nowrap;
            padding: 0.15rem 0;
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: color 0.15s ease, border-color 0.15s ease;
        }
        @media (min-width: 768px) {
            .nav-top-bar-links > a { font-size: 0.6875rem; letter-spacing: 0.12em; }
        }
        .nav-top-bar-links > a:hover {
            color: #fff;
            border-bottom-color: rgba(129, 140, 248, 0.6);
        }
        .nav-top-sep {
            color: #64748b;
            font-size: 0.55rem;
            opacity: 0.9;
            line-height: 1;
            user-select: none;
            pointer-events: none;
            padding: 0 0.0625rem;
        }
        .nav-top-bar-actions {
            display: inline-flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.35rem 0.45rem;
        }
        .nav-top-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.625rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 0.375rem;
            padding: 0.22rem 0.55rem;
            min-height: 1.5rem;
            transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        }
        @media (min-width: 768px) {
            .nav-top-btn { font-size: 0.6875rem; padding: 0.25rem 0.65rem; min-height: 1.55rem; }
        }
        .nav-top-btn--login {
            color: #e2e8f0;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(148, 163, 184, 0.45);
        }
        .nav-top-btn--login:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(199, 210, 254, 0.5);
        }
        .nav-top-btn--join {
            color: #fff;
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            border: 1px solid rgba(129, 140, 248, 0.5);
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.1) inset, 0 2px 8px rgba(79, 70, 229, 0.35);
        }
        .nav-top-btn--join:hover {
            background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
        }
        .nav-top-btn--logout {
            color: #f8fafc;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid rgba(148, 163, 184, 0.4);
            cursor: pointer;
            font-family: inherit;
        }
        .nav-top-btn--logout:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(248, 113, 113, 0.55);
            color: #fecaca;
        }
    </style>
    {% block schema %}{% endblock %}
    {% block extra_head %}{% endblock %}
</head>
<body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen antialiased selection:bg-indigo-100 selection:text-indigo-900 font-sans pb-20 md:pb-0">
    {% set current_role = request.user.role if request.user.is_authenticated and request.user.role is defined else 'STUDENT' %}
    {% if request.user.is_authenticated and current_role == 'TUTOR' %}
        {% set top_study_href = url('study:tutor_dashboard') %}
    {% else %}
        {% set top_study_href = url('study:student_hub') %}
    {% endif %}

    <header class="sticky top-0 z-50">
        {# Slim utility row: quick account + blog — always visible above primary nav #}
        <div class="nav-top-bar">
            <div class="nav-top-bar-inner">
                <nav class="nav-top-bar-links" aria-label="Quick links">
                    <a href="{{ top_study_href }}">Study</a>
                    <span class="nav-top-sep" aria-hidden="true">·</span>
                    <a href="{{ url('blog:index') }}">Blog</a>
                </nav>
                <div class="nav-top-bar-actions">
                    {% if request.user.is_authenticated %}
                        <form action="{{ url('users:logout') }}" method="post" class="m-0">
                            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                            <button type="submit" class="nav-top-btn nav-top-btn--logout">{{ uil.logout }}</button>
                        </form>
                    {% else %}
                        <a href="{{ url('users:login') }}" class="nav-top-btn nav-top-btn--login">{{ uil.login }}</a>
                        <a href="{{ url('users:signup') }}" class="nav-top-btn nav-top-btn--join">{{ uil.join }}</a>
                    {% endif %}
                </div>
            </div>
        </div>

    <nav class="nav-glass border-t-0">
        <div class="max-w-7xl mx-auto px-4 md:px-8 h-12 md:h-14 flex justify-between items-center">
            <a href="{{ url('core:home') }}" class="flex items-center gap-2 md:gap-2.5 group">
                <div class="w-8 h-8 md:w-9 md:h-9 bg-indigo-600 rounded-lg md:rounded-xl flex items-center justify-center text-white font-black text-lg md:text-xl shadow-lg shadow-indigo-500/10 group-hover:scale-105 transition-transform">R</div>
                <span class="text-lg md:text-xl font-black text-slate-900 tracking-tight">Rank<span class="text-indigo-600">Jee</span></span>
            </a>
            <div class="flex items-center justify-end gap-3 min-w-0">
                {% if request.user.is_authenticated and not request.user.is_premium %}
                <a href="{{ url('payments:plans') }}" class="inline-flex items-center gap-1.5 bg-gradient-to-r from-amber-400 to-orange-500 text-white text-[10px] md:text-xs font-black px-3 py-1.5 md:px-4 md:py-2 rounded-lg md:rounded-xl shadow-md shadow-orange-200/80 hover:scale-[1.02] transition-all uppercase tracking-widest">
                    <span>{{ uil.pro }}</span>
                </a>
                {% endif %}
            </div>
        </div>
        {% if nav_progress_percent is defined %}
        <div class="h-1 bg-slate-100">
            <div class="h-1 bg-indigo-600 transition-all" style="width: {{ nav_progress_percent }}%"></div>
        </div>
        {% endif %}
    </nav>
    </header>

    <!-- Mobile Bottom Tab Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-t border-slate-100 md:hidden mobile-nav-shadow px-4 py-2">
        <div class="flex items-center justify-between gap-1 w-full max-w-lg mx-auto">
            <a href="{{ url('core:home') }}" class="flex flex-shrink-0 flex-col items-center gap-1 p-1.5 group">
                <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if request.path == '/' %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">🏠</div>
                <span class="text-[10px] font-black uppercase tracking-wider {% if request.path == '/' %}text-indigo-600{% else %}text-slate-500{% endif %}">{{ uil.home }}</span>
            </a>
            {% if not request.user.is_authenticated or current_role == 'STUDENT' %}
                <div class="flex flex-1 justify-evenly items-center min-w-0 gap-0.5">
                <a href="{{ url('assessment:index') }}" class="flex flex-col items-center gap-0.5 p-1 group min-w-0 flex-1 max-w-[4.5rem]">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if 'assessment' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">📝</div>
                    <span class="text-[10px] font-black uppercase tracking-wider text-center leading-tight {% if 'assessment' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">{{ uil.test }}</span>
                </a>
                <a href="{{ url('learning:index') }}" class="flex flex-col items-center gap-0.5 p-1 group min-w-0 flex-1 max-w-[4.5rem]">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if 'learning' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">🎓</div>
                    <span class="text-[10px] font-black uppercase tracking-wider text-center leading-tight {% if 'learning' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">{{ uil.learn }}</span>
                </a>
                {% if request.user.is_authenticated and current_role == 'STUDENT' %}
                <a href="{{ url('study:student_hub') }}" class="flex flex-col items-center gap-0.5 p-1 group min-w-0 flex-1 max-w-[4.5rem]">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if request.path.startswith('/study/') %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">📚</div>
                    <span class="text-[10px] font-black uppercase tracking-wider text-center leading-tight {% if request.path.startswith('/study/') %}text-indigo-600{% else %}text-slate-500{% endif %}">Study</span>
                </a>
                {% endif %}
                {% if request.user.is_authenticated and current_role == 'STUDENT' %}
                <a href="{{ url('dashboard:daily_class_log') }}" class="flex flex-col items-center gap-0.5 p-1 group min-w-0 flex-1 max-w-[4.5rem]">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if 'daily-class-log' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">📓</div>
                    <span class="text-[10px] font-black uppercase tracking-wider text-center leading-tight {% if 'daily-class-log' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">Class log</span>
                </a>
                {% endif %}
                <a href="{{ url('core:earnings') }}" class="flex flex-col items-center gap-0.5 p-1 group min-w-0 flex-1 max-w-[4.5rem]">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg transition-all {% if 'earnings' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">💰</div>
                    <span class="text-[10px] font-black uppercase tracking-wider text-center leading-tight {% if 'earnings' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">{{ uil.earn }}</span>
                </a>
                </div>
            {% elif current_role == 'TUTOR' %}
                <a href="{{ url('hometutor:tutor_demos') }}" class="flex flex-col items-center gap-1 p-2 group">
                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-xl transition-all {% if 'my/demos' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">📥</div>
                    <span class="text-xs font-black uppercase tracking-widest {% if 'my/demos' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">Inbox</span>
                </a>
                <a href="{{ url('hometutor:my_profile') }}" class="flex flex-col items-center gap-1 p-2 group">
                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-xl transition-all {% if 'my/profile' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">🧑</div>
                    <span class="text-xs font-black uppercase tracking-widest {% if 'my/profile' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">Profile</span>
                </a>
            {% elif current_role == 'PARENT' %}
                <a href="{{ url('hometutor:tutor_list') }}" class="flex flex-col items-center gap-1 p-2 group">
                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-xl transition-all {% if request.path.startswith('/hometutor/') and 'requests' not in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">👨‍🏫</div>
                    <span class="text-xs font-black uppercase tracking-widest {% if request.path.startswith('/hometutor/') and 'requests' not in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">Tutors</span>
                </a>
                <a href="{{ url('hometutor:my_demo_requests') }}" class="flex flex-col items-center gap-1 p-2 group">
                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-xl transition-all {% if 'my/requests' in request.path %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">📅</div>
                    <span class="text-xs font-black uppercase tracking-widest {% if 'my/requests' in request.path %}text-indigo-600{% else %}text-slate-500{% endif %}">Demos</span>
                </a>
            {% else %}
                <a href="/sd/" class="flex flex-col items-center gap-1 p-2 group">
                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-xl transition-all {% if request.path.startswith('/sd/') %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">🛡️</div>
                    <span class="text-xs font-black uppercase tracking-widest {% if request.path.startswith('/sd/') %}text-indigo-600{% else %}text-slate-500{% endif %}">Admin</span>
                </a>
                <a href="{{ url('hometutor:tutor_list') }}" class="flex flex-col items-center gap-1 p-2 group">
                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-xl transition-all {% if request.path.startswith('/hometutor/') %}bg-indigo-600 text-white shadow-lg shadow-indigo-200{% else %}text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600{% endif %}">👨‍🏫</div>
                    <span class="text-xs font-black uppercase tracking-widest {% if request.path.startswith('/hometutor/') %}text-indigo-600{% else %}text-slate-500{% endif %}">Tutors</span>
                </a>
            {% endif %}
        </div>
    </div>

    <main class="flex-grow text-base leading-relaxed text-slate-800">
        {% if messages %}
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
                {% for message in messages %}
                <div class="p-3 rounded-lg mb-4 text-base font-bold shadow-sm flex items-center gap-2 {% if message.tags == 'error' %}bg-red-50 text-red-800 border border-red-100{% else %}bg-indigo-50 text-indigo-800 border border-indigo-100{% endif %}">
                    {% if message.tags == 'error' %}
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    {% else %}
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    {% endif %}
                    {{ message }}
                </div>
                {% endfor %}
            </div>
        {% endif %}
        {% block content %}{% endblock %}
    </main>

    <footer class="bg-white border-t border-slate-200/60 py-5 text-center text-sm font-semibold text-slate-600 mt-auto space-y-2">
        <div class="flex flex-wrap justify-center gap-4">
            <a href="{{ url('core:privacy') }}" class="text-slate-700 hover:text-indigo-600">Privacy</a>
            <a href="{{ url('core:terms') }}" class="text-slate-700 hover:text-indigo-600">Terms</a>
        </div>
        <p class="text-xs text-slate-500">&copy; 2026 RankJee · Focus on Execution</p>
    </footer>
</body>
</html>
