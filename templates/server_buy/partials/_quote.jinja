{# Main quote panel (swapped into #server-quote). OOB sibling updates the fixed footer. #}
<div>
<div class="overflow-hidden rounded-2xl border border-slate-200/90 bg-gradient-to-br from-white to-slate-50/90 shadow-sm ring-1 ring-slate-900/5">
    {% if incomplete %}
    <div class="flex gap-3 p-5">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500" aria-hidden="true">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
            <p class="text-sm font-bold text-slate-800">Pick a server setup</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-600">Choose one of the preset configurations below. Your total is fixed for that setup.</p>
        </div>
    </div>
    {% elif error %}
    <div class="flex gap-3 p-5">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-100 text-rose-600" aria-hidden="true">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-sm font-semibold text-rose-800">{{ error }}</p>
    </div>
    {% elif quote %}
    <div class="border-b border-slate-100 bg-slate-50/80 px-5 py-4">
        <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500">Your selection</h3>
        <p class="mt-1 text-base font-bold text-slate-900">{{ quote.title }}</p>
    </div>
    <dl class="grid gap-0 divide-y divide-slate-100 px-5 py-1 sm:grid-cols-2">
        {% for line in quote.lines %}
        {% if line.kind == 'spec' %}
        <div class="flex flex-col gap-0.5 py-3 sm:px-1">
            <dt class="text-[10px] font-black uppercase tracking-wider text-slate-500">{{ line.label }}</dt>
            <dd class="text-sm font-semibold text-slate-900">{{ line.value }}</dd>
        </div>
        {% endif %}
        {% endfor %}
    </dl>
    <div class="flex items-end justify-between gap-4 bg-gradient-to-r from-indigo-600/5 to-violet-600/5 px-5 py-4">
        <div>
            <p class="text-[11px] font-black uppercase tracking-[0.2em] text-indigo-900/70">Fixed price</p>
            <p class="mt-1 text-3xl font-black tabular-nums tracking-tight text-slate-900">₹{{ quote.total_inr }}</p>
        </div>
        <span class="mb-1 rounded-full bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-indigo-700 shadow-sm ring-1 ring-indigo-100">One payment · INR</span>
    </div>
    {% else %}
    <div class="p-5 text-sm text-slate-600">Unable to load this setup. Try again or pick another option.</div>
    {% endif %}
</div>
</div>

<div id="server-buy-footer-price" hx-swap-oob="true" class="pointer-events-auto fixed bottom-0 left-0 right-0 z-[60] border-t border-slate-200/90 bg-white/90 shadow-[0_-12px_40px_-12px_rgba(15,23,42,0.15)] backdrop-blur-md supports-[backdrop-filter]:bg-white/75">
    <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-4">
        <div class="min-w-0 flex-1">
            {% if quote %}
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Pay today</p>
            <p class="truncate text-2xl font-black tabular-nums text-slate-900 sm:text-3xl">₹{{ quote.total_inr }}</p>
            <p class="truncate text-xs text-slate-500">{{ quote.title }} — Razorpay secure checkout</p>
            {% elif incomplete %}
            <p class="text-sm font-semibold text-slate-700">Total</p>
            <p class="text-lg font-bold text-slate-400">—</p>
            <p class="text-xs text-slate-500">Select a server setup to see your fixed price</p>
            {% elif error %}
            <p class="text-sm font-semibold text-rose-800">Cannot show price</p>
            <p class="text-xs text-rose-600/90">Adjust your selection above</p>
            {% else %}
            <p class="text-sm font-semibold text-slate-600">Total</p>
            <p class="text-lg font-bold text-slate-400">—</p>
            {% endif %}
        </div>
        <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:min-w-[200px]">
            <button type="button" id="server-pay-btn" form="server-buy-form"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3.5 text-sm font-black uppercase tracking-wider text-white shadow-lg shadow-indigo-500/25 transition hover:from-indigo-500 hover:to-violet-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 disabled:shadow-none"
                    {% if not quote %}disabled{% endif %}>
                <svg class="h-4 w-4 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                Pay with Razorpay
            </button>
            {% if quote %}
            <p class="text-center text-[10px] text-slate-500">Amount confirmed in Razorpay window</p>
            {% endif %}
        </div>
    </div>
</div>
