{# Role cards — shared by signup + Google onboarding. Expects: role_rows, selected_role, field_name (default role) #}
{% set _field = field_name|default('role') %}
<div class="grid gap-3 md:gap-4">
    {% for value, icon, title, line1, line2 in role_rows %}
    <label class="block rounded-xl md:rounded-2xl border-2 p-4 md:p-5 cursor-pointer transition-all
        {% if selected_role == value %}border-indigo-500 bg-indigo-50/80 shadow-sm ring-2 ring-indigo-100{% else %}border-slate-200 bg-white hover:border-indigo-200{% endif %}">
        <div class="flex items-start gap-3 md:gap-4">
            <input type="radio" name="{{ _field }}" value="{{ value }}" class="mt-1 md:mt-1.5 shrink-0"
                   {% if selected_role == value %}checked{% endif %}>
            <span class="text-2xl md:text-3xl leading-none">{{ icon }}</span>
            <div class="min-w-0">
                <span class="block text-base md:text-lg font-black text-slate-900">{{ title }}</span>
                <span class="block text-xs md:text-sm font-semibold text-slate-700 mt-0.5">{{ line1 }}</span>
                {% if line2 %}
                <span class="block text-xs text-slate-500 mt-1">{{ line2 }}</span>
                {% endif %}
            </div>
        </div>
    </label>
    {% endfor %}
</div>
