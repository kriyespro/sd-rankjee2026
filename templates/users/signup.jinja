{% extends "base.jinja" %}
{% block title %}Join Free - RankJee{% endblock %}
{% block content %}
<div class="max-w-lg mx-auto mt-12 mb-24 px-4">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-6 md:p-8">
        <div class="text-center mb-6">
            <div class="text-4xl mb-3 drop-shadow-sm">✨</div>
            <h2 class="text-3xl font-black text-slate-900 tracking-tight">Join RankJee — it's free</h2>
            <p class="text-slate-500 mt-2 text-sm font-medium leading-relaxed">
                Students practice for exams. Parents find tutors. Tutors get students.<br>
                <span class="text-emerald-600 font-bold">Get ₹50 free credit</span> when you sign up.
            </p>
        </div>

        <form method="post" action="{{ url('users:signup') }}" class="space-y-5"
              x-data="{ role: '{{ selected_role }}' }"
              @change="if ($event.target.name === 'role') role = $event.target.value">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">

            <p class="text-xs font-black uppercase tracking-wider text-slate-500">Step 1 — Pick who you are</p>
            {% include 'users/partials/_role_picker_cards.jinja' %}
            {% if form.role.errors %}
            <p class="text-rose-600 text-xs font-semibold">{{ form.role.errors|join(', ') }}</p>
            {% endif %}

            <div class="relative my-2">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
                <div class="relative flex justify-center text-xs uppercase">
                    <span class="bg-white px-3 text-slate-500 font-semibold tracking-wide">Step 2 — Your account</span>
                </div>
            </div>

            <a :href="'{{ url('users:google_signup_start') }}?role=' + encodeURIComponent(role)"
               class="group w-full inline-flex items-center justify-center gap-3 rounded-lg border border-[#dadce0] bg-white py-3 px-4 text-sm font-semibold text-[#3c4043] shadow-sm transition-all hover:bg-[#f8f9fa] hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[#4285F4]/40 focus:ring-offset-2">
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <span>Continue with Google</span>
            </a>
            <p class="text-center text-xs text-slate-400 font-medium">or use email below</p>

            <div class="space-y-4">
                <div>
                    <label for="id_username" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Username</label>
                    <input type="text" name="username" id="id_username" required
                           value="{{ form.username.value() or '' }}"
                           placeholder="e.g. priya2026"
                           class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white">
                    {% if form.username.errors %}<p class="text-rose-500 text-xs font-semibold mt-1">{{ form.username.errors|join(', ') }}</p>{% endif %}
                </div>
                <div>
                    <label for="id_email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email</label>
                    <input type="email" name="email" id="id_email" required
                           value="{{ form.email.value() or '' }}"
                           placeholder="you@email.com"
                           class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white">
                    {% if form.email.errors %}<p class="text-rose-500 text-xs font-semibold mt-1">{{ form.email.errors|join(', ') }}</p>{% endif %}
                </div>
                <div>
                    <label for="id_password1" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
                    <input type="password" name="password1" id="id_password1" required
                           class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white">
                    {% if form.password1.errors %}<p class="text-rose-500 text-xs font-semibold mt-1">{{ form.password1.errors|join(', ') }}</p>{% endif %}
                </div>
                <div>
                    <label for="id_password2" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Confirm password</label>
                    <input type="password" name="password2" id="id_password2" required
                           class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white">
                    {% if form.password2.errors %}<p class="text-rose-500 text-xs font-semibold mt-1">{{ form.password2.errors|join(', ') }}</p>{% endif %}
                </div>
            </div>

            <div class="pt-2 border-t border-slate-100">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                    Referral code <span class="text-slate-400 font-medium normal-case">(optional)</span>
                </label>
                <input type="text" name="referral_code" value="{{ ref_code }}"
                       placeholder="e.g. A1B2C3D4"
                       class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm font-mono uppercase bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500">
            </div>

            <button type="submit" class="w-full bg-indigo-600 text-white py-3.5 rounded-xl font-black text-sm hover:bg-slate-900 transition-colors shadow-sm">
                Create free account →
            </button>
        </form>
    </div>
    <p class="mt-8 text-center text-sm font-medium text-slate-500">
        Already have an account?
        <a href="{{ url('users:login') }}" class="text-indigo-600 font-bold hover:text-indigo-800">Log in</a>
    </p>
</div>
{% endblock %}
