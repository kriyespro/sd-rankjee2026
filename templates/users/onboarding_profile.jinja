{% extends "base.jinja" %}
{% block title %}Complete profile · RankJee{% endblock %}

{% block content %}
<section class="max-w-3xl mx-auto px-4 py-12">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Complete your {{ role_label }} profile</h1>
        <p class="text-slate-600 text-sm mt-2">
            {% if role == 'TUTOR' %}
            Add core tutoring details now. You can refine your full listing after this step.
            {% else %}
            Add basic account details to personalize your experience.
            {% endif %}
        </p>

        <form method="post" class="mt-6 space-y-4">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            {% for field in form %}
            <div>
                <label for="{{ field.id_for_label }}" class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">
                    {{ field.label }}
                </label>
                {{ field }}
                {% if field.help_text %}
                <p class="text-xs text-slate-500 mt-1">{{ field.help_text }}</p>
                {% endif %}
                {% if field.errors %}
                <p class="text-xs text-rose-700 mt-1">{{ field.errors|join(', ') }}</p>
                {% endif %}
            </div>
            {% endfor %}
            {% if form.non_field_errors() %}
            <p class="text-sm text-rose-700 font-semibold">{{ form.non_field_errors()|join(', ') }}</p>
            {% endif %}
            <button type="submit" class="w-full inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-white text-sm font-black hover:bg-indigo-500">
                Finish setup
            </button>
        </form>
    </div>
</section>
{% endblock %}
