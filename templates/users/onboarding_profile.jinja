{% extends "base.jinja" %}
{% block title %}Almost done · RankJee{% endblock %}

{% block content %}
<section class="max-w-2xl mx-auto px-4 py-12" {% if role == 'TUTOR' %}x-data="{ showMore: false }"{% endif %}>
    <div class="text-center mb-8">
        <p class="text-xs font-black uppercase tracking-widest text-indigo-600">Almost done</p>
        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight mt-2">
            {% if role == 'TUTOR' %}
            Set up your tutor listing
            {% elif role == 'PARENT' %}
            Hi parent — just your name
            {% else %}
            Hi — what's your name?
            {% endif %}
        </h1>
        <p class="text-slate-600 text-sm mt-2 max-w-md mx-auto">
            {% if role == 'TUTOR' %}
            Only 4 quick fields to go live. Add photo, fees & bio later from your dashboard.
            {% else %}
            Takes 10 seconds. You can fill the rest later.
            {% endif %}
        </p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-8">
        <form method="post" class="space-y-4">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">

            {% if role == 'TUTOR' %}
                {% for field_name in quick_fields %}
                {% set field = form[field_name] %}
                <div>
                    <label for="{{ field.id_for_label }}" class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1.5">
                        {{ field.label }}{% if field.field.required %} <span class="text-rose-500">*</span>{% endif %}
                    </label>
                    {{ field }}
                    {% if field.errors %}<p class="text-xs text-rose-700 mt-1 font-semibold">{{ field.errors|join(', ') }}</p>{% endif %}
                </div>
                {% endfor %}

                <button type="button" @click="showMore = !showMore"
                        class="w-full text-left text-sm font-bold text-indigo-600 hover:text-indigo-800 py-2">
                    <span x-text="showMore ? '− Hide optional details' : '+ Add optional details (area, classes, fee, bio)'"></span>
                </button>

                <div x-show="showMore" x-cloak class="space-y-4 border-t border-slate-100 pt-4">
                    {% for field_name in optional_fields %}
                    {% set field = form[field_name] %}
                    <div>
                        <label for="{{ field.id_for_label }}" class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1.5">
                            {{ field.label }}
                        </label>
                        {{ field }}
                        {% if field.errors %}<p class="text-xs text-rose-700 mt-1">{{ field.errors|join(', ') }}</p>{% endif %}
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                {% for field in form %}
                <div>
                    <label for="{{ field.id_for_label }}" class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1.5">
                        {{ field.label }}{% if field.field.required %} <span class="text-rose-500">*</span>{% endif %}
                    </label>
                    {{ field }}
                    {% if field.errors %}<p class="text-xs text-rose-700 mt-1 font-semibold">{{ field.errors|join(', ') }}</p>{% endif %}
                </div>
                {% endfor %}
            {% endif %}

            {% if form.non_field_errors() %}
            <p class="text-sm text-rose-700 font-semibold">{{ form.non_field_errors()|join(', ') }}</p>
            {% endif %}

            <button type="submit" class="w-full inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3.5 text-white text-sm font-black hover:bg-indigo-500 shadow-sm">
                {% if role == 'TUTOR' %}Publish my listing →{% else %}Go to my dashboard →{% endif %}
            </button>

            {% if role != 'TUTOR' %}
            <button type="submit" name="action" value="skip"
                    class="w-full text-center text-sm font-semibold text-slate-500 hover:text-slate-700 py-2">
                Skip for now
            </button>
            {% endif %}
        </form>
        {% if subject_suggestions %}
        <datalist id="subject-suggestions">
            {% for s in subject_suggestions %}<option value="{{ s }}">{% endfor %}
        </datalist>
        {% endif %}
    </div>
</section>
{% endblock %}
