{% extends "base.jinja" %}
{% block title %}{{ pub.user.username }} — RankJee Profile{% endblock %}
{% block content %}
<div class="max-w-2xl mx-auto px-4 py-10">
    <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-8">
        <p class="text-[10px] font-black uppercase tracking-widest text-indigo-600 mb-2">Public learner profile</p>
        <h1 class="text-2xl font-black text-slate-900">{{ pub.user.username }}</h1>
        {% if pub.headline %}
        <p class="text-slate-600 mt-2">{{ pub.headline }}</p>
        {% endif %}
        <div class="flex gap-6 mt-6 text-sm">
            <div><span class="text-slate-400 font-bold uppercase text-[10px]">Tests</span><p class="font-black text-lg">{{ attempts_total }}</p></div>
            <div><span class="text-slate-400 font-bold uppercase text-[10px]">Passed</span><p class="font-black text-lg text-emerald-600">{{ passed_total }}</p></div>
        </div>
        {% if badges %}
        <div class="mt-8">
            <h2 class="text-xs font-black uppercase text-slate-400 mb-3">Badges</h2>
            <div class="flex flex-wrap gap-2">
                {% for b in badges %}
                <span class="text-xl" title="{{ b.badge.title }}">{{ b.badge.icon }}</span>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>

    <div class="mt-8 bg-slate-50 rounded-2xl border border-slate-200 p-6">
        <h2 class="font-black text-slate-800 mb-4">Hiring inquiry</h2>
        <form method="post" action="{{ url('users:company_inquiry', pub.slug) }}" class="space-y-4">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <input type="text" name="website" class="absolute -left-[9999px] opacity-0" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1">Company</label>
                <input type="text" name="company_name" required maxlength="200" class="w-full rounded-xl border border-slate-200 px-4 py-2 text-sm">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1">Work email</label>
                <input type="email" name="contact_email" required class="w-full rounded-xl border border-slate-200 px-4 py-2 text-sm">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1">Message</label>
                <textarea name="message" required maxlength="2000" rows="4" class="w-full rounded-xl border border-slate-200 px-4 py-2 text-sm"></textarea>
            </div>
            <button type="submit" class="w-full py-3 rounded-xl bg-indigo-600 text-white font-black text-sm uppercase tracking-widest hover:bg-indigo-700">Send inquiry</button>
        </form>
    </div>
</div>
{% endblock %}
